        # ── Gate G8.5D5 — EV-Kelly-CPCV-Coherence (v132.0) ─────────────────
        # Zero-API meta-gate that cross-validates 3 complementary momentum
        # sentinels: EVPV (_last_g85b5_evpv), TSQC (_last_g85c5_tsqc), and
        # SVC (_last_g85a5_svc).  All 3 positive = strong multi-source
        # confirmation (+2.0pts); 2/3 positive = moderate alignment (+1.0pts);
        # all 3 negative = triple-crisis brake (−2.0pts); 2/3 negative = mild
        # brake (−1.0pts).  Uses sentinels already computed this cycle — zero
        # additional API calls, zero latency overhead.
        # Sentinel: _last_g85d5_ekc. [v132.0]
        try:
            _d5_evpv = int(getattr(self, "_last_g85b5_evpv", 0) or 0)   # +2/+1=EV-positive, -1=EV-negative
            _d5_tsqc = int(getattr(self, "_last_g85c5_tsqc", 0) or 0)   # +2/+1=quality-ok, -1=quality-crisis
            _d5_svc  = int(getattr(self, "_last_g85a5_svc",  0) or 0)   # +2/+1=sharpe+quality-ok, -1=both-negative
            _d5_votes_pos = sum(1 for v in (_d5_evpv, _d5_tsqc, _d5_svc) if v > 0)
            _d5_votes_neg = sum(1 for v in (_d5_evpv, _d5_tsqc, _d5_svc) if v < 0)
            if _d5_votes_pos == 3:
                _d5_ekc = 2; _d5_adj = +2.0; _d5_pass = True
            elif _d5_votes_pos == 2:
                _d5_ekc = 1; _d5_adj = +1.0; _d5_pass = True
            elif _d5_votes_neg == 3:
                _d5_ekc = -1; _d5_adj = -2.0; _d5_pass = False
            elif _d5_votes_neg == 2:
                _d5_ekc = -1; _d5_adj = -1.0; _d5_pass = False
            else:
                _d5_ekc = 0; _d5_adj = 0.0; _d5_pass = True
            quality_score += _d5_adj
            self._last_g85d5_ekc = _d5_ekc
            self._gate_stats["gate_g85d5_ekc"]["pass" if _d5_pass else "fail"] += 1
            _d5_ring2 = self._gate_stats_recent.get("gate_g85d5_ekc")
            if _d5_ring2 is not None:
                _d5_ring2.append(1 if _d5_pass else 0)
            if _d5_adj != 0.0:
                self._logger.debug(
                    f"[v132.0 G8.5D5 EKC] {symbol} "
                    f"evpv={_d5_evpv:+d} tsqc={_d5_tsqc:+d} svc={_d5_svc:+d} "
                    f"pos={_d5_votes_pos} neg={_d5_votes_neg} adj={_d5_adj:+.1f}pts ekc={_d5_ekc:+d}"
                )
        except Exception:
            pass  # G8.5D5 EV-Kelly-CPCV-Coherence is non-fatal soft-gate

        # ── Gate G8.5E5 — Multi-Sentinel-Consensus Meta-Gate (v132.0) ───────
        # Zero-API 4-sentinel majority vote.  Aggregates RWS (_last_g85b4_rws),
        # AEV (_last_g85c4_aev), EVPV (_last_g85b5_evpv), and TSQC
        # (_last_g85c5_tsqc) into a single meta-consensus signal.  ≥3/4
        # positive = strong multi-sentinel bullish alignment (+2.0pts); 2/4
        # = mild alignment (+1.0pts); ≥3/4 negative = multi-sentinel crisis
        # brake (−2.0pts); 2/4 negative = mild brake (−1.0pts).
        # Requires ≥2 non-neutral votes before applying to avoid cold-start noise.
        # Sentinel: _last_g85e5_msc. [v132.0]
        try:
            _e5_rws  = int(getattr(self, "_last_g85b4_rws",  0) or 0)   # hot=+1, losing=-2/-3
            _e5_aev  = int(getattr(self, "_last_g85c4_aev",  0) or 0)   # ev-positive=+1, ev-hole=-3/-2/-1
            _e5_evpv = int(getattr(self, "_last_g85b5_evpv", 0) or 0)   # ev-trend=+2/+1, negative=-1
            _e5_tsqc = int(getattr(self, "_last_g85c5_tsqc", 0) or 0)   # quality-ok=+2/+1, crisis=-1
            _e5_votes_pos = sum(1 for v in (_e5_rws, _e5_aev, _e5_evpv, _e5_tsqc) if v > 0)
            _e5_votes_neg = sum(1 for v in (_e5_rws, _e5_aev, _e5_evpv, _e5_tsqc) if v < 0)
            _e5_non_neutral = _e5_votes_pos + _e5_votes_neg
            if _e5_non_neutral < 2:
                _e5_msc = 0; _e5_adj = 0.0; _e5_pass = True   # insufficient evidence
            elif _e5_votes_pos >= 3:
                _e5_msc = 2; _e5_adj = +2.0; _e5_pass = True
            elif _e5_votes_pos == 2 and _e5_votes_neg <= 1:
                _e5_msc = 1; _e5_adj = +1.0; _e5_pass = True
            elif _e5_votes_neg >= 3:
                _e5_msc = -1; _e5_adj = -2.0; _e5_pass = False
            elif _e5_votes_neg == 2 and _e5_votes_pos <= 1:
                _e5_msc = -1; _e5_adj = -1.0; _e5_pass = False
            else:
                _e5_msc = 0; _e5_adj = 0.0; _e5_pass = True
            quality_score += _e5_adj
            self._last_g85e5_msc = _e5_msc
            self._gate_stats["gate_g85e5_msc"]["pass" if _e5_pass else "fail"] += 1
            _e5_ring2 = self._gate_stats_recent.get("gate_g85e5_msc")
            if _e5_ring2 is not None:
                _e5_ring2.append(1 if _e5_pass else 0)
            if _e5_adj != 0.0:
                self._logger.debug(
                    f"[v132.0 G8.5E5 MSC] {symbol} "
                    f"rws={_e5_rws:+d} aev={_e5_aev:+d} evpv={_e5_evpv:+d} tsqc={_e5_tsqc:+d} "
                    f"pos={_e5_votes_pos} neg={_e5_votes_neg} adj={_e5_adj:+.1f}pts msc={_e5_msc:+d}"
                )
        except Exception:
            pass  # G8.5E5 Multi-Sentinel-Consensus Meta-Gate is non-fatal soft-gate

        # ── Gate G8.5F5 — IRONS-Quality-Regime Composite (v133.0) ──────────
        # Zero-API 3-source composite.  Cross-validates IRONS score trajectory
        # (recent-10 vs all-time mean from _irons_score_ring), quality_score_ring
        # slope (recent-4 vs prior-4 mean delta), and volume_ratio regime band
        # (1.2–2.0 = institutional conviction; >2.0 = noise/exhaustion flip).
        # All 3 positive = strong multi-source institutional alignment (+2.0pts).
        # 2/3 positive = moderate alignment (+1.0pts).
        # All 3 negative = triple-crisis brake (−2.0pts); 2/3 = mild (−1.0pts).
        # Requires ≥5 IRONS scores and ≥4 quality scores (cold-start safe).
        # Sentinel: _last_g85f5_irq. [v133.0]
        try:
            # Source 1: IRONS score trajectory — recent-10 vs all-time average
            _f5_iring   = list(getattr(self, "_irons_score_ring", []) or [])
            _f5_delta   = 0.0
            _f5_irq1    = 0
            if len(_f5_iring) >= 5:
                _f5_recent  = sum(_f5_iring[-min(10, len(_f5_iring)):]) / min(10, len(_f5_iring))
                _f5_all_avg = sum(_f5_iring) / len(_f5_iring)
                _f5_delta   = _f5_recent - _f5_all_avg
                _f5_irq1    = (1 if _f5_delta >= 1.5 else (-1 if _f5_delta <= -1.5 else 0))
            # Source 2: quality_score_ring slope — recent-4 vs prior-4 mean delta
            _f5_qring   = list(getattr(self, "_quality_score_ring", []) or [])
            _f5_qdelta  = 0.0
            _f5_irq2    = 0
            if len(_f5_qring) >= 4:
                _f5_qrecent = sum(_f5_qring[-4:]) / 4
                _f5_qprior  = (sum(_f5_qring[:4]) / 4) if len(_f5_qring) >= 8 else _f5_qrecent
                _f5_qdelta  = _f5_qrecent - _f5_qprior
                _f5_irq2    = (1 if _f5_qdelta >= 1.0 else (-1 if _f5_qdelta <= -1.0 else 0))
            # Source 3: volume_ratio regime — conviction band vs noise/exhaustion
            _f5_vr   = float(signal_data.get("volume_ratio", 1.0) if isinstance(signal_data, dict) else 1.0)
            _f5_irq3 = (1 if 1.2 <= _f5_vr <= 2.0 else (-1 if _f5_vr > 2.0 else 0))
            _f5_votes_pos = sum(1 for v in (_f5_irq1, _f5_irq2, _f5_irq3) if v > 0)
            _f5_votes_neg = sum(1 for v in (_f5_irq1, _f5_irq2, _f5_irq3) if v < 0)
            if _f5_votes_pos == 3:
                _f5_irq = 2;  _f5_adj = +2.0; _f5_pass = True
            elif _f5_votes_pos == 2:
                _f5_irq = 1;  _f5_adj = +1.0; _f5_pass = True
            elif _f5_votes_neg == 3:
                _f5_irq = -1; _f5_adj = -2.0; _f5_pass = False
            elif _f5_votes_neg == 2:
                _f5_irq = -1; _f5_adj = -1.0; _f5_pass = False
            else:
                _f5_irq = 0;  _f5_adj = 0.0;  _f5_pass = True
            quality_score += _f5_adj
            self._last_g85f5_irq = _f5_irq
            self._gate_stats["gate_g85f5_irq"]["pass" if _f5_pass else "fail"] += 1
            _f5_ring2 = self._gate_stats_recent.get("gate_g85f5_irq")
            if _f5_ring2 is not None:
                _f5_ring2.append(1 if _f5_pass else 0)
            if _f5_adj != 0.0:
                self._logger.debug(
                    f"[v133.0 G8.5F5 IRQ] {symbol} "
                    f"irons_delta={_f5_delta:+.2f} qual_delta={_f5_qdelta:+.2f} "
                    f"vol_ratio={_f5_vr:.2f} pos={_f5_votes_pos} neg={_f5_votes_neg} "
                    f"adj={_f5_adj:+.1f}pts irq={_f5_irq:+d}"
                )
        except Exception:
            pass  # G8.5F5 IRONS-Quality-Regime Composite is non-fatal soft-gate

        # ── Gate G8.5G5 — Regime-Flow-Conviction Composite (v133.0) ─────────
        # Zero-API 3-source conviction filter.  Cross-validates HMM macro regime
        # direction (bull/bear from _hmm_regime.state), OFI directional z-score
        # alignment (from signal_data["ofi_z"] ±0.3σ threshold), and volume_ratio
        # conviction band (1.2–2.0 = institutional flow; >2.5 = noise/exhaustion).
        # All 3 directionally aligned = strong multi-layer conviction (+2.0pts).
        # 2/3 aligned = moderate conviction (+1.0pts).
        # All 3 opposed = triple-divergence brake (−2.0pts); 2/3 = mild (−1.0pts).
        # Sentinel: _last_g85g5_rfc. [v133.0]
        try:
            _g5_dir_int = (1 if direction in ("BUY", "LONG") else (-1 if direction in ("SELL", "SHORT") else 0))
            # Source 1: HMM macro regime direction alignment
            _g5_hmm_ref   = getattr(self, "_hmm_regime", None)
            _g5_rfc1      = 0
            _g5_hmm_state = ""
            if _g5_hmm_ref is not None:
                _g5_hmm_state = str(getattr(_g5_hmm_ref, "state", "") or "").upper()
                _g5_hmm_dir   = (1 if _g5_hmm_state in ("BULL", "BULLISH", "TRENDING") else
                                  (-1 if _g5_hmm_state in ("BEAR", "BEARISH") else 0))
                if _g5_dir_int != 0 and _g5_hmm_dir != 0:
                    _g5_rfc1 = (1 if _g5_hmm_dir == _g5_dir_int else -1)
            # Source 2: OFI direction alignment (±0.3σ threshold)
            _g5_ofi_z   = float(signal_data.get("ofi_z", 0.0) if isinstance(signal_data, dict) else 0.0)
            _g5_ofi_dir = (1 if _g5_ofi_z > 0.3 else (-1 if _g5_ofi_z < -0.3 else 0))

        # ── Gate G8.5A4 — FlowVolumeRegime-TripleSync (v114.0) ──
        # 87th gate. Zero-API-call soft-gate: cross-validates 3 pre-computed flow/volume
        # regime sentinels from v87-91 generation to confirm multi-source flow alignment.
        # Vote 1: _last_g85u2_vov — VoV-StabilityRegime (+1=stable vol, -1=chaotic vol, 0=neutral)
        # Vote 2: _last_g85v2_obp — OBPressure-Imbalance (+1=aligned OB pressure, -1=opposing pressure, 0=neutral)
        # Vote 3: _last_g85y2_hvc — HMM-VPIN-Coherence (+1=coherent HMM+VPIN, -1=divergent, 0=neutral)
        #   +2.0pts = 3-vote positive (all 3 flow/volume sources confirm flow-aligned)
        #   +1.5pts = 2-vote majority positive (majority flow/volume sources aligned)
        #   −1.5pts = 2-vote majority negative (majority flow/volume sources opposed)
        #   −2.0pts = 3-vote negative (all 3 flow/volume sources confirm flow-opposed)
        # Stores _last_g85a4_fvr (+1/-1/0) for Kelly Step 79 [v114.0].
        try:
            _a4_v1 = int(getattr(self, "_last_g85u2_vov", 0) or 0)   # Vote 1: VoV-StabilityRegime
            _a4_v2 = int(getattr(self, "_last_g85v2_obp", 0) or 0)   # Vote 2: OBPressure-Imbalance
            _a4_v3 = int(getattr(self, "_last_g85y2_hvc", 0) or 0)   # Vote 3: HMM-VPIN-Coherence
            _a4_fired = False
            self._last_g85a4_fvr = 0  # reset
            _a4_pos = sum(1 for v in [_a4_v1, _a4_v2, _a4_v3] if v > 0)
            _a4_neg = sum(1 for v in [_a4_v1, _a4_v2, _a4_v3] if v < 0)
            if _a4_pos == 3:
                quality_score += 2.0
                self._last_g85a4_fvr = 1
                _a4_fired = True
            elif _a4_pos == 2 and _a4_neg < 2:
                quality_score += 1.5
                self._last_g85a4_fvr = 1
                _a4_fired = True
            elif _a4_neg == 3:
                quality_score -= 2.0
                self._last_g85a4_fvr = -1
                _a4_fired = True
            elif _a4_neg == 2 and _a4_pos < 2:
                quality_score -= 1.5
                self._last_g85a4_fvr = -1
                _a4_fired = True
            self._record("gate_g85a4_fvr", _a4_fired)
        except Exception:
            pass  # G8.5A4 FlowVolumeRegime-TripleSync is non-fatal soft-gate

        # ── Gate G8.5B4 — RollingWR-Momentum-Sentinel (v115.0) ─────────────────
        # Zero-API-call gate using the booster's PnL ring to detect rolling WR momentum.
        # Tracks last-15 signal outcomes and applies a quality adjustment based on
        # the recent winning streak vs losing streak — a regime-aware momentum filter.
        # This prevents the engine from continuing to fire signals during sustained
        # losing runs where the composite score is inflated by point-heavy macro gates
        # but the actual outcome WR is sub-break-even.
        #   last-15 WR < 18%: −3.0pts (catastrophic rolling loss — ruin territory)
        #   last-15 WR < 30%: −2.0pts (active losing momentum below break-even) [v154.0: 27%→30%]
        #   last-15 WR < 34%: −1.0pts (below-break-even streak warning)
        #   last-15 WR > 45%: +1.5pts (confirmed hot streak quality bonus)
        # Guard: ring must have ≥ 8 samples (cold-start safe).
        # Stores _last_g85b4_rws for Kelly Step 80.
        try:
            _b4_booster = self._booster
            _b4_ring    = getattr(_b4_booster, "_pnl_ring", None) if _b4_booster else None
            if _b4_ring is not None and len(_b4_ring) >= 8:
                _b4_n15    = list(_b4_ring)[-15:]  # last ≤15 outcomes
                _b4_wins   = sum(1 for x in _b4_n15 if x > 0)
                _b4_size   = len(_b4_n15)
                _b4_wr     = _b4_wins / _b4_size
                _b4_fired  = True
                if _b4_wr < 0.18:
                    quality_score -= 3.0
                    self._last_g85b4_rws = -3
                    self._logger.debug(
                        f"[G8.5B4 RWS v115.0] {symbol} roll15-WR={_b4_wr:.1%} "
                        f"→ -3.0pts CATASTROPHIC rolling loss (n={_b4_size})"
                    )
                elif _b4_wr < 0.30:
                    quality_score -= 2.0
                    self._last_g85b4_rws = -2
                    self._logger.debug(
                        f"[G8.5B4 RWS v115.0/v154.0] {symbol} roll15-WR={_b4_wr:.1%} "
                        f"→ -2.0pts losing momentum (n={_b4_size})"
                    )
                elif _b4_wr < 0.34:
                    quality_score -= 1.0
                    self._last_g85b4_rws = -1
                    self._logger.debug(
                        f"[G8.5B4 RWS v115.0] {symbol} roll15-WR={_b4_wr:.1%} "
                        f"→ -1.0pts below-BE streak warning (n={_b4_size})"
                    )
                elif _b4_wr > 0.45:
                    quality_score += 1.5
                    self._last_g85b4_rws = 1
                    self._logger.debug(
                        f"[G8.5B4 RWS v115.0] {symbol} roll15-WR={_b4_wr:.1%} "
                        f"→ +1.5pts hot streak quality bonus (n={_b4_size})"
                    )
                else:
                    self._last_g85b4_rws = 0
                    _b4_fired = False
                self._record("gate_g85b4_rws", _b4_fired)
            else:
                self._last_g85b4_rws = 0  # cold-start neutral
        except Exception:
            pass  # G8.5B4 RollingWR-Momentum-Sentinel is non-fatal soft-gate

        # ── Gate G8.5C4 — AdaptiveEV-Persistence Sentinel (v116.0) ─────────────────
        # Zero-API sentinel: uses the booster _ev_ring (deque maxlen=20) which stores
        # per-trade R-multiples (rr_ratio if won, else -1.0) from record_outcome().
        # A rolling avg of the last-10 R-multiples captures recent EV trajectory:
        #   Deep-EV-hole: recent-10 avg < -0.40R AND alltime-20 avg < -0.30R → -3pts
        #     (both time-windows negative = systematic deterioration, not noise)
        #   EV-Deteriorating: recent-10 avg < -0.20R                          → -2pts
        #   Below-breakeven:  recent-10 avg <  0.00R                          → -1pt
        #   EV-Positive-Trend: recent-10 avg > +0.05R                         → +1.5pts
        #   Cold-start (ring < 10 resolved trades)                            → 0 (neutral)
        # Stores _last_g85c4_aev for Kelly Step 81.
        # Non-fatal soft-gate: adjusts quality_score only, cannot block by itself.
        try:
            _c4_ev_ring = getattr(self._booster, "_ev_ring", None) if self._booster else None
            if _c4_ev_ring is not None and len(_c4_ev_ring) >= 10:
                _c4_ring_list  = list(_c4_ev_ring)
                _c4_recent10   = _c4_ring_list[-10:]
                _c4_recent_avg = sum(_c4_recent10) / len(_c4_recent10)
                _c4_all_avg    = sum(_c4_ring_list) / len(_c4_ring_list)
                if _c4_recent_avg < -0.40 and _c4_all_avg < -0.30:
                    self._last_g85c4_aev = -3
                    quality_score -= 3.0
                    self._logger.debug(
                        f"G8.5C4_AEV: {symbol} deep-EV-hole recent10={_c4_recent_avg:.3f}R "
                        f"alltime={_c4_all_avg:.3f}R → -3pts"
                    )
                elif _c4_recent_avg < -0.20:
                    self._last_g85c4_aev = -2
                    quality_score -= 2.0
                    self._logger.debug(
                        f"G8.5C4_AEV: {symbol} EV-deteriorating recent10={_c4_recent_avg:.3f}R → -2pts"
                    )
                elif _c4_recent_avg < 0.0:
                    self._last_g85c4_aev = -1
                    quality_score -= 1.0
                elif _c4_recent_avg > 0.05:
                    self._last_g85c4_aev = 1
                    quality_score += 1.5
                    self._logger.debug(
                        f"G8.5C4_AEV: {symbol} EV-positive recent10={_c4_recent_avg:.3f}R → +1.5pts"
                    )
                else:
                    self._last_g85c4_aev = 0
                # record gate call
                _c4_dir  = float(getattr(self, "_last_g85c4_aev", 0) or 0)
                _c4_pass = _c4_dir >= 0
                self._gate_stats["gate_g85c4_aev"]["pass" if _c4_pass else "fail"] += 1
                self._gate_stats_recent["gate_g85c4_aev"].append(_c4_pass)
            else:
                self._last_g85c4_aev = 0  # cold-start
        except Exception:
            pass  # G8.5C4 AdaptiveEV-Persistence Sentinel is non-fatal soft-gate

        # ── Gate G8.5D4 — TimesFM-ForecastConfluence (v117.0) ───────────────────────
        # TimesFM-inspired patch-based time-series forecast gate.  Implements the core
        # TimesFM concept (https://github.com/google-research/timesfm): divide the close
        # price history into non-overlapping patches, compute per-patch momentum via
        # linear regression slope, then aggregate into a multi-horizon direction signal
        # with a confidence score (fraction of patches agreeing with aggregate direction).
        #
        # Algorithm (pure numpy, zero-API, zero-external-model):
        #   1. Take the last 32 close prices from _quant_layer_close_buf[symbol]
        #   2. Divide into 8 non-overlapping 4-bar patches (8×4=32)
        #   3. Compute per-patch linear-regression slope via np.polyfit(deg=1)
        #   4. Aggregate direction: sign of mean slope across all 8 patches
        #   5. Confidence: fraction of patches whose slope sign == aggregate direction
        #   6. Direction aligned with signal AND conf≥0.70 → +2.0pts
        #      Direction aligned with signal AND conf≥0.55 → +1.5pts
        #      Direction opposed to signal AND conf≥0.70  → -2.0pts
        #      Direction opposed to signal AND conf≥0.55  → -1.5pts
        # Stores _last_g85d4_tfc (+1/-1/0) and _last_g85d4_conf for Kelly Step 82.
        # Non-fatal soft-gate: adjusts quality_score only, cannot block by itself.
        try:
            import numpy as _np_d4
            _d4_sym = (symbol or "").upper()
            _d4_buf = _quant_layer_close_buf.get(_d4_sym) if isinstance(_quant_layer_close_buf, dict) else None
            if _d4_buf is None:
                _d4_buf = globals().get("_quant_layer_close_buf", {}).get(_d4_sym)
            if _d4_buf is not None and len(_d4_buf) >= 32:
                _d4_closes = _np_d4.array(list(_d4_buf)[-32:], dtype=_np_d4.float64)
                _PATCH_SIZE = 4
                _N_PATCHES  = 8
                _d4_slopes  = []
                for _pi in range(_N_PATCHES):
                    _ps = _pi * _PATCH_SIZE
                    _pe = _ps + _PATCH_SIZE
                    _patch = _d4_closes[_ps:_pe]
                    if len(_patch) == _PATCH_SIZE and _patch[-1] != _patch[0]:
                        _xs = _np_d4.arange(_PATCH_SIZE, dtype=_np_d4.float64)
                        _coef = _np_d4.polyfit(_xs, _patch, 1)
                        _d4_slopes.append(float(_coef[0]))
                if len(_d4_slopes) >= 4:
                    _d4_mean_slope = float(_np_d4.mean(_d4_slopes))
                    _d4_agg_dir    = 1 if _d4_mean_slope > 0 else -1
                    _d4_agree      = sum(1 for _s in _d4_slopes if (_s > 0) == (_d4_mean_slope > 0))
                    _d4_conf       = _d4_agree / len(_d4_slopes)  # [0, 1]
                    self._last_g85d4_conf = _d4_conf
                    # Map to signal direction: +1=aligned, -1=opposed
                    _d4_signal_dir = 1 if str(direction or "").upper() in ("BUY", "LONG") else -1
                    _d4_aligned    = (_d4_agg_dir == _d4_signal_dir)
                    if _d4_aligned and _d4_conf >= 0.70:
                        self._last_g85d4_tfc = 1
                        quality_score += 2.0
                        self._logger.debug(
                            f"[G8.5D4 TFC v117.0] {symbol} TimesFM forecast ALIGNED "
                            f"dir={_d4_agg_dir} conf={_d4_conf:.2f} → +2.0pts"
                        )
                    elif _d4_aligned and _d4_conf >= 0.55:
                        self._last_g85d4_tfc = 1
                        quality_score += 1.5
                        self._logger.debug(
                            f"[G8.5D4 TFC v117.0] {symbol} TimesFM partial-align "
                            f"dir={_d4_agg_dir} conf={_d4_conf:.2f} → +1.5pts"
                        )
                    elif not _d4_aligned and _d4_conf >= 0.70:
                        self._last_g85d4_tfc = -1
                        quality_score -= 2.0
                        self._logger.debug(
                            f"[G8.5D4 TFC v117.0] {symbol} TimesFM OPPOSED "
                            f"dir={_d4_agg_dir} conf={_d4_conf:.2f} → -2.0pts"
                        )
                    elif not _d4_aligned and _d4_conf >= 0.55:
                        self._last_g85d4_tfc = -1
                        quality_score -= 1.5
                        self._logger.debug(
                            f"[G8.5D4 TFC v117.0] {symbol} TimesFM partial-oppose "
                            f"dir={_d4_agg_dir} conf={_d4_conf:.2f} → -1.5pts"
                        )
                    else:
                        self._last_g85d4_tfc = 0
                    _d4_pass = (self._last_g85d4_tfc >= 0)
                    self._gate_stats["gate_g85d4_tfc"]["pass" if _d4_pass else "fail"] += 1
                    self._gate_stats_recent["gate_g85d4_tfc"].append(_d4_pass)
                else:
                    self._last_g85d4_tfc = 0
                    self._last_g85d4_conf = 0.0
                    self._gate_stats["gate_g85d4_tfc"]["pass"] += 1
                    self._gate_stats_recent["gate_g85d4_tfc"].append(True)
            else:
                # v143.1 FIX: cold-start (buffer < 32 closes) previously did NOT
                # record → gate was invisible (zero-call) for non-buffered symbols.
                self._last_g85d4_tfc = 0
                self._last_g85d4_conf = 0.0
                self._gate_stats["gate_g85d4_tfc"]["pass"] += 1
                self._gate_stats_recent["gate_g85d4_tfc"].append(True)
        except Exception:
            pass  # G8.5D4 is a non-fatal soft-gate

        # ── Gate G8.5E4 — TimesFM-RegimeSync (v117.0) ───────────────────────────────
        # Cross-validates the TimesFM patch-forecast direction with HMM regime and OFI
        # z-score direction — creates a triple-source zero-API confluence gate that
        # combines the forecast model signal (G8.5D4) with the two most reliable
        # microstructure signals already proven in v91.0-v92.0 gate architecture.
        # Vote sources (each ±1/0):
        #   V1: TimesFM direction (from _last_g85d4_tfc, requires conf≥0.55)
        #   V2: HMM regime direction (EXPANSION=+1 BUY/-1 SELL, from sovereign_rm)
        #   V3: OFI z-score direction (ofi_z > 0.3=+1, < -0.3=-1, else 0)
        # 3/3 aligned → +2.0pts; 2/3 aligned → +1.5pts;
        # 2/3 opposed → -1.5pts; 3/3 opposed → -2.0pts.
        # Requires ≥2 non-zero votes. Stores _last_g85e4_trs for Kelly Step 83.
        # Non-fatal soft-gate.
        try:
            _e4_votes = []
            # V1: TimesFM direction (only use when conf≥0.55 = meaningful signal)
            _e4_tfc = int(getattr(self, "_last_g85d4_tfc", 0) or 0)
            _e4_conf = float(getattr(self, "_last_g85d4_conf", 0.0) or 0.0)
            if _e4_tfc != 0 and _e4_conf >= 0.55:
                _e4_votes.append(_e4_tfc)
            # V2: HMM regime direction
            try:
                _e4_hmm_state = None
                _e4_rm = getattr(self, "sovereign_rm", None)
                if _e4_rm is not None:
                    _e4_hd = getattr(_e4_rm, "_hmm_detector", None)
                    if _e4_hd is not None:
                        _e4_hmm_state = getattr(_e4_hd, "current_state", None)
                if _e4_hmm_state is not None:
                    _e4_sig_dir = 1 if str(direction or "").upper() in ("BUY", "LONG") else -1
                    if str(_e4_hmm_state).upper() == "EXPANSION":
                        _e4_votes.append(1 if _e4_sig_dir == 1 else -1)
                    elif str(_e4_hmm_state).upper() == "CONTRACTION":
                        _e4_votes.append(-1 if _e4_sig_dir == 1 else 1)
            except Exception:
                pass
            # V3: OFI z-score direction
            try:
                _e4_ofi_z = float(signal_data.get("ofi_z", 0.0) if isinstance(signal_data, dict) else 0.0)
                _e4_sig_dir2 = 1 if str(direction or "").upper() in ("BUY", "LONG") else -1
                if _e4_ofi_z > 0.3:
                    _e4_votes.append(1 if _e4_sig_dir2 == 1 else -1)
                elif _e4_ofi_z < -0.3:
                    _e4_votes.append(-1 if _e4_sig_dir2 == 1 else 1)
            except Exception:
                pass
            if len(_e4_votes) >= 2:
                _e4_pos = sum(1 for v in _e4_votes if v > 0)
                _e4_neg = sum(1 for v in _e4_votes if v < 0)
                _e4_total = len(_e4_votes)
                if _e4_pos == _e4_total:
                    self._last_g85e4_trs = 1
                    quality_score += 2.0
                    self._logger.debug(
                        f"[G8.5E4 TRS v117.0] {symbol} triple-sync {_e4_votes} → +2.0pts"
                    )
                elif _e4_pos >= 2:
                    self._last_g85e4_trs = 1
                    quality_score += 1.5
                    self._logger.debug(
                        f"[G8.5E4 TRS v117.0] {symbol} dual-sync {_e4_votes} → +1.5pts"
                    )
                elif _e4_neg == _e4_total:
                    self._last_g85e4_trs = -1
                    quality_score -= 2.0
                    self._logger.debug(
                        f"[G8.5E4 TRS v117.0] {symbol} triple-opposed {_e4_votes} → -2.0pts"
                    )
                elif _e4_neg >= 2:
                    self._last_g85e4_trs = -1
                    quality_score -= 1.5
                    self._logger.debug(
                        f"[G8.5E4 TRS v117.0] {symbol} dual-opposed {_e4_votes} → -1.5pts"
                    )
                else:
                    self._last_g85e4_trs = 0
                _e4_pass = (self._last_g85e4_trs >= 0)
                self._gate_stats["gate_g85e4_trs"]["pass" if _e4_pass else "fail"] += 1
                self._gate_stats_recent["gate_g85e4_trs"].append(_e4_pass)
            else:
                # v143.1 FIX: <2 votes previously did NOT record → zero-call gate.
                self._last_g85e4_trs = 0
                self._gate_stats["gate_g85e4_trs"]["pass"] += 1
                self._gate_stats_recent["gate_g85e4_trs"].append(True)
        except Exception:
            pass  # G8.5E4 is a non-fatal soft-gate

        # ── Gate G8.5F4 — TimesFM-PatchMomentum (v118.0) ────────────────────────────
        # Multi-resolution TimesFM-inspired patch gate. Implements the TimesFM concept
        # (https://github.com/google-research/timesfm) of dividing a price history into
        # non-overlapping patches and extracting directional slope signals per-patch.
        # Uses 3 independent patch-scale windows (16-bar, 32-bar, 64-bar) from the
        # per-symbol close buffer (_quant_layer_close_buf, maxlen=512).
        # For each scale N: extract the last N bars, divide into 4 equal segments
        # (patches of N/4 bars each), compute linear-regression slope per segment,
        # take the average slope across all patches, then determine directional vote:
        #   vote = +1 if avg_slope > atrnorm_threshold (trend-adjusted positive)
        #   vote = -1 if avg_slope < -atrnorm_threshold (trend-adjusted negative)
        #   vote =  0 if |avg_slope| ≤ threshold (flat/insufficient trend)
        # Multi-scale consensus vote tallied vs signal direction:
        #   3/3 scales aligned with signal direction  → +2.0pts (strong multi-scale)
        #   2/3 scales aligned with signal direction  → +1.5pts (majority aligned)
        #   2/3 scales opposed to signal direction    → -1.5pts (majority opposed)
        #   3/3 scales opposed to signal direction    → -2.0pts (strong opposition)
        #   ≤1/3 agreement either way                → 0pts    (mixed/flat)
        # Stores _last_g85f4_tpm (+1/-1/0) and _last_g85f4_strength ([0,1]) for Kelly Step 84.
        # Requires ≥64 bars in buffer (64-bar window needs 64 close prices).
        try:
            # v143.1 FIX: _quant_layer_close_buf is a MODULE-LEVEL global dict
            # (line ~2806) — getattr(self, ...) always returned {} (no such instance
            # attr), so f4 never saw any closes. Read the module global directly.
            _f4_buf_raw = _quant_layer_close_buf if isinstance(_quant_layer_close_buf, dict) else {}
            _f4_sym_buf = _f4_buf_raw.get(symbol)
            if _f4_sym_buf is None:
                _f4_sym_buf = _f4_buf_raw.get((symbol or "").upper())
            # v143.1 FIX: buffer is capped at 60 closes (write site), so the old
            # >=64 guard could NEVER be satisfied → zero-call. Use >=48 to fit.
            if _f4_sym_buf is not None and len(_f4_sym_buf) >= 48:
                import numpy as _np_f4
                _f4_closes = _np_f4.array(list(_f4_sym_buf), dtype=_np_f4.float64)
                # v143.1 FIX: bare `action` was undefined (NameError) → use `direction`.
                _f4_direction_int = 1 if str(direction or "").upper() in ("BUY", "LONG") else -1
                # Compute 20-bar ATR for slope normalisation
                _f4_atr_n = min(20, len(_f4_closes) - 1)
                _f4_diffs = _np_f4.abs(_np_f4.diff(_f4_closes[-(_f4_atr_n + 1):]))
                _f4_atr = float(_np_f4.mean(_f4_diffs)) if len(_f4_diffs) > 0 else 0.0
                _f4_atr_safe = _f4_atr if _f4_atr > 1e-10 else 1.0
                # Three patch scales: 16-bar, 32-bar, 48-bar (capped to 60-bar buffer)
                _f4_votes_aligned: int = 0
                _f4_votes_opposed: int = 0
                for _f4_window in (16, 32, 48):
                    try:
                        if len(_f4_closes) < _f4_window:
                            continue
                        _f4_seg = _f4_closes[-_f4_window:]
                        _f4_patch_n = _f4_window // 4  # 4 equal patches
                        if _f4_patch_n < 2:
                            continue
                        _f4_slopes = []
                        for _f4_pi in range(4):
                            _f4_patch = _f4_seg[_f4_pi * _f4_patch_n: (_f4_pi + 1) * _f4_patch_n]
                            _f4_xs = _np_f4.arange(len(_f4_patch), dtype=_np_f4.float64)
                            _f4_coef = _np_f4.polyfit(_f4_xs, _f4_patch, 1)
                            _f4_slopes.append(_f4_coef[0] / _f4_atr_safe)
                        _f4_avg_slope = float(_np_f4.mean(_f4_slopes)) if _f4_slopes else 0.0
                        _f4_thresh = 0.08  # normalised slope threshold (8% of ATR per bar)
                        if _f4_avg_slope > _f4_thresh:
                            _f4_scale_vote = 1
                        elif _f4_avg_slope < -_f4_thresh:
                            _f4_scale_vote = -1
                        else:
                            _f4_scale_vote = 0
                        if _f4_scale_vote == _f4_direction_int:
                            _f4_votes_aligned += 1
                        elif _f4_scale_vote == -_f4_direction_int:
                            _f4_votes_opposed += 1
                    except Exception:
                        pass
                # Score based on aligned-vs-opposed votes
                _f4_net = _f4_votes_aligned - _f4_votes_opposed
                _f4_total_scales = min(3, _f4_votes_aligned + _f4_votes_opposed + max(0, 3 - _f4_votes_aligned - _f4_votes_opposed))
                _f4_strength = _f4_votes_aligned / 3.0
                if _f4_votes_aligned == 3:
                    self._last_g85f4_tpm = 1
                    self._last_g85f4_strength = 1.0
                    quality_score += 2.0
                    self._logger.debug(f"[G8.5F4 TPM v118.0] {symbol} 3/3 scales aligned → +2.0pts (str=1.00)")
                elif _f4_votes_aligned == 2:
                    self._last_g85f4_tpm = 1
                    self._last_g85f4_strength = 0.67
                    quality_score += 1.5
                    self._logger.debug(f"[G8.5F4 TPM v118.0] {symbol} 2/3 scales aligned → +1.5pts (str=0.67)")
                elif _f4_votes_opposed == 3:
                    self._last_g85f4_tpm = -1
                    self._last_g85f4_strength = 1.0
                    quality_score -= 2.0
                    self._logger.debug(f"[G8.5F4 TPM v118.0] {symbol} 3/3 scales opposed → -2.0pts (str=1.00)")
                elif _f4_votes_opposed == 2:
                    self._last_g85f4_tpm = -1
                    self._last_g85f4_strength = 0.67
                    quality_score -= 1.5
                    self._logger.debug(f"[G8.5F4 TPM v118.0] {symbol} 2/3 scales opposed → -1.5pts (str=0.67)")
                else:
                    self._last_g85f4_tpm = 0
                    self._last_g85f4_strength = _f4_strength
                _f4_pass = (self._last_g85f4_tpm >= 0)
                self._gate_stats["gate_g85f4_tpm"]["pass" if _f4_pass else "fail"] += 1
                self._gate_stats_recent["gate_g85f4_tpm"].append(_f4_pass)
            else:
                # v143.1 FIX: insufficient buffer previously did NOT record → zero-call.
                self._last_g85f4_tpm = 0
                self._last_g85f4_strength = 0.0
                self._gate_stats["gate_g85f4_tpm"]["pass"] += 1
                self._gate_stats_recent["gate_g85f4_tpm"].append(True)
        except Exception:
            pass  # G8.5F4 is a non-fatal soft-gate

        # ── Gate G8.5G4 — SharpeVelocity-TimesFM Composite (v118.0) ─────────────────
        # Compound gate combining Sharpe acceleration with TimesFM confluence.
        # Sharpe velocity: computes recent-5 vs prior-5 trade Sharpe delta from pnl_ring.
        #   sharpe_velocity > +0.30 → improving; sharpe_velocity < -0.30 → deteriorating.
        # TimesFM confluence: sums votes from D4 (ForecastConfluence) + E4 (RegimeSync) +
        #   F4 (PatchMomentum) — each contributes ±1 or 0. Range: -3 to +3.
        # Composite scoring:
        #   Sharpe improving (vel>0.30) AND ≥2 TF votes aligned → +2.0pts
        #   Sharpe improving (vel>0.30) AND ≥1 TF vote aligned  → +1.5pts
        #   Sharpe deteriorating (vel<-0.30) AND ≤-2 TF votes   → -2.0pts
        #   Sharpe deteriorating (vel<-0.30) AND ≤-1 TF vote    → -1.5pts
        #   Mixed or flat                                         → 0pts
        # Stores _last_g85g4_svtfc (±1/0) for Kelly Step 85.
        try:
            _g4_pnl_ring = getattr(self, "_pnl_ring", None)
            _g4_pnl_list = list(_g4_pnl_ring) if _g4_pnl_ring is not None and len(_g4_pnl_ring) >= 10 else None
            _g4_sharpe_vel = 0.0
            if _g4_pnl_list is not None and len(_g4_pnl_list) >= 10:
                _g4_recent5 = _g4_pnl_list[-5:]
                _g4_prior5 = _g4_pnl_list[-10:-5]
                import numpy as _np_g4
                _g4_r_mean = float(_np_g4.mean(_g4_recent5))
                _g4_r_std  = float(_np_g4.std(_g4_recent5)) + 1e-10
                _g4_p_mean = float(_np_g4.mean(_g4_prior5))
                _g4_p_std  = float(_np_g4.std(_g4_prior5)) + 1e-10
                _g4_sharpe_recent = _g4_r_mean / _g4_r_std
                _g4_sharpe_prior  = _g4_p_mean / _g4_p_std
                _g4_sharpe_vel    = float(_np_g4.clip(_g4_sharpe_recent - _g4_sharpe_prior, -2.0, 2.0))
            # TimesFM 3-gate confluence
            _g4_tf_votes = (
                int(getattr(self, "_last_g85d4_tfc", 0) or 0)
                + int(getattr(self, "_last_g85e4_trs", 0) or 0)
                + int(getattr(self, "_last_g85f4_tpm", 0) or 0)
            )
            _g4_sharpe_improving    = _g4_sharpe_vel >  0.30
            _g4_sharpe_deteriorating = _g4_sharpe_vel < -0.30
            _g4_scored = False
            if _g4_sharpe_improving and _g4_tf_votes >= 2:
                self._last_g85g4_svtfc = 1
                quality_score += 2.0
                self._logger.debug(f"[G8.5G4 SVTFC v118.0] {symbol} Sharpe+vel={_g4_sharpe_vel:.2f} + TFvotes={_g4_tf_votes} → +2.0pts")
                _g4_scored = True
            elif _g4_sharpe_improving and _g4_tf_votes >= 1:
                self._last_g85g4_svtfc = 1
                quality_score += 1.5
                self._logger.debug(f"[G8.5G4 SVTFC v118.0] {symbol} Sharpe+vel={_g4_sharpe_vel:.2f} + TFvotes={_g4_tf_votes} → +1.5pts")
                _g4_scored = True
            elif _g4_sharpe_deteriorating and _g4_tf_votes <= -2:
                self._last_g85g4_svtfc = -1
                quality_score -= 2.0
                self._logger.debug(f"[G8.5G4 SVTFC v118.0] {symbol} Sharpe-vel={_g4_sharpe_vel:.2f} + TFvotes={_g4_tf_votes} → -2.0pts")
                _g4_scored = True
            elif _g4_sharpe_deteriorating and _g4_tf_votes <= -1:
                self._last_g85g4_svtfc = -1
                quality_score -= 1.5
                self._logger.debug(f"[G8.5G4 SVTFC v118.0] {symbol} Sharpe-vel={_g4_sharpe_vel:.2f} + TFvotes={_g4_tf_votes} → -1.5pts")
                _g4_scored = True
            else:
                self._last_g85g4_svtfc = 0
            _g4_pass = (self._last_g85g4_svtfc >= 0)
            self._gate_stats["gate_g85g4_svtfc"]["pass" if _g4_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85g4_svtfc"].append(_g4_pass)
        except Exception:
            pass  # G8.5G4 SharpeVelocity-TimesFM Composite is non-fatal soft-gate

        # ── Gate 8.5H4 — TimesFM-PatchEnsemble (v119.0) ──────────────────────
        # 5-scale pure-numpy patch ensemble (8/16/24/32/48-bar windows).
        # For each scale, computes 4 equal sub-patch linear regression slopes,
        # mean slope normalised by 20-bar ATR, compared to vote threshold 0.06.
        # Vote consensus aggregated across all 5 scales:
        #   ≥4 scales aligned with signal direction → +2.0pts (full ensemble)
        #   ≥3 scales aligned                       → +1.5pts (strong majority)
        #   ≥3 scales opposed                       → -1.5pts (strong opposition)
        #   ≥4 scales opposed                       → -2.0pts (full opposed)
        #   otherwise                               → 0pts (no consensus)
        # Requires _quant_layer_close_buf global (≥48 bars); reads "action" key.
        # Stores _last_g85h4_tpe (+1/-1/0) and _last_g85h4_conf ([0,1]) for Kelly Step 86.
        try:
            # v143.1 FIX: list(_quant_layer_close_buf) returned the dict KEYS
            # (symbol-name strings), not closes → np.array(...,float) raised
            # ValueError every cycle → zero-call. Read the per-symbol close list.
            _h4_cb     = _quant_layer_close_buf if isinstance(_quant_layer_close_buf, dict) else {}
            _h4_closes = list(_h4_cb.get((symbol or "").upper(), _h4_cb.get(symbol, [])))
            _h4_n      = len(_h4_closes)
            # v143.1 FIX: bare `direction_int` was undefined (NameError) → derive.
            _h4_dir    = 1 if str(direction or "").upper() in ("BUY", "LONG") else -1
            if _h4_n >= 48:
                import numpy as _np_h4
                _h4_arr   = _np_h4.array(_h4_closes, dtype=float)
                _h4_atr20 = float(_np_h4.mean(_np_h4.abs(_np_h4.diff(_h4_arr[-21:]))) + 1e-10)
                _H4_SCALES     = (8, 16, 24, 32, 48)
                _H4_N_PATCHES  = 4
                _H4_THRESHOLD  = 0.06   # slope/ATR must exceed this to count as a directional vote
                _h4_aligned    = 0  # scales whose mean patch slope agrees with direction
                _h4_opposed    = 0  # scales whose mean patch slope opposes direction
                for _h4_win in _H4_SCALES:
                    _h4_seg   = _h4_arr[-_h4_win:]
                    _h4_psz   = _h4_win // _H4_N_PATCHES  # patch size = window / 4 (e.g. 8→2, 16→4, etc.)
                    if _h4_psz < 2:
                        continue
                    _h4_slopes = []
                    for _h4_pi in range(_H4_N_PATCHES):
                        _h4_ps  = _h4_pi * _h4_psz
                        _h4_pe  = _h4_ps + _h4_psz
                        _h4_p   = _h4_seg[_h4_ps:_h4_pe]
                        if len(_h4_p) < 2:
                            continue
                        _h4_x   = _np_h4.arange(len(_h4_p), dtype=float)
                        _h4_sl  = float(_np_h4.polyfit(_h4_x, _h4_p, 1)[0])
                        _h4_slopes.append(_h4_sl / (_h4_atr20 or 1e-10))
                    if not _h4_slopes:
                        continue
                    _h4_mean_slope = float(_np_h4.mean(_h4_slopes))
                    if _h4_mean_slope * _h4_dir > _H4_THRESHOLD:
                        _h4_aligned += 1
                    elif _h4_mean_slope * _h4_dir < -_H4_THRESHOLD:
                        _h4_opposed += 1
                # Determine vote result across 5 scales
                if _h4_aligned >= 4:
                    _h4_adj, _h4_tpe, _h4_conf = +2.0, +1, min(1.0, _h4_aligned / 5.0)
                elif _h4_aligned >= 3:
                    _h4_adj, _h4_tpe, _h4_conf = +1.5, +1, min(1.0, _h4_aligned / 5.0)
                elif _h4_opposed >= 4:
                    _h4_adj, _h4_tpe, _h4_conf = -2.0, -1, min(1.0, _h4_opposed / 5.0)
                elif _h4_opposed >= 3:
                    _h4_adj, _h4_tpe, _h4_conf = -1.5, -1, min(1.0, _h4_opposed / 5.0)
                else:
                    _h4_adj, _h4_tpe, _h4_conf = 0.0, 0, 0.0
                quality_score               += _h4_adj
                self._last_g85h4_tpe         = _h4_tpe
                self._last_g85h4_conf        = _h4_conf
                _h4_pass = (_h4_tpe >= 0)
                self._gate_stats["gate_g85h4_tpe"]["pass" if _h4_pass else "fail"] += 1
                self._gate_stats_recent["gate_g85h4_tpe"].append(_h4_pass)
                if _h4_tpe != 0:
                    self._logger.debug(
                        f"[v119.0 G8.5H4 TPE] {symbol} aligned={_h4_aligned}/5 opposed={_h4_opposed}/5 "
                        f"adj={_h4_adj:+.1f}pts conf={_h4_conf:.2f}"
                    )
            else:
                # Cold-start: not enough bars for 48-bar scale
                self._last_g85h4_tpe  = 0
                self._last_g85h4_conf = 0.0
                self._gate_stats["gate_g85h4_tpe"]["pass"] += 1
                self._gate_stats_recent["gate_g85h4_tpe"].append(True)
        except Exception:
            pass  # G8.5H4 is a non-fatal soft-gate

        # ── Gate 8.5I4 — DrawdownGuard-TimesFM Composite (v119.0) ────────────
        # Compound gate combining MaxDD regime level with TimesFM cross-gate
        # vote confluence (H4+F4+G4 votes summed; range -3 to +3).
        # A drawdown-aware signal quality filter:
        #   MaxDD>45% AND TF-votes ≤-1 → -2.0pts (ruin-territory + TF disagreement)
        #   MaxDD>40% AND TF-votes ≤-2 → -1.5pts (high-risk DD + strong TF opposition)
        #   MaxDD<25% AND TF-votes ≥+2 → +2.0pts (healthy equity + TF momentum aligned)
        #   MaxDD<30% AND TF-votes ≥+1 → +1.5pts (good equity + TF support)
        #   else → 0pts
        # Stores _last_g85i4_dgc (+1/-1/0) for Kelly Step 87.
        try:
            _i4_maxdd   = float(getattr(self, "_max_drawdown", 0.0) or 0.0)
            # Aggregate TimesFM votes from H4 (+1/-1/0), F4 (+1/-1/0), G4 (+1/-1/0)
            _i4_tf_h4   = int(getattr(self, "_last_g85h4_tpe", 0) or 0)
            _i4_tf_f4   = int(getattr(self, "_last_g85f4_tpm", 0) or 0)
            _i4_tf_g4   = int(getattr(self, "_last_g85g4_svtfc", 0) or 0)
            _i4_votes   = _i4_tf_h4 + _i4_tf_f4 + _i4_tf_g4   # range [-3, +3]
            if _i4_maxdd > 0.45 and _i4_votes <= -1:
                _i4_adj, _i4_dgc = -2.0, -1
            elif _i4_maxdd > 0.40 and _i4_votes <= -2:
                _i4_adj, _i4_dgc = -1.5, -1
            elif _i4_maxdd < 0.25 and _i4_votes >= 2:
                _i4_adj, _i4_dgc = +2.0, +1
            elif _i4_maxdd < 0.30 and _i4_votes >= 1:
                _i4_adj, _i4_dgc = +1.5, +1
            else:
                _i4_adj, _i4_dgc = 0.0, 0
            quality_score              += _i4_adj
            self._last_g85i4_dgc        = _i4_dgc
            _i4_pass = (_i4_dgc >= 0)
            self._gate_stats["gate_g85i4_dgc"]["pass" if _i4_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85i4_dgc"].append(_i4_pass)
            if _i4_adj != 0.0:
                self._logger.debug(
                    f"[v119.0 G8.5I4 DGC] {symbol} maxdd={_i4_maxdd:.1%} tf_votes={_i4_votes:+d}"
                    f"(H4={_i4_tf_h4:+d} F4={_i4_tf_f4:+d} G4={_i4_tf_g4:+d}) adj={_i4_adj:+.1f}pts"
                )
        except Exception:
            pass  # G8.5I4 DrawdownGuard-TimesFM Composite is non-fatal soft-gate

        # ── Gate 8.5J4 — TimesFM-MultiScale-ForecastVote (v120.0) ───────────
        # Extended 7-scale pure-numpy TimesFM-inspired patch forecast gate.
        # Windows: 12, 16, 24, 32, 48, 64, 96 bars. For each scale, computes the
        # linear regression slope of the LAST HALF of the window (forecast horizon)
        # normalised by that window's ATR. A vote is cast if |slope/ATR| > 0.05:
        #   slope > 0 and direction_int ≥ 1 → bull vote (+1);
        #   slope < 0 and direction_int ≥ 1 → bear vote (-1); else abstain (0).
        # 7-vote consensus:
        #   ≥5 aligned → ±2.0pts (overwhelming majority); ≥4 aligned → ±1.5pts;
        #   otherwise 0pts (no actionable consensus).
        # Uses _quant_layer_close_buf (≥96 bars required). Zero-API.
        # Stores _last_g85j4_tfms (+1/-1/0) and _last_g85j4_tfms_conf ([0,1]).
        try:
            # v143.1 FIX: list(_quant_layer_close_buf) returned dict KEYS (symbol
            # strings) → ValueError; bare direction_int undefined → NameError; and
            # the >=96 guard exceeded the 60-close buffer cap → zero-call. All fixed.
            _j4_cb     = _quant_layer_close_buf if isinstance(_quant_layer_close_buf, dict) else {}
            _j4_closes = list(_j4_cb.get((symbol or "").upper(), _j4_cb.get(symbol, [])))
            _j4_n      = len(_j4_closes)
            _j4_dir    = 1 if str(direction or "").upper() in ("BUY", "LONG") else -1
            if _j4_n >= 48:
                import numpy as _np_j4
                _j4_arr     = _np_j4.array(_j4_closes, dtype=float)
                _J4_SCALES  = (8, 12, 16, 24, 32, 40, 48)
                _J4_THRESH  = 0.05   # |slope/ATR| threshold for a directional vote
                _j4_aligned = 0
                _j4_opposed = 0
                for _j4_win in _J4_SCALES:
                    _j4_seg    = _j4_arr[-_j4_win:]
                    _j4_half   = _j4_win // 2
                    _j4_fore   = _j4_seg[-_j4_half:]   # forecast horizon = last half
                    if len(_j4_fore) < 2:
                        continue
                    _j4_atr    = float(_np_j4.mean(_np_j4.abs(_np_j4.diff(_j4_seg))) + 1e-10)
                    _j4_x      = _np_j4.arange(len(_j4_fore), dtype=float)
                    _j4_slope  = float(_np_j4.polyfit(_j4_x, _j4_fore, 1)[0])
                    _j4_snorm  = _j4_slope / _j4_atr
                    if _j4_snorm * _j4_dir > _J4_THRESH:
                        _j4_aligned += 1
                    elif _j4_snorm * _j4_dir < -_J4_THRESH:
                        _j4_opposed += 1
                if _j4_aligned >= 5:
                    _j4_adj, _j4_tfms, _j4_conf = +2.0, +1, _j4_aligned / 7.0
                elif _j4_aligned >= 4:
                    _j4_adj, _j4_tfms, _j4_conf = +1.5, +1, _j4_aligned / 7.0
                elif _j4_opposed >= 5:
                    _j4_adj, _j4_tfms, _j4_conf = -2.0, -1, _j4_opposed / 7.0
                elif _j4_opposed >= 4:
                    _j4_adj, _j4_tfms, _j4_conf = -1.5, -1, _j4_opposed / 7.0
                else:
                    _j4_adj, _j4_tfms, _j4_conf = 0.0, 0, 0.0
                quality_score                += _j4_adj
                self._last_g85j4_tfms         = _j4_tfms
                self._last_g85j4_tfms_conf    = _j4_conf
                _j4_pass = (_j4_tfms >= 0)
                self._gate_stats["gate_g85j4_tfms"]["pass" if _j4_pass else "fail"] += 1
                self._gate_stats_recent["gate_g85j4_tfms"].append(_j4_pass)
                if _j4_tfms != 0:
                    self._logger.debug(
                        f"[v120.0 G8.5J4 TFMS] {symbol} aligned={_j4_aligned}/7 opposed={_j4_opposed}/7 "
                        f"adj={_j4_adj:+.1f}pts conf={_j4_conf:.2f}"
                    )
            else:
                self._last_g85j4_tfms      = 0
                self._last_g85j4_tfms_conf = 0.0
                self._gate_stats["gate_g85j4_tfms"]["pass"] += 1
                self._gate_stats_recent["gate_g85j4_tfms"].append(True)
        except Exception:
            pass  # G8.5J4 is a non-fatal soft-gate

        # ── Gate 8.5K4 — PatchScale-RegimeAlignment (v120.0) ─────────────────
        # Macro/mid/micro regime alignment gate. Computes linear regression slopes
        # across 3 independent scale windows from _quant_layer_close_buf:
        #   macro=64-bar, mid=32-bar, micro=16-bar.
        # Each slope is normalised by that window's own ATR. Cross-validates
        # direction with OFI z-score (from timing_state if available; else neutral).
        # Vote counting (scale slope sign vs direction_int; |slope/ATR|>0.04 threshold):
        #   macro + mid + micro all aligned + OFI aligned → +2.0pts (triple+OFI aligned)
        #   macro + mid + micro all aligned (no OFI)      → +1.5pts (triple aligned)
        #   at least 2 aligned                            → +1.5pts (dual aligned)
        #   at least 2 opposed                            → -1.5pts (dual opposed)
        #   all 3 opposed                                 → -2.0pts (triple opposed)
        #   else 0pts
        # Stores _last_g85k4_psr (+1/-1/0). Zero-API. [v120.0]
        try:
            # v143.1 FIX: dict-KEYS ValueError + bare direction_int NameError + >=64
            # guard above 60-close buffer cap → zero-call. All corrected below.
            _k4_cb     = _quant_layer_close_buf if isinstance(_quant_layer_close_buf, dict) else {}
            _k4_closes = list(_k4_cb.get((symbol or "").upper(), _k4_cb.get(symbol, [])))
            _k4_n      = len(_k4_closes)
            _k4_dir    = 1 if str(direction or "").upper() in ("BUY", "LONG") else -1
            if _k4_n >= 48:
                import numpy as _np_k4
                _k4_arr   = _np_k4.array(_k4_closes, dtype=float)
                _K4_WINS  = (16, 32, 48)   # micro, mid, macro
                _K4_THRESH = 0.04
                _k4_votes  = []  # +1, -1, or 0 per scale
                for _k4_win in _K4_WINS:
                    _k4_seg   = _k4_arr[-_k4_win:]
                    _k4_atr   = float(_np_k4.mean(_np_k4.abs(_np_k4.diff(_k4_seg))) + 1e-10)
                    _k4_x     = _np_k4.arange(len(_k4_seg), dtype=float)
                    _k4_slope = float(_np_k4.polyfit(_k4_x, _k4_seg, 1)[0])
                    _k4_snorm = _k4_slope / _k4_atr
                    if _k4_snorm * _k4_dir > _K4_THRESH:
                        _k4_votes.append(+1)
                    elif _k4_snorm * _k4_dir < -_K4_THRESH:
                        _k4_votes.append(-1)
                    else:
                        _k4_votes.append(0)
                # OFI cross-validation — use last OFI z-score if available
                try:
                    _k4_ofi_z = float(signal_data.get("ofi_z", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                    _k4_ofi_vote = +1 if _k4_ofi_z * _k4_dir > 0.2 else (-1 if _k4_ofi_z * _k4_dir < -0.2 else 0)
                except Exception:
                    _k4_ofi_vote = 0
                _k4_aligned  = sum(1 for v in _k4_votes if v == +1)
                _k4_opposed  = sum(1 for v in _k4_votes if v == -1)
                if _k4_aligned == 3 and _k4_ofi_vote == +1:
                    _k4_adj, _k4_psr = +2.0, +1
                elif _k4_aligned == 3:
                    _k4_adj, _k4_psr = +1.5, +1
                elif _k4_aligned >= 2:
                    _k4_adj, _k4_psr = +1.5, +1
                elif _k4_opposed >= 3 and _k4_ofi_vote == -1:
                    _k4_adj, _k4_psr = -2.0, -1
                elif _k4_opposed >= 3:
                    _k4_adj, _k4_psr = -1.5, -1
                elif _k4_opposed >= 2:
                    _k4_adj, _k4_psr = -1.5, -1
                else:
                    _k4_adj, _k4_psr = 0.0, 0
                quality_score          += _k4_adj
                self._last_g85k4_psr   = _k4_psr
                _k4_pass = (_k4_psr >= 0)
                self._gate_stats["gate_g85k4_psr"]["pass" if _k4_pass else "fail"] += 1
                self._gate_stats_recent["gate_g85k4_psr"].append(_k4_pass)
                if _k4_psr != 0:
                    self._logger.debug(
                        f"[v120.0 G8.5K4 PSR] {symbol} votes={_k4_votes} ofi_vote={_k4_ofi_vote:+d} "
                        f"adj={_k4_adj:+.1f}pts"
                    )
            else:
                self._last_g85k4_psr = 0
                self._gate_stats["gate_g85k4_psr"]["pass"] += 1
                self._gate_stats_recent["gate_g85k4_psr"].append(True)
        except Exception:
            pass  # G8.5K4 is a non-fatal soft-gate

        # ── Gate 8.5L4 — WinRate-Sharpe-DrawdownTriple (v120.0) ─────────────
        # Triple compound gate combining three independent crisis/health signals:
        #   WR trajectory (G8.5X2: _last_g85x2_wrt, range -2/-1/0/+1/+2);
        #     +2=improving WR; -2=catastrophic WR deterioration
        #   Sharpe velocity (G8.5G4: _last_g85g4_svtfc, +1/-1/0);
        #   DrawdownGuard (G8.5I4: _last_g85i4_dgc, +1/-1/0).
        # Maps votes to +1/−1/0 and counts:
        #   all 3 positive → +2.0pts; 2/3 positive → +1.5pts;
        #   2/3 negative   → -2.0pts; all 3 negative → -3.0pts.
        # Stores _last_g85l4_wsd (+1/-1/0). Zero-API. [v120.0]
        try:
            _l4_wrt   = int(getattr(self, "_last_g85x2_wrt",  0) or 0)
            _l4_svtfc = int(getattr(self, "_last_g85g4_svtfc", 0) or 0)
            _l4_dgc   = int(getattr(self, "_last_g85i4_dgc",  0) or 0)
            # Normalise WRT score: +2→+1, +1→+1, -1→-1, -2→-1, 0→0
            _l4_wrt_v  = +1 if _l4_wrt > 0 else (-1 if _l4_wrt < 0 else 0)
            _l4_pos    = sum(1 for v in [_l4_wrt_v, _l4_svtfc, _l4_dgc] if v == +1)
            _l4_neg    = sum(1 for v in [_l4_wrt_v, _l4_svtfc, _l4_dgc] if v == -1)
            if _l4_neg == 3:
                _l4_adj, _l4_wsd = -3.0, -1
            elif _l4_neg >= 2:
                _l4_adj, _l4_wsd = -2.0, -1
            elif _l4_pos == 3:
                _l4_adj, _l4_wsd = +2.0, +1
            elif _l4_pos >= 2:
                _l4_adj, _l4_wsd = +1.5, +1
            else:
                _l4_adj, _l4_wsd = 0.0, 0
            quality_score          += _l4_adj
            self._last_g85l4_wsd   = _l4_wsd
            _l4_pass = (_l4_wsd >= 0)
            self._gate_stats["gate_g85l4_wsd"]["pass" if _l4_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85l4_wsd"].append(_l4_pass)
            if _l4_adj != 0.0:
                self._logger.debug(
                    f"[v120.0 G8.5L4 WSD] {symbol} wrt={_l4_wrt_v:+d} svtfc={_l4_svtfc:+d} "
                    f"dgc={_l4_dgc:+d} pos={_l4_pos} neg={_l4_neg} adj={_l4_adj:+.1f}pts"
                )
        except Exception:
            pass  # G8.5L4 WinRate-Sharpe-DrawdownTriple is non-fatal soft-gate

        # ── Gate 8.5M4 — OFI-VPIN-Funding Microstructure Triple (v120.0) ────
        # Triple microstructure compound gate cross-validating three live signals:
        #   OFI persistence direction (_last_g85n2_fmp_signal: +1/-1/0)
        #   VPIN toxicity regime (timing_state["vpin_toxic_regime"]: bool → +1=clean/-1=toxic)
        #   Funding momentum direction (_last_g85n2_fmp_signal cross-check with fr trend)
        # Since OFI persist + funding are both encoded in fmp_signal, the third vote
        # comes from VPIN toxicity. When all 3 signals agree → maximum adjustment:
        #   OFI+1 AND VPIN_clean AND FR_pos → +2.0pts (triple aligned)
        #   2/3 agree                       → +1.5pts (dual aligned)
        #   2/3 oppose                      → -1.5pts (dual opposed)
        #   OFI-1 AND VPIN_toxic AND FR_neg → -2.0pts (triple opposed)
        # Stores _last_g85m4_ofm (+1/-1/0). Zero-API. [v120.0]
        try:
            _m4_ofi     = int(getattr(self, "_last_g85n2_fmp_signal", 0) or 0)
            # VPIN toxicity: True = toxic (bad) = -1 vote; False = clean = +1 vote
            _m4_vpin_raw = signal_data.get("vpin_toxic_regime", False) if isinstance(signal_data, dict) else False
            _m4_vpin     = -1 if bool(_m4_vpin_raw) else +1
            # Funding rate trend: use the rolling fr_trend from _last_g85n2 cross-check
            # fr_trend stored in timing_state["fr_trend"] or use fmp_signal as proxy
            try:
                _m4_fr_raw = float(signal_data.get("fr_trend", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                _m4_fr_dir = 1 if str(direction or "").upper() in ("BUY", "LONG") else -1
                _m4_fr     = +1 if _m4_fr_raw * _m4_fr_dir > 0.00005 else (-1 if _m4_fr_raw * _m4_fr_dir < -0.00005 else 0)
            except Exception:
                _m4_fr = int(getattr(self, "_last_g85n2_fmp_signal", 0) or 0)  # fallback = OFI proxy
            _m4_votes = [_m4_ofi, _m4_vpin, _m4_fr]
            _m4_pos   = sum(1 for v in _m4_votes if v == +1)
            _m4_neg   = sum(1 for v in _m4_votes if v == -1)
            if _m4_pos == 3:
                _m4_adj, _m4_ofm = +2.0, +1
            elif _m4_pos >= 2:
                _m4_adj, _m4_ofm = +1.5, +1
            elif _m4_neg == 3:
                _m4_adj, _m4_ofm = -2.0, -1
            elif _m4_neg >= 2:
                _m4_adj, _m4_ofm = -1.5, -1
            else:
                _m4_adj, _m4_ofm = 0.0, 0
            quality_score          += _m4_adj
            self._last_g85m4_ofm   = _m4_ofm
            _m4_pass = (_m4_ofm >= 0)
            self._gate_stats["gate_g85m4_ofm"]["pass" if _m4_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85m4_ofm"].append(_m4_pass)
            if _m4_adj != 0.0:
                self._logger.debug(
                    f"[v120.0 G8.5M4 OFM] {symbol} ofi={_m4_ofi:+d} vpin={_m4_vpin:+d} "
                    f"fr={_m4_fr:+d} pos={_m4_pos} neg={_m4_neg} adj={_m4_adj:+.1f}pts"
                )
        except Exception:
            pass  # G8.5M4 is a non-fatal soft-gate

        # ── Gate 8.5N4 — TimesFM-ConsensusCap Meta-Gate (v120.0) ────────────
        # Meta-gate aggregating all TimesFM-family gate votes:
        #   D4 (_last_g85d4_tfc: +1/-1/0), E4 (_last_g85e4_trs: +1/-1/0),
        #   F4 (_last_g85f4_tpm: +1/-1/0), G4 (_last_g85g4_svtfc: +1/-1/0),
        #   H4 (_last_g85h4_tpe: +1/-1/0). Summed vote range: [-5, +5].
        # Consensus scoring:
        #   sum ≥ +4 → +2.5pts (overwhelming TimesFM consensus bullish);
        #   sum ≥ +3 → +2.0pts (strong consensus); sum ≤ -4 → -2.5pts;
        #   sum ≤ -3 → -2.0pts; otherwise → 0pts.
        # Stores _last_g85n4_tfc (+1/-1/0) and _last_g85n4_tfc_votes (raw sum). [v120.0]
        try:
            _n4_d4 = int(getattr(self, "_last_g85d4_tfc",   0) or 0)
            _n4_e4 = int(getattr(self, "_last_g85e4_trs",   0) or 0)
            _n4_f4 = int(getattr(self, "_last_g85f4_tpm",   0) or 0)
            _n4_g4 = int(getattr(self, "_last_g85g4_svtfc", 0) or 0)
            _n4_h4 = int(getattr(self, "_last_g85h4_tpe",   0) or 0)
            _n4_votes = _n4_d4 + _n4_e4 + _n4_f4 + _n4_g4 + _n4_h4   # range [-5, +5]
            self._last_g85n4_tfc_votes = _n4_votes
            if _n4_votes >= 4:
                _n4_adj, _n4_tfc = +2.5, +1
            elif _n4_votes >= 3:
                _n4_adj, _n4_tfc = +2.0, +1
            elif _n4_votes <= -4:
                _n4_adj, _n4_tfc = -2.5, -1
            elif _n4_votes <= -3:
                _n4_adj, _n4_tfc = -2.0, -1
            else:
                _n4_adj, _n4_tfc = 0.0, 0
            quality_score          += _n4_adj
            self._last_g85n4_tfc   = _n4_tfc
            _n4_pass = (_n4_tfc >= 0)
            self._gate_stats["gate_g85n4_tfc"]["pass" if _n4_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85n4_tfc"].append(_n4_pass)
            if _n4_adj != 0.0:
                self._logger.debug(
                    f"[v120.0 G8.5N4 TFC] {symbol} tf_votes={_n4_votes:+d} "
                    f"(D4={_n4_d4:+d} E4={_n4_e4:+d} F4={_n4_f4:+d} G4={_n4_g4:+d} H4={_n4_h4:+d}) "
                    f"adj={_n4_adj:+.1f}pts"
                )
        except Exception:
            pass  # G8.5N4 TimesFM-ConsensusCap Meta-gate is non-fatal soft-gate

        # ── Gate 8.5O4 — EV-Velocity-Trend (v121.0) ─────────────────────────
        # Tracks the velocity (rate-of-change) of recent EV values to detect
        # improving vs deteriorating EV trajectories.  Uses _aev_ring (from
        # G8.5C4 AEV-Sentinel) as the EV history ring buffer.
        # Recent 5 EV avg vs prior 10 EV avg:
        #   improving (delta > +0.05R) → +1.5pts (EV recovering toward positive)
        #   worsening (delta < -0.05R) → -2.0pts (EV deteriorating further)
        #   flat → 0pts (no meaningful velocity signal)
        # Stores _last_g85o4_ev_vel (+1/-1/0) for Kelly Step 93.
        # Zero-API; reads _aev_ring deque set by G8.5C4. [v121.0]
        try:
            _o4_ev_ring = list(getattr(self, "_aev_ring", None) or [])
            _o4_adj, _o4_ev_vel, _o4_delta = 0.0, 0, 0.0
            if len(_o4_ev_ring) >= 15:
                _o4_recent = sum(_o4_ev_ring[-5:]) / 5.0
                _o4_prior  = sum(_o4_ev_ring[-15:-5]) / 10.0
                _o4_delta  = _o4_recent - _o4_prior
                if _o4_delta > 0.05:
                    _o4_adj, _o4_ev_vel = +1.5, +1   # EV velocity improving
                elif _o4_delta < -0.05:
                    _o4_adj, _o4_ev_vel = -2.0, -1   # EV velocity worsening
            quality_score             += _o4_adj
            self._last_g85o4_ev_vel    = _o4_ev_vel
            _o4_pass = (_o4_ev_vel >= 0)
            self._gate_stats["gate_g85o4_ev_vel"]["pass" if _o4_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85o4_ev_vel"].append(_o4_pass)
            if _o4_adj != 0.0:
                self._logger.debug(
                    f"[v121.0 G8.5O4 EVVel] {symbol} ev_vel={_o4_ev_vel:+d} "
                    f"delta={_o4_delta:+.3f}R (recent5={_o4_recent:.3f}R prior10={_o4_prior:.3f}R) "
                    f"adj={_o4_adj:+.1f}pts"
                )
        except Exception:
            pass  # G8.5O4 EV-Velocity-Trend is non-fatal soft-gate

        # ── Gate 8.5P4 — WR-Acceleration-Sentinel (v121.0) ───────────────────
        # Cross-validates WR trajectory (_last_g85x2_wrt) with EV crisis
        # (_last_g85c4_aev) to detect dual-signal deceleration or acceleration.
        # Dual-positive (WR improving + EV improving) → +1.5pts
        # Dual-negative (WR catastrophic OR dual-decline) → -2.0pts
        # Single-negative (both -1 signals) → -1.5pts
        # Stores _last_g85p4_wra (+1/-1/0) for Kelly Step 94. [v121.0]
        try:
            _p4_wrt = int(getattr(self, "_last_g85x2_wrt", 0) or 0)   # +2=improving/-2=catastrophic
            _p4_aev = int(getattr(self, "_last_g85c4_aev", 0) or 0)   # +1=EV-positive/-2=deep-hole
            _p4_adj, _p4_wra = 0.0, 0
            if _p4_wrt == 2 and _p4_aev >= 1:
                _p4_adj, _p4_wra = +1.5, +1    # WR+EV dual acceleration
            elif _p4_wrt == 1 and _p4_aev >= 1:
                _p4_adj, _p4_wra = +1.5, +1    # Both mildly positive
            elif _p4_wrt == -2 or (_p4_wrt <= -1 and _p4_aev <= -2):
                _p4_adj, _p4_wra = -2.0, -1    # WR catastrophic OR dual-crisis
            elif _p4_wrt == -1 and _p4_aev <= -1:
                _p4_adj, _p4_wra = -1.5, -1    # Single dual-decline
            quality_score          += _p4_adj
            self._last_g85p4_wra   = _p4_wra
            _p4_pass = (_p4_wra >= 0)
            self._gate_stats["gate_g85p4_wra"]["pass" if _p4_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85p4_wra"].append(_p4_pass)
            if _p4_adj != 0.0:
                self._logger.debug(
                    f"[v121.0 G8.5P4 WRAccel] {symbol} wra={_p4_wra:+d} "
                    f"(wrt={_p4_wrt:+d} aev={_p4_aev:+d}) adj={_p4_adj:+.1f}pts"
                )
        except Exception:
            pass  # G8.5P4 WR-Acceleration-Sentinel is non-fatal soft-gate

        # ── Gate 8.5Q4 — MaxDD-EV-Compound (v121.0/v152.0) ──────────────────────────
        # Compound gate combining MaxDD severity with current session WR regime.
        # v152.0 BLIND-SPOT FIX: at WR=29%+DD=49.37% only -2.0pts (deep tier) fires;
        #   the extreme tier (DD>47%+WR<28%) MISSES because WR=29%>28%.
        #   Added advanced-crisis tier + raised ultra-extreme tier penalty.
        # MaxDD>47% AND WR<28%  → -4.0pts (v152.0: -3.0→-4.0 ultra compound ruin)
        # MaxDD>48% AND WR<30%  → -3.5pts (v152.0 NEW: advanced-crisis; fires at WR=29%+DD=49.37%)
        # MaxDD>42% AND WR<32%  → -2.0pts (deep compound crisis: both deteriorating)
        # MaxDD<25% AND WR>38%  → +1.5pts (healthy compound regime: DD low + WR healthy)
        # Reads _max_drawdown_pct (engine attribute) and current_wr (IRONS scope).
        # Stores _last_g85q4_mec (+1/-1/0) for Kelly Step 95. [v121.0]
        try:
            _q4_dd  = float(getattr(self, "_max_drawdown_pct", 0.0) or 0.0)
            _q4_wr  = float(getattr(self, "_bayes_wr", 0.5) or 0.5)
            _q4_adj, _q4_mec = 0.0, 0
            if _q4_dd > 47.0 and _q4_wr < 0.28:
                _q4_adj, _q4_mec = -4.0, -1    # v152.0: Ultra compound ruin (-3.0→-4.0)
            elif _q4_dd > 48.0 and _q4_wr < 0.30:
                # v152.0: ADVANCED-CRISIS tier — closes the gap where WR 28-30%
                # with DD>48% only gets -2.0pts (deep tier). At live state
                # (WR=29%+DD=49.37%) the WR<28% ultra-tier fails; this fires.
                # Kelly Step 95 ×0.75 (extreme ruin) still applies via mec=-1.
                _q4_adj, _q4_mec = -3.5, -1
            elif _q4_dd > 42.0 and _q4_wr < 0.32:
                _q4_adj, _q4_mec = -2.0, -1    # Deep compound crisis
            elif _q4_dd < 25.0 and _q4_wr > 0.38:
                _q4_adj, _q4_mec = +1.5, +1    # Healthy compound regime
            quality_score          += _q4_adj
            self._last_g85q4_mec   = _q4_mec
            _q4_pass = (_q4_mec >= 0)
            self._gate_stats["gate_g85q4_mec"]["pass" if _q4_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85q4_mec"].append(_q4_pass)
            if _q4_adj != 0.0:
                self._logger.debug(
                    f"[v152.0 G8.5Q4 MaxDD-EV-Cmpd] {symbol} mec={_q4_mec:+d} "
                    f"DD={_q4_dd:.1f}% WR={_q4_wr:.1%} adj={_q4_adj:+.1f}pts"
                )
        except Exception:
            pass  # G8.5Q4 MaxDD-EV-Compound is non-fatal soft-gate

        # ── Gate 8.5R4 — Sharpe-OFI-WR TripleResonance (v123.0) ─────────────
        # Three-source triple-resonance gate: Sharpe trend + OFI persistence + WR trajectory.
        # Each source votes +1 (positive/bullish/healthy) or -1 (negative/bearish/weak) or 0 (neutral).
        # total_vote = vote_sr + vote_ofi + vote_wrt (range -3 to +3).
        # +2.0pts: total >= +2 (at least 2 of 3 sources positive — strong resonance).
        # +1.5pts: total == +1 (weak positive resonance — 1 source positive).
        # -2.0pts: total <= -2 (at least 2 of 3 sources negative — strong crisis resonance).
        # -1.5pts: total == -1 (weak negative resonance — 1 source negative).
        # Sources: vote_sr = Sharpe > -0.5 → +1, < -2.5 → -1 (0 otherwise);
        #          vote_ofi = _last_g85b_ofi (+1/-1/0, OFI persistence ring direction);
        #          vote_wrt = _last_g85x2_wrt (+1/-1/0, WR trajectory direction).
        # Stores _last_g85r4_sow (+1/-1/0) for Kelly Step 96. Zero-API. [v123.0]
        try:
            _r4_sr_raw   = float(getattr(self, "_sharpe_ratio", 0.0) or 0.0)
            _r4_ofi      = int(getattr(self, "_last_g85b_ofi", 0) or 0)
            _r4_wrt      = int(getattr(self, "_last_g85x2_wrt", 0) or 0)
            _r4_vote_sr  = +1 if _r4_sr_raw > -0.5 else (-1 if _r4_sr_raw < -2.5 else 0)
            _r4_vote_ofi = max(-1, min(1, _r4_ofi))
            _r4_vote_wrt = max(-1, min(1, _r4_wrt))
            _r4_total    = _r4_vote_sr + _r4_vote_ofi + _r4_vote_wrt  # -3..+3
            _r4_adj, _r4_sow = 0.0, 0
            if _r4_total >= 2:
                _r4_adj, _r4_sow = +2.0, +1   # Strong triple resonance positive
            elif _r4_total == 1:
                _r4_adj, _r4_sow = +1.5, +1   # Weak positive resonance
            elif _r4_total <= -2:
                _r4_adj, _r4_sow = -2.0, -1   # Strong triple resonance negative
            elif _r4_total == -1:
                _r4_adj, _r4_sow = -1.5, -1   # Weak negative resonance
            quality_score          += _r4_adj
            self._last_g85r4_sow   = _r4_sow
            _r4_pass = (_r4_sow >= 0)
            self._gate_stats["gate_g85r4_sow"]["pass" if _r4_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85r4_sow"].append(_r4_pass)
            if _r4_adj != 0.0:
                self._logger.debug(
                    f"[v123.0 G8.5R4 SOW-TripleRes] {symbol} sow={_r4_sow:+d} "
                    f"sr_vote={_r4_vote_sr:+d}(SR={_r4_sr_raw:.2f}) "
                    f"ofi_vote={_r4_vote_ofi:+d} wrt_vote={_r4_vote_wrt:+d} "
                    f"total={_r4_total:+d} adj={_r4_adj:+.1f}pts"
                )
        except Exception:
            pass  # G8.5R4 Sharpe-OFI-WR TripleResonance is non-fatal soft-gate

        # ── Gate 8.5S4 — Signal-Quality-Coherence Sentinel (v123.0) ──────────
        # Three-dimensional crisis sentinel: MaxDD severity + WR + Sharpe coherence.
        # Distinct from G8.5Q4 (MaxDD+WR only) by adding Sharpe as 3rd dimension.
        # Triple crisis (DD>45% AND WR<30% AND SR<-3.0): -3.0pts (triple coherent crisis).
        # Dual crisis tier A (DD>40% AND WR<33%): -2.0pts (DD+WR compound).
        # Dual crisis tier B (SR<-2.5 AND WR<33%): -2.0pts (Sharpe+WR compound).
        # Healthy (DD<20% AND WR>40% AND SR>-0.5): +1.5pts (three-way healthy coherence).
        # At live DD=49.37%, WR=29.2%, SR=-4.87: fires triple crisis -3.0pts.
        # Stores _last_g85s4_sqc (+1/-1/0) for Kelly Step 97. Zero-API. [v123.0]
        try:
            _s4_dd   = float(getattr(self, "_max_drawdown_pct", 0.0) or 0.0)
            _s4_wr   = float(getattr(self, "_bayes_wr", 0.5) or 0.5)
            _s4_sr   = float(getattr(self, "_sharpe_ratio", 0.0) or 0.0)
            _s4_adj, _s4_sqc = 0.0, 0
            if _s4_dd > 45.0 and _s4_wr < 0.30 and _s4_sr < -3.0:
                _s4_adj, _s4_sqc = -3.0, -1   # Triple coherent crisis
            elif (_s4_dd > 40.0 and _s4_wr < 0.33) or (_s4_sr < -2.5 and _s4_wr < 0.33):
                _s4_adj, _s4_sqc = -2.0, -1   # Dual crisis compound
            elif _s4_dd < 20.0 and _s4_wr > 0.40 and _s4_sr > -0.5:
                _s4_adj, _s4_sqc = +1.5, +1   # Three-way healthy coherence
            quality_score          += _s4_adj
            self._last_g85s4_sqc   = _s4_sqc
            _s4_pass = (_s4_sqc >= 0)
            self._gate_stats["gate_g85s4_sqc"]["pass" if _s4_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85s4_sqc"].append(_s4_pass)
            if _s4_adj != 0.0:
                self._logger.debug(
                    f"[v123.0 G8.5S4 SQC-Sentinel] {symbol} sqc={_s4_sqc:+d} "
                    f"DD={_s4_dd:.1f}% WR={_s4_wr:.1%} SR={_s4_sr:.2f} "
                    f"adj={_s4_adj:+.1f}pts"
                )
        except Exception:
            pass  # G8.5S4 Signal-Quality-Coherence Sentinel is non-fatal soft-gate

        # ── Gate 8.5T4 — Capitulation-Reversal Gate (v124.0) ─────────────────
        # Zero-API extreme-fear capitulation detector. Reads public Fear&Greed index
        # and Deribit BTC GEX regime to detect historic reversal setups at market extremes.
        # Ultra-capitulation (F&G<15 + BTC FLIP ZONE) → +2.5pts: deeply oversold, dealers
        # short-gamma, regime uncertain — highest-probability reversal setup per historical data.
        # Deep-fear LONG (F&G<20 + NEGATIVE GEX) → +1.5pts: fear + negative GEX aligns.
        # Greed-exhaustion SHORT (F&G>78 + POSITIVE GEX) → +2.0pts: overbought reversal.
        # Counter-trend LONG in fear (F&G<18 + POSITIVE GEX + LONG) → -2.0pts: fighting trend.
        # Stores _last_g85t4_cap for Kelly Step 98. [v124.0]
        try:
            _t4_adj   = 0.0
            _t4_cap   = 0   # +1=reversal-setup, -1=counter-trend, 0=neutral
            _t4_fg    = 0.0
            _t4_dir   = (direction or "").upper()
            # Read Fear & Greed from PublicAPIIntelligence (cached, zero-API cost)
            _t4_pub_api = getattr(self, "_engine_public_api", None)
            if _t4_pub_api is not None:
                try:
                    _t4_fg_raw = getattr(_t4_pub_api, "_fear_greed_index", None)
                    if _t4_fg_raw is not None:
                        _t4_fg = float(_t4_fg_raw)
                except Exception:
                    pass
            # Read BTC GEX regime from Deribit snapshots (cached, zero-API cost)
            _t4_btc_regime = ""
            _t4_btc_net    = 0.0
            _t4_snaps = getattr(self, "_engine_gex_snapshots", None)
            if _t4_snaps is not None:
                _t4_entry = _t4_snaps.get("BTCUSDT")
                if _t4_entry is not None:
                    _t4_snap, _t4_ts = (
                        (_t4_entry[0], _t4_entry[1])
                        if isinstance(_t4_entry, tuple)
                        else (_t4_entry, 0.0)
                    )
                    if time.time() - float(_t4_ts or 0.0) < 120.0 and _t4_snap is not None:
                        _t4_btc_regime = str(getattr(_t4_snap, "regime", "") or "").upper()
                        _t4_btc_net    = float(getattr(_t4_snap, "net_gex", 0.0) or 0.0)
            # Apply capitulation logic
            if _t4_fg > 0.0:  # cold-start guard (fg=0 means no data)
                if _t4_dir == "LONG":
                    if _t4_fg < 15.0 and _t4_btc_regime == "FLIP ZONE":
                        # Ultra-capitulation reversal: extreme fear + dealer-neutral zone
                        _t4_adj = 2.5
                        _t4_cap = 1
                    elif _t4_fg < 20.0 and _t4_btc_regime in ("NEGATIVE", "FLIP ZONE"):
                        # Deep-fear support alignment: fear + neg GEX supports bounce
                        _t4_adj = 1.5
                        _t4_cap = 1
                    elif _t4_fg < 18.0 and _t4_btc_net > 500_000_000.0:
                        # Counter-trend LONG: fighting positive GEX in extreme fear
                        _t4_adj = -2.0
                        _t4_cap = -1
                elif _t4_dir == "SHORT":
                    if _t4_fg > 78.0 and _t4_btc_regime == "POSITIVE":
                        # Greed exhaustion SHORT: overbought with dealer long-gamma
                        _t4_adj = 2.0
                        _t4_cap = 1
                    elif _t4_fg > 85.0:
                        # Extreme greed SHORT: fear-of-missing-out peak exhaustion
                        _t4_adj = 1.5
                        _t4_cap = 1
                    elif _t4_fg < 20.0 and _t4_btc_regime == "FLIP ZONE":
                        # v150.0: GCEF — crowded SHORT in Extreme Fear + FLIP ZONE.
                        # In capitulation (F&G<20), short positions are maximally
                        # crowded; FLIP ZONE (dealer-neutral GEX) means no structural
                        # support for further downside. Squeeze risk is highest.
                        # Mirror of the LONG +2.5pts reversal bonus — penalises
                        # directional alignment with the panicking crowd.
                        _t4_adj = -2.5
                        _t4_cap = -1
            self._last_g85t4_cap = _t4_cap
            quality_score += _t4_adj
            _t4_pass = 1 if _t4_adj >= 0.0 else 0
            self._gate_stats["gate_g85t4_cap"]["pass"] += _t4_pass
            self._gate_stats["gate_g85t4_cap"]["fail"] += (1 - _t4_pass)
            _t4_ring = self._gate_stats_recent.get("gate_g85t4_cap")
            if _t4_ring is not None:
                _t4_ring.append(_t4_pass)
            if _t4_adj != 0.0:
                self._logger.debug(
                    f"[v124.0 G8.5T4 CapReversal] {symbol} fg={_t4_fg:.0f} "
                    f"btc_regime={_t4_btc_regime} dir={_t4_dir} "
                    f"adj={_t4_adj:+.1f}pts cap={_t4_cap:+d}"
                )
        except Exception:
            pass  # G8.5T4 Capitulation-Reversal Gate is non-fatal soft-gate

        # ── Gate 8.5U4 — Triple-Ultimate-Crisis Sentinel (v124.0) ─────────────
        # Most aggressive crisis gate — applies maximum penalty when ALL THREE
        # crisis metrics (WR, Sharpe, MaxDD) are simultaneously at extreme levels.
        # This creates a "triple convergence" crisis detector that fires only when
        # the system is in genuine distress across all dimensions simultaneously.
        # Unlike G8.5S4 (which uses thresholds of DD>45%+WR<30%+SR<-3.0), this
        # gate uses tighter thresholds to catch only the most extreme crises:
        # Ultimate triple crisis (WR<25%+SR<-4.0+DD>47%) → -4.0pts.
        # Deep triple crisis (WR<28%+SR<-3.0+DD>42%) → -3.0pts.
        # Triple healthy (WR>40%+SR>-0.5+DD<18%) → +1.5pts.
        # At live conditions (WR=29.2%+SR=-6.53+DD=49.37%): fires ultimate -4.0pts. [v124.0]
        try:
            _u4_adj  = 0.0
            _u4_tuc  = 0   # +1=triple-healthy, -1=deep-crisis, -2=ultimate-crisis, 0=neutral
            # Read live metrics from engine state (zero-API, in-memory only)
            _u4_wr = float(getattr(self, "_win_rate", 0.0) or 0.0)
            _u4_w  = int(getattr(self, "_wins",  0) or 0)
            _u4_l  = int(getattr(self, "_losses", 0) or 0)
            if (_u4_w + _u4_l) > 0:
                _u4_wr = _u4_w / (_u4_w + _u4_l)
            _u4_dd = float(getattr(self, "_max_drawdown",  0.0) or 0.0)
            _u4_sr = float(getattr(self, "_sharpe_ratio", 0.0) or 0.0)
            # Ultimate triple crisis — all three metrics at extreme failure
            if _u4_wr < 0.25 and _u4_sr < -4.0 and _u4_dd > 47.0:
                _u4_adj = -4.0
                _u4_tuc = -2
            elif _u4_wr < 0.28 and _u4_sr < -3.0 and _u4_dd > 42.0:
                _u4_adj = -3.0
                _u4_tuc = -1
            elif _u4_wr < 0.30 and _u4_sr < -4.0 and _u4_dd > 47.0:
                # v151.0 tier: WR<30%+SR<-4.0+DD>47% — sub-ultimate crisis wide-WR band
                _u4_adj = -2.5
                _u4_tuc = -1
            elif _u4_wr < 0.30 and _u4_sr < -3.0 and _u4_dd > 44.0:
                # v155.0 tier: sub-GDCR zone (DD 44-47.5%, SR<-3.0) — fills the scoring
                # gap where GDCR isn't active but conditions are structurally adverse.
                # At DD=44-47%, WR=29%, SR=-3.5 the prior code gave 0 pts; this adds -2.0pts.
                _u4_adj = -2.0
                _u4_tuc = -1
            elif _u4_wr > 0.40 and _u4_sr > -0.5 and _u4_dd < 18.0:
                _u4_adj = 1.5
                _u4_tuc = 1
            self._last_g85u4_tuc = _u4_tuc
            quality_score += _u4_adj
            _u4_pass = 1 if _u4_adj >= 0.0 else 0
            self._gate_stats["gate_g85u4_tuc"]["pass"] += _u4_pass
            self._gate_stats["gate_g85u4_tuc"]["fail"] += (1 - _u4_pass)
            _u4_ring = self._gate_stats_recent.get("gate_g85u4_tuc")
            if _u4_ring is not None:
                _u4_ring.append(_u4_pass)
            if _u4_adj != 0.0:
                self._logger.debug(
                    f"[v124.0 G8.5U4 TUC-Sentinel] {symbol} "
                    f"WR={_u4_wr:.1%} SR={_u4_sr:.2f} DD={_u4_dd:.1f}% "
                    f"adj={_u4_adj:+.1f}pts tuc={_u4_tuc:+d}"
                )
        except Exception:
            pass  # G8.5U4 Triple-Ultimate-Crisis Sentinel is non-fatal soft-gate

        # ── Gate 8.5V4 — EV-Recovery-Velocity (v125.0) ──────────────────────
        # Zero-API gate: reads booster._ev_ring (deque of recent EV-R values stored
        # after each closed trade) and computes a linear regression slope over the
        # last 10 entries to detect whether EV is trending toward recovery.
        # Slope is in R-units per trade (positive = improving, negative = declining).
        #   slope > +0.020 R/trade → +2.0pts (fast EV recovery — system finding edge)
        #   slope > +0.010 R/trade → +1.0pts (moderate EV recovery)
        #   slope < −0.020 R/trade → −2.0pts (fast EV deterioration — system losing edge)
        #   otherwise            →  0.0pts (neutral / insufficient data)
        # Cold-start guard: ≥10 ev_ring samples required; else 0pts.
        # Stores _last_g85v4_erv (+2/+1/0/-1) for Kelly Step 100. [v125.0]
        try:
            _v4_bst    = getattr(self, "_booster", None) if hasattr(self, "_booster") else None
            _v4_erv    = getattr(_v4_bst, "_ev_ring", None) if _v4_bst is not None else None
            _v4_adj    = 0.0
            _v4_erv_v  = 0
            if _v4_erv is not None and len(_v4_erv) >= 10:
                _v4_vals = list(_v4_erv)[-10:]
                _v4_n    = len(_v4_vals)
                _v4_xs   = list(range(_v4_n))
                _v4_xm   = sum(_v4_xs) / _v4_n
                _v4_ym   = sum(_v4_vals) / _v4_n
                _v4_num  = sum((_v4_xs[i] - _v4_xm) * (_v4_vals[i] - _v4_ym) for i in range(_v4_n))
                _v4_den  = sum((_v4_xs[i] - _v4_xm) ** 2 for i in range(_v4_n))
                _v4_slope = _v4_num / _v4_den if _v4_den > 1e-9 else 0.0
                if _v4_slope > 0.020:
                    _v4_adj, _v4_erv_v = +2.0, +2
                elif _v4_slope > 0.010:
                    _v4_adj, _v4_erv_v = +1.0, +1
                elif _v4_slope < -0.020:
                    _v4_adj, _v4_erv_v = -2.0, -1
                else:
                    _v4_adj, _v4_erv_v = 0.0, 0
            quality_score          += _v4_adj
            self._last_g85v4_erv   = _v4_erv_v
            _v4_pass = (_v4_erv_v >= 0)
            self._gate_stats["gate_g85v4_erv"]["pass" if _v4_pass else "fail"] += 1
            _v4_ring = self._gate_stats_recent.get("gate_g85v4_erv")
            if _v4_ring is not None:
                _v4_ring.append(_v4_pass)
            if _v4_adj != 0.0:
                self._logger.debug(
                    f"[v125.0 G8.5V4 ERV] {symbol} "
                    f"ev_slope={_v4_slope if _v4_erv is not None and len(_v4_erv) >= 10 else 0.0:.4f}R/trade "
                    f"adj={_v4_adj:+.1f}pts erv={_v4_erv_v:+d}"
                )
        except Exception:
            pass  # G8.5V4 EV-Recovery-Velocity is non-fatal soft-gate

        # ── Gate 8.5W4 — WinRate-Acceleration-Coherence (v125.0) ────────────
        # Zero-API gate: reads booster._pnl_ring (deque of +1/-1 outcome flags)
        # and computes recent-10 WR vs prior-20 WR to detect WR acceleration.
        # Requires ≥30 pnl_ring entries for reliable comparison.
        #   WR_delta ≥ +15pp → +2.0pts (strong WR acceleration — momentum building)
        #   WR_delta ≥ +8pp  → +1.5pts (moderate WR acceleration)
        #   WR_delta ≤ −15pp → −2.0pts (significant WR deceleration — losing streak)
        #   otherwise        →  0.0pts (neutral / insufficient data)
        # Stores _last_g85w4_wac (+2/+1/0/-1) for Kelly Step 101. [v125.0]
        try:
            _w4_bst    = getattr(self, "_booster", None) if hasattr(self, "_booster") else None
            _w4_pnl    = getattr(_w4_bst, "_pnl_ring", None) if _w4_bst is not None else None
            _w4_adj    = 0.0
            _w4_wac    = 0
            if _w4_pnl is not None and len(_w4_pnl) >= 30:
                _w4_full     = list(_w4_pnl)
                _w4_recent   = _w4_full[-10:]
                _w4_prior    = _w4_full[-30:-10]
                _w4_wr_rec   = sum(1 for x in _w4_recent if x > 0) / len(_w4_recent)
                _w4_wr_pri   = sum(1 for x in _w4_prior  if x > 0) / len(_w4_prior)
                _w4_delta_pp = (_w4_wr_rec - _w4_wr_pri) * 100.0
                if _w4_delta_pp >= 15.0:
                    _w4_adj, _w4_wac = +2.0, +2
                elif _w4_delta_pp >= 8.0:
                    _w4_adj, _w4_wac = +1.5, +1
                elif _w4_delta_pp <= -15.0:
                    _w4_adj, _w4_wac = -2.0, -1
                else:
                    _w4_adj, _w4_wac = 0.0, 0
            quality_score          += _w4_adj
            self._last_g85w4_wac   = _w4_wac
            _w4_pass = (_w4_wac >= 0)
            self._gate_stats["gate_g85w4_wac"]["pass" if _w4_pass else "fail"] += 1
            _w4_ring = self._gate_stats_recent.get("gate_g85w4_wac")
            if _w4_ring is not None:
                _w4_ring.append(_w4_pass)
            if _w4_adj != 0.0:
                self._logger.debug(
                    f"[v125.0 G8.5W4 WAC] {symbol} "
                    f"wr_rec={_w4_wr_rec if _w4_pnl is not None and len(_w4_pnl) >= 30 else 0.0:.1%} "
                    f"wr_pri={_w4_wr_pri if _w4_pnl is not None and len(_w4_pnl) >= 30 else 0.0:.1%} "
                    f"delta={_w4_delta_pp if _w4_pnl is not None and len(_w4_pnl) >= 30 else 0.0:+.1f}pp "
                    f"adj={_w4_adj:+.1f}pts wac={_w4_wac:+d}"
                )
        except Exception:
            pass  # G8.5W4 WinRate-Acceleration-Coherence is non-fatal soft-gate

        # ── Gate 8.5X4 — SVR: Quality-Score-Velocity-Recovery Sentinel [v126.0] ──
        # Tracks the quality_score_ring (last-8 composite scores) and computes a
        # linear regression slope to detect quality recovery from crisis territory.
        # Slope >+2.0pts/cycle → +2.0pts; >+0.5 → +1.0pts; <-2.0 → -2.0pts.
        # Soft gate — cannot block signals. Sentinel: _last_g85x4_svr. [v126.0]
        try:
            _x4_qring = getattr(self, "_quality_score_ring", None)
            _x4_adj, _x4_svr = 0.0, 0
            if _x4_qring is not None and len(_x4_qring) >= 5:
                _x4_vals = list(_x4_qring)
                _x4_n    = len(_x4_vals)
                _x4_xs   = list(range(_x4_n))
                _x4_xm   = sum(_x4_xs) / _x4_n
                _x4_ym   = sum(_x4_vals) / _x4_n
                _x4_num  = sum((_x4_xs[i] - _x4_xm) * (_x4_vals[i] - _x4_ym) for i in range(_x4_n))
                _x4_den  = sum((_x4_xs[i] - _x4_xm) ** 2 for i in range(_x4_n))
                _x4_slope = (_x4_num / _x4_den) if _x4_den > 1e-9 else 0.0
                if _x4_slope > 2.0:
                    _x4_adj, _x4_svr = +2.0, +2
                elif _x4_slope > 0.5:
                    _x4_adj, _x4_svr = +1.0, +1
                elif _x4_slope < -2.0:
                    _x4_adj, _x4_svr = -2.0, -1
            quality_score          += _x4_adj
            self._last_g85x4_svr   = _x4_svr
            _x4_pass = (_x4_svr >= 0)
            self._gate_stats["gate_g85x4_svr"]["pass" if _x4_pass else "fail"] += 1
            _x4_ring2 = self._gate_stats_recent.get("gate_g85x4_svr")
            if _x4_ring2 is not None:
                _x4_ring2.append(_x4_pass)
            if _x4_adj != 0.0:
                self._logger.debug(
                    f"[v126.0 G8.5X4 SVR] {symbol} "
                    f"slope={_x4_slope:+.2f}pts/cycle adj={_x4_adj:+.1f}pts svr={_x4_svr:+d}"
                )
        except Exception:
            pass  # G8.5X4 Quality-Score-Velocity-Recovery is non-fatal soft-gate

        # ── Gate 8.5Y4 — OWS: OFI-WR-Trajectory-Sync Confluence [v126.0] ───
        # Cross-validates OFI net direction (from _ofi_ring z-score) vs WR momentum
        # trajectory (_last_g85w4_wac sentinel). Strong OFI+WR-accel alignment: +2.0pts.
        # OFI direction aligned alone: +1.0pts. OFI opposed+WR decelerating: -2.0pts.
        # Soft gate — cannot block signals. Sentinel: _last_g85y4_ows. [v126.0]
        try:
            _y4_ring = getattr(self._booster, "_ofi_ring", None)
            _y4_ofi_dir = 0
            if _y4_ring is not None and len(_y4_ring) >= 2:
                _y4_ofi_last = sum(list(_y4_ring)[-3:]) / min(3, len(_y4_ring))
                _y4_ofi_dir  = 1 if _y4_ofi_last > 0.0 else (-1 if _y4_ofi_last < 0.0 else 0)
            _y4_wac  = int(getattr(self, "_last_g85w4_wac", 0) or 0)
            _y4_dir  = 1 if str(direction or "").upper() in ("BUY", "LONG") else -1  # v143.1 FIX: bare _direction_int undefined
            _y4_adj, _y4_ows = 0.0, 0
            if _y4_ofi_dir != 0:
                _y4_ofi_aligned = (_y4_ofi_dir == _y4_dir)
                if _y4_ofi_aligned and _y4_wac >= 1:
                    _y4_adj, _y4_ows = +2.0, +2
                elif _y4_ofi_aligned:
                    _y4_adj, _y4_ows = +1.0, +1
                elif (not _y4_ofi_aligned) and _y4_wac <= -1:
                    _y4_adj, _y4_ows = -2.0, -1
            quality_score          += _y4_adj
            self._last_g85y4_ows   = _y4_ows
            _y4_pass = (_y4_ows >= 0)
            self._gate_stats["gate_g85y4_ows"]["pass" if _y4_pass else "fail"] += 1
            _y4_ring2 = self._gate_stats_recent.get("gate_g85y4_ows")
            if _y4_ring2 is not None:
                _y4_ring2.append(_y4_pass)
            if _y4_adj != 0.0:
                self._logger.debug(
                    f"[v126.0 G8.5Y4 OWS] {symbol} "
                    f"ofi_dir={_y4_ofi_dir:+d} wac={_y4_wac:+d} dir={_y4_dir:+d} "
                    f"adj={_y4_adj:+.1f}pts ows={_y4_ows:+d}"
                )
        except Exception:
            pass  # G8.5Y4 is a non-fatal soft-gate

        # ── Gate 8.5Z4 — ARC: Adaptive-Regime-Composite Sentinel [v127.0] ───
        # 3-source zero-API composite: RegimeMomentumSync verdict (_last_g85z2_rms)
        # + OFI net direction (from _booster._ofi_ring mean sign)
        # + WR trajectory verdict (_last_g85w4_wac), all cross-validated vs trade dir.
        # All 3 aligned with direction → +2.0pts; 2 of 3 aligned → +1.0pts
        # All 3 opposed to direction   → -2.0pts; else 0.
        # Soft gate — cannot block signals. Sentinel: _last_g85z4_arc. [v127.0]
        try:
            _z4_rms     = int(getattr(self, "_last_g85z2_rms", 0) or 0)   # +1/-1/0
            _z4_ofi_ring = getattr(self._booster, "_ofi_ring", None)
            _z4_ofi_dir = 0
            if _z4_ofi_ring is not None and len(_z4_ofi_ring) >= 2:
                _z4_ofi_mean = sum(list(_z4_ofi_ring)[-3:]) / min(3, len(_z4_ofi_ring))
                _z4_ofi_dir  = 1 if _z4_ofi_mean > 0.05 else (-1 if _z4_ofi_mean < -0.05 else 0)
            _z4_wac     = int(getattr(self, "_last_g85w4_wac", 0) or 0)   # +2/+1/-1/0
            _z4_wac_dir = 1 if _z4_wac >= 1 else (-1 if _z4_wac <= -1 else 0)
            _z4_dir     = 1 if str(direction or "").upper() in ("BUY", "LONG") else -1  # v143.1 FIX: bare _direction_int undefined
            _z4_adj, _z4_arc = 0.0, 0
            if _z4_dir != 0:
                _z4_votes = [
                    1 if _z4_rms == _z4_dir else (-1 if _z4_rms == -_z4_dir else 0),
                    1 if _z4_ofi_dir == _z4_dir else (-1 if _z4_ofi_dir == -_z4_dir else 0),
                    1 if _z4_wac_dir == _z4_dir else (-1 if _z4_wac_dir == -_z4_dir else 0),
                ]
                _z4_pos = sum(1 for v in _z4_votes if v == 1)
                _z4_neg = sum(1 for v in _z4_votes if v == -1)
                if _z4_pos == 3:
                    _z4_adj, _z4_arc = +2.0, +2
                elif _z4_pos == 2 and _z4_neg == 0:
                    _z4_adj, _z4_arc = +1.0, +1
                elif _z4_neg == 3:
                    _z4_adj, _z4_arc = -2.0, -1
            quality_score          += _z4_adj
            self._last_g85z4_arc   = _z4_arc
            _z4_pass = (_z4_arc >= 0)
            self._gate_stats["gate_g85z4_arc"]["pass" if _z4_pass else "fail"] += 1
            _z4_ring2 = self._gate_stats_recent.get("gate_g85z4_arc")
            if _z4_ring2 is not None:
                _z4_ring2.append(_z4_pass)
            if _z4_adj != 0.0:
                self._logger.debug(
                    f"[v127.0 G8.5Z4 ARC] {symbol} "
                    f"rms={_z4_rms:+d} ofi_dir={_z4_ofi_dir:+d} wac_dir={_z4_wac_dir:+d} "
                    f"votes=+{_z4_pos}/-{_z4_neg} adj={_z4_adj:+.1f}pts arc={_z4_arc:+d}"
                )
        except Exception:
            pass  # G8.5Z4 is a non-fatal soft-gate

        # ── Gate 8.5A5 — SVC: Sharpe-Velocity-Confluence Sentinel [v127.0] ──
        # Cross-validates Sharpe velocity trend (signal_data sharpe_velocity_norm)
        # with quality-score slope (_last_g85x4_svr) to detect edge-quality confluence.
        # Both positive → +2.0pts; either positive → +1.0pts; both negative → -2.0pts.
        # Soft gate — cannot block signals. Sentinel: _last_g85a5_svc. [v127.0]
        try:
            _a5_sharpe_vel = float(signal_data.get("sharpe_velocity_norm", 0.0) if isinstance(signal_data, dict) else 0.0)
            _a5_svr        = int(getattr(self, "_last_g85x4_svr", 0) or 0)
            _a5_adj, _a5_svc = 0.0, 0
            _a5_sharpe_pos  = (_a5_sharpe_vel > 0.15)
            _a5_sharpe_neg  = (_a5_sharpe_vel < -0.15)
            _a5_qual_pos    = (_a5_svr >= 1)
            _a5_qual_neg    = (_a5_svr <= -1)
            if _a5_sharpe_pos and _a5_qual_pos:
                _a5_adj, _a5_svc = +2.0, +2
            elif _a5_sharpe_pos or _a5_qual_pos:
                _a5_adj, _a5_svc = +1.0, +1
            elif _a5_sharpe_neg and _a5_qual_neg:
                _a5_adj, _a5_svc = -2.0, -1
            quality_score          += _a5_adj
            self._last_g85a5_svc   = _a5_svc
            _a5_pass = (_a5_svc >= 0)
            self._gate_stats["gate_g85a5_svc"]["pass" if _a5_pass else "fail"] += 1
            _a5_ring2 = self._gate_stats_recent.get("gate_g85a5_svc")
            if _a5_ring2 is not None:

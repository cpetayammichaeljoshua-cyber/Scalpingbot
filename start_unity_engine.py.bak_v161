            _z3_v2 = int(getattr(self, "_last_g85s2_wrcrisis",   0) or 0)   # Vote 2: WRCrisisRegime
            _z3_v3 = int(getattr(self, "_last_g85z2_rms",        0) or 0)   # Vote 3: RegimeMomentumSync
            _z3_fired = False

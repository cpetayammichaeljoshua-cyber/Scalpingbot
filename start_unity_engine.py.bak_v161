            ("SignalMaestro.market_microstructure_enhancer", "get_market_microstructure_enhancer", "Microstructure Enhancer"),
            ("SignalMaestro.advanced_market_depth_analyzer", "get_market_depth_analyzer",          "Depth Analyzer"),
        ]:

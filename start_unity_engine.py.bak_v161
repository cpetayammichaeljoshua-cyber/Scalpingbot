                        signal_data.setdefault("v5_ir_composite",  0.5)
                    pass  # v141.0 F346-F350 injection block is non-fatal
                    # ── v142.0: F351-F355 — WNZ+ADF Winsorization+Stationarity Features ────
                    try:
                        # F351: w5_wnz_gate — G8.5W5 WNZ state {-3→0.0,-2→0.1,-1→0.3,0→0.5,1→0.75,2→1.0}
                        _f351_wnz = int(getattr(self, "_last_g85w5_wnz", 0) or 0)
                        signal_data["w5_wnz_gate"] = float({-3:0.0,-2:0.1,-1:0.3,0:0.5,1:0.75,2:1.0}.get(_f351_wnz, 0.5))
                        # F352: w5_qs_extremity — quality_score z-position in ring, normalized [−4,+4]→[0,1]
                        _f352_ring = list(getattr(self, "_quality_score_ring", None) or [])
                        _f352_z = 0.0
                        if len(_f352_ring) >= 5:
                            _f352_mu = sum(_f352_ring) / len(_f352_ring)
                            _f352_sig = (sum((x - _f352_mu)**2 for x in _f352_ring) / len(_f352_ring)) ** 0.5
                            if _f352_sig > 0:
                                _f352_z = (float(signal_data.get("quality_score", 50.0) or 50.0) - _f352_mu) / _f352_sig
                        signal_data["w5_qs_extremity"] = max(0.0, min(1.0, (abs(_f352_z) / 4.0)))
                        # F353: w5_ofi_extremity — |ofi_z| extremity, normalized [0,4]→[0,1]
                        _f353_ofi_z = abs(float(signal_data.get("ofi_z", 0.0) or 0.0))
                        signal_data["w5_ofi_extremity"] = max(0.0, min(1.0, _f353_ofi_z / 4.0))
                        # F354: x5_adf_gate — G8.5X5 ADF state {-3→0.0,-2→0.1,-1→0.3,0→0.5,1→0.75,2→1.0}
                        _f354_adf = int(getattr(self, "_last_g85x5_adf", 0) or 0)
                        signal_data["x5_adf_gate"] = float({-3:0.0,-2:0.1,-1:0.3,0:0.5,1:0.75,2:1.0}.get(_f354_adf, 0.5))
                        # F355: x5_stationarity — lag-1 autocorrelation inverted (1-|rho1|), normalized [0,1]
                        _f355_ring = list(getattr(self, "_quality_score_ring", None) or [])
                        _f355_rho1 = 0.5  # neutral default
                        if len(_f355_ring) >= 4:
                            _f355_mu  = sum(_f355_ring) / len(_f355_ring)
                            _f355_dem = [x - _f355_mu for x in _f355_ring]
                            _f355_cov = sum(_f355_dem[i] * _f355_dem[i-1] for i in range(1, len(_f355_ring))) / max(1, len(_f355_ring)-1)
                            _f355_var = sum(v*v for v in _f355_dem) / len(_f355_ring)
                            _f355_rho1 = max(-1.0, min(1.0, _f355_cov / _f355_var)) if _f355_var > 1e-9 else 0.0
                        signal_data["x5_stationarity"] = max(0.0, min(1.0, 1.0 - abs(_f355_rho1)))
                    except Exception:
                        signal_data.setdefault("w5_wnz_gate",     0.5)
                        signal_data.setdefault("w5_qs_extremity", 0.5)
                        signal_data.setdefault("w5_ofi_extremity",0.5)
                        signal_data.setdefault("x5_adf_gate",     0.5)
                        signal_data.setdefault("x5_stationarity", 0.5)
                    pass  # v142.0 F351-F355 injection block is non-fatal
                    # ── v143.0: F356-F360 — PCO+ICS FLOAM Signal Orthogonality+IC Features ──
                    try:
                        # F356: y5_pco_gate — G8.5Y5 PCO state {-3→0.0,-2→0.1,-1→0.3,0→0.5,1→0.75,2→1.0}
                        _f356_pco = int(getattr(self, "_last_g85y5_pco", 0) or 0)
                        signal_data["y5_pco_gate"] = float({-3:0.0,-2:0.1,-1:0.3,0:0.5,1:0.75,2:1.0}.get(_f356_pco, 0.5))
                        # F357: y5_signal_orthogonality — avg pairwise signal independence proxy (1-avg_corr)
                        _f357_ofi_r  = list(getattr(self, "_ofi_z_ring", []))
                        _f357_qs_r   = list(getattr(self, "_quality_score_ring", []))
                        _f357_orth   = 0.5  # default neutral
                        if len(_f357_ofi_r) >= 5 and len(_f357_qs_r) >= 5:
                            _f357_n = min(len(_f357_ofi_r), len(_f357_qs_r), 20)
                            _f357_a = _f357_qs_r[-_f357_n:]; _f357_b = _f357_ofi_r[-_f357_n:]
                            _f357_ma = sum(_f357_a)/_f357_n; _f357_mb = sum(_f357_b)/_f357_n
                            _f357_num = sum((_f357_a[i]-_f357_ma)*(_f357_b[i]-_f357_mb) for i in range(_f357_n))
                            _f357_da  = (sum((x-_f357_ma)**2 for x in _f357_a)/_f357_n)**0.5
                            _f357_db  = (sum((x-_f357_mb)**2 for x in _f357_b)/_f357_n)**0.5
                            _f357_r   = _f357_num/(_f357_n*_f357_da*_f357_db) if _f357_da*_f357_db>1e-9 else 0.0
                            _f357_orth = max(0.0, min(1.0, 1.0 - abs(_f357_r)))
                        signal_data["y5_signal_orthogonality"] = _f357_orth
                        # F358: y5_ofi_qs_corr — raw OFI×QS Pearson correlation normalized [−1,+1]→[0,1]
                        signal_data["y5_ofi_qs_corr"] = max(0.0, min(1.0, (_f357_r + 1.0) / 2.0)) if len(_f357_ofi_r) >= 5 else 0.5
                        # F359: z5_ics_gate — G8.5Z5 ICS state {-3→0.0,-2→0.1,-1→0.3,0→0.5,1→0.75,2→1.0}
                        _f359_ics = int(getattr(self, "_last_g85z5_ics", 0) or 0)
                        signal_data["z5_ics_gate"] = float({-3:0.0,-2:0.1,-1:0.3,0:0.5,1:0.75,2:1.0}.get(_f359_ics, 0.5))
                        # F360: z5_floam_ir — FLOAM IR proxy = IC × √(BR/252), normalized [−1,+1]→[0,1]
                        _f360_pnl = list(getattr(self, "_pnl_ring", None) or [])
                        _f360_ir  = 0.0
                        if len(_f360_pnl) >= 10:
                            _f360_n  = min(30, len(_f360_pnl))
                            _f360_wr = sum(1 for x in _f360_pnl[-_f360_n:] if x > 0) / _f360_n
                            _f360_ic = (_f360_wr - 0.5) * 2.0
                            _f360_ir = _f360_ic * (1.0) ** 0.5  # BR=252/252=1, normalized
                        signal_data["z5_floam_ir"] = max(0.0, min(1.0, (_f360_ir + 1.0) / 2.0))
                    except Exception:
                        signal_data.setdefault("y5_pco_gate",             0.5)
                        signal_data.setdefault("y5_signal_orthogonality", 0.5)
                        signal_data.setdefault("y5_ofi_qs_corr",          0.5)
                        signal_data.setdefault("z5_ics_gate",             0.5)
                        signal_data.setdefault("z5_floam_ir",             0.5)
                    pass  # v143.0 F356-F360 injection block is non-fatal



                    if isinstance(signal_data, dict) and callable(_pfd):
                        nn_prob = float(_pfd(signal_data))
                    elif not isinstance(signal_data, dict) and callable(_ps):
                        nn_prob = float(_ps(signal_data))
                    else:
                        nn_prob = 0.5
                # v10.5 FIX: let the trainer's G-mean-optimal threshold drive G4.
                # Previous clamp was max(0.55, min(0.70, opt)) which ALWAYS pinned
                # to 0.55 (the trainer's opt is ~0.22-0.28 at 27% WR).
                # New clamp: max(NN_WIN_PROB_GATE=0.28, min(0.55, opt)) lets the
                # adaptive threshold actually work — with floor 0.28 preventing
                # the gate from becoming a rubber-stamp at very low confidence.
                _raw_opt = float(getattr(nn_trainer, "_opt_threshold", NN_WIN_PROB_GATE))
                nn_threshold = max(NN_WIN_PROB_GATE, min(0.55, _raw_opt))
                # v18.98: Cold-start tightening — untrained/early NN returns exactly 0.5.
                # With threshold = 0.50, p=0.5 ≥ 0.50 means ALL signals pass G4 during
                # cold-start (rubber stamp).  Raise to 0.53 when <50 labeled samples so
                # the NN must be distinctly above neutral before passing — prevents the
                # untrained model from being a non-gate.  After 50+ samples the
                # G-mean-optimal threshold from training takes over.
                _nn_n_cold = int(getattr(nn_trainer, "n_samples_trained", 0) or 0)
                if _nn_n_cold < 50:
                    nn_threshold = max(nn_threshold, 0.53)
                # v18.59: Record successful NN inference for health telemetry.
                # Keeps LayerStatus.success_rate ≥ 0.90 (✅) when predictions work,
                # surfaces the real sr in the console HUD and circuit-breaker logic.
                self._health.record_call("NeuralNetwork", success=True)
            except Exception:
                nn_prob = 0.5
                nn_threshold = NN_WIN_PROB_GATE
                # v18.59: Record failed NN inference so operators see sr drop in HUD
                # instead of the old "calls=0 / N/A" that masked silent failures.
                self._health.record_call("NeuralNetwork", success=False)
            # v14.0: critical WR<20% regime — require +5pts higher NN confidence
            # to prevent accepting low-confidence predictions during sustained drawdowns.
            if self._booster is not None:
                _g4_win_ring = self._booster._win_ring
                if len(_g4_win_ring) >= 10:
                    _g4_ring_wr = sum(_g4_win_ring) / len(_g4_win_ring)
                    if _g4_ring_wr < 0.20:
                        nn_threshold = max(nn_threshold, min(0.55, NN_WIN_PROB_GATE + 0.05))
            # v18.28: Regime-Adaptive NN Gate — Sharpe-based drawdown tightening.
            # WR<20% detection misses regimes with WR 25-35% but deeply negative
            # Sharpe (large loss magnitudes despite adequate trade count = adverse
            # selection).  Negative-Sharpe periods correlate with NN calibration
            # drift — the model's win-prob estimates become systematically overconfident
            # just when the market is most hostile.  Tighten to compensate:
            #   Sharpe < -3.5 → +10pp (max 0.60) — crisis / near-ruin zone
            #   Sharpe < -2.0 → +5pp  (max 0.55) — active drawdown regime
            # Applied AFTER WR step so both adjustments compound in worst regimes.
            if self._booster is not None and len(getattr(self._booster, "_pnl_ring", [])) >= 10:
                _g4_sr = float(getattr(self._booster, "sharpe_ratio", 0.0) or 0.0)
                if _g4_sr < -5.0:
                    # v20.1: EXTREME RUIN ZONE — Sharpe<-5 catastrophic; NN must require
                    # near-certainty. At NN_WIN_PROB_GATE=0.48: min(0.56,0.58)=0.56 → with
                    # 1.5× NN inflation raw output needs ≥0.84 to pass (≈37% actual WR).
                    nn_threshold = max(nn_threshold, min(0.56, NN_WIN_PROB_GATE + 0.10))
                elif _g4_sr < -3.5:
                    nn_threshold = max(nn_threshold, min(0.54, NN_WIN_PROB_GATE + 0.08))  # v18.89: cap 0.46→0.54 — RECALIBRATION FIX: when NN_WIN_PROB_GATE was raised 0.39→0.45 (v18.85) the crisis cap 0.46 was not updated; old: min(0.46,0.39+0.08)=0.46=+7pp; new-broken: min(0.46,0.45+0.08=0.53)=0.46=+1pp (CRISIS WEAKER than mild-crisis +5pp — backwards!); fix: cap→0.54 restores min(0.54,0.53)=0.53=+8pp, correctly stricter than mild-crisis 0.50; at Sharpe=-4.87: threshold=0.53; at RR=2.20 break-even=0.318 so 0.53 is 1.67× BE; prevents NN calibration-drift losers in deep-drawdown regimes
                elif _g4_sr < -2.0:
                    nn_threshold = max(nn_threshold, min(0.55, NN_WIN_PROB_GATE + 0.05))
            # v59.0: G4 Compound Crisis Gate — WR<30% + Sharpe<-3.0 simultaneous.
            # The existing Sharpe axis (above) handles each severity tier independently.
            # But the COMPOUND state WR<30% + Sharpe<-3.0 is measurably worse than either
            # factor alone: WR in the 25-30% band paired with a deeply negative Sharpe
            # means the NN is calibration-drifted (systematically overconfident) while
            # operating in a loss regime. The compound gate imposes an additional +2pp
            # on top of whatever the Sharpe-only path computed, raising the conviction bar.
            # v67.0: cap lowered 0.58→0.52 and compound delta 0.03→0.02 — at live Sharpe=-5.15
            # the Sharpe path sets threshold at 0.53; adding +0.03 compound previously pushed
            # to 0.56; CPCV gap further pushed to 0.58 → unreachable for 30% WR NN (max ~0.42).
            # Cap=0.52 prevents compounding of multiple tightening steps into an impossible gate.
            # Guard: ≥10 ring samples (cold-start safe).
            try:
                if self._booster is not None:
                    _g4_cmp_ring = self._booster._win_ring
                    if len(_g4_cmp_ring) >= 10:
                        _g4_cmp_wr = sum(_g4_cmp_ring) / len(_g4_cmp_ring)
                        _g4_cmp_sr = float(getattr(self._booster, "sharpe_ratio", 0.0) or 0.0)
                        if _g4_cmp_wr < 0.30 and _g4_cmp_sr < -3.0:
                            _nn_compound = 0.02  # v67.0: 0.03→0.02
                            _nn_prev_cmp = nn_threshold
                            nn_threshold = min(0.52, nn_threshold + _nn_compound)  # v67.0: cap 0.58→0.52
                            if nn_threshold > _nn_prev_cmp:
                                self._logger.debug(
                                    f"[G4-Compound v67.0] {symbol} WR={_g4_cmp_wr:.0%}<30% "
                                    f"SR={_g4_cmp_sr:.2f}<-3.0 → nn_thresh "
                                    f"{_nn_prev_cmp:.2f}→{nn_threshold:.2f} (+{_nn_compound:.2f} compound)"
                                )
            except Exception:
                pass
            # v60.0: G4 MC Uncertainty Threshold Boost — when the MC-Dropout ensemble
            # produces high epistemic uncertainty (σ > 0.15), the model is self-disagreeing
            # across its 50 forward passes — a direct proxy for distributional shift,
            # regime transition, or insufficient training coverage near this feature region.
            # Require up to +2pp higher conviction to pass in these high-uncertainty windows.
            # Cap at 0.58 to avoid over-restriction. Non-fatal try/except guard.
            try:
                _nn_sigma_g4 = float(getattr(nn_trainer, "_last_uncertainty", 0.0) or 0.0)
                if _nn_sigma_g4 > 0.15:
                    _sigma_delta   = min(0.02, (_nn_sigma_g4 - 0.15) * 0.13)
                    _nn_prev_sigma = nn_threshold
                    nn_threshold   = min(0.58, nn_threshold + _sigma_delta)
                    if nn_threshold > _nn_prev_sigma:
                        self._logger.debug(
                            f"[G4-Sigma v60.0] {symbol} MC_σ={_nn_sigma_g4:.3f}>0.15 → "
                            f"thresh {_nn_prev_sigma:.2f}→{nn_threshold:.2f} "
                            f"(+{_sigma_delta:.3f} epistemic uncertainty penalty)"
                        )
            except Exception:
                pass
            # v37.0 STRICT: All G4 threshold relaxations and bypass paths removed.
            # Removed: G4-DroughtRelax (-0.02), G4-Unani relaxation (-0.04 at ≥99%),
            #          G4-PessimismRelief (-0.04 at WR<35%), G4-SovRelax (-0.03 SOVEREIGN+drought),
            #          G4-unanimous bypass (consensus≥95%+nn_prob≥0.60×threshold→pass),
            #          G4-UNC_SOFT bypass (σ>0.18+consensus≥88%→quality-penalty pass).
            # Preserved: Crisis tightening (Sharpe<-2.0/-3.5/-5.0) — raises bar in adverse regimes.
            # Signals must genuinely clear nn_prob >= nn_threshold, NO exceptions. [v37.0-STRICT]
            # v67.0: G4 Hard Threshold Cap — prevents physically impossible thresholds.
            # All tightening steps (Sharpe crisis, compound WR+SR, CPCV gap, MC sigma) can stack
            # to 0.58-0.61. At WR=29%, calibrated NN predicts 0.35-0.45 — no 30% WR model can
            # clear 0.58.
            # Cap logic has TWO levels based on NN training status:
            #   trained=True  (NN active, real predictions): cap=0.52 — requires 1.79×
            #                 break-even conviction; strong but achievable.
            #   trained=False (NN disabled, sentinel=0.5): cap=0.50 — the fallback 0.5
            #                 exactly clears the base bar; crisis tightening applied to a
            #                 sentinel is meaningless and blocks all signals permanently.
            #                 The other 34 gates continue to filter quality.
            # Applied BEFORE dead-zone relief so relief works from a bounded baseline. [v67.0]
            try:
                _nn_trained_flag = bool(getattr(nn_trainer, "trained", False))
                # v86.0: WR-Adaptive Hard Cap — static 0.52 was unreachable at WR=29.4%.
                # NN trained on 29% WR data predicts max 0.38-0.44 for genuine winners; a
                # static 0.52 cap creates a permanent dead-zone (no signals ever pass G4).
                # Solution: lower cap proportionally to the session WR regime:
                #   WR < 25% → 0.44 (matches dead-zone floor — absolute floor for ultra-crisis)
                #   WR < 28% → 0.46 (deep crisis: NN max ≈ 0.40-0.44 at this WR)
                #   WR ≥ 28% → 0.52 (standard institutional cap — unchanged from v67.0)
                # untrained sentinel (0.50 exactly) cap unchanged — crisis tightening on a
                # sentinel value is meaningless and blocks all signals permanently.
                _g4_session_wr = 0.50  # default healthy
                try:
                    if self._booster is not None and len(getattr(self._booster, "_win_ring", [])) >= 20:
                        _g4_session_wr = sum(self._booster._win_ring) / len(self._booster._win_ring)
                except Exception:
                    pass
                if _nn_trained_flag:
                    if _g4_session_wr < 0.25:
                        _g4_hard_cap = 0.44  # ultra-crisis: NN max ≈ 0.35-0.40, cap=dead-zone floor
                    elif _g4_session_wr < 0.28:
                        _g4_hard_cap = 0.46  # deep-crisis: NN max ≈ 0.40-0.44, allows genuine winners
                    elif _g4_session_wr < 0.30:
                        _g4_hard_cap = 0.50  # v148.0: crisis regime (WR<30%=29%) — tighter than standard 0.52; coherent with NN_WIN_PROB_GATE=0.58; filters G4-compound-path signals in 0.50-0.52 band at crisis WR
                    else:
                        _g4_hard_cap = 0.52  # standard institutional cap [v67.0]
                else:
                    _g4_hard_cap = 0.50      # untrained sentinel cap unchanged
                if nn_threshold > _g4_hard_cap:
                    _g4_hc_pre   = nn_threshold
                    nn_threshold = _g4_hard_cap
                    self._logger.debug(
                        f"[G4-HardCap v86.0] {symbol} nn_thresh capped "
                        f"{_g4_hc_pre:.3f}→{_g4_hard_cap:.2f} "
                        f"(trained={_nn_trained_flag}, sessWR={_g4_session_wr:.1%})"
                    )
            except Exception:
                pass
            # v66.0/v67.0: G4 Dead-Zone Emergency Relief — when gate produced 0% pass rate for
            # last 15 evaluations (learned-pessimism deadlock), reduce nn_threshold toward 0.42.
            # v67.0: max relief 0.09→0.12, floor 0.44→0.42, guard 0.45→0.44 — after hard cap
            # sets threshold at 0.52, relief of up to 0.10 brings it to 0.42. At nn_prob=0.43
            # (improved from higher MAX_CLASS_WEIGHT+focal_gamma): 0.43 > 0.42 → PASS.
            # Distinct from removed relaxations: fires only when gate is in proven deadlock,
            # NOT as a general throughput boost. INFO log makes it fully visible to operators.
            try:
                if (len(self._g4_pass_ring) >= 15
                        and sum(self._g4_pass_ring) == 0
                        and nn_threshold > 0.44):
                    _g4_dz_relief = min(0.12, nn_threshold - 0.42)  # v67.0: 0.09→0.12, floor 0.44→0.42
                    if _g4_dz_relief > 0.005:
                        _g4_dz_pre   = nn_threshold
                        nn_threshold = max(0.42, nn_threshold - _g4_dz_relief)
                        self._logger.info(
                            f"[G4-DeadZone v67.0] {symbol} 15/15 dead-zone → "
                            f"nn_thresh {_g4_dz_pre:.3f}→{nn_threshold:.3f} "
                            f"(−{_g4_dz_relief:.3f}, floor=0.42)"
                        )
            except Exception:
                pass
            passed_g4 = nn_prob >= nn_threshold
            self._record("gate4", passed_g4)
            # v66.0: Track G4 pass/fail in ring for dead-zone detection next evaluation.
            try:
                self._g4_pass_ring.append(1 if passed_g4 else 0)
            except Exception:
                pass
            if not passed_g4:
                return False, f"G4_FAIL: NN win-prob={nn_prob:.2f} < {nn_threshold:.2f}", 0.0
            # v37.0: Full NN quality credit — all bypasses removed, nn_prob always genuinely >= threshold
            quality_score += min(15.0, nn_prob * 15.0)
        else:
            self._record("gate4", True)
            quality_score += 7.5

        # ── Gate 5 — External analyzer alignment (symmetric veto) ─────────────
        atas_dir = None
        bm_dir   = None

        if atas_result and isinstance(atas_result, dict) and "error" not in atas_result:
            # FIX v5.2: ATAS analyzer returns 'composite_signal' not 'overall_signal'.
            # Previously Gate 5 always read an empty string → atas_dir stayed None
            # → veto never fired and quality bonus never awarded fully.
            sig = atas_result.get(
                "overall_signal",
                atas_result.get(
                    "composite_signal",
                    atas_result.get("signal", "")
                )
            )
            if isinstance(sig, str) and sig:
                if "BUY" in sig.upper() or "BULL" in sig.upper():
                    atas_dir = "BUY"
                elif "SELL" in sig.upper() or "BEAR" in sig.upper():
                    atas_dir = "SELL"

        if bookmap_result and isinstance(bookmap_result, dict) and "error" not in bookmap_result:
            bm_sig = bookmap_result.get("order_flow_direction", "")
            if isinstance(bm_sig, str) and bm_sig:
                if "BUY" in bm_sig.upper():
                    bm_dir = "BUY"
                elif "SELL" in bm_sig.upper():
                    bm_dir = "SELL"

        atas_disagrees = atas_dir is not None and atas_dir != direction
        bm_disagrees   = bm_dir   is not None and bm_dir   != direction
        atas_agrees    = atas_dir == direction
        bm_agrees      = bm_dir   == direction

        # v7.1 G5 REWRITE — soft-veto replaces hard-block for single-analyzer cases.
        # Live diagnostics showed G5 = 25% pass rate (biggest bottleneck in the pipeline)
        # because the old logic hard-blocked whenever ONE analyzer disagreed even if the
        # OTHER had no data at all.  This caused IRONS Gate 10 to never activate.
        # Fix: only HARD-BLOCK when BOTH analyzers explicitly disagree.
        #      When only one disagrees (other has no data), apply a quality penalty so
        #      Gate 9 and Gate 10 make the final quality-adjusted decision.
        if atas_disagrees and bm_disagrees:
            # Both analyzers say opposite direction → HARD VETO (unchanged)
            passed_g5 = False
            self._record("gate5", False)
            return False, f"G5_FAIL: dual analyzer veto (ATAS={atas_dir} BM={bm_dir} dir={direction})", 0.0

        elif atas_disagrees and bm_dir is None:
            # ATAS disagrees but Bookmap has no data — soft penalty, don't block
            passed_g5 = True
            quality_score -= G5_SINGLE_VETO_PENALTY
            self._logger.debug(
                f"G5_SOFT: ATAS={atas_dir} disagrees (BM=no data) — "
                f"−{G5_SINGLE_VETO_PENALTY:.0f}pts quality penalty (v7.1)"
            )

        elif bm_disagrees and atas_dir is None:
            # Bookmap disagrees but ATAS has no data — soft penalty, don't block
            passed_g5 = True
            quality_score -= G5_SINGLE_VETO_PENALTY
            self._logger.debug(
                f"G5_SOFT: BM={bm_dir} disagrees (ATAS=no data) — "
                f"−{G5_SINGLE_VETO_PENALTY:.0f}pts quality penalty (v7.1)"
            )

        elif atas_disagrees and bm_agrees:
            # Split signal — Bookmap confirms but ATAS contradicts → small penalty
            passed_g5 = True
            quality_score -= G5_SPLIT_VETO_PENALTY
            self._logger.debug(
                f"G5_SPLIT: ATAS={atas_dir}≠dir BM={bm_dir}=dir — "
                f"−{G5_SPLIT_VETO_PENALTY:.0f}pts split penalty"
            )

        elif bm_disagrees and atas_agrees:
            # Split signal — ATAS confirms but Bookmap contradicts → small penalty
            passed_g5 = True
            quality_score -= G5_SPLIT_VETO_PENALTY
            self._logger.debug(
                f"G5_SPLIT: BM={bm_dir}≠dir ATAS={atas_dir}=dir — "
                f"−{G5_SPLIT_VETO_PENALTY:.0f}pts split penalty"
            )

        else:
            # Neither disagrees — pass cleanly
            passed_g5 = True

        self._record("gate5", passed_g5)
        # Quality bonus: agreement adds up to +10, full agreement adds +10, partial +5
        if atas_agrees and bm_agrees:
            quality_score += 10.0    # both confirm → full alignment bonus
        elif atas_agrees or bm_agrees:
            quality_score += 5.0     # one confirms (other neutral) → partial bonus
        elif atas_dir is None and bm_dir is None:
            quality_score += 3.0     # no analyzer data → neutral (was 5.0)

        # ── Gate 6 — Regime filter (Public API / Fear & Greed) ────────────────
        if self._public_api is not None:
            try:
                summary = self._public_api.get_market_summary()
                fg = int(summary.get("fear_greed", 50) or 50)
                # v69.0: Hard-block tightened 20→10 — crash-level panic only.
                # F&G 10-20 now receives a quality-score penalty (−3 pts) instead of
                # hard rejection, allowing IRONS/NN/GEX to make the final call.
                # Rationale: F&G=12 in live operation blocked ALL BUY signals at G6
                # resulting in IRONS calls=0 and complete SELL-only signal flow.
                # At F&G=12 the fear is already priced; genuine reversal setups
                # (DGRP>60, swarm=100%, NN≥0.52) should not be vetoed by regime alone.
                if fg <= 10 and direction == "BUY":
                    self._record("gate6", False)
                    return False, f"G6_FAIL: F&G={fg} (crash-level panic) blocks LONG", 0.0
                if fg >= 90 and direction == "SELL":
                    self._record("gate6", False)
                    return False, f"G6_FAIL: F&G={fg} (euphoric greed) blocks SHORT", 0.0
                self._record("gate6", True)
                # v69.0: F&G 10-20 BUY — quality score penalty instead of hard block
                if fg > 10 and fg <= 20 and direction == "BUY":
                    quality_score -= 3.0   # fear context penalty — IRONS/NN/GEX still decide
                # v69.0: F&G 80-90 SELL — symmetric soft penalty band
                if fg >= 80 and fg < 90 and direction == "SELL":
                    quality_score -= 3.0   # greed context penalty
                fg_quality = 1.0 - abs(fg - 50) / 50.0
                # v42.0: Direction-aware F&G quality bonus — regime-aligned signals rewarded,
                # regime-opposed signals penalised. Extreme Fear (F&G<30): SELL aligns with
                # panic-selling momentum continuation (historically higher realized RR) → 1.5×.
                # BUY fights regime (counter-trend into capitulation selling) → 0.65×.
                # Symmetric logic for Extreme Greed (F&G>70). Neutral band (30-70): unchanged 1.0×.
                # Math: F&G=23 SELL: 0.46×7.5×1.5=+5.18pts (was +3.45, +1.73pt lift).
                # F&G=23 BUY: 0.46×7.5×0.65=+2.24pts (was +3.45, -1.21pt, regime-opposed penalty).
                _fg_dir_mult = 1.0   # neutral band (F&G 30-70): direction-agnostic
                if fg < 30 and direction == "SELL":
                    _fg_dir_mult = 1.5   # v42.0: extreme fear → SELL regime-aligned (+50%)
                elif fg < 30 and direction == "BUY":
                    _fg_dir_mult = 0.65  # v42.0: extreme fear → BUY regime-opposed (-35%)
                elif fg > 70 and direction == "BUY":
                    _fg_dir_mult = 1.5   # v42.0: extreme greed → BUY regime-aligned (+50%)
                elif fg > 70 and direction == "SELL":
                    _fg_dir_mult = 0.65  # v42.0: extreme greed → SELL regime-opposed (-35%)
                quality_score += fg_quality * 7.5 * _fg_dir_mult
            except Exception:
                self._record("gate6", True)
                quality_score += 3.75
        else:
            self._record("gate6", True)
            quality_score += 3.75

        # ── Gate 7 — GEX Regime (AEGIS Dealer Flow) ───────────────────────────
        # v5.2: regime-aware DGRP thresholds:
        #   FLIP ZONE      → 35  (natural low-DGRP transition zone)
        #   POSITIVE/NEG   → 45  (only enter with strong dealer conviction)
        #   NEUTRAL/UNKNOWN→ 35  (permissive when regime is unclear)
        if gex_snapshot is not None and self._health.is_available("AEGIS_GEX"):
            try:
                regime    = str(getattr(gex_snapshot, "regime", "NEUTRAL")).upper()
                dgrp      = float(getattr(gex_snapshot, "dgrp_score", 50) or 50)
                gex_conf  = float(getattr(gex_snapshot, "confidence", 50) or 50)
                # Regime-aware DGRP threshold
                if "FLIP" in regime:
                    dgrp_threshold = GEX_FLIP_ZONE_DGRP   # v5.9: 35→30 for FLIP ZONE
                elif regime in ("POSITIVE", "NEGATIVE"):
                    dgrp_threshold = 40   # v18.58: 45→43; v111.0: 43→40 — live log: SOLUSDT dgrp=39 conf=96 rejected at 43 (too strict); 40 admits strong-conviction signals while remaining well above NEUTRAL floor (35/38); FLIP ZONE (33) unchanged
                else:
                    dgrp_threshold = GEX_MIN_DGRP  # 35 for NEUTRAL/UNKNOWN
                passed_dgrp = dgrp >= dgrp_threshold
                regime_ok = True
                _gex_dir_mismatch = False   # v11.3: soft-penalty flag for partial mismatch
                if regime == "POSITIVE" and direction == "SELL":
                    if gex_conf >= GEX_MIN_CONFIDENCE:
                        regime_ok = False       # hard block: strong dealer flow opposes
                    else:
                        _gex_dir_mismatch = True  # v11.3: soft penalty below conf threshold
                elif regime == "NEGATIVE" and direction == "BUY":
                    if gex_conf >= GEX_MIN_CONFIDENCE:
                        regime_ok = False       # hard block: strong dealer flow opposes
                    else:
                        _gex_dir_mismatch = True  # v11.3: soft penalty below conf threshold
                passed_g7 = passed_dgrp and regime_ok
                self._record("gate7", passed_g7)
                if not passed_g7:
                    return False, (
                        f"G7_FAIL: GEX regime={regime} dir={direction} "
                        f"dgrp={dgrp:.0f} thresh={dgrp_threshold} conf={gex_conf:.0f}"
                    ), 0.0
                # v11.3: regime-direction mismatch soft penalty (conf below hard-block threshold)
                # Even at lower GEX confidence, a BUY in NEGATIVE regime or SELL in POSITIVE
                # regime is swimming against confirmed dealer positioning — penalise quality.
                if _gex_dir_mismatch:
                    quality_score -= 18.0
                    self._logger.debug(
                        f"G7_MISMATCH [{symbol}]: regime={regime} opposes {direction} "
                        f"(conf={gex_conf:.0f}<{GEX_MIN_CONFIDENCE}) → −18pts quality [v11.3]"
                    )
                if (regime == "POSITIVE" and direction == "BUY") or \
                   (regime == "NEGATIVE" and direction == "SELL"):
                    # v15.0: confidence-weighted GEX alignment bonus
                    # Higher dealer conviction aligned with direction → larger reward.
                    # conf≥90: ultra-conviction  → +12pts
                    # conf≥80: strong conviction → +10pts
                    # conf< 80: standard          → +7.5pts
                    if gex_conf >= 90.0:
                        _gex_align_bonus = 12.0
                    elif gex_conf >= 80.0:
                        _gex_align_bonus = 10.0
                    else:
                        _gex_align_bonus = 7.5
                    quality_score += _gex_align_bonus
                    self._logger.debug(
                        f"✅ [{symbol}] GEX align bonus: {regime}+{direction} "
                        f"conf={gex_conf:.0f} → +{_gex_align_bonus:.1f}pts [v15.0]"
                    )
                elif "FLIP" in regime:
                    quality_score += 5.5   # flip zone breakout bonus (v5.2 new)
                else:
                    quality_score += 3.75

                # ── v8.0 GEX Gamma Zero proximity bonus ─────────────────────
                # When the entry price is within GEX_GAMMA_ZERO_PROX_PCT of the
                # Gamma Zero level (GEX flip proxy), the market is at a critical
                # dealer-hedge inflection point — entries here have significantly
                # higher mean-reversion win rate than random entries.
                # GEX formula: GEX = Σ(OI × Gamma × 100) → zero crossing = flip
                _gamma_zero = float(getattr(gex_snapshot, "gamma_zero",
                              getattr(gex_snapshot, "gex_flip_price", 0)) or 0)
                if _gamma_zero and entry:
                    _gz_dist_pct = abs(entry - _gamma_zero) / entry
                    if _gz_dist_pct <= GEX_GAMMA_ZERO_PROX_PCT:
                        quality_score += GEX_GAMMA_ZERO_QUALITY_BONUS
                        self._logger.debug(
                            f"🎯 [{symbol}] Gamma Zero proximity: entry={entry:.4f} "
                            f"GZ={_gamma_zero:.4f} dist={_gz_dist_pct:.3%} "
                            f"→ +{GEX_GAMMA_ZERO_QUALITY_BONUS:.0f}pts"
                        )

                # ── v8.0 VOL TRIGGER directional alignment bonus ─────────────
                # VOL TRIGGER UP/DOWN are price levels at which realized vol
                # accelerates.  A BUY signal above VOL_TRIGGER_UP (or SELL below
                # VOL_TRIGGER_DN) aligns with the volatility expansion direction
                # and historically delivers better momentum continuation.
                _vt_up = float(getattr(gex_snapshot, "vol_trigger_up",
                         getattr(gex_snapshot, "vt_up", 0)) or 0)
                _vt_dn = float(getattr(gex_snapshot, "vol_trigger_dn",
                         getattr(gex_snapshot, "vt_dn", 0)) or 0)
                if direction == "BUY" and _vt_up and entry >= _vt_up:
                    quality_score += GEX_VOL_TRIGGER_QUALITY_BONUS
                    self._logger.debug(
                        f"📈 [{symbol}] VOL TRIGGER UP aligned: entry={entry:.4f} "
                        f">= VT_UP={_vt_up:.4f} → +{GEX_VOL_TRIGGER_QUALITY_BONUS:.0f}pts"
                    )
                elif direction == "SELL" and _vt_dn and entry <= _vt_dn:
                    quality_score += GEX_VOL_TRIGGER_QUALITY_BONUS
                    self._logger.debug(
                        f"📉 [{symbol}] VOL TRIGGER DN aligned: entry={entry:.4f} "
                        f"<= VT_DN={_vt_dn:.4f} → +{GEX_VOL_TRIGGER_QUALITY_BONUS:.0f}pts"
                    )

                # ── v8.0 Prompt 2: GEX Zero-Crossing hybrid strategy tag ────────
                # Classifies the trade as MEAN_REVERT or TREND_FOLLOW based on
                # the relationship between entry price and gamma zero level, then
                # applies a precision quality bonus.
                #
                # MEAN_REVERT mode — price is within GZ proximity AND the GEX
                #   regime is in a FLIP ZONE (dealer hedging compresses range):
                #   expect reversion back toward gamma zero.  A BUY below GZ or
                #   SELL above GZ exploits this compression → +3 pts precision.
                #
                # TREND_FOLLOW mode — price has just crossed gamma zero (GEX sign
                #   changed) and regime is NOT neutral: dealer hedging NOW
                #   accelerates the move.  Aligning direction with the crossing
                #   captures the institutional momentum spike → +4 pts precision.
                #
                # This is NOT a duplicate of the GZ proximity bonus above —
                # the proximity bonus fires on distance alone; this bonus fires
                # only when directional alignment with the crossing is correct.
                if _gamma_zero and entry:
                    _gz_signed_dist = (entry - _gamma_zero) / entry  # + if above GZ
                    _in_flip   = "FLIP" in regime
                    _gz_close  = abs(_gz_signed_dist) <= GEX_GAMMA_ZERO_PROX_PCT

                    if _in_flip and _gz_close:
                        # Mean-reversion: BUY below GZ or SELL above GZ
                        if (direction == "BUY" and _gz_signed_dist < 0) or \
                           (direction == "SELL" and _gz_signed_dist > 0):
                            quality_score += 3.0
                            self._logger.debug(
                                f"↩️  [{symbol}] GEX MEAN_REVERT: entry{'<' if _gz_signed_dist < 0 else '>'}GZ "
                                f"({_gz_signed_dist:+.3%}) in FLIP ZONE → +3pts"
                            )
                    elif not _gz_close and abs(_gz_signed_dist) <= GEX_GAMMA_ZERO_PROX_PCT * 3:
                        # Trend-follow: price just crossed GZ — enter in crossing direction
                        if (direction == "BUY" and _gz_signed_dist > 0) or \
                           (direction == "SELL" and _gz_signed_dist < 0):
                            quality_score += 4.0
                            self._logger.debug(
                                f"📐 [{symbol}] GEX TREND_FOLLOW: entry crossed GZ "
                                f"({_gz_signed_dist:+.3%}) → momentum spike → +4pts"
                            )

            except Exception as e:
                self._logger.debug(f"Gate 7 GEX error (non-fatal): {e}")
                self._record("gate7", True)
                quality_score += 3.75
        else:
            self._record("gate7", True)
            quality_score += 3.75

        # ── Gate 7b — BS Greeks IV Skew bonus (v11.0) ─────────────────────────
        # Call skew → positive dealer flow → BUY bias (+2pts)
        # Put skew  → tail-risk hedging active → SELL alignment (+2pts)
        _bs_eng = getattr(self, "_bs_greeks_engine", None)
        if _bs_eng is not None:
            try:
                _base_sym = symbol.replace("USDT", "").replace("PERP", "")[:3]
                _skew = _bs_eng.get_skew(_base_sym)
                if _skew is not None and hasattr(_skew, "skew_regime"):
                    _sr = str(_skew.skew_regime).upper()
                    if _sr == "CALL_SKEW" and direction == "BUY":
                        quality_score += 2.0
                    elif _sr == "PUT_SKEW" and direction == "SELL":
                        quality_score += 2.0
                    elif _sr == "PUT_SKEW" and direction == "BUY":
                        quality_score -= 1.5
            except Exception:
                pass

        # ── Gate 8 — Per-symbol win rate ──────────────────────────────────────
        # [v9.7-DYN] Hard block REMOVED — converted to dynamic quality modifier.
        # Old behavior (still available via UNITY_GATE8_HARD=1): hard-veto any
        # symbol with WR<SYMBOL_MIN_WIN_RATE over ≥SYMBOL_MIN_TRADES trades.
        # New default: scale a quality penalty/bonus around the 35% pivot so
        # weak symbols are demoted (not banned) and strong symbols rewarded —
        # lets recovering symbols re-prove themselves instead of being frozen.
        _g8_hard = os.getenv("UNITY_GATE8_HARD", "0").strip().lower() not in ("0", "false", "no", "")
        if _g8_hard and symbol and self._sym_tracker.is_blocked(symbol):
            wr = self._sym_tracker.win_rate(symbol)
            n  = self._sym_tracker.trade_count(symbol)
            self._record("gate8", False)
            return False, (
                f"G8_FAIL: {symbol} win_rate={wr:.0%} < {SYMBOL_MIN_WIN_RATE:.0%} "
                f"({n} trades) — blocked [hard mode]"
            ), 0.0
        self._record("gate8", True)
        if symbol and self._sym_tracker.trade_count(symbol) >= SYMBOL_MIN_TRADES:
            # Dynamic Gate 8: quality delta linearly proportional to how far
            # the rolling WR is from SYMBOL_MIN_WIN_RATE. Penalty floor = -12,
            # bonus ceiling = +5. Symbols with WR≥0.55 get the full +5; symbols
            # at WR=0 get the full -12 (still allowed through, just demoted).
            sym_wr = self._sym_tracker.win_rate(symbol)
            _delta_wr = sym_wr - SYMBOL_MIN_WIN_RATE
            if _delta_wr >= 0:
                # v18.9: raised ceiling +5→+8, slope 25×→30×. High-WR symbols (WR≥65%)
                # now get up to +8 quality credit vs +5 previously. Symbols at break-even
                # WR=38% still get 0 bonus (delta=0); WR=55%→+5.1; WR=65%→+8.1 (capped).
                # This makes the engine preferentially select historically profitable symbols.
                _q_adj = min(8.0, _delta_wr * 30.0)         # v18.9: +0..+8 between WR=0.38 → 0.65
            else:
                # v14.0: extra floor when per-symbol WR<20% (catastrophic track record)
                _g8_floor = -15.0 if sym_wr < 0.20 else -12.0
                _q_adj = max(_g8_floor, _delta_wr * 34.3)   # -0..-12 or -15 by WR severity
            quality_score += _q_adj
            if _q_adj <= -6.0:
                self._logger.debug(
                    f"G8_DYN: {symbol} WR={sym_wr:.0%} → quality {_q_adj:+.1f}pts "
                    f"(n={self._sym_tracker.trade_count(symbol)})"
                )
        elif symbol:
            # Insufficient sample (< SYMBOL_MIN_TRADES) — neutral
            quality_score += 1.5
        else:
            quality_score += 2.5

        # ── v18.62 InsiderTactics Alpha/Avoid/Directional/EV Scoring ────────────
        # Four-layer IT edge integration from 8,660-row InsiderTactics USDM dataset:
        # 1) ALPHA BONUS: high-conviction (WR≥60%) +2.5pts, borderline (WR 50-60%) +1.5pts
        # 2) AVOID PENALTY: symbols with 0-6% WR across ≥5 signals → -3.0pts
        # 3) DIRECTIONAL ALIGNMENT BONUS: +1.5pts when direction matches IT bias (WR≥70%)
        # 4) HIGH-EV BONUS: +1.0pt for symbols with convex payoff (positive EV despite <50% WR)
        if symbol and symbol in ALPHA_SYMBOLS_IT:
            quality_score += ALPHA_SYMBOLS_IT_BONUS
            self._logger.debug(
                f"[G8-AlphaIT v18.61] {symbol} HIGH-CONVICTION → "
                f"+{ALPHA_SYMBOLS_IT_BONUS:.1f}pts (IT WR≥60%, n≥5)"
            )
        elif symbol and symbol in ALPHA_SYMBOLS_IT_BORDERLINE:
            quality_score += ALPHA_SYMBOLS_IT_BORDERLINE_BONUS
            self._logger.debug(
                f"[G8-AlphaIT v18.61] {symbol} BORDERLINE alpha → "
                f"+{ALPHA_SYMBOLS_IT_BORDERLINE_BONUS:.1f}pts (IT WR 50-60%, n≥10)"
            )
        if symbol and symbol in IT_AVOID_SYMBOLS:
            quality_score += IT_AVOID_QUALITY_PENALTY
            self._logger.debug(
                f"[G8-AvoidIT v18.61] {symbol} in IT_AVOID_SYMBOLS → "
                f"{IT_AVOID_QUALITY_PENALTY:.1f}pts (IT WR≤6%, n≥5)"
            )
        # v18.62: IT High-EV bonus — convex payoff even at <50% WR
        if symbol and symbol in IT_HIGH_EV_SYMBOLS and symbol not in ALPHA_SYMBOLS_IT and symbol not in ALPHA_SYMBOLS_IT_BORDERLINE:
            quality_score += IT_HIGH_EV_BONUS
            self._logger.debug(
                f"[G8-EvIT v18.62] {symbol} HIGH-EV → "
                f"+{IT_HIGH_EV_BONUS:.1f}pts (IT positive EV, convex payoff)"
            )
        # v18.66: IT Large-N Positive-EV micro-bonus — n≥40, positive EV below HIGH-EV threshold
        if (symbol and symbol in IT_LARGE_N_POSEV_SYMBOLS
                and symbol not in ALPHA_SYMBOLS_IT
                and symbol not in ALPHA_SYMBOLS_IT_BORDERLINE
                and symbol not in IT_HIGH_EV_SYMBOLS):
            quality_score += IT_LARGE_N_POSEV_BONUS
            self._logger.debug(
                f"[G8-LargeNEV v18.66] {symbol} LARGE-N-POSEV → "
                f"+{IT_LARGE_N_POSEV_BONUS:.1f}pts (IT n≥40, positive EV, below HIGH-EV threshold)"
            )
        # Directional alignment bonus — BUY=LONG edge, SELL=SHORT edge from IT dataset
        if symbol and direction == "BUY" and symbol in IT_DIR_LONG:
            quality_score += IT_DIR_ALIGNMENT_BONUS
            self._logger.debug(
                f"[G8-DirIT v18.61] {symbol} BUY matches IT LONG edge "
                f"({IT_DIR_LONG[symbol]:.0f}% long WR) → +{IT_DIR_ALIGNMENT_BONUS:.1f}pts"
            )
        elif symbol and direction == "SELL" and symbol in IT_DIR_SHORT:
            quality_score += IT_DIR_ALIGNMENT_BONUS
            self._logger.debug(
                f"[G8-DirIT v18.61] {symbol} SELL matches IT SHORT edge "
                f"({IT_DIR_SHORT[symbol]:.0f}% short WR) → +{IT_DIR_ALIGNMENT_BONUS:.1f}pts"
            )

        # ── Gate 8.5 — Dynamic-backtest quality bias (v9.9.1 Apex-#5) ─────────
        # Soft modifier (-8 .. +5) derived from a vectorised proxy backtest
        # of the latest UNITY_DBT_LOOKBACK_BARS of 15m USDM klines.  Provides
        # a synthetic per-symbol prior when Gate 8 has insufficient live trades
        # (the typical case for newly-listed perps & freshly un-blacklisted
        # rescues).  Never hard-vetos.  When the backtester is absent / stale
        # / under-sampled, falls back to MiroFish swarm simulation bias.
        _dbt = getattr(self, "_dyn_backtester", None)
        _dbt_min_trades = int(getattr(self, "_dbt_min_trades", 10))
        _gate85_applied = False
        if symbol and _dbt is not None:
            try:
                _bias = float(_dbt.quality_bias(symbol, max_age_sec=UNITY_DBT_MAX_AGE_SEC))
                # Check if backtest has enough live trade data to be trusted
                _r = _dbt.result(symbol)
                _n_trades = getattr(_r, "n_trades", 0) if _r is not None else 0
                if _n_trades >= _dbt_min_trades:
                    if _bias != 0.0:
                        quality_score += _bias
                        _gate85_applied = True
                        # v18.20: PBO always-log — extract anti-overfitting metrics for
                        # every backtest signal, not only when bias is negative.
                        _pbo_lbl = getattr(_r, "pbo_label", "CLEAN") if _r else "CLEAN"
                        _wfr     = getattr(_r, "walk_forward_ratio", 1.0) if _r else 1.0
                        _dsr     = getattr(_r, "deflated_sharpe", 0.0) if _r else 0.0
                        _pbo_pen = getattr(_r, "pbo_penalty", 0.0) if _r else 0.0
                        # v18.20: PBO CLEAN bonus — genuine transferable edge earns
                        # +1.5pts when walk-forward AND deflated-Sharpe both confirm the
                        # strategy is not in-sample overfitted (WFR≥0.50, PBO<0.55, DSR>0).
                        _pbo_clean_bonus = 0.0
                        if _pbo_lbl == "CLEAN" and _wfr >= 0.55 and _dsr > 0.0:
                            _pbo_clean_bonus = 5.0   # v20.0: 3.5→5.0pts — 4-step institutional validation CLEAN (IS-Excellence + IS-Permutation + Walk-Forward + WF-Permutation all pass); this is 4× more rigorous than old PBO-only CLEAN; WFR≥0.55 on all 4 steps means p<0.05 of chance = genuine non-overfitted edge; +1.5pt increase proportional to the stronger validation standard; at WR=30% a 4-step CLEAN is a high-conviction positive prior for live edge
                            quality_score += _pbo_clean_bonus
                        _pbo_bonus_tag = (
                            f" +PBO_CLEAN={_pbo_clean_bonus:+.1f}pts" if _pbo_clean_bonus else ""
                        )
                        self._logger.debug(
                            f"G8.5_DYN [{symbol}]: bt_WR={getattr(_r,'win_rate',0):.0%} "
                            f"PF={getattr(_r,'profit_factor',0):.2f} EV={getattr(_r,'ev_r',0):+.2f}R "
                            f"n={_n_trades} → bias {_bias:+.1f}pts{_pbo_bonus_tag} "
                            f"[PBO={_pbo_lbl} WFR={_wfr:.2f} DSR={_dsr:.2f} pen={_pbo_pen:+.1f}]"
                            f" [v18.20]"
                        )
            except Exception:
                pass

        # v10.0: MiroFish swarm simulation fallback bias for Gate 8.5
        # When DYN_BACKTEST result has insufficient live trades or is unavailable,
        # use the 10-agent swarm proxy backtest bias as the quality modifier.
        if symbol and not _gate85_applied:
            _msim = getattr(self, "_mirofish_sim", None)
            if _msim is not None:
                try:
                    _sim_bias = float(_msim.get_quality_bias(symbol))
                    if _sim_bias != 0.0:
                        quality_score += _sim_bias
                        self._logger.debug(
                            f"G8.5_MFISH: {symbol} swarm_sim bias → {_sim_bias:+.1f}pts"
                        )
                except Exception:
                    pass

        # ── Gate 8.5b — Factor IC/IR quality bias (v11.0 / v18.31 live-feed) ───
        # Applies Factor IC/IR directional alpha signal as a soft quality bias.
        # Strong factor (IC>0.05, IR>0.30) aligned with trade direction → +3.
        # Weak or opposing factor → -2 pts.  Missing data → no-op.
        # v18.31 FIX: update_symbol() is now called every evaluation so the
        # analyzer's _factor_buffer accumulates real data.  Previously it was
        # never called → _snapshots empty → _report None → bias always 0.0.
        _fac_ana = getattr(self, "_factor_analyzer", None)
        if symbol and _fac_ana is not None:
            try:
                # Feed live factor values — O(1), just writes to a dict.
                _fac_price = float(entry or 0.0)
                _fac_ofi_z = 0.0
                if self._timing_state is not None:
                    _fac_ofi_z = float(
                        self._timing_state.ofi_zscore(symbol) or 0.0
                    )
                # gex_snapshot may have different attribute names across versions
                _fac_gex = float(
                    getattr(gex_snapshot, "net_gex",   None) or
                    getattr(gex_snapshot, "net_gamma",  None) or
                    getattr(gex_snapshot, "gex_net",    None) or 0.0
                )
                _fac_ana.update_symbol(
                    symbol,
                    price   = _fac_price,
                    ofi_z   = _fac_ofi_z,
                    gex_net = _fac_gex,
                    nn_prob = float(nn_prob),
                )
            except Exception:
                pass
            try:
                _fac_bias = _fac_ana.get_quality_bias(symbol)
                if _fac_bias != 0.0:
                    quality_score += _fac_bias
                    self._logger.debug(
                        f"G8.5b_FACTOR: {symbol} factor bias → {_fac_bias:+.1f}pts"
                    )
            except Exception:
                pass

        # ── Gate 8.5c — Portfolio Optimizer Kelly adjustment (v11.0) ──────────
        # Portfolio optimizer provides per-symbol allocation weight [0..1].
        # High allocation (>0.15) → modest quality boost; over-weight > 0.25 → skip.
        _port_opt = getattr(self, "_portfolio_optimizer", None)
        if symbol and _port_opt is not None:
            try:
                _sym_weight = _port_opt.get_weight(symbol)
                if _sym_weight is not None:
                    if _sym_weight > 0.25:
                        quality_score += 3.0
                    elif _sym_weight > 0.12:
                        quality_score += 1.5
                    elif _sym_weight < 0.02:
                        quality_score -= 1.0
            except Exception:
                pass

        # ── Gate 8.5d — Microstructure Regime Quality Bias (v18.13) ──────────
        # Combines live OFI Z-score, CUSUM regime-shift, and order-book spread
        # to classify the symbol's current microstructure state and apply a
        # directional quality modifier before the Bayesian WP penalty.
        #
        # Scoring matrix:
        #   MOMENTUM_ALIGNED  (|OFI_Z|≥1.5, CUSUM active, direction aligned,
        #                       spread ≤ 0.15%) → +3pts   — flow agrees with trade
        #   MOMENTUM_OPPOSED  (|OFI_Z|≥1.5, direction opposed)             → -2pts
        #   ADVERSE_SPREAD    (spread > 0.30% — wide bid-ask, thin book)   → -3pts
        #   SPREAD_ELEVATED   (spread 0.15–0.30%)                          → -1pt
        #
        # Only fires when timing_state buffer has ≥20 OFI samples (cold-start safe).
        if symbol and self._timing_state is not None:
            try:
                _ofi_z   = float(self._timing_state.ofi_zscore(symbol) or 0.0)
                _cusum_a = self._timing_state.cusum_event_active(symbol)
                _sig_dir = str(signal_data.get("direction") or signal_data.get("action") or "").upper()
                _ws_ob   = (self._ws_state_ref or {}).get(symbol.upper(), {})
                _spread  = float(_ws_ob.get("spread_pct", 0.0) or 0.0)   # fraction: 0.001 = 0.10%

                # Only fire when OFI history is warm (avoids noise on cold-start)
                _ofi_hist = self._timing_state._ofi_history.get(symbol.upper(), [])
                if len(_ofi_hist) >= 20:
                    # Momentum alignment (+3 / -2)
                    if abs(_ofi_z) >= 1.5 and _cusum_a:
                        _long_aligned  = _ofi_z > 0 and "BUY"  in _sig_dir
                        _short_aligned = _ofi_z < 0 and "SELL" in _sig_dir
                        if _long_aligned or _short_aligned:
                            if _spread <= 0.0015:   # ≤0.15% spread
                                quality_score += 3.0
                                self._logger.debug(
                                    f"[G8.5d v18.13] MOMENTUM_ALIGNED: {symbol} "
                                    f"OFI_Z={_ofi_z:+.2f} spread={_spread:.4f} "
                                    f"dir={_sig_dir} → +3.0pts"
                                )
                        else:
                            quality_score -= 2.0
                            self._logger.debug(
                                f"[G8.5d v18.13] MOMENTUM_OPPOSED: {symbol} "
                                f"OFI_Z={_ofi_z:+.2f} dir={_sig_dir} → -2.0pts"
                            )
                    # Spread penalty (adversarial market-making)
                    if _spread > 0.0030:     # > 0.30%
                        quality_score -= 3.0
                        self._logger.debug(
                            f"[G8.5d v18.13] ADVERSE_SPREAD: {symbol} "
                            f"spread={_spread:.4f}>0.30% → -3.0pts"
                        )
                    elif _spread > 0.0015:   # 0.15–0.30%
                        quality_score -= 1.0
            except Exception:
                pass

        # ── Gate 8.5e — HMM Regime Quality Adjustment (v18.75) ───────────────
        # Hidden Markov Model regime detection feeds a quality bonus/penalty
        # based on market regime classification (EXPANSION / TRANSITION / CONTRACTION).
        # v18.75: EXPANSION (P≥0.70): +8pts quality (was +6pts; MacroGlide directive)
        # v18.75: CONTRACTION (P≥0.70): -10pts quality (was -8pts; harder risk filter)
        # Kelly Step 21 (booster._hmm_regime_ref) compounds: EXPANSION ×1.25 Kelly.
        # v19.2: EXPANSION P≥0.75+SR≥0 → ×1.25 | CONTRACTION P≥0.65 → ×0.60
        # Only fires when HMM has ≥30 observations (cold-start safe).
        _hmm_ref = getattr(self, "_hmm_regime", None)
        if symbol and _hmm_ref is not None and _hmm_ref.is_ready:
            try:
                _hmm_regime_str, _hmm_p_exp, _hmm_quality_adj = _hmm_ref.get_regime()
                if _hmm_quality_adj != 0.0:
                    quality_score += _hmm_quality_adj
                    self._logger.debug(
                        f"[G8.5e HMM v18.72] {symbol} regime={_hmm_regime_str} "
                        f"P(exp)={_hmm_p_exp:.2f} → {_hmm_quality_adj:+.1f}pts"
                    )
                # v18.85: TRANSITION regime — no bonus, apply small penalty when uncertain.
                # TRANSITION with P(exp)≥0.30 previously gave +2pts partial credit —
                # but TRANSITION means the HMM is UNCERTAIN between regimes; awarding
                # expansion credit for uncertain states was inflating quality scores.
                # v18.85: TRANSITION now applies -2pts uncertainty penalty to filter
                # out signal noise during regime crossroads (empirically ~15% lower WR
                # in TRANSITION vs confirmed regimes). EXPANSION only awards bonus at P≥0.75.
                if _hmm_regime_str == "TRANSITION":
                    _hmm_sr_now = float(getattr(self, "sharpe_ratio", 0.0) or 0.0)
                    if _hmm_sr_now < -4.0:
                        # v20.2: Crisis tightening — Sharpe<-4 + TRANSITION = ruin-regime
                        # uncertainty compounding. -4pts (was -3pts) forces TRANSITION signals
                        # to need 4pts more quality from other quant layers to survive the
                        # crisis filter. At Sharpe=-6, regime uncertainty is unacceptable.
                        _hmm_trans_penalty = -4.0
                    else:
                        _hmm_trans_penalty = -3.0  # v18.87: -2→-3pts — console shows HMM:TRAN(33%) so 1/3 of symbols are in TRANSITION; -2pts was insufficient to filter regime-uncertain signals given new G9 floor=64 at WR<35%; -3pts forces TRANSITION signals to need 3pts more quality elsewhere (Kalman/CSM/Dispersion/PCA) to compensate; aligned with v18.85 direction that TRANSITION = penalty, not neutral
                    quality_score += _hmm_trans_penalty
                    self._logger.debug(
                        f"[G8.5e HMM v20.2] {symbol} TRANSITION P(exp)={_hmm_p_exp:.2f}"
                        f" Sharpe={_hmm_sr_now:.2f} → {_hmm_trans_penalty:.1f}pts regime-uncertainty penalty"
                    )
                # v18.98: HMM directional confirmation — second-order signal beyond
                # the regime quality adjustment already in _hmm_quality_adj.
                # EXPANSION regime has HMM-confirmed upward momentum: BUYs are
                # trend-aligned (+2.5pts), SELLs fight the regime (-3.0pts).
                # CONTRACTION is inverse.  Does NOT fire for TRANSITION (already penalized).
                # The combination of regime quality adj (G8.5e primary) + directional
                # alignment (here) creates up to +4.5pts for aligned signals and -5.0pts
                # for contra-regime signals — a strong but not veto-level filter.
                elif _hmm_regime_str in ("EXPANSION", "CONTRACTION"):
                    _hmm_dir = str(direction or "").upper()
                    if ((_hmm_regime_str == "EXPANSION"   and _hmm_dir == "BUY") or
                            (_hmm_regime_str == "CONTRACTION" and _hmm_dir == "SELL")):
                        quality_score += 2.5
                        self._logger.debug(
                            f"[G8.5e HMM-DIR v18.98] {symbol} {_hmm_regime_str}+{_hmm_dir} "
                            f"aligned → +2.5pts direction-confirmation"
                        )
                    elif ((_hmm_regime_str == "EXPANSION"   and _hmm_dir == "SELL") or
                              (_hmm_regime_str == "CONTRACTION" and _hmm_dir == "BUY")):
                        quality_score -= 4.0   # v22.0: 3.0→4.0 — stronger contra-regime filter
                        self._logger.debug(
                            f"[G8.5e HMM-DIR v22.0] {symbol} {_hmm_regime_str}+{_hmm_dir} "
                            f"contra-regime → -4.0pts direction-misalignment [v22.0: 3→4]"
                        )
            except Exception:
                pass

        # ── Gate 8.5j — HMM Regime-Flip Cooldown (v18.93) ───────────────────
        # When HMM transitions between regimes (EXPANSION↔CONTRACTION or any
        # state ↔ TRANSITION), the first 15 minutes carry elevated false-signal
        # risk — the model is extrapolating from limited posterior evidence
        # on a freshly-updated emission distribution.
        # Apply a linearly-decaying quality penalty of -4pts at the flip moment,
        # fading to 0 over 900 seconds:
        #   penalty = -4.0 × (900 − flip_age_sec) / 900
        # Example: flip 5 min ago → -4.0 × 600/900 = -2.67pts.
        # This does NOT veto signals — it creates headroom so only high-conviction
        # signals clear the quality gate during the regime uncertainty window.
        # Complements G8.5e (TRANSITION penalty) by also penalising confirmed-regime
        # signals that arose immediately after a flip (momentum chasers).
        try:
            _hmm_flip_ref = getattr(self, "_hmm_regime", None)
            if _hmm_flip_ref is not None and _hmm_flip_ref.is_ready:
                _flip_secs = _hmm_flip_ref.regime_flip_seconds_ago()
                if _flip_secs < 900:
                    _flip_penalty = -4.0 * (900.0 - _flip_secs) / 900.0
                    quality_score += _flip_penalty
                    self._logger.debug(
                        f"[G8.5L HMM-FLIP v18.94] {symbol} regime flipped {_flip_secs:.0f}s ago "
                        f"→ {_flip_penalty:+.2f}pts cooldown penalty (fades at 900s) [v18.94]"
                    )
        except Exception:
            pass

        # ── Gate 8.5f — VPIN Order-Flow Toxicity (v18.75) ────────────────────
        # Volume-synchronized Probability of Informed Trading (VPIN).
        # "Reduce exposure or fade momentum once order-flow imbalance enters
        #  historically unstable percentile ranges above 90%." — MacroGlide VPIN strategy
        # v18.75: Tiered penalty — 3 escalating tiers based on toxicity severity:
        #   pct > 0.90: -6pts  (base — toxic, from vpin_model.get_signal)
        #   pct > 0.95: -15pts (severe toxicity — pre-crash / informed-trading signal)
        #   pct > 0.97: -18pts (extreme toxicity — near-veto, flash-crash precursor)
        # Only fires when ≥50 volume buckets accumulated (cold-start safe).
        _vpin_ref = getattr(self, "_vpin_model", None)
        if symbol and _vpin_ref is not None and _vpin_ref.is_ready:
            try:
                _vpin_val, _vpin_pct, _vpin_quality_adj, _vpin_toxic = _vpin_ref.get_signal()
                # v18.75: Escalating VPIN toxicity tiers above 95th percentile
                if _vpin_pct >= 0.97:
                    _vpin_quality_adj -= 12.0   # extreme toxicity: total ≈ -18pts
                    self._logger.debug(
                        f"[G8.5f VPIN v18.75] {symbol} EXTREME pct={_vpin_pct:.3f}≥0.97 → extra -12pts"
                    )
                elif _vpin_pct >= 0.95:
                    _vpin_quality_adj -= 9.0    # severe toxicity: total ≈ -15pts
                    self._logger.debug(
                        f"[G8.5f VPIN v18.75] {symbol} SEVERE pct={_vpin_pct:.3f}≥0.95 → extra -9pts"
                    )
                if _vpin_quality_adj != 0.0:
                    quality_score += _vpin_quality_adj
                    self._logger.debug(
                        f"[G8.5f VPIN v18.75] {symbol} VPIN={_vpin_val:.3f} "
                        f"pct={_vpin_pct:.2f} toxic={_vpin_toxic} → {_vpin_quality_adj:+.1f}pts"
                    )
                # v18.87: VPIN clean order-flow bonus — asymmetry fix.
                # VPIN previously only penalised high toxicity (>90th pct = -6pts to -18pts)
                # but awarded zero quality credit when order flow was genuinely CLEAN.
                # MacroGlide VPIN strategy: "Reduce exposure above 90th pct"; by symmetry
                # clean flow (<20th pct) signals non-toxic microstructure = more reliable momentum.
                # +2pts for confirmed clean order flow (pct < 20th percentile, non-toxic).
                # Guard: not_toxic flag must be clear (get_signal sets toxic=True at >90th pct).
                if _vpin_pct < 0.20 and not _vpin_toxic:
                    _vpin_clean_bonus = 2.0
                    quality_score += _vpin_clean_bonus
                    self._logger.debug(
                        f"[G8.5f VPIN v18.87] {symbol} CLEAN-FLOW pct={_vpin_pct:.3f}<0.20 "
                        f"→ +{_vpin_clean_bonus:.0f}pts microstructure bonus [v18.87]"
                    )
            except Exception:
                pass

        # ── Gate 8.5g — Kalman Pairs Trading Signal (v18.72) ─────────────────
        # Kalman Filter hedge-ratio estimator for co-integrated crypto pairs.
        # Z-score ≥ 2.5 with direction match → +5pts quality, 1.10× Kelly.
        # Z-score in exhaustion zone (≥3.5) → -3pts (spread over-extension).
        _kf_ref = getattr(self, "_kalman_pairs", None)
        if symbol and direction and _kf_ref is not None and _kf_ref.is_ready:
            try:
                _kf_quality_adj, _kf_kelly, _kf_active = _kf_ref.get_signal_for(symbol, direction)
                if _kf_active and _kf_quality_adj != 0.0:
                    quality_score += _kf_quality_adj
                    self._logger.debug(
                        f"[G8.5g Kalman v18.72] {symbol} pairs quality {_kf_quality_adj:+.1f}pts"
                    )
            except Exception:
                pass

        # ── Gate 8.5h — Dispersion Volatility Regime (v18.72) ────────────────
        # Cross-asset realized correlation tracker.
        # Low correlation (<0.25) + vol above 30-bar avg → DISPERSION +4pts
        # Correlation spike (>0.85) → SYSTEMIC_RISK -5pts
        _disp_ref = getattr(self, "_dispersion_vol", None)
        if symbol and _disp_ref is not None:
            try:
                _disp_regime, _disp_quality_adj, _disp_avg_corr = _disp_ref.get_signal(symbol)
                if _disp_quality_adj != 0.0:
                    quality_score += _disp_quality_adj
                    self._logger.debug(
                        f"[G8.5h Dispersion v18.72] {symbol} regime={_disp_regime} "
                        f"avg_corr={_disp_avg_corr:.3f} → {_disp_quality_adj:+.1f}pts"
                    )
            except Exception:
                pass

        # ── Gate 8.5i — PCA Factor Neutral Signal (v18.72) ───────────────────
        # Principal Component Analysis factor-neutral residual ranking.
        # Top residual quartile (LONG) or bottom (SHORT) → +4pts quality.
        # Factor-dominated signal (loading > 0.90) → -3pts.
        _pca_ref = getattr(self, "_pca_factor", None)
        if symbol and direction and _pca_ref is not None and _pca_ref.is_ready:
            try:
                _pca_quality_adj, _pca_z, _pca_active = _pca_ref.get_signal(symbol, direction)
                if _pca_active and _pca_quality_adj != 0.0:
                    quality_score += _pca_quality_adj
                    self._logger.debug(
                        f"[G8.5i PCA v18.72] {symbol} residual_z={_pca_z:.2f} "
                        f"→ {_pca_quality_adj:+.1f}pts"
                    )
            except Exception:
                pass

        # ── Gate 8.5j — Cross-Section Mean Reversion (v18.72) ────────────────
        # Beta-adjusted cross-sectional abnormal return Z-score.
        # Symbol at ±2σ extreme (weakest/strongest 3%) → +5pts quality.
        # Symbol in middle zone (|z|<1.0) → -2pts (no cross-sectional edge).
        _csm_ref = getattr(self, "_csm_engine", None)
        if symbol and direction and _csm_ref is not None and _csm_ref.is_ready:
            try:
                _csm_quality_adj, _csm_z, _csm_active = _csm_ref.get_signal(symbol, direction)
                if _csm_active and _csm_quality_adj != 0.0:
                    quality_score += _csm_quality_adj
                    self._logger.debug(
                        f"[G8.5j CSM v18.72] {symbol} z={_csm_z:.2f} "
                        f"→ {_csm_quality_adj:+.1f}pts"
                    )
            except Exception:
                pass

        # ── Gate 8.5k — IV Crush / IV Rank Monitor (v18.72) ──────────────────
        # Parkinson-vol IV Rank + perpetual funding rate monitor.
        # High IV Rank (>80%) + elevated funding → -4pts (premium collapse risk).
        # Extreme funding (>0.10%) → -6pts systemic squeeze.
        # Low IV Rank (<20%) + flat funding → +3pts (vol expansion potential).
        _iv_ref = getattr(self, "_iv_crush_monitor", None)
        if symbol and _iv_ref is not None:
            try:
                _iv_regime, _iv_quality_adj, _iv_kelly = _iv_ref.get_signal(symbol)
                if _iv_quality_adj != 0.0:
                    quality_score += _iv_quality_adj
                    self._logger.debug(
                        f"[G8.5k IVCrush v18.72] {symbol} regime={_iv_regime} "
                        f"→ {_iv_quality_adj:+.1f}pts"
                    )
            except Exception:
                pass

        # ── Gate 8.5sq — StochasticQuant OU/Heston/Kalman/Jump (v19.0) ──────
        # Institutional stochastic-calculus quality gate using the live-calibrated
        # StochasticQuantEngine (OU, Heston, Merton, Kalman).  Reads from the
        # 5-minute TTL cache populated by the bot scanner's async calibration call.
        #
        #   OU REVERTING regime (half-life ≤ 8 bars):
        #     Signal aligned with OU reversion → +3.5pts (mean-reversion edge confirmed)
        #     Signal fighting OU reversion      → -4.0pts (adverse selection risk)
        #   OU TRENDING regime (half-life > 20 bars):
        #     Kalman velocity direction aligned → +2.0pts (momentum continuation)
        #     Kalman velocity opposed           → -1.5pts (contra-trend entry)
        #   Heston vol regime (current_vol vs long-run theta):
        #     CRISIS  (v0 > 3×theta)   → -3.5pts (extreme vol = noisy microstructure)
        #     HIGH_VOL (v0 1.5–3×theta) → -1.5pts (elevated uncertainty)
        #     LOW_VOL  (v0 < 0.5×theta) → +2.0pts (calm vol = cleaner signals)
        #   Merton jump-diffusion daily probability:
        #     jump_prob_1d > 8% → -2.5pts (high gap risk, stop-loss violation likely)
        #     jump_prob_1d > 5% → -1.0pts (moderate gap risk)
        #   Net adjustment capped ±6.0pts to prevent stochastic gate dominating.
        #   Gate skips silently when cache not yet warm (cold-start safe).
        _sq_ref = getattr(self, "_stochastic_quant", None)
        if symbol and _sq_ref is not None:
            try:
                _sq_sig = _sq_ref.get_cached_signal(symbol)
                if _sq_sig is not None:
                    _sq_adj  = 0.0
                    _sq_dir  = str(direction or "").upper()
                    _is_long_sq = _sq_dir in ("BUY", "LONG")

                    # ── OU mean-reversion / Kalman trend alignment ──────────
                    _ou_z   = float(_sq_sig.ou_zscore)
                    _ou_reg = str(_sq_sig.ou_regime)
                    if _ou_reg == "REVERTING" and abs(_ou_z) >= 1.2:
                        # Mean-reversion: BUY when price below OU equilibrium (z<0)
                        #                 SELL when price above OU equilibrium (z>0)
                        _ou_aligned = (_ou_z < -1.2 and _is_long_sq) or \
                                      (_ou_z > +1.2 and not _is_long_sq)
                        if _ou_aligned:
                            _ou_pts = min(3.5, 1.5 + abs(_ou_z) * 0.5)
                            _sq_adj += _ou_pts
                            self._logger.debug(
                                f"[G8.5sq OU v19.0] {symbol} REVERTING "
                                f"z={_ou_z:+.2f} aligned → +{_ou_pts:.1f}pts"
                            )
                        else:
                            _sq_adj -= 4.0
                            self._logger.debug(
                                f"[G8.5sq OU v19.0] {symbol} REVERTING "
                                f"z={_ou_z:+.2f} opposed → -4.0pts anti-reversion"
                            )
                    elif _ou_reg == "TRENDING":
                        _kal_t = float(_sq_sig.kalman_trend)
                        if abs(_kal_t) > 1e-5:
                            _kal_aligned = (_kal_t > 0 and _is_long_sq) or \
                                           (_kal_t < 0 and not _is_long_sq)
                            if _kal_aligned:
                                _sq_adj += 2.0
                                self._logger.debug(
                                    f"[G8.5sq Kalman v19.0] {symbol} TRENDING "
                                    f"vel={_kal_t:+.5f} aligned → +2.0pts"
                                )
                            else:
                                _sq_adj -= 1.5
                                self._logger.debug(
                                    f"[G8.5sq Kalman v19.0] {symbol} TRENDING "
                                    f"vel={_kal_t:+.5f} opposed → -1.5pts"
                                )

                    # ── Heston stochastic vol regime ────────────────────────
                    _h_reg = str(_sq_sig.heston_regime)
                    _h_adj = 0.0
                    if   _h_reg == "CRISIS":   _h_adj = -3.5
                    elif _h_reg == "HIGH_VOL": _h_adj = -1.5
                    elif _h_reg == "LOW_VOL":  _h_adj = +2.0
                    if _h_adj != 0.0:
                        _sq_adj += _h_adj
                        self._logger.debug(
                            f"[G8.5sq Heston v19.0] {symbol} "
                            f"vol_regime={_h_reg} "
                            f"heston_vol={_sq_sig.heston_vol:.4f} → {_h_adj:+.1f}pts"
                        )

                    # ── Merton jump-diffusion gap risk ──────────────────────
                    _jp = float(_sq_sig.jump_prob_1d)
                    if _jp > 0.08:
                        _sq_adj -= 2.5
                        self._logger.debug(
                            f"[G8.5sq Jump v19.0] {symbol} "
                            f"jump_prob={_jp:.3f}>8% → -2.5pts gap risk"
                        )
                    elif _jp > 0.05:
                        _sq_adj -= 1.0
                        self._logger.debug(
                            f"[G8.5sq Jump v19.0] {symbol} "
                            f"jump_prob={_jp:.3f}>5% → -1.0pts gap risk"
                        )

                    # ── Cap ±6pts and apply ─────────────────────────────────
                    _sq_adj = max(-6.0, min(6.0, _sq_adj))
                    if _sq_adj != 0.0:
                        quality_score += _sq_adj
                        self._logger.info(
                            f"[G8.5sq StochQuant v19.0] {symbol} "
                            f"OU={_ou_reg}(z={_ou_z:+.2f}) "
                            f"Heston={_h_reg} Jump={_jp:.3f} "
                            f"→ net {_sq_adj:+.1f}pts (capped ±6)"
                        )
            except Exception:
                pass

        # ── Gate 8.5q — QuantDinger Momentum-Volume Coherence (v21.2) ───────
        # Inspired by QuantDinger/TauricResearch momentum quality framework:
        # identifies setups where price momentum and volume are COHERENT (bonus)
        # vs divergent (penalty). A price move without volume confirmation has
        # statistically lower follow-through — this gate eliminates false breakouts.
        # Also integrates ValueCell-inspired signal quality: RSI extreme alignment
        # ensures we are entering WITH momentum, not fading a liquid trend.
        #
        # Scoring logic:
        #   vol_ratio ≥ 1.3 + RSI aligned (BUY≥55 | SELL≤45):  +2.5pts (confirmed trend)
        #   vol_ratio ≥ 1.3 + RSI neutral (45-55):              +1.0pts (volume support only)
        #   vol_ratio 0.7–1.3 + RSI aligned:                    +0.5pts (mild confirmation)
        #   vol_ratio ≤ 0.7 + RSI aligned:                      −1.5pts (momentum without vol)
        #   vol_ratio ≤ 0.7 + RSI counter-directional:          −2.5pts (false breakout risk)
        #   RSI counter-directional (any vol):                   −1.5pts (fighting momentum)
        # Cap: ±3pts. Fires only when vol_ratio > 0.05 (data present check).
        try:
            _q_data      = signal_data if isinstance(signal_data, dict) else {}
            _q_vol_ratio = float(_q_data.get("volume_ratio",   _q_data.get("vol_ratio",  0.0)) or 0.0)
            _q_rsi       = float(_q_data.get("rsi",            _q_data.get("rsi_14",    50.0)) or 50.0)
            _q_direction = (direction or "").upper()
            _q_adj       = 0.0
            if _q_vol_ratio > 0.05 and _q_direction in ("BUY", "LONG", "SELL", "SHORT"):
                _vol_exp   = _q_vol_ratio >= 1.3   # above-average volume expansion
                _vol_col   = _q_vol_ratio <= 0.7   # volume contraction / weak participation
                _long_dir  = _q_direction in ("BUY", "LONG")
                # RSI aligned with direction: confirms momentum is with the trade
                _rsi_align = (
                    (_long_dir  and _q_rsi >= 55.0) or
                    (not _long_dir and _q_rsi <= 45.0)
                )
                # RSI counter-directional: fighting the current momentum regime
                _rsi_contra = (
                    (_long_dir  and _q_rsi <= 42.0) or
                    (not _long_dir and _q_rsi >= 58.0)
                )
                if _vol_exp and _rsi_align:
                    _q_adj = 2.5    # full confirmation: volume + RSI aligned
                elif _vol_exp and not _rsi_contra:
                    _q_adj = 1.0    # volume support, RSI neutral
                elif not _vol_exp and not _vol_col and _rsi_align:
                    _q_adj = 0.5    # mild RSI confirmation, normal volume
                elif _vol_col and _rsi_align:
                    _q_adj = -1.5   # momentum without volume: divergence warning
                elif _rsi_contra and _vol_exp:
                    _q_adj = -1.5   # fighting momentum despite volume
                elif _vol_col and _rsi_contra:
                    _q_adj = -2.5   # full divergence: false breakout high-risk
                elif _rsi_contra:
                    _q_adj = -1.5   # counter-momentum entry
                _q_adj = max(-3.0, min(3.0, _q_adj))
                if _q_adj != 0.0:
                    quality_score += _q_adj
                    self._logger.debug(
                        f"[G8.5q QuantDinger v21.2] {symbol} "
                        f"vol={_q_vol_ratio:.2f} rsi={_q_rsi:.1f} dir={_q_direction} "
                        f"vol_exp={_vol_exp} rsi_align={_rsi_align} → {_q_adj:+.1f}pts"
                    )
        except Exception:
            pass

        # ── Gate 8.5r — FinRobot/ValueCell Funding Rate Alignment (v21.3) ─────
        # Inspired by AI4Finance-Foundation/FinRobot funding regime intelligence
        # and ValueCell-ai/valuecell carry-cost analysis. In crypto perpetual
        # futures, the 8-hourly funding rate is the market's real-time crowding vote:
        #   Positive funding → longs pay shorts → LONGS are crowded (overweight)
        #     → SELL/SHORT: squeeze fuel bonus | BUY/LONG: reversal risk penalty
        #   Negative funding → shorts pay longs → SHORTS are crowded (overweight)
        #     → BUY/LONG: short-squeeze fuel bonus | SELL/SHORT: squeeze risk penalty
        # Also models KylinMountain/TradingAgents-AShare contrarian positioning:
        # extreme one-sided positioning is the best contrarian setup indicator.
        # Thresholds: elevated ≥ 0.02%/8h (2bps), extreme ≥ 0.05%/8h (5bps).
        # Data source: live 1s WS mark-price stream (L0.75) → _live_funding_rates.
        # Cap: ±2pts. Skips cleanly if funding data unavailable (vol_ratio guard).
        try:
            _fr_sym  = (symbol or "").upper()
            _fr_rate = float(
                _live_funding_rates.get(_fr_sym, 0.0)
                or (signal_data if isinstance(signal_data, dict) else {}).get("funding_rate", 0.0)
                or 0.0
            )
            _fr_dir  = (direction or "").upper()
            _fr_adj  = 0.0
            if abs(_fr_rate) > 0.00005 and _fr_dir in ("BUY", "LONG", "SELL", "SHORT"):
                _fr_long     = _fr_dir in ("BUY", "LONG")
                _fr_extreme  = abs(_fr_rate) >= 0.0005  # ≥0.05%/8h — strong crowding signal
                _fr_elevated = abs(_fr_rate) >= 0.0002  # ≥0.02%/8h — notable crowding
                _fr_pos      = _fr_rate > 0.0           # positive → longs crowded → SELL benefits
                _fr_super   = abs(_fr_rate) >= 0.0010  # ≥0.10%/8h — super-extreme crowding [v31.0]
                if _fr_super:
                    # Super-extreme crowding [v31.0]: massive forced-liquidation squeeze setup (±3pts)
                    if _fr_pos and not _fr_long:
                        _fr_adj = 3.0    # super-extreme positive + SELL: trapped longs cascade liquidation
                    elif _fr_pos and _fr_long:
                        _fr_adj = -3.0   # super-extreme positive + BUY: extreme crowding, strong reversal risk
                    elif not _fr_pos and _fr_long:
                        _fr_adj = 3.0    # super-extreme negative + BUY: trapped shorts forced to cover
                    else:
                        _fr_adj = -3.0   # super-extreme negative + SELL: extreme short crowd, squeeze risk
                    self._logger.debug(
                        f"[G8.5r-SuperExtreme v31.0] {symbol} "
                        f"fr={_fr_rate*10000:.2f}bps/8h super-extreme → {_fr_adj:+.1f}pts [v31.0]"
                    )
                elif _fr_extreme:
                    # Extreme crowding: strong contrarian setup (±2pts full)
                    if _fr_pos and not _fr_long:
                        _fr_adj = 2.0    # extreme positive + SELL: longs trapped → squeeze fuel
                    elif _fr_pos and _fr_long:
                        _fr_adj = -2.0   # extreme positive + BUY: crowded longs, reversal risk
                    elif not _fr_pos and _fr_long:
                        _fr_adj = 2.0    # extreme negative + BUY: shorts trapped → squeeze fuel
                    else:
                        _fr_adj = -2.0   # extreme negative + SELL: crowded shorts, squeeze risk
                elif _fr_elevated:
                    # Elevated crowding: moderate contrarian setup (±1pt)
                    if _fr_pos and not _fr_long:
                        _fr_adj = 1.0
                    elif _fr_pos and _fr_long:
                        _fr_adj = -1.0
                    elif not _fr_pos and _fr_long:
                        _fr_adj = 1.0
                    else:
                        _fr_adj = -1.0
                _fr_adj = max(-2.0, min(2.0, _fr_adj))
                if _fr_adj != 0.0:
                    quality_score += _fr_adj
                    self._logger.debug(
                        f"[G8.5r FundingRate v21.3] {symbol} "
                        f"fr={_fr_rate*10000:.2f}bps/8h dir={_fr_dir} "
                        f"extreme={_fr_extreme} elevated={_fr_elevated} "
                        f"→ {_fr_adj:+.1f}pts"
                    )
        except Exception:
            pass

        # v58.0/v68.0: Pre-initialize soft-gate adj/fired sentinels so G8.5U consensus
        # meta-gate can safely read them regardless of exception paths in each gate.
        # v68.0: Added G8.5Z + G8.5Y sentinels; G8.5U moved to AFTER G8.5Y so the
        # 5-gate consensus reads live values — NOT cold sentinels — for all 5 gates.
        _g85w_fired = False; _g85w_adj = 0.0
        _g85x_fired = False; _g85x_adj = 0.0
        _g85t_fired = False; _g85t_adj = 0.0
        _g85z_fired = False; _g85z_adj = 0.0   # v68.0: G8.5Z AutoCorr sentinel
        _g85y_fired = False; _g85y_adj = 0.0   # v68.0: G8.5Y ATR-VolCompress sentinel

        # ── Gate 8.5w — Multi-Timeframe Momentum Alignment (v49.0) ─────────
        # TauricResearch/TradingAgents multi-timeframe analysis concept: checks if
        # recent price momentum over two distinct windows (short 1-2 bars, medium
        # 3-8 bars) aligns with signal direction. A signal fired WITH the prevailing
        # short+medium momentum has statistically higher follow-through than a signal
        # entering against a sustained trend. Both windows opposing = counter-trend
        # entry with elevated risk; both aligning = momentum-confirmed setup.
        #
        # Uses `price_returns` from signal_data OR falls back to _quant_layer_close_buf
        # (per-symbol rolling close buffer populated by _feed_quant_layers_kline() on
        # every kline tick — always available for scanned symbols). This guarantees the
        # gate fires even when signal_data doesn't carry the price_returns field.
        # Scoring logic:
        #   short + medium both aligned:  +2.0pts  (confirmed MTF momentum)
        #   short or medium one aligned:  +0.8pts  (partial confirmation)
        #   short opposes only:          −1.0pts   (near-term headwind)
        #   medium opposes only:         −0.8pts   (medium-term headwind)
        #   short + medium both oppose:  −2.5pts   (strong counter-trend entry)
        # Cap: ±2.5pts. Fires whenever ≥4 price return bars are available.
        try:
            _g85w_data = signal_data if isinstance(signal_data, dict) else {}
            _g85w_dir  = (direction or "").upper()
            _g85w_adj   = 0.0
            _g85w_fired = False   # v53.0: moved outside direction guard — _record() fires even if dir invalid/missing
            if _g85w_dir in ("BUY", "LONG", "SELL", "SHORT"):
                _g85w_long = _g85w_dir in ("BUY", "LONG")
                _g85w_rets = _g85w_data.get("price_returns", [])
                # ── Fallback: derive returns from rolling close buffer [v50.0] ───
                # _quant_layer_close_buf is written on every kline tick for all 76
                # scanned symbols, so it is always fresh when the gate runs.
                if not (isinstance(_g85w_rets, (list, tuple)) and len(_g85w_rets) >= 4):
                    _g85w_buf = _quant_layer_close_buf.get(symbol, [])
                    if len(_g85w_buf) >= 5:
                        _g85w_cls = list(_g85w_buf)[-9:]  # last 9 closes → 8 returns
                        _g85w_rets = [
                            (_g85w_cls[i + 1] - _g85w_cls[i]) / _g85w_cls[i]
                            for i in range(len(_g85w_cls) - 1)
                            if _g85w_cls[i] > 0
                        ]
                if isinstance(_g85w_rets, (list, tuple)) and len(_g85w_rets) >= 4:
                    _g85w_fired = True
                    _g85w_short = (float(_g85w_rets[0]) + float(_g85w_rets[1])) / 2.0
                    _g85w_slice = _g85w_rets[2:8]
                    _g85w_med   = sum(float(r) for r in _g85w_slice) / max(1, len(_g85w_slice))
                    _g85w_al_s  = (_g85w_long and _g85w_short > 0.0005) or (not _g85w_long and _g85w_short < -0.0005)
                    _g85w_al_m  = (_g85w_long and _g85w_med   > 0.0003) or (not _g85w_long and _g85w_med   < -0.0003)
                    _g85w_op_s  = (_g85w_long and _g85w_short < -0.0005) or (not _g85w_long and _g85w_short > 0.0005)
                    _g85w_op_m  = (_g85w_long and _g85w_med   < -0.0003) or (not _g85w_long and _g85w_med   > 0.0003)
                    if _g85w_al_s and _g85w_al_m:
                        _g85w_adj = 2.0
                    elif _g85w_al_s or _g85w_al_m:
                        _g85w_adj = 0.8
                    elif _g85w_op_s and _g85w_op_m:
                        _g85w_adj = -2.5
                    elif _g85w_op_s:
                        _g85w_adj = -1.0
                    elif _g85w_op_m:
                        _g85w_adj = -0.8
                    _g85w_adj = max(-2.5, min(2.5, _g85w_adj))
                    if _g85w_adj != 0.0:
                        quality_score += _g85w_adj
                    self._logger.debug(
                        f"[G8.5w MTF-Momentum v51.0] {symbol} "
                        f"dir={_g85w_dir} short={_g85w_short*100:.3f}% "
                        f"med={_g85w_med*100:.3f}% bars={len(_g85w_rets)} "
                        f"al_s={_g85w_al_s} al_m={_g85w_al_m} "
                        f"→ {_g85w_adj:+.1f}pts [MTF/v51.0]"
                    )
            # v51.0/v53.0: record to gate_stats so gate appears in analytics/health.
            # v53.0 FIX: moved outside the dir guard — previously only fired for valid
            # directions ("BUY"/"SELL"/etc.); if direction was missing/invalid, _record()
            # was never called → G8.5w showed 0% evaluations as false bottleneck #1.
            self._record("gate_g85w", _g85w_fired)
        except Exception:
            pass

        # ── Gate 8.5x — Liquidation Cascade Direction (v49.0) ───────────────
        # Liquidation direction from Binance forceOrder WS (L0.425) provides a
        # powerful directional confirmation signal. When long positions are being
        # force-liquidated (liq_net_side="LONG"), downward cascade pressure is
        # ongoing and SELL signals gain additional confirmation — while BUY signals
        # face amplified adverse flow. Conversely, short-liquidation cascades
        # (liq_net_side="SHORT") produce upward squeeze momentum.
        # Magnitude 0-1 (normalised): >0.5 = strong cascade, ≤0.5 = moderate.
        # Note: `gate_liq_cascade` (GLIQ) already handles the hard pass/fail;
        # G8.5x provides the directional QUALITY ADJUSTMENT not covered by GLIQ.
        #
        # Scoring logic:
        #   strong cascade confirms direction:    +1.5pts (cascade behind trade)
        #   moderate cascade confirms direction:  +0.8pts
        #   strong cascade opposes direction:     −2.0pts (caught in counter-flow)
        #   moderate cascade opposes direction:   −1.0pts
        # Cap: ±2.0pts. Falls back to global _live_liq_data (forceOrder@arr WS state)
        # when signal_data doesn't carry liq_net_side/liq_magnitude — this guarantees
        # the gate fires whenever the Binance liquidation WS has recent data [v50.0].
        try:
            _g85x_data    = signal_data if isinstance(signal_data, dict) else {}
            _g85x_dir     = (direction or "").upper()
            _g85x_adj     = 0.0
            _g85x_net_liq = str(_g85x_data.get("liq_net_side", "") or "").upper()
            _g85x_liq_mag = float(_g85x_data.get("liq_magnitude", 0.0) or 0.0)
            # ── Fallback: read from global _live_liq_data [v50.0] ──────────────
            # _live_liq_data is populated in real-time by _liq_ws_task() for every
            # symbol.  long_usd = longs being force-liquidated (bearish cascade);
            # short_usd = shorts being force-liquidated (bullish squeeze).
            if not _g85x_net_liq and symbol:
                _g85x_liq_entry = _live_liq_data.get(symbol)
                if _g85x_liq_entry and (time.time() - float(_g85x_liq_entry.get("ts", 0.0))) < 90.0:
                    _g85x_long_usd  = float(_g85x_liq_entry.get("long_usd",  0.0))
                    _g85x_short_usd = float(_g85x_liq_entry.get("short_usd", 0.0))
                    if _g85x_long_usd > 0 or _g85x_short_usd > 0:
                        if _g85x_long_usd >= _g85x_short_usd:
                            _g85x_net_liq = "LONG"   # bearish cascade
                            _g85x_liq_mag = min(1.0, _g85x_long_usd / 1_000_000.0)
                        else:
                            _g85x_net_liq = "SHORT"  # bullish squeeze
                            _g85x_liq_mag = min(1.0, _g85x_short_usd / 1_000_000.0)
            _g85x_fired = _g85x_net_liq in ("LONG", "SHORT") and _g85x_liq_mag > 0
            if _g85x_fired and _g85x_dir in ("BUY", "LONG", "SELL", "SHORT"):
                _g85x_long  = _g85x_dir in ("BUY", "LONG")
                _g85x_str   = _g85x_liq_mag > 0.5
                if _g85x_net_liq == "LONG":
                    if not _g85x_long:
                        _g85x_adj = 1.5 if _g85x_str else 0.8
                    else:
                        _g85x_adj = -2.0 if _g85x_str else -1.0
                elif _g85x_net_liq == "SHORT":
                    if _g85x_long:
                        _g85x_adj = 1.5 if _g85x_str else 0.8
                    else:
                        _g85x_adj = -2.0 if _g85x_str else -1.0
                _g85x_adj = max(-2.0, min(2.0, _g85x_adj))
                if _g85x_adj != 0.0:
                    quality_score += _g85x_adj
                self._logger.debug(
                    f"[G8.5x LiqCascade v51.0] {symbol} "
                    f"net_liq={_g85x_net_liq} mag={_g85x_liq_mag:.2f} "
                    f"dir={_g85x_dir} str={_g85x_str} → {_g85x_adj:+.1f}pts [v51.0]"
                )
            # v51.0: record to gate_stats so gate appears in analytics/health
            self._record("gate_g85x", _g85x_fired)
        except Exception:
            pass

        # ── Gate 8.5T — TurboVec Vectorized 3-Timeframe Momentum [v57.0] ─────
        # Inspired by RyanCodrai/turbovec: vectorized batch computation of
        # momentum alignment across 3 Fibonacci-scaled timeframes using numpy
        # matrix operations — zero external deps beyond numpy already imported.
        #
        # Input: _quant_layer_close_buf (per-symbol rolling 60-bar close series,
        #        populated by _feed_quant_layers_kline() on every kline tick).
        #
        # Algorithm (all vectorized, no Python loops over bars):
        #   Short  TF momentum : return over last  3 bars (fast noise signal)
        #   Medium TF momentum : return over last  8 bars (trend confirmation)
        #   Long   TF momentum : return over last 21 bars (structural direction)
        #   Fibonacci 3/8/21 scaling — proven in systematic quant research
        #   (Ehlers 2001; Lo, Mamaysky & Wang 2000 technical-pattern analysis).
        #
        # Direction alignment scoring vs signal direction:
        #   BUY  signal: positive TF return = aligned
        #   SELL signal: negative TF return = aligned
        #   n_aligned (count of 3 TFs aligned with signal direction):
        #     3/3 → +2.5pts  (all TFs confirm — highest conviction filter)
        #     2/3 → +1.0pts  (moderate momentum support)
        #     1/3 → −1.0pts  (split — elevated noise signal risk)
        #     0/3 → −2.5pts  (counter-momentum — all TFs oppose direction)
        #
        # Cold-start guard: requires ≥25 bars (covers 21-bar long TF + buffer).
        # Soft-gate: adjusts quality_score only — cannot hard-veto a signal.
        # _record(fired) → visible in /gates, gate_stats_summary(), HUD.
        try:
            _g85t_adj   = 0.0
            _g85t_fired = False
            _g85t_dir   = (direction or "").upper()
            if _g85t_dir in ("BUY", "LONG", "SELL", "SHORT") and symbol:
                _g85t_buf = _quant_layer_close_buf.get(symbol, [])
                if len(_g85t_buf) >= 25:
                    import numpy as _np_t
                    # Vectorized: grab last 22 closes (sufficient for 21-bar long TF)
                    _g85t_c = _np_t.array(_g85t_buf[-22:], dtype=_np_t.float64)
                    # Three Fibonacci-period momentum returns (vectorized ratio)
                    _g85t_short = (_g85t_c[-1] / _g85t_c[-4]  - 1.0) if _g85t_c[-4]  > 0.0 else 0.0
                    _g85t_med   = (_g85t_c[-1] / _g85t_c[-9]  - 1.0) if _g85t_c[-9]  > 0.0 else 0.0
                    _g85t_long  = (_g85t_c[-1] / _g85t_c[-22] - 1.0) if _g85t_c[-22] > 0.0 else 0.0
                    _g85t_buy   = _g85t_dir in ("BUY", "LONG")
                    # Count timeframes aligned with signal direction
                    _g85t_n = (
                        (1 if (_g85t_buy and _g85t_short > 0.0) or (not _g85t_buy and _g85t_short < 0.0) else 0) +
                        (1 if (_g85t_buy and _g85t_med   > 0.0) or (not _g85t_buy and _g85t_med   < 0.0) else 0) +
                        (1 if (_g85t_buy and _g85t_long  > 0.0) or (not _g85t_buy and _g85t_long  < 0.0) else 0)
                    )
                    # Ruthless scoring: 3→+2.5, 2→+1.0, 1→−1.0, 0→−2.5
                    _g85t_score_map = {3: 2.5, 2: 1.0, 1: -1.0, 0: -2.5}
                    _g85t_adj   = _g85t_score_map[_g85t_n]
                    quality_score += _g85t_adj
                    _g85t_fired = True
                    self._logger.debug(
                        f"[G8.5T TurboVec v57.0] {symbol} dir={_g85t_dir} "
                        f"3TF=[{_g85t_short*100:.2f}%,{_g85t_med*100:.2f}%,{_g85t_long*100:.2f}%] "
                        f"n={_g85t_n}/3 → {_g85t_adj:+.1f}pts [Fib3/8/21]"
                    )
            self._record("gate_g85t", _g85t_fired)
        except Exception:
            pass

        # ── Gate 8.5U — v68.0: MOVED to after G8.5Z and G8.5Y ────────────────
        # G8.5U is a 5-gate meta-consensus that requires G8.5Z + G8.5Y live values.
        # Pre-init sentinels (_g85z_adj/fired, _g85y_adj/fired) are False/0.0 here;
        # G8.5U now executes AFTER G8.5Y to ensure all 5 gate votes are live.
        # Gate stats registration occurs at the moved block — no double-record.

        # ── Gate 8.5P — BTC Cross-Pair Momentum Alignment (v60.0) ─────────────
        # For non-BTC signals: checks if BTC short-term momentum agrees with the
        # signal direction.  BTC drives 60-70% of altcoin variance — opposing BTC
        # macro momentum means swimming against the dominant market current.
        # Uses _quant_layer_close_buf["BTCUSDT"] (already populated by the quant layer
        # scan — no extra API calls).  Requires ≥20 BTC candle closes for reliability.
        # Direction: 5-period MA vs 20-period MA on BTC closes.
        #   BTC fast > slow (bull) + BUY signal:  +1.5pts (macro current aligned)
        #   BTC fast < slow (bear) + SELL signal: +1.5pts (macro current aligned)
        #   BTC fast > slow (bull) + SELL signal: -1.5pts (swimming against tide)
        #   BTC fast < slow (bear) + BUY signal:  -1.5pts (swimming against tide)
        #   Signal IS BTCUSDT or <20 BTC closes:  no adjustment (not applicable)
        # Soft-gate: quality_score only — cannot hard-veto. [v60.0 — 30th gate]
        _g85p_adj   = 0.0
        _g85p_fired = False
        try:
            _g85p_sym = (symbol or "").upper()
            if _g85p_sym != "BTCUSDT":
                # v75.0 BUG FIX: _quant_layer_close_buf is a MODULE-LEVEL global dict —
                # NOT a self instance attribute. self._quant_layer_close_buf raised
                # AttributeError every call (silently caught by except → gate dead since v60.0).
                # Fix: direct module-level access (same pattern as G8.5Z/T/w).
                _g85p_buf = list(_quant_layer_close_buf.get("BTCUSDT", []))
                if len(_g85p_buf) >= 20:
                    _g85p_fast_ma = sum(_g85p_buf[-5:])  / 5.0
                    _g85p_slow_ma = sum(_g85p_buf[-20:]) / 20.0
                    _g85p_btc_bull = _g85p_fast_ma > _g85p_slow_ma
                    _g85p_dir      = (direction or "").upper()
                    _g85p_fired    = True
                    if (_g85p_btc_bull and _g85p_dir == "BUY") or (not _g85p_btc_bull and _g85p_dir == "SELL"):
                        _g85p_adj = 1.5
                    else:
                        _g85p_adj = -1.5
                    quality_score += _g85p_adj
                    self._logger.debug(
                        f"[G8.5P BTC-Align v60.0] {symbol} {_g85p_dir} "
                        f"BTC fast={_g85p_fast_ma:.2f} slow={_g85p_slow_ma:.2f} "
                        f"bull={_g85p_btc_bull} → {_g85p_adj:+.1f}pts"
                    )
            self._record("gate_g85p", _g85p_fired)
        except Exception:
            pass

        # ── Gate 8.5R — HMM-GEX Regime Coherence (v62.0) ────────────────────
        # Joint confirmation: when the HMM regime direction AND BTC GEX net
        # direction BOTH agree with the signal direction, apply a +1.5pt
        # coherence bonus.  Two orthogonal analytical systems (state-machine
        # regime and dealer gamma positioning) simultaneously aligned with the
        # trade creates multiplicatively stronger conviction than either alone.
        # When they BOTH oppose the signal direction: −1.5pts (incoherence signal).
        # This gate does NOT double-count with G8.5e (HMM unilateral) or G8.5m
        # (GEX unilateral) — those apply individual adjustments; G8.5R fires only
        # on the JOINT (HMM dir == signal dir AND GEX dir == signal dir) condition.
        # Guards: GEX conf ≥ 35, not FLIP ZONE, GEX snapshot < 120s old.
        _g85r_adj    = 0.0
        _g85r_fired  = False
        try:
            _g85r_hmm_ref    = getattr(self, "_hmm_regime", None)
            _g85r_gex_snaps  = getattr(self, "_engine_gex_snapshots", None)
            _g85r_dir        = (direction or "").upper()
            if _g85r_hmm_ref is not None and _g85r_gex_snaps is not None and _g85r_dir in ("BUY", "SELL"):
                _g85r_hmm_str = ""
                try:
                    _g85r_hmm_str, _, _ = _g85r_hmm_ref.get_regime()
                    _g85r_hmm_str = str(_g85r_hmm_str or "").upper()
                except Exception:
                    pass
                _g85r_gex_bull = False
                _g85r_gex_bear = False
                try:
                    _g85r_btc_e = _g85r_gex_snaps.get("BTCUSDT")
                    if _g85r_btc_e is not None:
                        _g85r_snap = _g85r_btc_e[0] if isinstance(_g85r_btc_e, tuple) else _g85r_btc_e
                        _g85r_ts   = float(_g85r_btc_e[1] if isinstance(_g85r_btc_e, tuple) else 0.0)
                        if time.time() - _g85r_ts < 120.0:
                            _g85r_net    = float(getattr(_g85r_snap, "net_gex",    0.0) or 0.0)
                            _g85r_conf   = float(getattr(_g85r_snap, "confidence", 0)   or 0)
                            _g85r_regime = str(getattr(_g85r_snap, "regime", "") or "").upper()
                            if _g85r_conf >= 35 and "FLIP" not in _g85r_regime:
                                _g85r_gex_bull = _g85r_net >  500e6   # long-gamma → bullish
                                _g85r_gex_bear = _g85r_net < -500e6   # short-gamma → bearish
                except Exception:
                    pass
                _g85r_hmm_bull = _g85r_hmm_str == "EXPANSION"
                _g85r_hmm_bear = _g85r_hmm_str == "CONTRACTION"
                if _g85r_dir == "BUY":
                    if _g85r_hmm_bull and _g85r_gex_bull:
                        _g85r_adj   = 1.5    # dual bullish confirmation
                        _g85r_fired = True
                    elif _g85r_hmm_bear and _g85r_gex_bear:
                        _g85r_adj   = -1.5   # dual bearish opposition
                        _g85r_fired = True
                else:  # SELL
                    if _g85r_hmm_bear and _g85r_gex_bear:
                        _g85r_adj   = 1.5    # dual bearish confirmation
                        _g85r_fired = True
                    elif _g85r_hmm_bull and _g85r_gex_bull:
                        _g85r_adj   = -1.5   # dual bullish opposition
                        _g85r_fired = True
                if _g85r_fired:
                    quality_score += _g85r_adj
                    self._logger.debug(
                        f"[G8.5R HMM-GEX Coherence v62.0] {symbol} {_g85r_dir} "
                        f"HMM={_g85r_hmm_str} "
                        f"GEX={'bull' if _g85r_gex_bull else 'bear' if _g85r_gex_bear else 'n/a'} "
                        f"→ {_g85r_adj:+.1f}pts joint-coherence"
                    )
        except Exception:
            pass
        self._record("gate_g85r", _g85r_fired)

        # ── Gate 8.5Z — Return-Autocorrelation Persistence Gate (v64.0) ─────
        # Measures the lag-1 autocorrelation (AC) of bar-to-bar returns computed
        # from `_quant_layer_close_buf`.  AC discriminates between two microstructure
        # regimes that require opposite entry strategies:
        #
        #   AC > +0.15  (trending):    returns persist — momentum strategies win.
        #     recent return > 0 (rising) + BUY:  +2.0pts  (trend-follow aligned)
        #     recent return > 0 (rising) + SELL: -1.5pts  (counter-trend risk)
        #     recent return < 0 (falling)+ SELL: +2.0pts  (trend-follow aligned)
        #     recent return < 0 (falling)+ BUY:  -1.5pts  (counter-trend risk)
        #
        #   AC < -0.15  (mean-reverting): returns oscillate — fade strategies win.
        #     recent return > 0 (rose)  + SELL:  +1.5pts  (fade the bounce)
        #     recent return > 0 (rose)  + BUY:   -1.0pt   (chasing after bounce)
        #     recent return < 0 (fell)  + BUY:   +1.5pts  (buy the dip reversion)
        #     recent return < 0 (fell)  + SELL:  -1.0pt   (selling into collapse)
        #
        #   |AC| ≤ 0.15 (random walk): gate silent (0pts) — no reliable edge.
        #
        # Guard: ≥ 20 bars in close buffer for reliable AC estimate; non-fatal.
        # Reference: De Prado AFML ch.17 — autocorrelation of returns is the primary
        # mathematical discriminator between trending and mean-reverting regimes.
        # Soft-gate: adjusts quality_score only; cannot hard-veto any signal.
        _g85z_adj   = 0.0
        _g85z_fired = False
        try:
            _g85z_dir = (direction or "").upper()
            if _g85z_dir in ("BUY", "SELL") and symbol:
                _g85z_buf = list(_quant_layer_close_buf.get(symbol, []))
                if len(_g85z_buf) >= 20:
                    import numpy as _np_z
                    _g85z_c = _np_z.array(_g85z_buf[-21:], dtype=_np_z.float64)
                    # Bar-to-bar percentage returns (avoids log-return ±inf on zeros)
                    _g85z_prev = _np_z.maximum(_g85z_c[:-1], 1e-10)
                    _g85z_r    = (_g85z_c[1:] - _g85z_c[:-1]) / _g85z_prev
                    if len(_g85z_r) >= 10:
                        _g85z_mu     = float(_np_z.mean(_g85z_r))
                        _g85z_demean = _g85z_r - _g85z_mu
                        _g85z_lag0   = float(_np_z.sum(_g85z_demean[:-1] ** 2))
                        _g85z_lag1   = float(_np_z.sum(_g85z_demean[:-1] * _g85z_demean[1:]))
                        # Lag-1 autocorrelation (bounded [-1, +1])
                        _g85z_ac     = _g85z_lag1 / max(abs(_g85z_lag0), 1e-12)
                        _g85z_recent = float(_g85z_r[-1])   # most-recent bar return
                        _g85z_buy    = (_g85z_dir == "BUY")
                        _g85z_fired  = True
                        if _g85z_ac > 0.15:        # trending: momentum persists
                            if _g85z_recent > 0.0:
                                _g85z_adj = 2.0 if _g85z_buy else -1.5
                            else:
                                _g85z_adj = -1.5 if _g85z_buy else 2.0
                        elif _g85z_ac < -0.15:     # mean-reverting: fade the bounce
                            if _g85z_recent > 0.0:
                                _g85z_adj = -1.0 if _g85z_buy else 1.5
                            else:
                                _g85z_adj = 1.5 if _g85z_buy else -1.0
                        # else: |AC| ≤ 0.15 → random walk, gate silent (_g85z_adj=0)
                        if _g85z_adj != 0.0:
                            quality_score += _g85z_adj
                        self._logger.debug(
                            f"[G8.5Z AutoCorr v64.0] {symbol} {_g85z_dir} "
                            f"AC={_g85z_ac:.3f} recent={_g85z_recent*100:.3f}% "
                            f"→ {_g85z_adj:+.1f}pts "
                            f"({'trending' if _g85z_ac > 0.15 else 'mean-rev' if _g85z_ac < -0.15 else 'random-walk'})"
                        )
        except Exception:
            pass
        self._record("gate_g85z", _g85z_fired)

        # ── Gate 8.5Y — ATR Volatility Compression / Expansion Gate (v65.0) ─
        # Detects the volatility regime using a rolling ATR percentile over the
        # last 60 bars.  Uses bar-to-bar absolute price changes from the same
        # _quant_layer_close_buf as G8.5Z (no additional data source needed).
        #
        # Rationale (De Prado AFML ch.19 / Garman-Klass vol):
        #   Compressed vol (ATR ≤ 25th pct): market energy is coiling before an
        #   explosive directional move. Aligned entries benefit from the impulse.
        #   Expanded vol (ATR ≥ 80th pct): chaotic high-vol market — spreads widen,
        #   stops are routinely swept by noise, EV degrades.
        #
        #   ATR ≤ 25th pct (compressed, pre-breakout):   +2.0pts
        #   ATR ≥ 80th pct (expanded, noisy):            −1.5pts
        #   25th–80th pct (normal range):                  0pts (gate silent)
        #
        # Guard: ≥20 bars in close buffer, ≥15 ATR observations in rolling window.
        # Non-fatal. Soft-gate (quality adjuster — cannot hard-veto a signal).
        _g85y_fired = False
        try:
            # v75.0 BUG FIX: _quant_layer_close_buf is a MODULE-LEVEL global dict —
            # NOT a self instance attribute. getattr(self, ...) always returned {} (the default)
            # → .get(symbol) always returned None → gate body never entered (dead since v65.0).
            # Fix: direct module-level access (same pattern as G8.5Z/T/w at lines ~8616/~8445).
            _g85y_buf = _quant_layer_close_buf.get(symbol)
            if _g85y_buf is not None and len(_g85y_buf) >= 20:
                import numpy as _np_g85y
                _g85y_closes = _np_g85y.array(
                    [float(x) for x in _g85y_buf], dtype=_np_g85y.float64
                )
                _g85y_atr_series = _np_g85y.abs(_np_g85y.diff(_g85y_closes))
                if len(_g85y_atr_series) >= 15:
                    # 5-bar smoothed ATR as the current-regime estimator
                    _g85y_cur = float(_np_g85y.mean(_g85y_atr_series[-5:]))
                    # Rolling window: last 60 ATR observations (or all available)
                    _g85y_win = _g85y_atr_series[-60:] if len(_g85y_atr_series) >= 60 else _g85y_atr_series
                    if _g85y_cur > 0.0 and len(_g85y_win) >= 15:
                        _g85y_p25 = float(_np_g85y.percentile(_g85y_win, 25))
                        _g85y_p80 = float(_np_g85y.percentile(_g85y_win, 80))
                        if _g85y_cur <= _g85y_p25:
                            quality_score += 2.0
                            _g85y_fired = True
                            self._logger.debug(
                                f"[G8.5Y ATR-Compress v65.0] {symbol} "
                                f"ATR={_g85y_cur:.6f} ≤ p25={_g85y_p25:.6f} "
                                f"→ +2.0pts compressed-vol pre-breakout"
                            )
                        elif _g85y_cur >= _g85y_p80:
                            quality_score -= 1.5
                            _g85y_fired = True
                            self._logger.debug(
                                f"[G8.5Y ATR-Expand v65.0] {symbol} "
                                f"ATR={_g85y_cur:.6f} ≥ p80={_g85y_p80:.6f} "
                                f"→ −1.5pts noisy-market penalty"
                            )
        except Exception:
            pass
        self._record("gate_g85y", _g85y_fired)

        # ── Gate 8.5U — Momentum Soft-Gate Consensus [v68.0 — 5-gate] ────────
        # Meta-gate: aggregates directional votes from 5 soft momentum gates.
        # v68.0 upgrade from 3-gate (w/x/T) to 5-gate (w/x/T/Z/Y):
        #   • G8.5w  MTF-Momentum: multi-timeframe MA alignment
        #   • G8.5x  LiqCascade-Dir: liquidation cascade direction
        #   • G8.5T  TurboVec-3TF-Fib: vectorized Fibonacci momentum
        #   • G8.5Z  AutoCorr-Persistence: trending vs mean-reverting regime (NEW v68.0)
        #   • G8.5Y  ATR-VolCompress: pre-breakout vol compression signal (NEW v68.0)
        # Key insight at WR=27%: when 4-5 independent momentum signals oppose direction,
        # that is a far more reliable warning than any individual gate (-3.5pts veto).
        # When 4-5 agree, the consensus amplifies the genuine directional edge (+2.5pts).
        # MOVED here (v68.0): ensures G8.5Z + G8.5Y are live before consensus fires.
        # Guard: only fires if ≥1 gate had live data (n_data ≥ 1).
        # Soft-gate: adjusts quality_score only — cannot hard-veto a signal.
        try:
            _g85u_adj   = 0.0
            _g85u_fired = False
            _g85u_n_data = (
                (1 if _g85w_fired else 0) +
                (1 if _g85x_fired else 0) +
                (1 if _g85t_fired else 0) +
                (1 if _g85z_fired else 0) +   # v68.0: AutoCorr regime
                (1 if _g85y_fired else 0)      # v68.0: ATR vol-compress
            )
            _g85u_n_pos  = (
                (1 if _g85w_fired and _g85w_adj > 0.0 else 0) +
                (1 if _g85x_fired and _g85x_adj > 0.0 else 0) +
                (1 if _g85t_fired and _g85t_adj > 0.0 else 0) +
                (1 if _g85z_fired and _g85z_adj > 0.0 else 0) +   # v68.0
                (1 if _g85y_fired and _g85y_adj > 0.0 else 0)     # v68.0
            )
            if _g85u_n_data >= 1:    # at least 1 momentum gate had live data
                _g85u_fired = True
                # v68.0: 5-gate ruthless consensus scoring
                if   _g85u_n_pos >= 4: _g85u_adj =  2.5   # 4-5/5 overwhelming consensus
                elif _g85u_n_pos == 3: _g85u_adj =  1.5   # 3/5 majority
                elif _g85u_n_pos == 2: _g85u_adj =  0.5   # 2/5 narrow
                elif _g85u_n_pos == 1: _g85u_adj = -1.5   # split: 1 vs 4 opposing
                else:                  _g85u_adj = -3.5   # all oppose: WR-killer veto
                quality_score += _g85u_adj
                self._logger.debug(
                    f"[G8.5U MomConsensus v68.0-5gate] {symbol} "
                    f"pos={_g85u_n_pos}/{_g85u_n_data} "
                    f"w={_g85w_adj:+.1f} x={_g85x_adj:+.1f} t={_g85t_adj:+.1f} "
                    f"z={_g85z_adj:+.1f} y={_g85y_adj:+.1f} "
                    f"→ {_g85u_adj:+.1f}pts"
                )
            self._record("gate_g85u", _g85u_fired)
        except Exception:
            pass

        # ── Gate 8.5X — DGRP Velocity Gate (v66.0) ───────────────────────────
        # Measures the velocity of the GEX Dealer-GRP composite score (DGRP) over
        # the last 3–6 readings to detect regime momentum: is the dealer positioning
        # rapidly improving (bullish gamma environment building) or deteriorating
        # (dealer hedging pressure accelerating)?
        #
        # Rationale (De Prado AFML ch.16 regime labelling):
        #   A rapidly falling DGRP (velocity < −8pts) signals that dealer exposures are
        #   shifting adversely — spreads will widen and stop-hunting risk increases.
        #   A rapidly rising DGRP (velocity > +6pts) indicates the market structure is
        #   healing; premium setups become more durable.
        #
        # Velocity thresholds (raw DGRP pts per scan cycle, scale 0–100):
        #   velocity < −8pts (rapid deterioration): −2.0pts quality penalty
        #   velocity > +6pts (rapid improvement):   +1.5pts quality bonus
        #   |velocity| ≤ these thresholds:             0pts (gate silent)
        #
        # Guard: ≥4 DGRP readings in ring; 30s update guard prevents duplicate
        # readings from the same scan cycle. Soft-gate (quality adjuster only).
        _g85dv_fired = False
        try:
            _dgrp_now = float(getattr(gex_snapshot, "dgrp_score", 50) or 50) if gex_snapshot is not None else 50.0
            _dgrp_t_now = time.time()
            if (_dgrp_t_now - self._dgrp_vel_last_update) >= 30.0:
                self._dgrp_velocity_ring.append(_dgrp_now)
                self._dgrp_vel_last_update = _dgrp_t_now
            if len(self._dgrp_velocity_ring) >= 4:
                _dgrp_hist = list(self._dgrp_velocity_ring)
                _dgrp_vel  = _dgrp_hist[-1] - float(sum(_dgrp_hist[-4:-1]) / 3.0)
                if _dgrp_vel < -8.0:
                    quality_score -= 2.0
                    _g85dv_fired   = True
                    self._logger.debug(
                        f"[G8.5X DGRP-Vel v66.0] {symbol} velocity={_dgrp_vel:+.1f}pts<-8 "
                        f"→ -2.0pts rapid-deterioration"
                    )
                elif _dgrp_vel > 6.0:
                    quality_score += 1.5
                    _g85dv_fired   = True
                    self._logger.debug(
                        f"[G8.5X DGRP-Vel v66.0] {symbol} velocity={_dgrp_vel:+.1f}pts>+6 "
                        f"→ +1.5pts rapid-improvement"
                    )
        except Exception:
            pass
        self._record("gate_g85dv", _g85dv_fired)

        # ── Gate 8.5A — Funding Rate Trend / Crowding Momentum (v68.0) ────────
        # Tracks the rolling TREND of the per-symbol funding rate over 3 readings
        # to detect escalating crowding or de-crowding.  G8.5r checks current funding
        # alignment; G8.5A adds time-domain crowding trajectory that G8.5r misses.
        #
        # Crowding-escalation penalty (trade swims into rising crowd):
        #   Net funding delta > +0.015%/8h AND funding opposes trade direction → -2.0pts
        #   (e.g. positive funding escalating + LONG = more crowded longs = squeeze risk)
        # De-crowding bonus (funding trending toward 0, crowd exits):
        #   Net funding delta < -0.010%/8h (funding compressing toward 0) AND
        #   direction aligns with the de-crowd flow → +1.5pts
        # Guard: ≥3 readings required (cold-start safe); 30s min update interval.
        # Soft-gate: quality_score only — cannot hard-veto. [v68.0 — 36th gate]
        try:
            _g85a_adj   = 0.0
            _g85a_fired = False
            _fr_sym = (symbol or "UNKNOWN").upper()
            _fr_now = time.time()
            # Rate-limiting: update ring at most every 30s per symbol
            _fr_last = self._fr_trend_last_update.get(_fr_sym, 0.0)
            if _fr_now - _fr_last >= 30.0:
                _fr_val = float(signal_data.get("funding_rate") or 0.0)
                if abs(_fr_val) > 0.0:   # skip zero/missing funding data
                    if _fr_sym not in self._funding_rate_ring:
                        from collections import deque as _deque
                        self._funding_rate_ring[_fr_sym] = _deque(maxlen=3)
                    self._funding_rate_ring[_fr_sym].append(_fr_val)
                    self._fr_trend_last_update[_fr_sym] = _fr_now
            _fr_ring = self._funding_rate_ring.get(_fr_sym)
            if _fr_ring is not None and len(_fr_ring) >= 3:
                _g85a_fired = True
                _fr_list    = list(_fr_ring)
                _fr_delta   = _fr_list[-1] - _fr_list[0]   # net 3-reading delta
                _g85a_dir   = (direction or "").upper()
                _fr_latest  = _fr_list[-1]
                # Crowding escalation: funding moving AWAY from 0 toward a crowded position
                if abs(_fr_delta) > 0.00015:    # delta > 0.015%/8h (threshold for significant trend)
                    _fr_escalating_against = (
                        (_fr_delta > 0 and _g85a_dir == "BUY") or    # rising positive FR + LONG
                        (_fr_delta < 0 and _g85a_dir == "SELL")       # falling negative FR + SHORT
                    )
                    _fr_decrowing_aligned  = (
                        (_fr_delta < 0 and _fr_latest > 0 and _g85a_dir == "BUY") or   # pos FR shrinking → de-crowd → BUY bonus
                        (_fr_delta > 0 and _fr_latest < 0 and _g85a_dir == "SELL")      # neg FR shrinking → de-crowd → SELL bonus
                    )
                    if _fr_escalating_against:
                        _g85a_adj = -2.0
                        quality_score += _g85a_adj
                        self._logger.debug(
                            f"[G8.5A FundingTrend v68.0] {symbol} FR_delta={_fr_delta*100:+.4f}% "
                            f"dir={_g85a_dir} latest={_fr_latest*100:+.4f}% "
                            f"→ -2.0pts crowd-escalation-against"
                        )
                    elif _fr_decrowing_aligned:
                        _g85a_adj = +1.5
                        quality_score += _g85a_adj
                        self._logger.debug(
                            f"[G8.5A FundingTrend v68.0] {symbol} FR_delta={_fr_delta*100:+.4f}% "
                            f"dir={_g85a_dir} latest={_fr_latest*100:+.4f}% "
                            f"→ +1.5pts de-crowding-aligned"
                        )
            self._record("gate_g85a", _g85a_fired)
        except Exception:
            pass  # G8.5A FundingTrend is non-fatal soft-gate

        # ── Gate 8.5B — OFI Persistence Direction (v72.0) ────────────────────
        # Tracks per-symbol order-flow imbalance (OFI) direction over 3 consecutive
        # scan cycles.  When OFI has been consistently aligned with the signal
        # direction for all 3 readings → strong directional order-flow conviction (+2.0pts).
        # When all 3 readings oppose signal direction → adverse flow head-wind (-2.0pts).
        # 2/3 aligned (3-reading ring) → mild confirmation (+0.5pts); 1/3 → neutral.
        # Source: signal_data["ofi_z"] (NumpyOFI Z-score, already computed each cycle).
        # Guard: |ofi_z|≥0.3 to filter noise; ≥2 readings required (cold-start safe);
        # 45s min update interval to prevent over-sampling within one scan burst.
        # Soft-gate: quality_score adjuster only — cannot hard-veto a signal. [v72.0 — 37th gate]
        try:
            _g85b_adj   = 0.0
            _g85b_fired = False
            _b_sym = (symbol or "UNKNOWN").upper()
            _b_now = time.time()
            _b_last = self._ofi_persist_last_update.get(_b_sym, 0.0)
            if _b_now - _b_last >= 45.0:
                _b_ofi_z = float(signal_data.get("ofi_z") or 0.0)
                if abs(_b_ofi_z) >= 0.3:   # only record directional OFI readings (filter noise)
                    if _b_sym not in self._ofi_persist_ring:
                        self._ofi_persist_ring[_b_sym] = deque(maxlen=3)
                    _b_sign = 1 if _b_ofi_z > 0 else -1
                    self._ofi_persist_ring[_b_sym].append(_b_sign)
                    self._ofi_persist_last_update[_b_sym] = _b_now
            _b_ring = self._ofi_persist_ring.get(_b_sym)
            if _b_ring is not None and len(_b_ring) >= 2:
                _g85b_fired = True
                _b_readings = list(_b_ring)
                _b_dir_sign = 1 if (direction or "").upper() == "BUY" else -1
                _b_aligned  = sum(1 for r in _b_readings if r == _b_dir_sign)
                _b_n        = len(_b_readings)
                if _b_aligned == _b_n:         # all readings aligned with direction
                    _g85b_adj = +2.0
                    quality_score += _g85b_adj
                    self._logger.debug(
                        f"[G8.5B OFI-Persist v72.0] {symbol} {_b_n}/{_b_n} OFI readings "
                        f"aligned dir={direction} → +2.0pts persistent-flow-confirm"
                    )
                elif _b_aligned == 0:           # all readings opposed to direction
                    _g85b_adj = -2.0
                    quality_score += _g85b_adj
                    self._logger.debug(
                        f"[G8.5B OFI-Persist v72.0] {symbol} 0/{_b_n} OFI readings "
                        f"aligned dir={direction} → -2.0pts persistent-flow-headwind"
                    )
                elif _b_aligned >= 2 and _b_n >= 3:   # 2/3 aligned — mild confirmation
                    _g85b_adj = +0.5
                    quality_score += _g85b_adj
                    self._logger.debug(
                        f"[G8.5B OFI-Persist v72.0] {symbol} {_b_aligned}/{_b_n} OFI "
                        f"readings aligned dir={direction} → +0.5pts mild-flow-confirm"
                    )
            self._record("gate_g85b", _g85b_fired)
        except Exception:
            pass  # G8.5B OFI Persistence is non-fatal soft-gate

        # ── Gate 8.5C — Regime-Coherence Dual HMM+GEX Confirm (v73.0) ───────
        # Checks that BOTH the HMM regime state machine AND the BTC dealer GEX net
        # direction confirm the signal's trade direction.  Each source individually
        # appears in G8.5e (HMM-DIR ±8pts) and G8.5m (BTC-macro-GEX ±2pts), but
        # neither gate requires BOTH to agree simultaneously.  This gate captures the
        # joint-confirmation uplift: when two orthogonal institutional intelligence
        # sources (market microstructure HMM + dealer option positioning) both align
        # it signals a regime consensus that eliminates a large class of false signals.
        #
        # Scoring matrix:
        #   Both aligned (EXPANSION+GEX>$200M+BUY | CONTRACTION+GEX<-$200M+SELL)
        #                                        → +2.0pts strong dual-confirm
        #   Both opposed (EXPANSION+GEX>$200M+SELL | CONTRACTION+GEX<-$200M+BUY)
        #                                        → -2.0pts strong dual-adverse
        #   HMM aligned, GEX neutral/opposed     → +1.0pts single-HMM weak
        #   GEX aligned, HMM neutral/opposed     → +1.0pts single-GEX weak
        #   HMM opposed, GEX neutral/aligned     → -1.0pts single-HMM weak-adverse
        #   GEX opposed, HMM neutral/aligned     → -1.0pts single-GEX weak-adverse
        #   No signal from either source         →  0.0pts (neutral)
        # HMM guard: ≥15 warm samples required (cold-start safe).
        # GEX guard: |net_gex| > $200M and snapshot age < 120s.
        # Soft-gate: quality_score adjuster only — cannot hard-veto a signal. [v73.0 — 38th gate]
        try:
            _g85c_adj    = 0.0
            _g85c_fired  = False
            _g85c_hmm_rf = getattr(self, "_hmm_regime", None)
            if _g85c_hmm_rf is not None:
                try:
                    _g85c_hmm_s, _g85c_pexp, _ = _g85c_hmm_rf.get_regime()
                    _g85c_dir_u  = (direction or "").upper()
                    _g85c_buy    = _g85c_dir_u == "BUY"
                    # HMM alignment: EXPANSION → supports BUY; CONTRACTION → supports SELL
                    _g85c_hmm_all = (_g85c_hmm_s == "EXPANSION"   and float(_g85c_pexp or 0.0) >= 0.60 and _g85c_buy) or \
                                    (_g85c_hmm_s == "CONTRACTION" and float(_g85c_pexp or 0.0) >= 0.55 and not _g85c_buy)
                    _g85c_hmm_opp = (_g85c_hmm_s == "EXPANSION"   and float(_g85c_pexp or 0.0) >= 0.60 and not _g85c_buy) or \
                                    (_g85c_hmm_s == "CONTRACTION" and float(_g85c_pexp or 0.0) >= 0.55 and _g85c_buy)
                    # GEX alignment: net > +$200M → supports BUY; net < -$200M → supports SELL
                    _g85c_gex_net = 0.0
                    _g85c_gex_age = 999.0
                    _g85c_gex_rf2 = getattr(self, "_engine_gex_snapshots", None)
                    if _g85c_gex_rf2 is not None:
                        _g85c_btc = _g85c_gex_rf2.get("BTCUSDT")
                        if _g85c_btc is not None:
                            _g85c_bs, _g85c_bt = (
                                (_g85c_btc[0], _g85c_btc[1])
                                if isinstance(_g85c_btc, tuple) else (_g85c_btc, 0.0)
                            )
                            _g85c_gex_net = float(getattr(_g85c_bs, "net_gex", 0) or 0.0)
                            _g85c_gex_age = time.time() - float(_g85c_bt or 0.0)
                    _g85c_gex_live = abs(_g85c_gex_net) > 200_000_000.0 and _g85c_gex_age < 120.0
                    _g85c_gex_all  = _g85c_gex_live and (
                        (_g85c_gex_net >  200_000_000.0 and _g85c_buy) or
                        (_g85c_gex_net < -200_000_000.0 and not _g85c_buy)
                    )
                    _g85c_gex_opp  = _g85c_gex_live and (
                        (_g85c_gex_net >  200_000_000.0 and not _g85c_buy) or
                        (_g85c_gex_net < -200_000_000.0 and _g85c_buy)
                    )
                    # Combine signals
                    if _g85c_hmm_all and _g85c_gex_all:
                        _g85c_adj   = +2.0
                        _g85c_fired = True
                    elif _g85c_hmm_opp and _g85c_gex_opp:
                        _g85c_adj   = -2.0
                        _g85c_fired = True
                    elif _g85c_hmm_all and not _g85c_gex_opp:
                        _g85c_adj   = +1.0
                        _g85c_fired = True
                    elif _g85c_gex_all and not _g85c_hmm_opp:
                        _g85c_adj   = +1.0
                        _g85c_fired = True
                    elif _g85c_hmm_opp and not _g85c_gex_all:
                        _g85c_adj   = -1.0
                        _g85c_fired = True
                    elif _g85c_gex_opp and not _g85c_hmm_all:
                        _g85c_adj   = -1.0
                        _g85c_fired = True
                    if _g85c_adj != 0.0:
                        quality_score += _g85c_adj
                        # v74.0: Store adj on self so G9 Flow-Persistence Stack bonus can
                        # detect dual-confirm (±2.0) without passing local vars up the call.
                        self._last_g85c_adj = _g85c_adj
                        self._logger.debug(
                            f"[G8.5C RegimeCoh v73.0] {symbol} HMM={_g85c_hmm_s}"
                            f"(P={float(_g85c_pexp or 0.0):.2f}) "
                            f"GEX={_g85c_gex_net/1e9:.2f}B "
                            f"dir={_g85c_dir_u} → {_g85c_adj:+.1f}pts "
                            f"{'dual-confirm' if abs(_g85c_adj)==2.0 else 'single-source'}"
                        )
                except Exception:
                    pass
            self._record("gate_g85c", _g85c_fired)
        except Exception:
            pass  # G8.5C Regime-Coherence is non-fatal soft-gate

        # ── Gate 8.5D — OFI Velocity (signed acceleration, v74.0) ────────────
        # Tracks the signed rate-of-change (velocity) of the per-symbol OFI
        # z-score across consecutive scan cycles. Institutional accumulation
        # is characterised by accelerating OFI in the trade direction — dealers
        # and large-lot buyers increase order flow pressure progressively.
        # A decelerating or reversing OFI z-score signals fading conviction.
        #   velocity > +0.5σ aligned with BUY  → +2.0pts (surging LONG flow)
        #   velocity > +0.5σ aligned with SELL → +2.0pts (surging SHORT flow)
        #   velocity < -0.5σ against direction  → -1.5pts (fading / reversing)
        #   |velocity| ≤ 0.5σ (no trend)        →  0.0pts (neutral)
        # Guard: ring must have 2 readings; both within 90s; |delta| < 10.0.
        # Soft-gate (quality adjuster only — cannot block a signal) [v74.0].
        _g85d_fired = False
        try:
            _g85d_sym  = (symbol or "").upper()
            _g85d_now  = time.time()
            # Fetch current OFI z-score from timing state
            _g85d_cur_z = 0.0
            try:
                _ts85d = getattr(self, "_timing_state", None)
                if _ts85d is not None:
                    _g85d_cur_z = float(_ts85d.ofi_zscore(_g85d_sym) or 0.0)
            except Exception:
                pass
            # Maintain per-symbol velocity buffer (deque of (ts, ofi_z) pairs)
            if _g85d_sym not in self._ofi_velocity_buf:
                from collections import deque as _dq85d
                self._ofi_velocity_buf[_g85d_sym] = _dq85d(maxlen=2)
            _g85d_buf = self._ofi_velocity_buf[_g85d_sym]
            # Append current reading if |ofi_z| ≥ 0.2 (filter absolute noise)
            if abs(_g85d_cur_z) >= 0.2:
                _g85d_buf.append((_g85d_now, _g85d_cur_z))
            if len(_g85d_buf) == 2:
                _g85d_t0, _g85d_z0 = _g85d_buf[0]
                _g85d_t1, _g85d_z1 = _g85d_buf[1]
                _g85d_age0 = _g85d_now - _g85d_t0
                _g85d_velocity = _g85d_z1 - _g85d_z0
                # Both readings within 90s and noise guard |delta| < 10
                if _g85d_age0 <= 90.0 and abs(_g85d_velocity) < 10.0:
                    _g85d_dir_u  = (direction or "").upper()
                    _g85d_is_buy = (_g85d_dir_u == "BUY")
                    _g85d_adj    = 0.0
                    if _g85d_velocity > 0.5:
                        # Accelerating OFI
                        if (_g85d_is_buy and _g85d_z1 > 0) or (not _g85d_is_buy and _g85d_z1 < 0):
                            _g85d_adj    = +2.0  # surging flow aligned with direction
                            _g85d_fired  = True
                        else:
                            _g85d_adj    = -1.5  # surging flow against direction
                            _g85d_fired  = True
                    elif _g85d_velocity < -0.5:
                        # Decelerating / reversing OFI
                        if (_g85d_is_buy and _g85d_z1 < 0) or (not _g85d_is_buy and _g85d_z1 > 0):
                            _g85d_adj    = -1.5  # fading aligned z-score → conviction fading
                            _g85d_fired  = True
                        # else: decelerating z already opposing direction — neutral
                    if _g85d_adj != 0.0:
                        quality_score += _g85d_adj
                        self._logger.debug(
                            f"[G8.5D OFI-Vel v74.0] {_g85d_sym} "
                            f"z0={_g85d_z0:.2f}→z1={_g85d_z1:.2f} "
                            f"vel={_g85d_velocity:+.2f} dir={_g85d_dir_u} "
                            f"→ {_g85d_adj:+.1f}pts"
                        )
            self._record("gate_g85d", _g85d_fired)
        except Exception:
            pass  # G8.5D OFI-Velocity is non-fatal soft-gate

        # ── Gate 8.5E — Quant Cross-Signal Coherence (v75.0) ─────────────────
        # Meta-gate measuring agreement among 3 independent quantitative systems:
        #   (1) OFI z-score direction:  positive OFI z (|z|≥0.4) aligned with trade = +1 vote
        #   (2) HMM regime direction:   EXPANSION→BUY / CONTRACTION→SELL aligned = +1 vote
        #   (3) BTC GEX net direction:  positive net GEX→BUY / negative→SELL aligned = +1 vote
        #
        # Rationale (multi-factor institutional conviction):
        #   Three orthogonal quant systems (order-flow, regime-state, dealer-positioning)
        #   simultaneously agreeing with the trade direction creates multiplicatively stronger
        #   conviction than any single system alone. When all three oppose the signal,
        #   the trade faces institutional-level headwind from three independent data sources.
        #
        # Scoring:
        #   3/3 votes aligned → +2.0pts (ultra-conviction institutional coherence)
        #   2/3 votes aligned → +0.8pts (majority alignment confirmation)
        #   1/3 votes aligned →  0.0pts (mixed signal — gate silent)
        #   0/3 votes aligned → −1.5pts (all 3 systems oppose — major headwind)
        #
        # Guards: direction must be BUY or SELL; gate fires only when ≥2 vote sources
        # are available (at least 2 of the 3 systems have live data).
        # Non-fatal soft-gate. Uses data already computed in this eval cycle.
        # Stores vote count in self._last_g85e_votes for Kelly Step 34. [v75.0]
        _g85e_fired = False
        try:
            _g85e_dir = (direction or "").upper()
            if _g85e_dir in ("BUY", "SELL"):
                _g85e_dir_sign = 1 if _g85e_dir == "BUY" else -1
                _g85e_votes    = 0
                _g85e_sources  = 0   # how many systems had live data

                # Vote 1: OFI z-score direction
                _g85e_ofi_z = float(signal_data.get("ofi_z", 0.0) or 0.0)
                if abs(_g85e_ofi_z) >= 0.4:
                    _g85e_sources += 1
                    if (_g85e_ofi_z > 0 and _g85e_dir_sign == 1) or (_g85e_ofi_z < 0 and _g85e_dir_sign == -1):
                        _g85e_votes += 1

                # Vote 2: HMM regime direction
                _g85e_hmm_ref = getattr(self, "_hmm_regime", None)
                if _g85e_hmm_ref is not None:
                    try:
                        _g85e_hmm_str, _g85e_hmm_p, _ = _g85e_hmm_ref.get_regime()
                        _g85e_hmm_str = str(_g85e_hmm_str or "").upper()
                        _g85e_hmm_p   = float(_g85e_hmm_p or 0.0)
                        if (_g85e_hmm_str == "EXPANSION"   and _g85e_hmm_p >= 0.55) or \
                           (_g85e_hmm_str == "CONTRACTION" and _g85e_hmm_p >= 0.55):
                            _g85e_sources += 1
                            if (_g85e_hmm_str == "EXPANSION"   and _g85e_dir_sign == 1) or \
                               (_g85e_hmm_str == "CONTRACTION" and _g85e_dir_sign == -1):
                                _g85e_votes += 1
                    except Exception:
                        pass

                # Vote 3: BTC GEX net direction
                _g85e_gex_snaps = getattr(self, "_engine_gex_snapshots", None)
                if _g85e_gex_snaps is not None:
                    try:
                        _g85e_btc_e = _g85e_gex_snaps.get("BTCUSDT")
                        if _g85e_btc_e is not None:
                            _g85e_snap = _g85e_btc_e[0] if isinstance(_g85e_btc_e, tuple) else _g85e_btc_e
                            _g85e_ts   = float(_g85e_btc_e[1] if isinstance(_g85e_btc_e, tuple) else 0.0)
                            if time.time() - _g85e_ts < 120.0:
                                _g85e_net  = float(getattr(_g85e_snap, "net_gex", 0.0) or 0.0)
                                _g85e_conf = float(getattr(_g85e_snap, "confidence", 0) or 0)
                                _g85e_rgm  = str(getattr(_g85e_snap, "regime", "") or "").upper()
                                if _g85e_conf >= 30 and _g85e_rgm != "FLIP ZONE" and abs(_g85e_net) >= 200_000_000.0:
                                    _g85e_sources += 1
                                    if (_g85e_net > 0 and _g85e_dir_sign == 1) or (_g85e_net < 0 and _g85e_dir_sign == -1):
                                        _g85e_votes += 1
                    except Exception:
                        pass

                # Apply scoring when ≥2 data sources are live
                if _g85e_sources >= 2:
                    self._last_g85e_votes = _g85e_votes   # store for Kelly Step 34
                    _g85e_fired = True
                    if _g85e_votes == 3:
                        quality_score += 2.0
                        self._logger.debug(
                            f"[G8.5E CrossCoherence v75.0] {symbol} {_g85e_dir} "
                            f"3/3 votes aligned (OFI+HMM+GEX) → +2.0pts ultra-conviction"
                        )
                    elif _g85e_votes == 2:
                        quality_score += 0.8
                        self._logger.debug(
                            f"[G8.5E CrossCoherence v75.0] {symbol} {_g85e_dir} "
                            f"2/3 votes aligned → +0.8pts majority confirmation"
                        )
                    elif _g85e_votes == 0:
                        quality_score -= 1.5
                        self._logger.debug(
                            f"[G8.5E CrossCoherence v75.0] {symbol} {_g85e_dir} "
                            f"0/3 votes aligned (all 3 systems oppose) → −1.5pts institutional headwind"
                        )
                    # 1/3: gate silent (0 pts — mixed signal)
            self._record("gate_g85e", _g85e_fired)
        except Exception:
            pass  # G8.5E Cross-Signal Coherence is non-fatal soft-gate

        # ── Gate 8.5F — VWAP-Extension Direction Adjuster (v76.0) ────────────
        # Measures how far the current price has moved from the Anchored VWAP
        # in basis points. AVWAP acts as a mean-reversion magnet: price extended
        # far AGAINST the trade direction means TP targets face an AVWAP pull-back
        # headwind (de-rate quality). Price extended far IN the trade direction
        # confirms momentum has broken decisively from the VWAP anchor (boost quality).
        #
        # Scoring (avwap_dist_bps signed: positive = price above VWAP):
        #   Against direction >80bps: −2.0pts  (mean-reversion risk, AVWAP headwind)
        #   Against direction 40-80bps: −1.0pts (mild extension against, caution)
        #   In direction >80bps: +1.5pts        (breakout momentum confirmed by VWAP)
        #   In direction 40-80bps: +0.8pts      (mild extension in direction, support)
        #   |dist| < 40bps: silent (0 pts)      (near VWAP equilibrium, no edge)
        #
        # Source: signal_data["avwap_dist_bps"] stamped by F81-F85 injection block
        # above (from _timing_state.avwap_distance_bps()). Guard: dist must be
        # non-trivially non-zero (data present from timing state warm-up).
        # Also stores avwap_dist in self._last_g85f_avwap_dist for Kelly Step 35.
        # Non-fatal soft-gate — _record() wired to gate_stats analytics [v76.0].
        try:
            _g85f_fired   = False
            _g85f_avwap   = float(signal_data.get("avwap_dist_bps") or 0.0)
            _g85f_dir     = (direction or "").upper()
            _g85f_is_buy  = (_g85f_dir == "BUY" or _g85f_dir == "LONG")
            # Signed distance: positive = price above VWAP, negative = price below
            # For BUY: above VWAP = extended in direction; below VWAP = against
            # For SELL: below VWAP = extended in direction; above VWAP = against
            if abs(_g85f_avwap) >= 1.0:   # timing state has data (not cold-start zero)
                self._last_g85f_avwap_dist = _g85f_avwap   # store for Kelly Step 35
                # Determine if extension is in direction or against direction
                _g85f_in_dir = (
                    (_g85f_is_buy  and _g85f_avwap > 0.0) or   # BUY + price above VWAP
                    (not _g85f_is_buy and _g85f_avwap < 0.0)    # SELL + price below VWAP
                )
                _g85f_abs = abs(_g85f_avwap)
                _g85f_fired = True
                if _g85f_in_dir:
                    if _g85f_abs >= 80.0:
                        quality_score += 1.5
                        self._logger.debug(
                            f"[G8.5F VWAP-Extension v76.0] {symbol} {_g85f_dir} "
                            f"dist={_g85f_avwap:+.1f}bps (>80bps in dir) → +1.5pts breakout"
                        )
                    elif _g85f_abs >= 40.0:
                        quality_score += 0.8
                        self._logger.debug(
                            f"[G8.5F VWAP-Extension v76.0] {symbol} {_g85f_dir} "
                            f"dist={_g85f_avwap:+.1f}bps (40-80bps in dir) → +0.8pts mild extension"
                        )
                    # else: <40bps in dir — near VWAP, silent
                else:
                    # Extension against direction — mean-reversion risk
                    if _g85f_abs >= 80.0:
                        quality_score -= 2.0
                        self._logger.debug(
                            f"[G8.5F VWAP-Extension v76.0] {symbol} {_g85f_dir} "
                            f"dist={_g85f_avwap:+.1f}bps (>80bps against dir) → −2.0pts AVWAP headwind"
                        )
                    elif _g85f_abs >= 40.0:
                        quality_score -= 1.0
                        self._logger.debug(
                            f"[G8.5F VWAP-Extension v76.0] {symbol} {_g85f_dir} "
                            f"dist={_g85f_avwap:+.1f}bps (40-80bps against dir) → −1.0pts mild headwind"
                        )
                    # else: <40bps against — near VWAP equilibrium, silent
            self._record("gate_g85f", _g85f_fired)
        except Exception:
            pass  # G8.5F VWAP-Extension is non-fatal soft-gate

        # ── Gate 8.5G — CUSUM-Breakout Statistical Confirmation (v76.0) ──────
        # Leverages the de Prado symmetric CUSUM event filter already running in
        # L9 (institutional timing layer). The CUSUM filter fires when a sequence
        # of log-returns accumulates enough evidence of a volatility-regime shift
        # to exceed the K-sigma threshold (default UNITY_CUSUM_K_SIGMA=3.0).
        #
        # When CUSUM is active, a statistically significant directional move has
        # been detected in the last UNITY_CUSUM_EVENT_TTL_SEC seconds (default 300s).
        # Aligning WITH that move = elevated follow-through probability.
        # Entering AGAINST that confirmed breakout = elevated adverse selection risk.
        #
        # Direction of the CUSUM breakout is inferred from the OFI z-score at the
        # time of evaluation: OFI > 0 = buy-side institutional flow (bullish CUSUM);
        # OFI < 0 = sell-side flow (bearish CUSUM). Guard: OFI z-score must have
        # magnitude ≥ 0.3 to determine direction (avoids zero-OFI false signal).
        # If CUSUM active but OFI is ambiguous (|ofi_z| < 0.3), gate is silent.
        #
        # Scoring:
        #   CUSUM active + aligned with OFI breakout direction: +1.5pts
        #   CUSUM active + opposed to OFI breakout direction:   −1.5pts
        #   CUSUM not active: silent (0 pts)
        #
        # Source: _timing_state.cusum_event_active() + _timing_state.ofi_zscore()
        # — both already computed per-cycle in L9 with zero extra API calls.
        # Also stores cusum state in self._last_g85g_cusum_active for Kelly Step 35.
        # Non-fatal soft-gate — _record() wired to gate_stats analytics [v76.0].
        try:
            _g85g_fired   = False
            _g85g_ts      = getattr(self, "_timing_state", None)
            if _g85g_ts is not None:
                _g85g_sym     = (symbol or "").upper()
                _g85g_cusum   = bool(_g85g_ts.cusum_event_active(_g85g_sym))
                self._last_g85g_cusum_active = _g85g_cusum   # store for Kelly Step 35
                if _g85g_cusum:
                    # CUSUM event is live — determine its direction from OFI z-score
                    try:
                        _g85g_ofi_z = float(_g85g_ts.ofi_zscore(_g85g_sym))
                    except Exception:
                        _g85g_ofi_z = 0.0
                    _g85g_dir     = (direction or "").upper()
                    _g85g_is_buy  = (_g85g_dir == "BUY" or _g85g_dir == "LONG")
                    if abs(_g85g_ofi_z) >= 0.3:
                        # OFI direction is determinate — score alignment
                        _g85g_cusum_bull = (_g85g_ofi_z > 0.0)   # positive OFI = buy-side breakout
                        _g85g_aligned    = (
                            (_g85g_is_buy  and _g85g_cusum_bull) or
                            (not _g85g_is_buy and not _g85g_cusum_bull)
                        )
                        _g85g_fired = True
                        if _g85g_aligned:
                            quality_score += 1.5
                            self._logger.debug(
                                f"[G8.5G CUSUM-Breakout v76.0] {symbol} {_g85g_dir} "
                                f"CUSUM active ofi_z={_g85g_ofi_z:+.2f} aligned → +1.5pts breakout confirm"
                            )
                        else:
                            quality_score -= 1.5
                            self._logger.debug(
                                f"[G8.5G CUSUM-Breakout v76.0] {symbol} {_g85g_dir} "
                                f"CUSUM active ofi_z={_g85g_ofi_z:+.2f} opposed → −1.5pts adverse selection risk"
                            )
                    # |ofi_z| < 0.3: CUSUM active but direction ambiguous — gate silent
            self._record("gate_g85g", _g85g_fired)
        except Exception:
            pass  # G8.5G CUSUM-Breakout is non-fatal soft-gate

        # ── Gate 8.5H — Bid-Ask Flow Asymmetry (v77.0) ───────────────────────
        # Dual-source adverse-selection detector: cross-product of OFI z-score
        # and orderbook imbalance.  When TWO independent flow signals (OFI from
        # aggTrade tick-rule and OB imbalance from depth-5 snapshot) simultaneously
        # oppose the trade direction, adverse selection probability is elevated —
        # both the active order-flow AND the passive book are against the signal.
        # Conversely, when both agree with the direction, momentum is institutionally
        # confirmed from two orthogonal data sources.
        #
        # Sources:
        #   OFI z-score   : self._timing_state.ofi_zscore(symbol) — already computed
        #   OB imbalance  : signal_data.get("ob_imbalance") or signal_data.get("ob_imbalance_norm")
        #                   (injected at F85 G4 stamping block)
        #
        # Scoring (BUY signal — positive OFI=buying, ob_imbalance>0.5=buy-pressure):
        #   |ofi_z| > 1.5 opposed AND ob_imb also opposed : −2.0pts (dual adverse-selection)
        #   |ofi_z| > 1.0 opposed alone                   : −1.0pts (single adverse OFI)
        #   |ofi_z| > 1.0 aligned AND ob_imb also aligned : +1.5pts (dual momentum confirm)
        #   |ofi_z| < 0.5 or cold start                   : silent
        #
        # Stores self._last_g85h_ofi_aligned (+1=dual-align, -1=dual-oppose, 0=neutral)
        # for Kelly Step 36 flow-asymmetry position sizing.
        try:
            _g85h_fired = False
            _g85h_ts    = self._timing_state
            if _g85h_ts is not None:
                _g85h_ofi_z   = _g85h_ts.ofi_zscore(symbol)
                _g85h_is_buy  = (direction or "").upper() in ("BUY", "LONG")
                _g85h_dir_sgn = 1.0 if _g85h_is_buy else -1.0
                # OFI direction: positive z = buy-side pressure
                _g85h_ofi_aligned = (_g85h_ofi_z * _g85h_dir_sgn) > 0.0
                # OB imbalance: >0.5 = buy pressure; read from signal_data (F85 injection)
                _g85h_ob_raw  = float(signal_data.get("ob_imbalance", 0.5)
                                      if isinstance(signal_data, dict) else 0.5)
                _g85h_ob_ctr  = _g85h_ob_raw - 0.5   # centred: positive=buy, negative=sell
                _g85h_ob_algn = (_g85h_ob_ctr * _g85h_dir_sgn) > 0.0
                _g85h_abs_z   = abs(_g85h_ofi_z)
                if _g85h_abs_z >= 0.5:   # noise floor
                    _g85h_fired = True
                    if not _g85h_ofi_aligned and not _g85h_ob_algn and _g85h_abs_z >= 1.5:
                        # Both OFI and OB imbalance oppose direction — dual adverse-selection
                        quality_score -= 2.0
                        self._last_g85h_ofi_aligned = -1
                        self._logger.debug(
                            f"[G8.5H FlowAsym v77.0] {symbol} {direction} "
                            f"ofi_z={_g85h_ofi_z:+.2f} ob_ctr={_g85h_ob_ctr:+.3f} "
                            f"DUAL-OPPOSE → −2.0pts adverse selection"
                        )
                    elif not _g85h_ofi_aligned and _g85h_abs_z >= 1.0:
                        # OFI only opposed (OB imbalance neutral or aligned)
                        quality_score -= 1.0
                        self._last_g85h_ofi_aligned = 0
                        self._logger.debug(
                            f"[G8.5H FlowAsym v77.0] {symbol} {direction} "
                            f"ofi_z={_g85h_ofi_z:+.2f} OFI-alone oppose → −1.0pts"
                        )
                    elif _g85h_ofi_aligned and _g85h_ob_algn and _g85h_abs_z >= 1.0:
                        # Both OFI and OB imbalance confirm direction
                        quality_score += 1.5
                        self._last_g85h_ofi_aligned = 1
                        self._logger.debug(
                            f"[G8.5H FlowAsym v77.0] {symbol} {direction} "
                            f"ofi_z={_g85h_ofi_z:+.2f} ob_ctr={_g85h_ob_ctr:+.3f} "
                            f"DUAL-ALIGN → +1.5pts institutional momentum confirm"
                        )
                    else:
                        self._last_g85h_ofi_aligned = 0
                # |ofi_z| < 0.5: noise envelope — gate silent
            self._record("gate_g85h", _g85h_fired)
        except Exception:
            pass  # G8.5H FlowAsymmetry is non-fatal soft-gate

        # ── Gate 8.5I — Close-Microtrend Slope (v77.0) ───────────────────────
        # Linear regression slope of the last 10 one-minute closes from the
        # module-level `_quant_layer_close_buf[symbol]` rolling buffer (already
        # populated every kline tick by the kline-1m WS task).  A positive slope
        # means price is trending up over the last 10 minutes; negative = trending
        # down.  Signal direction alignment with the short-term micro-trend adds
        # conviction; opposition reduces it (price is fighting the signal).
        #
        # Sources:
        #   _quant_layer_close_buf[symbol] — module-level List[float], last 60 closes
        #
        # Scoring:
        #   slope > 0 AND BUY  (or slope < 0 AND SELL): +1.5pts (micro-trend aligned)
        #   slope < 0 AND BUY  (or slope > 0 AND SELL): -1.5pts (micro-trend opposed)
        #   < 5 closes in buffer                       : silent (cold-start guard)
        try:
            _g85i_fired  = False
            _g85i_closes = list(_quant_layer_close_buf.get(symbol.upper(), []))
            if len(_g85i_closes) >= 5:
                _g85i_sample = _g85i_closes[-10:] if len(_g85i_closes) >= 10 else _g85i_closes
                _g85i_n      = len(_g85i_sample)
                try:
                    import numpy as _np_g85i
                    _g85i_x     = _np_g85i.arange(_g85i_n, dtype=float)
                    _g85i_slope = float(_np_g85i.polyfit(_g85i_x, _g85i_closes[-_g85i_n:], 1)[0])
                except Exception:
                    # Manual slope fallback (no numpy): simple OLS
                    _g85i_xs   = list(range(_g85i_n))
                    _g85i_xm   = sum(_g85i_xs) / _g85i_n
                    _g85i_ym   = sum(_g85i_sample) / _g85i_n
                    _g85i_num  = sum((_g85i_xs[k] - _g85i_xm) * (_g85i_sample[k] - _g85i_ym)
                                     for k in range(_g85i_n))
                    _g85i_den  = sum((_g85i_xs[k] - _g85i_xm) ** 2 for k in range(_g85i_n))
                    _g85i_slope = _g85i_num / _g85i_den if _g85i_den != 0 else 0.0
                if abs(_g85i_slope) > 0.0:   # trivial guard
                    _g85i_fired   = True
                    _g85i_is_buy  = (direction or "").upper() in ("BUY", "LONG")
                    _g85i_aligned = (_g85i_slope > 0.0) == _g85i_is_buy
                    if _g85i_aligned:
                        quality_score += 1.5
                        self._logger.debug(
                            f"[G8.5I MicroTrend v77.0] {symbol} {direction} "
                            f"slope={_g85i_slope:+.6f} ({_g85i_n} closes) ALIGNED → +1.5pts"
                        )
                    else:
                        quality_score -= 1.5
                        self._logger.debug(
                            f"[G8.5I MicroTrend v77.0] {symbol} {direction} "
                            f"slope={_g85i_slope:+.6f} ({_g85i_n} closes) OPPOSED → −1.5pts"
                        )
            self._record("gate_g85i", _g85i_fired)
        except Exception:
            pass  # G8.5I MicroTrend is non-fatal soft-gate

        # ── Gate 8.5J — HMM Volatility Regime Transition (v78.0) ─────────────
        # Reads the hmm_expansion_prob already injected at F79 in signal_data.
        # Compares current probability against a per-symbol EWMA baseline (α=0.30)
        # to compute a regime-velocity delta (how fast P_expansion is moving).
        #
        # Logic:
        #   BUY direction: expansion regime aligns with longs (momentum/breakout)
        #     → P_expansion HIGH (>0.65) AND above EWMA = regime confirming → +1.5pts
        #     → P_expansion LOW (<0.35) AND dropping below EWMA = adverse transition → −2.0pts
        #   SELL direction: contraction regime aligns with shorts
        #     → P_expansion LOW (<0.35) AND below EWMA = regime confirming → +1.5pts
        #     → P_expansion HIGH (>0.65) AND rising above EWMA = adverse transition → −2.0pts
        #   Neutral (0.35–0.65): no points (transition ambiguous)
        #
        # EWMA update always happens (in-place, learning from every cycle).
        # Stores self._last_g85j_regime_signal for Kelly Step 37.
        # Zero-API-call gate: reads signal_data["hmm_expansion_prob"] injected at F79.
        _g85j_fired = False
        self._last_g85j_regime_signal = 0  # reset each signal evaluation
        try:
            _g85j_hmm_prob = float(signal_data.get("hmm_expansion_prob", -1.0))
            if _g85j_hmm_prob >= 0.0:  # valid reading (−1.0 = not available)
                # Update EWMA baseline for this symbol
                _g85j_alpha = 0.30
                _g85j_prev_ewma = self._g85j_hmm_ewma.get(symbol, _g85j_hmm_prob)
                _g85j_ewma = _g85j_alpha * _g85j_hmm_prob + (1.0 - _g85j_alpha) * _g85j_prev_ewma
                self._g85j_hmm_ewma[symbol] = _g85j_ewma
                _g85j_delta = _g85j_hmm_prob - _g85j_ewma  # positive = rising, negative = falling
                _g85j_fired = True
                if direction == "BUY":
                    if _g85j_hmm_prob > 0.65 and _g85j_delta > 0.0:
                        # Expansion regime confirmed and strengthening → LONG-aligned
                        quality_score += 1.5
                        self._last_g85j_regime_signal = 1
                        self._logger.debug(
                            f"[G8.5J HMMTransition v78.0] {symbol} BUY "
                            f"P_exp={_g85j_hmm_prob:.3f} δ={_g85j_delta:+.3f} ALIGNED → +1.5pts"
                        )
                    elif _g85j_hmm_prob < 0.35 and _g85j_delta < 0.0:
                        # Expansion regime collapsing — adverse for longs
                        quality_score -= 2.0
                        self._last_g85j_regime_signal = -1
                        self._logger.debug(
                            f"[G8.5J HMMTransition v78.0] {symbol} BUY "
                            f"P_exp={_g85j_hmm_prob:.3f} δ={_g85j_delta:+.3f} ADVERSE TRANSITION → −2.0pts"
                        )
                    # else: neutral range (0.35–0.65) or mixed → no adjustment
                elif direction == "SELL":
                    if _g85j_hmm_prob < 0.35 and _g85j_delta < 0.0:
                        # Contraction regime confirmed and deepening → SHORT-aligned
                        quality_score += 1.5
                        self._last_g85j_regime_signal = 1
                        self._logger.debug(
                            f"[G8.5J HMMTransition v78.0] {symbol} SELL "
                            f"P_exp={_g85j_hmm_prob:.3f} δ={_g85j_delta:+.3f} ALIGNED → +1.5pts"
                        )
                    elif _g85j_hmm_prob > 0.65 and _g85j_delta > 0.0:
                        # Expansion regime rising — adverse for shorts
                        quality_score -= 2.0
                        self._last_g85j_regime_signal = -1
                        self._logger.debug(
                            f"[G8.5J HMMTransition v78.0] {symbol} SELL "
                            f"P_exp={_g85j_hmm_prob:.3f} δ={_g85j_delta:+.3f} ADVERSE TRANSITION → −2.0pts"
                        )
                    # else: neutral range or mixed → no adjustment
            self._record("gate_g85j_hmm", _g85j_fired)
        except Exception:
            pass  # G8.5J HMM Regime Transition is non-fatal soft-gate

        # ── G8.5K — Spread-Regime Liquidity gate (v79.0) ─────────────────────
        # Compares current bid-ask spread ratio to a 30-sample per-symbol ring.
        # Illiquid regime (spread at >=75th pct of ring AND >15% above median) → −2.0pts.
        # Liquid regime (spread at <=25th pct of ring AND >15% below median)   → +1.5pts.
        # No data (<10 samples) or neutral range → 0pts.
        # Source: spread_ratio_norm (F89) = current_spread_pct / 20-bar-median already in signal_data.
        # Stores self._last_g85k_liq_signal (+1=liquid, -1=illiquid, 0=neutral) for Kelly Step 38.
        _g85k_fired = False
        try:
            _g85k_spread_ratio = float(signal_data.get("spread_ratio_norm", 1.0) or 1.0)
            # Per-symbol ring initialisation
            if symbol not in self._g85k_spread_ring:
                self._g85k_spread_ring[symbol] = deque(maxlen=30)
            _g85k_ring = self._g85k_spread_ring[symbol]
            _g85k_ring.append(_g85k_spread_ratio)
            self._last_g85k_liq_signal = 0  # reset each evaluation
            if len(_g85k_ring) >= 10:
                _g85k_sorted = sorted(_g85k_ring)
                _g85k_n = len(_g85k_sorted)
                _g85k_pct75 = _g85k_sorted[max(0, int(_g85k_n * 0.75) - 1)]
                _g85k_pct25 = _g85k_sorted[max(0, int(_g85k_n * 0.25) - 1)]
                if _g85k_spread_ratio >= _g85k_pct75 and _g85k_spread_ratio > 1.15:
                    # Illiquid: spread at >=75th percentile AND meaningfully above median
                    quality_score -= 2.0
                    _g85k_fired = True
                    self._last_g85k_liq_signal = -1
                    self._logger.debug(
                        f"📊 [v79.0 G8.5K] SPREAD-ILLIQUID {symbol} "
                        f"ratio={_g85k_spread_ratio:.3f} >=75th({_g85k_pct75:.3f}) → −2.0pts"
                    )
                elif _g85k_spread_ratio <= _g85k_pct25 and _g85k_spread_ratio < 0.85:
                    # Liquid: spread at <=25th percentile AND meaningfully below median
                    quality_score += 1.5
                    _g85k_fired = True
                    self._last_g85k_liq_signal = 1
                    self._logger.debug(
                        f"📊 [v79.0 G8.5K] SPREAD-LIQUID {symbol} "
                        f"ratio={_g85k_spread_ratio:.3f} <=25th({_g85k_pct25:.3f}) → +1.5pts"
                    )
            self._record("gate_g85k_spread", _g85k_fired)
        except Exception:
            pass  # G8.5K Spread-Regime Liquidity is non-fatal soft-gate

        # ── G8.5L2 — VolumePressure-Regime gate (v80.0) ──────────────────────
        # Detects institutional volume pressure aligned or opposed to real-time OFI direction.
        # High volume (volume_ratio ≥ 1.5×avg) with OFI OPPOSING trade direction → −2.0pts
        # (high-volume counter-flow = institutional sellers absorbing buy pressure = bearish warning).
        # High volume with OFI CONFIRMING trade direction → +1.5pts
        # (institutional volume backing direction = strong execution confirmation).
        # Low-volume or OFI ambiguous (|ofi_z| < 0.3) → 0pts (neutral, no adjustment).
        # Sources: volume_ratio and ofi_z already in signal_data (zero-API-call gate).
        # Stores self._last_g85l2_vpr_signal (+1=aligned, -1=opposed, 0=neutral) for Kelly Step 39.
        _g85l2_fired = False
        try:
            _g85l2_vol_ratio = float(signal_data.get("volume_ratio", 1.0) or 1.0)
            _g85l2_ofi_z     = float(signal_data.get("ofi_z", 0.0) or 0.0)
            self._last_g85l2_vpr_signal = 0  # reset each signal evaluation
            if _g85l2_vol_ratio >= 1.5:
                # Volume surge detected — evaluate OFI directional cross
                _g85l2_ofi_sign = (1.0 if _g85l2_ofi_z > 0.3 else (-1.0 if _g85l2_ofi_z < -0.3 else 0.0))
                _g85l2_dir_sign = 1.0 if direction == "BUY" else -1.0
                _g85l2_cross    = _g85l2_ofi_sign * _g85l2_dir_sign
                if _g85l2_cross < 0:
                    # OFI opposed to direction during volume surge → institutional counter-flow warning
                    quality_score -= 2.0
                    _g85l2_fired = True
                    self._last_g85l2_vpr_signal = -1
                    self._logger.debug(
                        f"📊 [v80.0 G8.5L2] VOL-OFI OPPOSED {symbol} "
                        f"vol={_g85l2_vol_ratio:.2f}× ofi_z={_g85l2_ofi_z:.2f} dir={direction} → −2.0pts"
                    )
                elif _g85l2_cross > 0:
                    # OFI aligned with direction during volume surge → institutional volume confirmation
                    quality_score += 1.5
                    _g85l2_fired = True
                    self._last_g85l2_vpr_signal = 1
                    self._logger.debug(
                        f"📊 [v80.0 G8.5L2] VOL-OFI ALIGNED {symbol} "
                        f"vol={_g85l2_vol_ratio:.2f}× ofi_z={_g85l2_ofi_z:.2f} dir={direction} → +1.5pts"
                    )
            self._record("gate_g85l2_vpr", _g85l2_fired)
        except Exception:
            pass  # G8.5L2 VolumePressure-Regime is non-fatal soft-gate

        # ── G8.5N2 — FundingMomentum-Persistence gate (v81.0) ────────────────
        # Detects when the funding rate trend (rolling 3-reading delta) is
        # STRONGLY OPPOSED to the signal direction — warning that the crowd is
        # persistently positioned against the trade (crowding risk).
        #   Threshold: |funding_rate_trend| > 0.0002 (two σ of typical 0.01%/8h)
        #   Opposed (trend × dir_sign < 0) → −2.0pts (crowding risk warning)
        #   Aligned (trend × dir_sign > 0) → +1.5pts (crowd confirms direction)
        #   Neutral (|trend| ≤ 0.0002)     → 0pts (no strong funding bias)
        # Source: signal_data["funding_rate_trend"] (already injected at F71/G8.5A)
        # Stores _last_g85n2_fmp_signal (+1/-1/0) for Kelly Step 40.
        try:
            _g85n2_trend   = float(signal_data.get("funding_rate_trend", 0.0) or 0.0)
            _g85n2_dir_s   = 1.0 if direction == "BUY" else -1.0
            _g85n2_cross   = _g85n2_trend * _g85n2_dir_s  # positive = funding favors direction (longs pay more → SHORT favored)
            _g85n2_fired   = False
            self._last_g85n2_fmp_signal = 0
            if abs(_g85n2_trend) > 0.0002:
                # Funding trend OPPOSED to direction (crowd positioned against us)
                # Note: positive funding rate trend + BUY direction = longs pay more = bad for longs
                if _g85n2_cross > 0:
                    quality_score -= 2.0
                    self._last_g85n2_fmp_signal = -1
                    _g85n2_fired = True
                    _log.debug(
                        f"[G8.5N2-FMP] FundingMomentum OPPOSED "
                        f"fr_trend={_g85n2_trend:.6f} dir={direction} → −2.0pts"
                    )
                # Funding trend ALIGNED with direction (crowd momentum confirms us)
                elif _g85n2_cross < 0:
                    quality_score += 1.5
                    self._last_g85n2_fmp_signal = 1
                    _g85n2_fired = True
                    _log.debug(
                        f"[G8.5N2-FMP] FundingMomentum ALIGNED "
                        f"fr_trend={_g85n2_trend:.6f} dir={direction} → +1.5pts"
                    )
            self._record("gate_g85n2_fmp", _g85n2_fired)
        except Exception:
            pass  # G8.5N2 FundingMomentum-Persistence is non-fatal soft-gate

        # ── G8.5O2 — WinRate-EV Coherence gate (v82.0) ──────────────────────
        # Uses global session win rate and consecutive-loss streak to adjust
        # signal quality based on current performance regime:
        #   • WR < 28% AND consec_losses ≥ 4 → −2.0pts (confirmed losing regime)
        #   • WR > 42% AND consec_losses = 0  → +1.5pts (confirmed winning regime)
        #   • consec_losses ≥ 3 (no regime flag) → −1.0pts (loss streak penalty)
        # Minimum sample guard: requires ≥ 10 resolved trades before firing.
        # Sources: self._metrics.win_count/loss_count + self._consec_losses.
        # Stores _last_g85o2_ev_signal (+1/-1/0) for Kelly Step 41 [v82.0].
        try:
            _g85o2_metrics = getattr(self, "_metrics", None)
            _g85o2_wins    = int(getattr(_g85o2_metrics, "win_count", 0) or 0)
            _g85o2_losses  = int(getattr(_g85o2_metrics, "loss_count", 0) or 0)
            _g85o2_total   = _g85o2_wins + _g85o2_losses
            _g85o2_consec  = int(getattr(self, "_consec_losses", 0) or 0)
            _g85o2_wr      = (_g85o2_wins / _g85o2_total * 100.0) if _g85o2_total >= 10 else 50.0
            _g85o2_fired   = False
            self._last_g85o2_ev_signal = 0
            if _g85o2_total >= 10:
                if _g85o2_wr < 28.0 and _g85o2_consec >= 4:
                    quality_score -= 2.0
                    self._last_g85o2_ev_signal = -1
                    _g85o2_fired = True
                    _log.debug(
                        f"[G8.5O2-WREVCoh] LowWR+ConsecLoss REGIME "
                        f"wr={_g85o2_wr:.1f}% consec={_g85o2_consec} → −2.0pts"
                    )
                elif _g85o2_wr > 42.0 and _g85o2_consec == 0:
                    quality_score += 1.5
                    self._last_g85o2_ev_signal = 1
                    _g85o2_fired = True
                    _log.debug(
                        f"[G8.5O2-WREVCoh] HighWR+NoLoss REGIME "
                        f"wr={_g85o2_wr:.1f}% → +1.5pts"
                    )
                elif _g85o2_consec >= 3 and self._last_g85o2_ev_signal == 0:
                    quality_score -= 1.0
                    _g85o2_fired = True
                    _log.debug(
                        f"[G8.5O2-WREVCoh] ConsecLoss streak "
                        f"consec={_g85o2_consec} → −1.0pts"
                    )
            self._record("gate_g85o2_evcoherence", _g85o2_fired)
        except Exception:
            pass  # G8.5O2 WinRate-EV Coherence is non-fatal soft-gate

        # ── G8.5P2 — EV-Crisis Quality Gate (v83.0) ──────────────────────────
        # Zero-API-call soft-gate. Reads self.expected_value_r (lifetime EV per
        # trade in R-multiples) and self.max_drawdown_pct. Applies progressive
        # quality score penalties when the session is in confirmed EV-negative
        # territory, directly addressing the current EV=−0.314R drawdown regime.
        # Tiers:
        #   EV < −0.30R                       → −3.0pts (ultra-crisis; fires now)
        #   EV < −0.20R (and ≥ −0.30R)        → −1.5pts (crisis filter)
        #   MaxDD > 45% AND EV < −0.15R       → additional −1.0pts (compound)
        #   EV ≥ −0.20R                        → 0pts (neutral/positive EV)
        # Requires ≥10 resolved trades (sample guard); initialises _last_g85p2_ev_crisis.
        # Kelly Step 42 uses _last_g85p2_ev_crisis to de-size in EV-crisis regimes.
        try:
            _p2_total = int(getattr(self, "_metrics", None) and
                           (getattr(self._metrics, "win_count", 0) +
                            getattr(self._metrics, "loss_count", 0)) or 0)
            _p2_fired = False
            self._last_g85p2_ev_crisis = 0  # reset each cycle
            if _p2_total >= 10:
                _p2_ev    = float(self.expected_value_r)
                _p2_dd    = float(self.max_drawdown_pct)
                _p2_adj   = 0.0
                if _p2_ev < -0.30:
                    # Ultra-crisis: EV deeply negative — ruthless quality penalty
                    _p2_adj = -3.0
                    self._last_g85p2_ev_crisis = -1
                    quality_score += _p2_adj
                    _p2_fired = True
                    self._logger.debug(
                        f"📉 [v83.0 G8.5P2] EV-Crisis ULTRA: "
                        f"EV={_p2_ev:+.3f}R → {_p2_adj:+.1f}pts"
                    )
                elif _p2_ev < -0.20:
                    # Standard crisis: EV negative — moderate quality penalty
                    _p2_adj = -1.5
                    quality_score += _p2_adj
                    _p2_fired = True
                    self._logger.debug(
                        f"📉 [v83.0 G8.5P2] EV-Crisis STANDARD: "
                        f"EV={_p2_ev:+.3f}R → {_p2_adj:+.1f}pts"
                    )
                # Compound penalty: high MaxDD + negative EV
                if _p2_dd > 45.0 and _p2_ev < -0.15:
                    quality_score += -1.0
                    _p2_fired = True
                    self._logger.debug(
                        f"📉 [v83.0 G8.5P2] EV-Crisis COMPOUND: "
                        f"MaxDD={_p2_dd:.1f}%+EV={_p2_ev:+.3f}R → −1.0pts"
                    )
            self._record("gate_g85p2_evcrisis", _p2_fired)
        except Exception:
            pass  # G8.5P2 EV-Crisis is non-fatal soft-gate

        # ── G8.5Q — TrendMomentum-Persistence Gate (v84.0) ───────────────────
        # Zero-API-call soft-gate combining 3 momentum persistence signals:
        #   1. 10-bar close-buffer slope (from _quant_layer_close_buf[symbol])
        #   2. OFI persistence ring direction (majority vote from _ofi_persist_ring)
        #   3. VolumePressure-Regime signal (_last_g85l2_vpr_signal)
        # Decision against trade direction:
        #   2+ of 3 signals aligned with trade direction → +2.0pts
        #   All 3 opposed to trade direction → −2.0pts
        #   Mixed/neutral → 0pts
        # Requires close-buffer ≥ 8 bars (warm-up guard).
        # Stores _last_g85q_trendmom (+1/0/-1) for Kelly Step 43 [v84.0].
        try:
            _q_dir    = (direction or "").upper()
            _q_fired  = False
            self._last_g85q_trendmom = 0
            if _q_dir in ("BUY", "SELL"):
                _q_dir_sign = 1 if _q_dir == "BUY" else -1
                _q_votes_aligned  = 0
                _q_votes_opposed  = 0
                _q_votes_total    = 0
                # Vote 1: close-buffer slope
                _q_close_buf = _quant_layer_close_buf.get(symbol, None)
                if _q_close_buf is not None and len(_q_close_buf) >= 8:
                    _q_closes = list(_q_close_buf)[-10:]
                    if len(_q_closes) >= 2:
                        _q_slope = (_q_closes[-1] - _q_closes[0]) / max(abs(_q_closes[0]), 1e-10)
                        _q_votes_total += 1
                        if _q_slope * _q_dir_sign > 0.0001:
                            _q_votes_aligned += 1
                        elif _q_slope * _q_dir_sign < -0.0001:
                            _q_votes_opposed += 1
                # Vote 2: OFI persistence ring majority direction
                _q_opr = getattr(self, "_ofi_persist_ring", None)
                _q_ofi_ring = _q_opr.get(symbol, None) if isinstance(_q_opr, dict) else None
                if _q_ofi_ring is not None and len(_q_ofi_ring) >= 2:
                    _q_ofi_majority = sum(_q_ofi_ring)
                    _q_votes_total += 1
                    if _q_ofi_majority * _q_dir_sign > 0:
                        _q_votes_aligned += 1
                    elif _q_ofi_majority * _q_dir_sign < 0:
                        _q_votes_opposed += 1
                # Vote 3: VolumePressure-Regime signal
                _q_vpr = getattr(self, "_last_g85l2_vpr_signal", 0)
                if _q_vpr != 0:
                    _q_votes_total += 1
                    if _q_vpr * _q_dir_sign > 0:
                        _q_votes_aligned += 1
                    elif _q_vpr * _q_dir_sign < 0:
                        _q_votes_opposed += 1
                # Apply score adjustment
                if _q_votes_total >= 2:
                    if _q_votes_aligned >= 2:
                        quality_score += 2.0
                        self._last_g85q_trendmom = 1
                        _q_fired = True
                        self._logger.debug(
                            f"✅ [v84.0 G8.5Q] TrendMomPersist ALIGNED: "
                            f"{_q_votes_aligned}/{_q_votes_total} aligned → +2.0pts"
                        )
                    elif _q_votes_opposed == _q_votes_total and _q_votes_total >= 2:
                        quality_score -= 2.0
                        self._last_g85q_trendmom = -1
                        _q_fired = True
                        self._logger.debug(
                            f"📉 [v84.0 G8.5Q] TrendMomPersist OPPOSED: "
                            f"{_q_votes_opposed}/{_q_votes_total} opposed → -2.0pts"
                        )
            self._record("gate_g85q_trendmom", _q_fired)
        except Exception:
            pass  # G8.5Q is a non-fatal soft-gate

        # ── G8.5R2 — RegimeSentiment-Composite Gate (v84.0) ──────────────────
        # Zero-API-call soft-gate synthesising 3 existing regime sentiment signals:
        #   1. FundingMomentum-Persistence (_last_g85n2_fmp_signal: +1/-1/0)
        #   2. WinRateEV-Coherence (_last_g85o2_ev_signal: +1/-1/0)
        #   3. EV-Crisis Quality (_last_g85p2_ev_crisis: -1/0)
        # Decision:
        #   FundMom=+1 AND WR=+1 AND EV-Crisis=0 → +2.0pts (full regime support)
        #   FundMom=-1 AND WR=-1                  → -2.0pts (full regime opposition)
        #   FundMom=+1 only (WR neutral)           → +1.5pts (funding support signal)
        #   EV-Crisis=-1 (ultra crisis) compound   → additional -1.0pts
        # Stores _last_g85r2_regimesent (+1/0/-1) for Kelly Step 44 [v84.0].
        try:
            _r2_fired = False
            self._last_g85r2_regimesent = 0
            _r2_fmp    = getattr(self, "_last_g85n2_fmp_signal", 0)
            _r2_wrev   = getattr(self, "_last_g85o2_ev_signal", 0)
            _r2_evcris = getattr(self, "_last_g85p2_ev_crisis", 0)
            _r2_adj    = 0.0
            if _r2_fmp == 1 and _r2_wrev == 1 and _r2_evcris == 0:
                # Full regime support: funding+WR both confirm, no EV crisis
                _r2_adj = 2.0
                self._last_g85r2_regimesent = 1
                _r2_fired = True
                self._logger.debug(
                    f"✅ [v84.0 G8.5R2] RegimeSentiment FULL-SUPPORT: "
                    f"FundMom={_r2_fmp} WR={_r2_wrev} EVCris={_r2_evcris} → +2.0pts"
                )
            elif _r2_fmp == -1 and _r2_wrev == -1:
                # Full regime opposition: both signals oppose
                _r2_adj = -2.0
                self._last_g85r2_regimesent = -1
                _r2_fired = True
                self._logger.debug(
                    f"📉 [v84.0 G8.5R2] RegimeSentiment FULL-OPPOSITION: "
                    f"FundMom={_r2_fmp} WR={_r2_wrev} → -2.0pts"
                )
            elif _r2_fmp == 1 and _r2_wrev == 0:
                # Funding support only, WR neutral — partial boost
                _r2_adj = 1.5
                self._last_g85r2_regimesent = 1
                _r2_fired = True
                self._logger.debug(
                    f"✅ [v84.0 G8.5R2] RegimeSentiment FUNDING-ONLY: "
                    f"FundMom={_r2_fmp} WR={_r2_wrev} → +1.5pts"
                )
            if _r2_adj != 0.0:
                quality_score += _r2_adj
            # Compound EV-ultra-crisis penalty (additive)
            if _r2_evcris == -1 and _r2_adj <= 0.0:
                quality_score -= 1.0
                _r2_fired = True
                self._logger.debug(
                    f"📉 [v84.0 G8.5R2] RegimeSentiment EV-ULTRA-CRISIS compound: −1.0pts"
                )
            self._record("gate_g85r2_regimesent", _r2_fired)
        except Exception:
            pass  # G8.5R2 RegimeSentiment-Composite is non-fatal soft-gate

        # ── G8.5S2 — WinRate-CrisisRegime Gate (v85.0) ───────────────────────
        # Zero-API-call soft-gate: maps the Bayesian-blended session WR to a
        # quality-score adjustment that captures WR-regime severity in real time.
        # Decision matrix (Bayesian WR from booster):
        #   WR < 28% → -2.0pts (ultra-crisis: severe negative EV territory)
        #   WR < 35% → -1.5pts (crisis: below institutional viability floor)
        #   WR > 55% → +2.0pts (strong win momentum: regime confirmation)
        #   WR > 45% → +1.5pts (healthy regime: above neutral profitability)
        #   otherwise → 0pts (neutral zone [35-45%])
        # Stores _last_g85s2_crisis (+1/0/-1) for Kelly Step 45 [v85.0].
        try:
            _s2_fired = False
            self._last_g85s2_crisis = 0
            # Bayesian WR from the booster (already computed, zero-cost read)
            _s2_wr = float(getattr(self._booster, "wr_bayes", 0.35) or 0.35)
            _s2_adj = 0.0
            if _s2_wr > 0.55:
                _s2_adj = 2.0
                self._last_g85s2_crisis = 1
                _s2_fired = True
                self._logger.debug(
                    f"✅ [v85.0 G8.5S2] WRCrisisRegime STRONG-WIN: "
                    f"WR={_s2_wr:.1%} > 55% → +2.0pts"
                )
            elif _s2_wr > 0.45:
                _s2_adj = 1.5
                self._last_g85s2_crisis = 1
                _s2_fired = True
                self._logger.debug(
                    f"✅ [v85.0 G8.5S2] WRCrisisRegime HEALTHY: "
                    f"WR={_s2_wr:.1%} > 45% → +1.5pts"
                )
            elif _s2_wr < 0.28:
                _s2_adj = -2.0
                self._last_g85s2_crisis = -1
                _s2_fired = True
                self._logger.debug(
                    f"📉 [v85.0 G8.5S2] WRCrisisRegime ULTRA-CRISIS: "
                    f"WR={_s2_wr:.1%} < 28% → -2.0pts"
                )
            elif _s2_wr < 0.35:
                _s2_adj = -1.5
                self._last_g85s2_crisis = -1
                _s2_fired = True
                self._logger.debug(
                    f"📉 [v85.0 G8.5S2] WRCrisisRegime CRISIS: "
                    f"WR={_s2_wr:.1%} < 35% → -1.5pts"
                )
            if _s2_adj != 0.0:
                quality_score += _s2_adj
            self._record("gate_g85s2_wrcrisis", _s2_fired)
        except Exception:
            pass  # G8.5S2 WinRateCrisisRegime is non-fatal soft-gate

        # ── G8.5T2 — ExtremeFear-Regime Gate (v85.0) ─────────────────────────
        # Zero-API-call soft-gate: applies a directional quality bias when the
        # Fear&Greed index enters extreme zones (< 20 Extreme Fear or > 80 Extreme Greed).
        # In Extreme Fear (F&G<20): SELL direction aligns with the regime → bonus;
        # BUY against the panic → penalty.  Mirror for Extreme Greed (F&G>80).
        # Thresholds:
        #   F&G < 20 + SELL → +1.5pts  (fear-aligned directional confirmation)
        #   F&G < 20 + BUY  → -1.5pts  (contrarian-panic high-risk long)
        #   F&G 20-35 + SELL → +0.5pts (deep-fear mild regime alignment)
        #   F&G 20-35 + BUY  → -0.5pts (deep-fear mild caution)
        #   F&G > 80 + BUY  → +1.5pts  (greed-aligned directional confirmation)
        #   F&G > 80 + SELL → -1.5pts  (contrarian-greed high-risk short)
        #   F&G 65-80 + BUY  → +0.5pts (high-greed mild regime alignment)
        #   F&G 65-80 + SELL → -0.5pts (high-greed mild caution)
        # Stores _last_g85t2_fearreg (+1/0/-1) for Kelly Step 46 [v85.0].
        try:
            _t2_fired = False
            self._last_g85t2_fearreg = 0
            _t2_fg  = float(signal_data.get("fear_greed_index", 50) or 50)
            _t2_dir = str(signal_data.get("direction", "") or "").upper()
            _t2_adj = 0.0
            _t2_is_long = (_t2_dir == "BUY" or _t2_dir == "LONG")
            if _t2_fg < 20.0:
                # Extreme Fear zone
                if not _t2_is_long:
                    _t2_adj = 1.5    # SELL aligned with panic regime
                    self._last_g85t2_fearreg = 1
                else:
                    _t2_adj = -1.5   # BUY against panic = elevated risk
                    self._last_g85t2_fearreg = -1
                _t2_fired = True
                self._logger.debug(
                    f"{'✅' if _t2_adj > 0 else '📉'} [v85.0 G8.5T2] ExtremeFear: "
                    f"F&G={_t2_fg:.0f} dir={_t2_dir} → {_t2_adj:+.1f}pts"
                )
            elif _t2_fg < 35.0:
                # Deep Fear zone — mild adjustment
                if not _t2_is_long:
                    _t2_adj = 0.5
                    self._last_g85t2_fearreg = 1
                else:
                    _t2_adj = -0.5
                    self._last_g85t2_fearreg = -1
                _t2_fired = True
                self._logger.debug(
                    f"{'✅' if _t2_adj > 0 else '📉'} [v85.0 G8.5T2] DeepFear: "
                    f"F&G={_t2_fg:.0f} dir={_t2_dir} → {_t2_adj:+.1f}pts"
                )
            elif _t2_fg > 80.0:
                # Extreme Greed zone
                if _t2_is_long:
                    _t2_adj = 1.5    # BUY aligned with greed regime
                    self._last_g85t2_fearreg = 1
                else:
                    _t2_adj = -1.5   # SELL against greed = elevated risk
                    self._last_g85t2_fearreg = -1
                _t2_fired = True
                self._logger.debug(
                    f"{'✅' if _t2_adj > 0 else '📉'} [v85.0 G8.5T2] ExtremeGreed: "
                    f"F&G={_t2_fg:.0f} dir={_t2_dir} → {_t2_adj:+.1f}pts"
                )
            elif _t2_fg > 65.0:
                # High Greed zone — mild adjustment
                if _t2_is_long:
                    _t2_adj = 0.5
                    self._last_g85t2_fearreg = 1
                else:
                    _t2_adj = -0.5
                    self._last_g85t2_fearreg = -1
                _t2_fired = True
                self._logger.debug(
                    f"{'✅' if _t2_adj > 0 else '📉'} [v85.0 G8.5T2] HighGreed: "
                    f"F&G={_t2_fg:.0f} dir={_t2_dir} → {_t2_adj:+.1f}pts"
                )
            if _t2_adj != 0.0:
                quality_score += _t2_adj
            self._record("gate_g85t2_fearreg", _t2_fired)
        except Exception:
            pass  # G8.5T2 ExtremeFearRegime is non-fatal soft-gate

        # ── G8.5U2 — Vol-of-Vol Stability Regime Gate (v87.0) ────────────────
        # Zero-API-call soft-gate: computes Volatility-of-Volatility (VoV) —
        # the coefficient of variation (CV = std/mean) of the 10-bar ATR proxy
        # series derived from _quant_layer_close_buf rolling close prices.
        # A stable vol regime (low CV) means directional signals are more
        # reliable (vol itself is predictable); chaotic vol (high CV) means
        # whipsaw-prone conditions regardless of signal direction.
        # Thresholds:
        #   CV < 0.10 (stable)      → +1.5pts (low VoV, signals trustworthy)
        #   CV 0.10–0.20 (mild)     → +0.8pts (moderate VoV, OK quality)
        #   CV 0.20–0.35 (elevated) →  0.0pts (neutral, no bias)
        #   CV > 0.35 (chaotic)     → -1.5pts (high VoV, whipsaw risk)
        # Stores _last_g85u2_vov (+1/0/-1) for Kelly Step 47 [v87.0].
        # CRITICAL: use module-level _quant_layer_close_buf (NOT self.*) — see v75.0 fix.
        try:
            _u2_sym    = str(signal_data.get("symbol", "") or "")
            _u2_closes = list(_quant_layer_close_buf.get(_u2_sym, []))
            self._last_g85u2_vov = 0
            _u2_adj    = 0.0
            _u2_fired  = False
            if len(_u2_closes) >= 15:
                # Compute absolute bar-returns as ATR proxy (no True Range overhead)
                _u2_trs = [abs(_u2_closes[i] - _u2_closes[i - 1])
                           for i in range(1, len(_u2_closes))
                           if _u2_closes[i - 1] > 0]
                if len(_u2_trs) >= 10:
                    _u2_window = _u2_trs[-10:]
                    _u2_mean   = sum(_u2_window) / len(_u2_window)
                    if _u2_mean > 0:
                        _u2_std = (sum((_x - _u2_mean) ** 2 for _x in _u2_window) / len(_u2_window)) ** 0.5
                        _u2_cv  = _u2_std / _u2_mean   # coefficient of variation
                        _u2_fired = True
                        if _u2_cv < 0.10:
                            _u2_adj = 1.5     # stable vol regime — trend signals reliable
                            self._last_g85u2_vov = 1
                        elif _u2_cv < 0.20:
                            _u2_adj = 0.8     # mild VoV — moderate quality boost
                            self._last_g85u2_vov = 1
                        elif _u2_cv <= 0.35:
                            _u2_adj = 0.0     # elevated VoV — neutral
                            self._last_g85u2_vov = 0
                        else:
                            _u2_adj = -1.5    # chaotic vol — whipsaw risk significant
                            self._last_g85u2_vov = -1
                        self._logger.debug(
                            f"{'✅' if _u2_adj >= 0 else '📉'} [v87.0 G8.5U2] VoV-Stability: "
                            f"sym={_u2_sym} CV={_u2_cv:.3f} n={len(_u2_window)} → {_u2_adj:+.1f}pts"
                        )
            if _u2_adj != 0.0:
                quality_score += _u2_adj
            self._record("gate_g85u2_vov", _u2_fired)
        except Exception:
            pass  # G8.5U2 VoV-StabilityRegime is non-fatal soft-gate

        # ── Gate 8.5V2 — OrderBook Pressure Imbalance (v88.0) ────────────────
        # Zero-API-call soft-gate: reads already-cached WS orderbook state
        # (depth_imbalance per symbol from _ws_state dict) to detect direction-
        # aligned vs opposing institutional OB pressure.
        # depth_imbalance > 0: bids dominate (buy pressure)
        # depth_imbalance < 0: asks dominate (sell pressure)
        # Direction-aligned strong pressure (|imb|>0.15):  ±2.0pts
        # Direction-aligned moderate pressure (|imb|>0.06): +1.5pts
        # Neutral (|imb|≤0.06):                             0.0pts
        # Opposing strong pressure (|imb|>0.15):           -2.0pts
        # Stores _last_g85v2_obp (+1/-1/0) for Kelly Step 48 [v88.0].
        # CRITICAL: reads _ws_state via getattr(self, "_ws_state", {}) — see v75.0 fix.
        try:
            _v2_sym    = (symbol or "").upper()
            _v2_ws     = getattr(self, "_ws_state", None) or {}
            _v2_entry  = _v2_ws.get(_v2_sym) or {}
            _v2_imb    = float(_v2_entry.get("depth_imbalance", 0.0) or 0.0)
            _v2_dir    = (direction or "").upper()
            self._last_g85v2_obp = 0
            _v2_adj    = 0.0
            _v2_fired  = bool(_v2_entry)  # fired when WS state exists for this symbol
            if _v2_fired:
                _v2_aligned = (
                    (_v2_dir == "BUY"  and _v2_imb > 0.0) or
                    (_v2_dir == "SELL" and _v2_imb < 0.0)
                )
                _v2_abs = abs(_v2_imb)
                if _v2_abs < 0.06:
                    _v2_adj = 0.0              # neutral OB pressure — no adjustment
                    self._last_g85v2_obp = 0
                elif _v2_aligned and _v2_abs >= 0.15:
                    _v2_adj = 2.0              # strong aligned OB pressure
                    self._last_g85v2_obp = 1
                elif _v2_aligned:
                    _v2_adj = 1.5              # moderate aligned OB pressure
                    self._last_g85v2_obp = 1
                elif _v2_abs >= 0.15:
                    _v2_adj = -2.0             # strong opposing OB pressure (contra-institutional)
                    self._last_g85v2_obp = -1
                else:
                    _v2_adj = 0.0              # weak opposing — neutral
                    self._last_g85v2_obp = 0
                self._logger.debug(
                    f"{'✅' if _v2_adj >= 0 else '📉'} [v88.0 G8.5V2] OBPressure: "
                    f"sym={_v2_sym} dir={_v2_dir} depth_imb={_v2_imb:+.3f} "
                    f"aligned={_v2_aligned} → {_v2_adj:+.1f}pts"
                )
            if _v2_adj != 0.0:
                quality_score += _v2_adj
            self._record("gate_g85v2_obp", _v2_fired)
        except Exception:
            pass  # G8.5V2 OBPressure-Imbalance is non-fatal soft-gate

        # ── G8.5W2 — DrawdownMomentum-Sentinel Gate (v89.0) ──────────────────
        # Zero-API-call soft-gate. Reads self.max_drawdown_pct (session MaxDD %)
        # and session Sharpe ratio via booster reference. Combines both into a
        # compound drawdown momentum sentinel that fires when the system is
        # confirmed in a deep drawdown + negative Sharpe crisis regime.
        # Tiers (compound AND conditions):
        #   MaxDD > 48% AND Sharpe < -4.0  → -4.0pts (ultra-extreme deep ruin [v154.0])
        #   MaxDD > 45% AND Sharpe < -3.0  → -3.0pts (ultra-ruin sentinel)
        #   MaxDD > 40% AND Sharpe < -2.0  → -2.0pts (deep drawdown warning)
        #   MaxDD > 35% AND Sharpe < -1.0  → -1.5pts (moderate drawdown caution)
        #   MaxDD < 20% AND Sharpe > -1.0  → +1.5pts (healthy regime quality bonus)
        # Requires ≥10 resolved trades (sample guard). Stores _last_g85w2_ddm
        # (+1=healthy, -1=drawdown warning, 0=neutral) for Kelly Step 49 [v89.0/v154.0].
        try:
            _w2_total = int(getattr(self, "_metrics", None) and
                           (getattr(self._metrics, "win_count", 0) +
                            getattr(self._metrics, "loss_count", 0)) or 0)
            _w2_fired = False
            self._last_g85w2_ddm = 0  # reset each cycle
            if _w2_total >= 10:
                _w2_dd  = float(self.max_drawdown_pct)
                _w2_sr  = float(getattr(self._booster, "sharpe_ratio", 0.0) or 0.0) if self._booster else 0.0
                _w2_adj = 0.0
                if _w2_dd > 48.0 and _w2_sr < -4.0:
                    # Ultra-extreme deep ruin: DD>48% + Sharpe worse than -4.0 [v154.0]
                    _w2_adj = -4.0
                    self._last_g85w2_ddm = -1
                    quality_score += _w2_adj
                    _w2_fired = True
                    self._logger.debug(
                        f"📉 [v154.0 G8.5W2] DDMomentum ULTRA-EXTREME: "
                        f"MaxDD={_w2_dd:.1f}%>48% AND Sharpe={_w2_sr:+.2f}<-4.0 "
                        f"→ {_w2_adj:+.1f}pts"
                    )
                elif _w2_dd > 45.0 and _w2_sr < -3.0:
                    # Ultra-ruin sentinel: MaxDD extreme + Sharpe deeply negative
                    _w2_adj = -3.0
                    self._last_g85w2_ddm = -1
                    quality_score += _w2_adj
                    _w2_fired = True
                    self._logger.debug(
                        f"📉 [v89.0 G8.5W2] DDMomentum ULTRA-RUIN: "
                        f"MaxDD={_w2_dd:.1f}%>45% AND Sharpe={_w2_sr:+.2f}<-3.0 "
                        f"→ {_w2_adj:+.1f}pts"
                    )
                elif _w2_dd > 40.0 and _w2_sr < -2.0:
                    # Deep drawdown warning: substantial DD + Sharpe deeply negative
                    _w2_adj = -2.0
                    self._last_g85w2_ddm = -1
                    quality_score += _w2_adj
                    _w2_fired = True
                    self._logger.debug(
                        f"📉 [v89.0 G8.5W2] DDMomentum DEEP-DD: "
                        f"MaxDD={_w2_dd:.1f}%>40% AND Sharpe={_w2_sr:+.2f}<-2.0 "
                        f"→ {_w2_adj:+.1f}pts"
                    )
                elif _w2_dd > 35.0 and _w2_sr < -1.0:
                    # Moderate drawdown caution: elevated DD + Sharpe negative
                    _w2_adj = -1.5
                    self._last_g85w2_ddm = -1
                    quality_score += _w2_adj
                    _w2_fired = True
                    self._logger.debug(
                        f"📉 [v89.0 G8.5W2] DDMomentum CAUTION: "
                        f"MaxDD={_w2_dd:.1f}%>35% AND Sharpe={_w2_sr:+.2f}<-1.0 "
                        f"→ {_w2_adj:+.1f}pts"
                    )
                elif _w2_dd < 20.0 and _w2_sr > -1.0:
                    # Healthy regime: low DD + Sharpe near-positive → quality bonus
                    _w2_adj = 1.5
                    self._last_g85w2_ddm = 1
                    quality_score += _w2_adj
                    _w2_fired = True
                    self._logger.debug(
                        f"✅ [v89.0 G8.5W2] DDMomentum HEALTHY: "
                        f"MaxDD={_w2_dd:.1f}%<20% AND Sharpe={_w2_sr:+.2f}>-1.0 "
                        f"→ {_w2_adj:+.1f}pts"
                    )
            self._record("gate_g85w2_ddm", _w2_fired)
        except Exception:
            pass  # G8.5W2 DrawdownMomentum-Sentinel is non-fatal soft-gate

        # ── G8.5X2 — WinRateTrajectory Gate (v90.0) ──────────────────────────
        # Zero-API-call soft-gate comparing recent booster RL-ring WR vs all-time WR.
        # Uses already-computed booster _rl_wins/_rl_ring_size (RL ring, last ~20 trades)
        # vs session all-time win_count/loss_count.
        # Tiers (based on delta = recent_wr - alltime_wr):
        #   delta < -0.08 (recent 8+pp worse): -2.0pts (strongly deteriorating trajectory)
        #   delta < -0.05 (recent 5+pp worse): -1.0pts (mild deterioration warning)
        #   delta > +0.08 (recent 8+pp better): +2.0pts (recovering momentum bonus)
        # Requires >=20 total trades + booster ring >=10. Stores _last_g85x2_wrt
        # (+1=recovering, -1=deteriorating, 0=neutral) for Kelly Step 50 [v90.0].
        try:
            # v143.1 FIX: UnitySignalFilter has no self._metrics (only UnityConsole
            # does) — the old direct attribute access raised AttributeError every
            # cycle, killing this gate (zero-call). Resolve safely and fall back to
            # the booster's all-time win-rate ring when no metrics object is wired.
            _x2_metrics = getattr(self, "_metrics", None)
            _x2_bst0    = getattr(self, "_booster", None)
            if _x2_metrics is not None:
                _x2_wc    = float(getattr(_x2_metrics, "win_count", 0) or 0)
                _x2_total = int(_x2_wc + float(getattr(_x2_metrics, "loss_count", 0) or 0))
            elif _x2_bst0 is not None and len(getattr(_x2_bst0, "_win_ring", []) or []) >= 20:
                _x2_wr_ring = list(getattr(_x2_bst0, "_win_ring", []) or [])
                _x2_total   = len(_x2_wr_ring)
                _x2_wc      = float(sum(1 for _w in _x2_wr_ring if _w))
            else:
                _x2_wc    = 0.0
                _x2_total = 0
            _x2_fired = False
            self._last_g85x2_wrt = 0  # reset each cycle
            if _x2_total >= 20:
                # All-time WR (session baseline)
                _x2_at_wr = _x2_wc / max(1.0, float(_x2_total))
                # Recent WR from booster RL ring
                _x2_bst = self._booster if self._booster else None
                _x2_rw  = int(getattr(_x2_bst, "_rl_wins", -1))
                _x2_rs  = int(getattr(_x2_bst, "_rl_ring_size", 0))
                if _x2_rw >= 0 and _x2_rs >= 10:
                    _x2_recent_wr = float(_x2_rw) / float(_x2_rs)
                    _x2_delta = _x2_recent_wr - _x2_at_wr
                    _x2_adj = 0.0
                    if _x2_delta < -0.08:
                        # Strongly deteriorating: recent WR >8pp below all-time
                        _x2_adj = -2.0
                        self._last_g85x2_wrt = -1
                        quality_score += _x2_adj
                        _x2_fired = True
                        self._logger.debug(
                            f"📉 [v90.0 G8.5X2] WRTrajectory DETERIORATING: "
                            f"recent={_x2_recent_wr:.1%} alltime={_x2_at_wr:.1%} "
                            f"delta={_x2_delta:+.1%} -> {_x2_adj:+.1f}pts"
                        )
                    elif _x2_delta < -0.05:
                        # Mild deterioration warning
                        _x2_adj = -1.0
                        self._last_g85x2_wrt = -1
                        quality_score += _x2_adj
                        _x2_fired = True
                        self._logger.debug(
                            f"⚠️ [v90.0 G8.5X2] WRTrajectory MILD-WARN: "
                            f"recent={_x2_recent_wr:.1%} alltime={_x2_at_wr:.1%} "
                            f"delta={_x2_delta:+.1%} -> {_x2_adj:+.1f}pts"
                        )
                    elif _x2_delta > 0.08:
                        # Recovering momentum: recent WR >8pp above all-time
                        _x2_adj = 2.0
                        self._last_g85x2_wrt = 1
                        quality_score += _x2_adj
                        _x2_fired = True
                        self._logger.debug(
                            f"✅ [v90.0 G8.5X2] WRTrajectory RECOVERING: "
                            f"recent={_x2_recent_wr:.1%} alltime={_x2_at_wr:.1%} "
                            f"delta={_x2_delta:+.1%} -> {_x2_adj:+.1f}pts"
                        )
            self._record("gate_g85x2_wrt", _x2_fired)
        except Exception:
            pass  # G8.5X2 is a non-fatal soft-gate

        # ── G8.5Y2 — HMM-VPIN-Coherence Gate (v91.0) ────────────────────────
        # Dual-source institutional-flow coherence gate: HMM regime state + VPIN toxicity.
        # Uses already-computed self._hmm_regime + self._vpin_model (both in pipeline).
        # Tiers:
        #   EXPANSION-HMM + clean VPIN (pct<0.20) + aligned direction  -> +2.0pts
        #   EXPANSION-HMM OR clean VPIN (only one source aligns)        -> +1.5pts
        #   CONTRACTION-HMM + toxic VPIN (pct>0.80) + opposing dir      -> -2.0pts
        #   CONTRACTION-HMM OR toxic VPIN (one source diverges)         -> -1.5pts
        # Stores _last_g85y2_hvc (+1=coherent, -1=divergent, 0=neutral)
        # for Kelly Step 51. Zero-API-call gate [v91.0].
        try:
            _y2_fired = False
            self._last_g85y2_hvc = 0  # reset each cycle
            _y2_sig_dir = signal_data.get("action", signal_data.get("direction", "")) if isinstance(signal_data, dict) else ""  # v99.0: "action" key fix
            # HMM regime state
            _y2_hmm_ref = getattr(self, "_hmm_regime", None)
            _y2_hmm_regime = "UNKNOWN"
            _y2_hmm_p_exp  = 0.5
            if _y2_hmm_ref is not None:
                try:
                    _y2_hmm_regime, _y2_hmm_p_exp, _ = _y2_hmm_ref.get_regime()
                except Exception:
                    pass
            # VPIN toxicity
            _y2_vpin_ref = getattr(self, "_vpin_model", None)
            _y2_vpin_pct  = 0.5
            _y2_vpin_toxic = False
            if _y2_vpin_ref is not None and getattr(_y2_vpin_ref, "is_ready", False):
                try:
                    _, _y2_vpin_pct, _, _y2_vpin_toxic = _y2_vpin_ref.get_signal()
                except Exception:
                    pass
            # Direction alignment
            _y2_is_long  = _y2_sig_dir in ("LONG",  "BUY",  "long",  "buy")
            _y2_is_short = _y2_sig_dir in ("SHORT", "SELL", "short", "sell")
            _y2_expansion    = _y2_hmm_regime in ("EXPANSION",)
            _y2_contraction  = _y2_hmm_regime in ("CONTRACTION",)
            _y2_clean_flow   = _y2_vpin_pct < 0.20 and not _y2_vpin_toxic
            _y2_toxic_flow   = _y2_vpin_pct > 0.80 or _y2_vpin_toxic
            _y2_hmm_aligned  = (_y2_expansion and _y2_is_long) or (_y2_contraction and _y2_is_short)
            _y2_hmm_opposed  = (_y2_expansion and _y2_is_short) or (_y2_contraction and _y2_is_long)
            if _y2_hmm_regime != "UNKNOWN" or _y2_vpin_ref is not None:
                _y2_adj = 0.0
                if _y2_hmm_aligned and _y2_clean_flow:
                    # Both sources coherently confirm direction
                    _y2_adj = 2.0
                    self._last_g85y2_hvc = 1
                    _y2_fired = True
                    self._logger.debug(
                        f"🏆 [v91.0 G8.5Y2] HMM-VPIN FULL-COHERENCE: "
                        f"HMM={_y2_hmm_regime}(p={_y2_hmm_p_exp:.2f}) VPIN_pct={_y2_vpin_pct:.3f} "
                        f"dir={_y2_sig_dir} -> +2.0pts"
                    )
                elif _y2_hmm_aligned and not _y2_toxic_flow:
                    # HMM aligned, VPIN neutral (partial coherence)
                    _y2_adj = 1.5
                    self._last_g85y2_hvc = 1
                    _y2_fired = True
                    self._logger.debug(
                        f"✅ [v91.0 G8.5Y2] HMM-VPIN PARTIAL-COHERENCE (HMM): "
                        f"HMM={_y2_hmm_regime} VPIN_pct={_y2_vpin_pct:.3f} -> +1.5pts"
                    )
                elif not _y2_hmm_opposed and _y2_clean_flow:
                    # VPIN clean flow, HMM neutral (partial coherence)
                    _y2_adj = 1.5
                    self._last_g85y2_hvc = 1
                    _y2_fired = True
                    self._logger.debug(
                        f"✅ [v91.0 G8.5Y2] HMM-VPIN PARTIAL-COHERENCE (VPIN): "
                        f"HMM={_y2_hmm_regime} VPIN_pct={_y2_vpin_pct:.3f} -> +1.5pts"
                    )
                elif _y2_hmm_opposed and _y2_toxic_flow:
                    # Both sources oppose direction (full divergence)
                    _y2_adj = -2.0
                    self._last_g85y2_hvc = -1
                    _y2_fired = True
                    self._logger.debug(
                        f"🚨 [v91.0 G8.5Y2] HMM-VPIN FULL-DIVERGENCE: "
                        f"HMM={_y2_hmm_regime} VPIN_pct={_y2_vpin_pct:.3f} "
                        f"dir={_y2_sig_dir} -> -2.0pts"
                    )
                elif _y2_hmm_opposed or _y2_toxic_flow:
                    # One source diverges (partial divergence)
                    _y2_adj = -1.5
                    self._last_g85y2_hvc = -1
                    _y2_fired = True
                    self._logger.debug(
                        f"⚠️  [v91.0 G8.5Y2] HMM-VPIN PARTIAL-DIVERGENCE: "
                        f"HMM={_y2_hmm_regime} VPIN_pct={_y2_vpin_pct:.3f} -> -1.5pts"
                    )
                if _y2_adj != 0.0:
                    quality_score += _y2_adj
            self._record("gate_g85y2_hvc", _y2_fired)
        except Exception:
            pass  # G8.5Y2 HMM-VPIN-Coherence is non-fatal soft-gate

        # ── G8.5Z2 — Regime-Momentum-Sync Gate (v92.0) ──────────────────────
        # Triple-source zero-API confluence: HMM regime direction + OFI z-score
        # direction + funding rate trend direction.  All three are already computed
        # in the pipeline (no extra API calls).
        # Scoring: count how many of the 3 sources align with signal direction.
        #   3/3 aligned  -> +2.0pts  (triple institutional confluence)
        #   2/3 aligned  -> +1.5pts  (dual confluence)
        #   2/3 opposed  -> -1.5pts  (dual regime resistance)
        #   3/3 opposed  -> -2.0pts  (triple regime resistance)
        # Stores _last_g85z2_rms (+1/-1/0) for Kelly Step 52 [v92.0].
        try:
            _z2_fired = False
            self._last_g85z2_rms = 0
            _z2_sig_dir = signal_data.get("action", signal_data.get("direction", "")) if isinstance(signal_data, dict) else ""  # v99.0: "action" key fix
            _z2_is_long  = _z2_sig_dir in ("LONG",  "BUY",  "long",  "buy")
            _z2_is_short = _z2_sig_dir in ("SHORT", "SELL", "short", "sell")
            if _z2_is_long or _z2_is_short:
                _z2_dir_sign = 1 if _z2_is_long else -1
                # Source 1: HMM regime (EXPANSION=bullish, CONTRACTION=bearish)
                _z2_hmm_ref = getattr(self, "_hmm_regime", None)
                _z2_hmm_sign = 0
                if _z2_hmm_ref is not None:
                    try:
                        _z2_hmm_str, _, _ = _z2_hmm_ref.get_regime()
                        if _z2_hmm_str == "EXPANSION":
                            _z2_hmm_sign = 1
                        elif _z2_hmm_str == "CONTRACTION":
                            _z2_hmm_sign = -1
                    except Exception:
                        pass
                # Source 2: OFI z-score direction (already in signal_data)
                _z2_ofi_z = float(signal_data.get("ofi_z", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                _z2_ofi_sign = (1 if _z2_ofi_z > 0.3 else (-1 if _z2_ofi_z < -0.3 else 0))
                # Source 3: Funding rate trend direction (already in signal_data)
                _z2_fr_trend = float(signal_data.get("funding_rate_trend", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                # Negative funding rate = bullish (shorts paying longs); positive = bearish
                _z2_fund_sign = (1 if _z2_fr_trend < -0.00005 else (-1 if _z2_fr_trend > 0.00005 else 0))
                # Count alignment vs opposition vs neutral
                _z2_sources = [_z2_hmm_sign, _z2_ofi_sign, _z2_fund_sign]
                _z2_active_sources = [s for s in _z2_sources if s != 0]
                if _z2_active_sources:
                    _z2_aligned  = sum(1 for s in _z2_active_sources if s == _z2_dir_sign)
                    _z2_opposed  = sum(1 for s in _z2_active_sources if s == -_z2_dir_sign)
                    _z2_n        = len(_z2_active_sources)
                    _z2_adj = 0.0
                    if _z2_aligned == 3:
                        _z2_adj = 2.0;  self._last_g85z2_rms = 1;  _z2_fired = True
                        self._logger.debug(
                            f"🏆 [v92.0 G8.5Z2] RMS TRIPLE-SYNC: HMM={_z2_hmm_sign:+d} "
                            f"OFI={_z2_ofi_sign:+d}(z={_z2_ofi_z:.2f}) FUND={_z2_fund_sign:+d} "
                            f"dir={_z2_sig_dir} -> +2.0pts"
                        )
                    elif _z2_aligned == 2 and _z2_n >= 2:
                        _z2_adj = 1.5;  self._last_g85z2_rms = 1;  _z2_fired = True
                        self._logger.debug(
                            f"✅ [v92.0 G8.5Z2] RMS DUAL-SYNC: {_z2_aligned}/3 align dir={_z2_sig_dir} -> +1.5pts"
                        )
                    elif _z2_opposed == 3:
                        _z2_adj = -2.0; self._last_g85z2_rms = -1; _z2_fired = True
                        self._logger.debug(
                            f"🚨 [v92.0 G8.5Z2] RMS TRIPLE-RESIST: all 3 oppose dir={_z2_sig_dir} -> -2.0pts"
                        )
                    elif _z2_opposed == 2 and _z2_n >= 2:
                        _z2_adj = -1.5; self._last_g85z2_rms = -1; _z2_fired = True
                        self._logger.debug(
                            f"⚠️  [v92.0 G8.5Z2] RMS DUAL-RESIST: {_z2_opposed}/3 oppose dir={_z2_sig_dir} -> -1.5pts"
                        )
                    if _z2_adj != 0.0:
                        quality_score += _z2_adj
            self._record("gate_g85z2_rms", _z2_fired)
        except Exception:
            pass  # G8.5Z2 RegimeMomentumSync is non-fatal soft-gate

        # ── G8.5A3 — VPIN-OFI-Funding Triple-Confluence Gate (v93.0) ─────────
        # Zero-API cross-validation gate that independently combines three
        # already-computed flow/regime sources:
        #   Source 1: VPIN toxicity percentile (from _vpin_model.get_signal())
        #   Source 2: OFI z-score direction (+1/>0.3, -1/<-0.3, 0=neutral)
        #   Source 3: Funding rate trend direction (+1=bulls pay, -1=bears pay)
        # VPIN sign convention: clean VPIN (<0.25 pct) = +1 (favours LONGs);
        #   toxic VPIN (>0.75 pct) = -1 (adverse-selection warning for LONGs).
        # Gate scoring (vs signal direction):
        #   VPIN-clean + OFI-aligned + Fund-aligned → +2.0pts (triple confluence)
        #   2/3 sources aligned (any combo) → +1.5pts (dual confluence)
        #   VPIN-toxic + OFI-opposed + Fund-opposed → -2.0pts (triple toxic warning)
        #   2/3 sources opposed → -1.5pts (dual toxic warning)
        # Stores _last_g85a3_vpc (+1/-1/0) for Kelly Step 53 [v93.0].
        try:
            _a3_fired = False
            self._last_g85a3_vpc = 0
            _a3_sig_dir  = signal_data.get("action", signal_data.get("direction", "")) if isinstance(signal_data, dict) else ""  # v99.0: "action" key fix
            _a3_is_long  = _a3_sig_dir in ("LONG",  "BUY",  "long",  "buy")
            _a3_is_short = _a3_sig_dir in ("SHORT", "SELL", "short", "sell")
            if _a3_is_long or _a3_is_short:
                _a3_dir_sign = 1 if _a3_is_long else -1
                # Source 1: VPIN toxicity (clean=aligned-with-LONGs, toxic=against)
                _a3_vpin_ref = getattr(self, "_vpin_model", None)
                _a3_vpin_pct = 0.5  # default neutral
                if _a3_vpin_ref is not None:
                    try:
                        _a3_vs       = _a3_vpin_ref.get_signal()
                        _a3_vpin_pct = float((_a3_vs or {}).get("vpin_pct", 0.5) or 0.5)
                    except Exception:
                        pass
                # VPIN sign relative to signal direction:
                # clean VPIN (<0.25) → clean-flow for LONG (+1 vs LONG; -1 vs SHORT)
                # toxic VPIN (>0.75) → adverse-selection for LONG (-1 vs LONG; +1 vs SHORT)
                if _a3_vpin_pct < 0.25:
                    _a3_vpin_sign = 1 * _a3_dir_sign  # clean = aligns with direction
                elif _a3_vpin_pct > 0.75:
                    _a3_vpin_sign = -1 * _a3_dir_sign  # toxic = opposes direction
                else:
                    _a3_vpin_sign = 0  # neutral zone
                # Source 2: OFI z-score direction
                _a3_ofi_z    = float(signal_data.get("ofi_z", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                _a3_ofi_sign = 1 if _a3_ofi_z > 0.3 else (-1 if _a3_ofi_z < -0.3 else 0)
                # map OFI sign to agreement with signal direction
                _a3_ofi_conf = _a3_ofi_sign * _a3_dir_sign if _a3_ofi_sign != 0 else 0
                # Source 3: Funding rate trend direction (bear-pays = positive fr → LONG favoured)
                _a3_fr_t      = float(signal_data.get("funding_rate_trend", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                _a3_fund_sign = 1 if _a3_fr_t < -0.00005 else (-1 if _a3_fr_t > 0.00005 else 0)
                _a3_fund_conf = _a3_fund_sign * _a3_dir_sign if _a3_fund_sign != 0 else 0
                # Count active sources and their alignment
                _a3_confs  = [c for c in [_a3_vpin_sign, _a3_ofi_conf, _a3_fund_conf] if c != 0]
                _a3_n      = len(_a3_confs)
                _a3_align  = sum(1 for c in _a3_confs if c > 0)
                _a3_oppose = sum(1 for c in _a3_confs if c < 0)
                _a3_adj    = 0.0
                if _a3_n >= 2:
                    if _a3_align == _a3_n and _a3_n == 3:
                        _a3_adj = 2.0; self._last_g85a3_vpc = 1; _a3_fired = True
                        self._logger.debug(
                            f"🏆 [v93.0 G8.5A3] VPC TRIPLE-CONF: all 3 aligned dir={_a3_sig_dir} -> +2.0pts"
                        )
                    elif _a3_align >= 2 and _a3_align > _a3_oppose:
                        _a3_adj = 1.5; self._last_g85a3_vpc = 1; _a3_fired = True
                        self._logger.debug(
                            f"✅ [v93.0 G8.5A3] VPC DUAL-CONF: {_a3_align}/{_a3_n} aligned dir={_a3_sig_dir} -> +1.5pts"
                        )
                    elif _a3_oppose == _a3_n and _a3_n == 3:
                        _a3_adj = -2.0; self._last_g85a3_vpc = -1; _a3_fired = True
                        self._logger.debug(
                            f"🚨 [v93.0 G8.5A3] VPC TRIPLE-TOXIC: all 3 oppose dir={_a3_sig_dir} -> -2.0pts"
                        )
                    elif _a3_oppose >= 2 and _a3_oppose > _a3_align:
                        _a3_adj = -1.5; self._last_g85a3_vpc = -1; _a3_fired = True
                        self._logger.debug(
                            f"⚠️  [v93.0 G8.5A3] VPC DUAL-TOXIC: {_a3_oppose}/{_a3_n} oppose dir={_a3_sig_dir} -> -1.5pts"
                        )
                    if _a3_adj != 0.0:
                        quality_score += _a3_adj
            self._record("gate_g85a3_vpc", _a3_fired)
        except Exception:
            pass  # G8.5A3 VPIN-OFI-Funding Triple-Confluence is non-fatal soft-gate

        # ── G8.5B3 — HMM-OFI-Spread Triple-Sync Gate (v94.0) ────────────────
        # Zero-API soft-gate that cross-validates three independently-computed
        # microstructure regime signals vs the signal direction:
        #   Source 1: HMM state (BULL/BEAR/TRENDING/RANGING/TRANSITIONING)
        #   Source 2: OFI z-score direction (+1/>0.3 / -1/<-0.3 / 0=neutral)
        #   Source 3: SpreadLiquidity gate output (_last_g85k_slq: +1=liquid/−1=illiquid)
        # Agreement convention: each source is mapped to +1 (favours trade),
        #   -1 (opposes trade), or 0 (neutral/absent).
        # Gate scoring:
        #   All 3 aligned → +2.0pts (triple sync — clean microstructure)
        #   2/3 aligned   → +1.5pts (dual sync)
        #   All 3 opposed → -2.0pts (triple hostility — regime against trade)
        #   2/3 opposed   → -1.5pts (dual hostility)
        # Needs ≥2 active (non-zero) sources to score.
        # Stores _last_g85b3_hos (+1/-1/0) for Kelly Step 54 [v94.0].
        try:
            _b3_fired = False
            self._last_g85b3_hos = 0
            _b3_sd       = signal_data.get("action", signal_data.get("direction", "")) if isinstance(signal_data, dict) else ""  # v99.0: "action" key fix
            _b3_is_long  = _b3_sd in ("LONG",  "BUY",  "long",  "buy")
            _b3_is_short = _b3_sd in ("SHORT", "SELL", "short", "sell")
            if _b3_is_long or _b3_is_short:
                _b3_dir_sign = 1 if _b3_is_long else -1
                # Source 1: HMM state alignment
                _b3_hmm_state = signal_data.get("hmm_state", None) if isinstance(signal_data, dict) else None
                if isinstance(_b3_hmm_state, str):
                    _b3_hmm_s = 1 if _b3_hmm_state.upper() in ("BULL", "BULLISH", "TRENDING") else \
                                (-1 if _b3_hmm_state.upper() in ("BEAR", "BEARISH") else 0)
                else:
                    _b3_hmm_s = 0
                _b3_hmm_conf = _b3_hmm_s * _b3_dir_sign if _b3_hmm_s != 0 else 0
                # Source 2: OFI z-score direction
                _b3_ofi_z    = float(signal_data.get("ofi_z", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                _b3_ofi_s    = 1 if _b3_ofi_z > 0.3 else (-1 if _b3_ofi_z < -0.3 else 0)
                _b3_ofi_conf = _b3_ofi_s * _b3_dir_sign if _b3_ofi_s != 0 else 0
                # Source 3: SpreadLiq output (liquid=+1=any-direction-ok; illiquid=-1=hostile)
                _b3_slq_s    = int(getattr(self, "_last_g85k_slq", 0))
                _b3_slq_conf = _b3_slq_s if _b3_slq_s != 0 else 0
                # Score
                _b3_confs    = [c for c in [_b3_hmm_conf, _b3_ofi_conf, _b3_slq_conf] if c != 0]
                _b3_n        = len(_b3_confs)
                _b3_align    = sum(1 for c in _b3_confs if c > 0)
                _b3_oppose   = sum(1 for c in _b3_confs if c < 0)
                _b3_adj      = 0.0
                if _b3_n >= 2:
                    if _b3_align == _b3_n and _b3_n == 3:
                        _b3_adj = 2.0; self._last_g85b3_hos = 1; _b3_fired = True
                        self._logger.debug(
                            f"🏆 [v94.0 G8.5B3] HOS TRIPLE-SYNC: all 3 aligned dir={_b3_sd} -> +2.0pts"
                        )
                    elif _b3_align >= 2 and _b3_align > _b3_oppose:
                        _b3_adj = 1.5; self._last_g85b3_hos = 1; _b3_fired = True
                        self._logger.debug(
                            f"✅ [v94.0 G8.5B3] HOS DUAL-SYNC: {_b3_align}/{_b3_n} aligned dir={_b3_sd} -> +1.5pts"
                        )
                    elif _b3_oppose == _b3_n and _b3_n == 3:
                        _b3_adj = -2.0; self._last_g85b3_hos = -1; _b3_fired = True
                        self._logger.debug(
                            f"🚨 [v94.0 G8.5B3] HOS TRIPLE-HOSTILE: all 3 opposed dir={_b3_sd} -> -2.0pts"
                        )
                    elif _b3_oppose >= 2 and _b3_oppose > _b3_align:
                        _b3_adj = -1.5; self._last_g85b3_hos = -1; _b3_fired = True
                        self._logger.debug(
                            f"⚠️  [v94.0 G8.5B3] HOS DUAL-HOSTILE: {_b3_oppose}/{_b3_n} opposed dir={_b3_sd} -> -1.5pts"
                        )
                    if _b3_adj != 0.0:
                        quality_score += _b3_adj
            self._record("gate_g85b3_hos", _b3_fired)
        except Exception:
            pass  # G8.5B3 HMM-OFI-Spread Triple-Sync is non-fatal soft-gate

        # ── G8.5C3 — VolumeFlow-OFI-EV Triple-Convergence Gate (v95.0) ──────
        # Zero-API soft-gate that cross-validates three independently-sourced
        # microstructure and EV-quality signals vs the signal direction:
        #   Source 1: VolPressure-Regime gate output (_last_g85l2_vpr: +1/-1/0)
        #             G8.5L2 fires when vol_ratio≥1.5× cross-validated with OFI direction
        #   Source 2: OFI-Persistence gate output (_last_g85b_ofi: +1/-1/0)
        #             G8.5B fires when 3-cycle OFI ring aligns with trade direction
        #   Source 3: EV quality tier — current signal's Expected Value vs risk budget
        #             EV≥0.8R → +1 (high quality), EV<0.4R → -1 (low quality), else 0
        # Gate scoring (identical to G8.5A3/B3 triple-sync pattern):
        #   All 3 aligned  → +2.0pts (triple convergence — clean flow+volume+EV)
        #   2/3 aligned    → +1.5pts (dual convergence)
        #   All 3 opposed  → -2.0pts (triple hostility — volume, flow, and EV all against)
        #   2/3 opposed    → -1.5pts (dual hostility)
        # Needs ≥2 active (non-zero) sources to score.
        # Stores _last_g85c3_voe (+1/-1/0) for Kelly Step 55 [v95.0].
        try:
            _c3_fired = False
            self._last_g85c3_voe = 0
            _c3_sd       = signal_data.get("action", signal_data.get("direction", "")) if isinstance(signal_data, dict) else ""  # v99.0: "action" key fix
            _c3_is_long  = _c3_sd in ("LONG",  "BUY",  "long",  "buy")
            _c3_is_short = _c3_sd in ("SHORT", "SELL", "short", "sell")
            if _c3_is_long or _c3_is_short:
                _c3_dir_sign = 1 if _c3_is_long else -1
                # Source 1: VolPressure-Regime gate output
                _c3_vpr_s    = int(getattr(self, "_last_g85l2_vpr", 0))
                _c3_vpr_conf = _c3_vpr_s * _c3_dir_sign if _c3_vpr_s != 0 else 0
                # Source 2: OFI-Persistence gate output
                _c3_ofi_s    = int(getattr(self, "_last_g85b_ofi", 0))
                _c3_ofi_conf = _c3_ofi_s * _c3_dir_sign if _c3_ofi_s != 0 else 0
                # Source 3: EV quality tier
                _c3_ev       = float(signal_data.get("ev", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                _c3_ev_s     = 1 if _c3_ev >= 0.8 else (-1 if _c3_ev < 0.4 else 0)
                _c3_ev_conf  = _c3_ev_s if _c3_ev_s != 0 else 0
                # Score
                _c3_confs  = [c for c in [_c3_vpr_conf, _c3_ofi_conf, _c3_ev_conf] if c != 0]
                _c3_n      = len(_c3_confs)
                _c3_align  = sum(1 for c in _c3_confs if c > 0)
                _c3_oppose = sum(1 for c in _c3_confs if c < 0)
                _c3_adj    = 0.0
                if _c3_n >= 2:
                    if _c3_align == _c3_n and _c3_n == 3:
                        _c3_adj = 2.0; self._last_g85c3_voe = 1; _c3_fired = True
                        self._logger.debug(
                            f"🏆 [v95.0 G8.5C3] VOE TRIPLE-CONVERGENCE: all 3 aligned dir={_c3_sd} EV={_c3_ev:.3f}R -> +2.0pts"
                        )
                    elif _c3_align >= 2 and _c3_align > _c3_oppose:
                        _c3_adj = 1.5; self._last_g85c3_voe = 1; _c3_fired = True
                        self._logger.debug(
                            f"✅ [v95.0 G8.5C3] VOE DUAL-CONVERGENCE: {_c3_align}/{_c3_n} aligned dir={_c3_sd} -> +1.5pts"
                        )
                    elif _c3_oppose == _c3_n and _c3_n == 3:
                        _c3_adj = -2.0; self._last_g85c3_voe = -1; _c3_fired = True
                        self._logger.debug(
                            f"🚨 [v95.0 G8.5C3] VOE TRIPLE-HOSTILE: all 3 opposed dir={_c3_sd} EV={_c3_ev:.3f}R -> -2.0pts"
                        )
                    elif _c3_oppose >= 2 and _c3_oppose > _c3_align:
                        _c3_adj = -1.5; self._last_g85c3_voe = -1; _c3_fired = True
                        self._logger.debug(
                            f"⚠️  [v95.0 G8.5C3] VOE DUAL-HOSTILE: {_c3_oppose}/{_c3_n} opposed dir={_c3_sd} -> -1.5pts"
                        )
                    if _c3_adj != 0.0:
                        quality_score += _c3_adj
            self._record("gate_g85c3_voe", _c3_fired)
        except Exception:
            pass  # G8.5C3 VolumeFlow-OFI-EV Triple-Convergence is non-fatal soft-gate

        # ── G8.5D3 — Regime-Drawdown-WinRate Triple-Risk Gate (v96.0) ────────
        # Zero-API soft-gate that cross-validates three independently-computed
        # performance and risk-health gate outputs:
        #   Source 1: RegimeSentiment-Composite gate (_last_g85r2_rs: +1/-1/0)
        #             G8.5R2 fires when FundMom+WREV+EVCrisis agree on regime health
        #   Source 2: DrawdownMomentum-Sentinel gate (_last_g85w2_ddm: +1/-1/0)
        #             G8.5W2 fires when MaxDD+Sharpe compound risk tiers align
        #   Source 3: WinRateTrajectory gate (_last_g85x2_wrt: +1/-1/0)
        #             G8.5X2 fires when recent WR delta vs all-time WR confirms momentum
        # These three gates measure regime health (macro), DD risk (drawdown), and
        # recent performance trend (WR momentum) — orthogonal risk dimensions.
        # Gate scoring (triple-sync pattern):
        #   All 3 positive → +2.0pts (all risk channels healthy — full risk-on confirmation)
        #   2/3 positive   → +1.5pts (dual risk-on confirmation)
        #   All 3 negative → -2.0pts (all risk channels hostile — full risk-off)
        #   2/3 negative   → -1.5pts (dual risk-off warning)
        # Needs ≥2 active (non-zero) sources to score.
        # Stores _last_g85d3_rdw (+1/-1/0) for Kelly Step 56 [v96.0].
        try:
            _d3_fired = False
            self._last_g85d3_rdw = 0
            # Source 1: RegimeSentiment gate output (+1=healthy regime, -1=hostile, 0=neutral)
            _d3_rs_s  = int(getattr(self, "_last_g85r2_rs",  0))
            # Source 2: DrawdownMomentum gate output (+1=DD risk contained, -1=sentinel/crisis, 0=neutral)
            _d3_ddm_s = int(getattr(self, "_last_g85w2_ddm", 0))
            # Source 3: WinRateTrajectory gate output (+1=WR improving, -1=WR declining, 0=neutral)
            _d3_wrt_s = int(getattr(self, "_last_g85x2_wrt", 0))
            _d3_confs  = [c for c in [_d3_rs_s, _d3_ddm_s, _d3_wrt_s] if c != 0]
            _d3_n      = len(_d3_confs)
            _d3_pos    = sum(1 for c in _d3_confs if c > 0)
            _d3_neg    = sum(1 for c in _d3_confs if c < 0)
            _d3_adj    = 0.0
            if _d3_n >= 2:
                if _d3_pos == _d3_n and _d3_n == 3:
                    _d3_adj = 2.0; self._last_g85d3_rdw = 1; _d3_fired = True
                    self._logger.debug(
                        f"🏆 [v96.0 G8.5D3] RDW TRIPLE-RISK-ON: RS={_d3_rs_s} DDM={_d3_ddm_s} WRT={_d3_wrt_s} -> +2.0pts"
                    )
                elif _d3_pos >= 2 and _d3_pos > _d3_neg:
                    _d3_adj = 1.5; self._last_g85d3_rdw = 1; _d3_fired = True
                    self._logger.debug(
                        f"✅ [v96.0 G8.5D3] RDW DUAL-RISK-ON: {_d3_pos}/{_d3_n} positive -> +1.5pts"
                    )
                elif _d3_neg == _d3_n and _d3_n == 3:
                    _d3_adj = -2.0; self._last_g85d3_rdw = -1; _d3_fired = True
                    self._logger.debug(
                        f"🚨 [v96.0 G8.5D3] RDW TRIPLE-RISK-OFF: RS={_d3_rs_s} DDM={_d3_ddm_s} WRT={_d3_wrt_s} -> -2.0pts"
                    )
                elif _d3_neg >= 2 and _d3_neg > _d3_pos:
                    _d3_adj = -1.5; self._last_g85d3_rdw = -1; _d3_fired = True
                    self._logger.debug(
                        f"⚠️  [v96.0 G8.5D3] RDW DUAL-RISK-OFF: {_d3_neg}/{_d3_n} negative -> -1.5pts"
                    )
                if _d3_adj != 0.0:
                    quality_score += _d3_adj
            self._record("gate_g85d3_rdw", _d3_fired)
        except Exception:
            pass  # G8.5D3 Regime-Drawdown-WinRate Triple-Risk is non-fatal soft-gate

        # ── Gate 8.5E3 — EV-FundMom-OFI Triple-Pressure (v97.0) ──────────────
        # 3-source cross-validation: EV quality tier, FundingMomentum-Persistence,
        # and OFI-Persistence gate outputs must ≥2 agree for a score adjustment.
        # Design rationale: when expected value, funding momentum, and order-flow
        # imbalance all point the same way, the trade has triple-source pressure
        # confirmation — maximally directional and high-conviction.
        # Scoring:
        #   3/3 positive   → +2.0pts (EV strong + FundMom + OFI all align)
        #   2/3 positive   → +1.5pts (dual pressure confirmation)
        #   3/3 negative   → -2.0pts (EV weak + FundMom + OFI all oppose)
        #   2/3 negative   → -1.5pts (dual pressure warning)
        # Needs ≥2 active (non-zero) sources to score.
        # Stores _last_g85e3_efo (+1/-1/0) for Kelly Step 57 [v97.0].
        try:
            _e3_fired = False
            self._last_g85e3_efo = 0
            # Source 1: EV quality tier (ev ≥ 0.8R → +1; ev < 0.4R → -1; else 0)
            _e3_ev_raw = float(signal_data.get("ev", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
            _e3_ev_s   = 1 if _e3_ev_raw >= 0.8 else (-1 if _e3_ev_raw < 0.4 else 0)
            # Source 2: FundingMomentum-Persistence gate output (+1=aligned, -1=opposed, 0=neutral)
            _e3_fmp_s  = int(getattr(self, "_last_g85n2_fmp_signal", 0))
            # Source 3: OFI-Persistence gate output (+1=3/3 aligned, -1=opposed, 0=neutral)
            _e3_ofi_s  = int(getattr(self, "_last_g85b_ofi", 0))
            _e3_confs  = [c for c in [_e3_ev_s, _e3_fmp_s, _e3_ofi_s] if c != 0]
            _e3_n      = len(_e3_confs)
            _e3_pos    = sum(1 for c in _e3_confs if c > 0)
            _e3_neg    = sum(1 for c in _e3_confs if c < 0)
            _e3_adj    = 0.0
            if _e3_n >= 2:
                if _e3_pos == _e3_n and _e3_n == 3:
                    _e3_adj = 2.0; self._last_g85e3_efo = 1; _e3_fired = True
                    self._logger.debug(
                        f"🏆 [v97.0 G8.5E3] EFO TRIPLE-PRESSURE-ON: EV={_e3_ev_s} FMP={_e3_fmp_s} OFI={_e3_ofi_s} -> +2.0pts"
                    )
                elif _e3_pos >= 2 and _e3_pos > _e3_neg:
                    _e3_adj = 1.5; self._last_g85e3_efo = 1; _e3_fired = True
                    self._logger.debug(
                        f"✅ [v97.0 G8.5E3] EFO DUAL-PRESSURE-ON: {_e3_pos}/{_e3_n} positive -> +1.5pts"
                    )
                elif _e3_neg == _e3_n and _e3_n == 3:
                    _e3_adj = -2.0; self._last_g85e3_efo = -1; _e3_fired = True
                    self._logger.debug(
                        f"🚨 [v97.0 G8.5E3] EFO TRIPLE-PRESSURE-OFF: EV={_e3_ev_s} FMP={_e3_fmp_s} OFI={_e3_ofi_s} -> -2.0pts"
                    )
                elif _e3_neg >= 2 and _e3_neg > _e3_pos:
                    _e3_adj = -1.5; self._last_g85e3_efo = -1; _e3_fired = True
                    self._logger.debug(
                        f"⚠️  [v97.0 G8.5E3] EFO DUAL-PRESSURE-OFF: {_e3_neg}/{_e3_n} negative -> -1.5pts"
                    )
                if _e3_adj != 0.0:
                    quality_score += _e3_adj
            self._record("gate_g85e3_efo", _e3_fired)
        except Exception:
            pass  # G8.5E3 EV-FundMom-OFI Triple-Pressure is non-fatal soft-gate

        # ── Gate 8.5F3 — MultiLayer-Coherence (v101.0) ───────────────────────
        # 66th gate (±2.0/+1.0pts): cross-validates the three independent prediction
        # layers (GODMODE LLM, MiroFish Swarm, and Neural Network) for agreement.
        # When all three agree at high conviction the combined signal has geometric
        # strength; when LLM and NN diverge it signals dangerous regime ambiguity.
        #
        # Inputs (all from signal_data, cold-start safe):
        #   confidence  — GODMODE AI confidence (0-100 scale)
        #   consensus   — Swarm consensus (0.0-1.0)
        #   nn_win_prob — NN win probability (0.0-1.0)
        #
        # Rules:
        #   AI≥89% + Swarm≥0.96 + NN≥0.54  →  +2.0pts (all 3 layers ultra-aligned)
        #   2 of 3 above thresholds         →  +1.0pts (strong dual-layer agreement)
        #   AI≥90% + NN<0.50                →  −2.0pts (LLM/NN divergence: dangerous)
        #   Neutral otherwise (0pts)
        try:
            _f3_ai_conf    = float(signal_data.get("confidence", signal_data.get("ai_confidence", 0)) or 0)
            _f3_consensus  = float(signal_data.get("consensus", signal_data.get("swarm_consensus", 0)) or 0)
            _f3_nn_prob    = float(signal_data.get("nn_win_prob", 0.50) or 0.50)
            _f3_adj        = 0.0
            _f3_fired      = True  # soft-gate always "passes" — only adjusts quality
            # Layer alignment checks
            _f3_ai_strong  = _f3_ai_conf    >= 89.0
            _f3_sw_strong  = _f3_consensus  >= 0.96
            _f3_nn_strong  = _f3_nn_prob    >= 0.54
            _f3_layers_on  = sum([_f3_ai_strong, _f3_sw_strong, _f3_nn_strong])
            # LLM-NN divergence: LLM extremely bullish but NN says <50% win probability
            _f3_diverge    = (_f3_ai_conf >= 90.0 and _f3_nn_prob < 0.50)
            if _f3_diverge:
                _f3_adj = -2.0
                self._last_g85f3_mlc = -1  # v102.0 FIX: store for Kelly Step 58
                self._logger.debug(
                    f"⚠️  [v102.0 G8.5F3] MLC DIVERGE: AI={_f3_ai_conf:.0f}% NN={_f3_nn_prob:.3f} "
                    f"→ -2.0pts (LLM-NN disagreement)"
                )
            elif _f3_layers_on == 3:
                _f3_adj = +2.0
                self._last_g85f3_mlc = 1   # v102.0 FIX: store for Kelly Step 58
                self._logger.debug(
                    f"🏆 [v102.0 G8.5F3] MLC ALL-3-ALIGNED: AI={_f3_ai_conf:.0f}% "
                    f"SW={_f3_consensus:.0%} NN={_f3_nn_prob:.3f} → +2.0pts"
                )
            elif _f3_layers_on == 2:
                _f3_adj = +1.0
                self._last_g85f3_mlc = 1   # v102.0 FIX: dual-aligned also Kelly-positive
                self._logger.debug(
                    f"✅ [v102.0 G8.5F3] MLC DUAL-ALIGNED: {_f3_layers_on}/3 layers strong "
                    f"AI={_f3_ai_conf:.0f}% SW={_f3_consensus:.0%} NN={_f3_nn_prob:.3f} → +1.0pts"
                )
            else:
                self._last_g85f3_mlc = 0   # v102.0 FIX: neutral — no adjustment
            if _f3_adj != 0.0:
                quality_score += _f3_adj
            self._record("gate_g85f3_mlc", _f3_fired)
        except Exception:
            pass  # G8.5F3 MultiLayer-Coherence is non-fatal soft-gate

        # ── v102.0 Gate 8.5G3 — SharpeVelocity-QualityMomentum (67th gate) ──
        # Zero-API zero-call soft-gate: cross-validates WinRate-Trajectory (G8.5X2)
        # against rolling Sharpe ratio to detect dual-source quality-regime momentum.
        # When recent WR is recovering AND Sharpe is non-crisis, both signals confirm
        # an improving regime — geometric reinforcement. When WR is falling AND Sharpe
        # is also deteriorating, the compound signal indicates confirmed quality collapse.
        #
        # Inputs:
        #   _last_g85x2_wrt — WR-trajectory gate output (+1=recovering/-1=deteriorating/0)
        #   sharpe_ratio    — from self._booster or fallback to 0.0
        #
        # Rules:
        #   WRT=+1 AND Sharpe > -2.0  →  +2.0pts (WR recovering + quality regime healthy)
        #   WRT=+1 AND Sharpe > -3.0  →  +1.5pts (WR recovering + mild quality stress)
        #   WRT=-1 AND Sharpe < -3.0  →  -2.0pts (WR falling + deep quality crisis)
        #   WRT=-1 AND Sharpe < -2.0  →  -1.5pts (WR falling + moderate quality stress)
        #   Neutral otherwise (0pts)
        # Requires >=10 resolved trades (sample guard).
        try:
            _g3_wrt     = int(getattr(self, "_last_g85x2_wrt", 0))
            _g3_sharpe  = float(getattr(getattr(self, "_booster", None), "sharpe_ratio", 0.0) or 0.0)
            _g3_n       = int(getattr(self, "_metrics", None) and
                              (self._metrics.win_count + self._metrics.loss_count) or 0)
            _g3_adj     = 0.0
            _g3_fired   = True   # soft-gate: always "passes", only adjusts quality
            self._last_g85g3_svq = 0  # reset; will be set if threshold triggered
            if _g3_n >= 10:
                if _g3_wrt == 1:
                    if _g3_sharpe > -2.0:
                        _g3_adj = +2.0
                        self._last_g85g3_svq = 1
                        self._logger.debug(
                            f"🚀 [v102.0 G8.5G3] SVQ QUALITY-MOMENTUM-UP: WRT=+1 "
                            f"Sharpe={_g3_sharpe:.2f}>-2.0 → +2.0pts"
                        )
                    elif _g3_sharpe > -3.0:
                        _g3_adj = +1.5
                        self._last_g85g3_svq = 1
                        self._logger.debug(
                            f"✅ [v102.0 G8.5G3] SVQ RECOVERING-MILD: WRT=+1 "
                            f"Sharpe={_g3_sharpe:.2f}>-3.0 → +1.5pts"
                        )
                elif _g3_wrt == -1:
                    if _g3_sharpe < -3.0:
                        _g3_adj = -2.0
                        self._last_g85g3_svq = -1
                        self._logger.debug(
                            f"⛔ [v102.0 G8.5G3] SVQ QUALITY-COLLAPSE: WRT=-1 "
                            f"Sharpe={_g3_sharpe:.2f}<-3.0 → -2.0pts"
                        )
                    elif _g3_sharpe < -2.0:
                        _g3_adj = -1.5
                        self._last_g85g3_svq = -1
                        self._logger.debug(
                            f"⚠️  [v102.0 G8.5G3] SVQ DETERIORATING-MODERATE: WRT=-1 "
                            f"Sharpe={_g3_sharpe:.2f}<-2.0 → -1.5pts"
                        )
            if _g3_adj != 0.0:
                quality_score += _g3_adj
            self._record("gate_g85g3_svq", _g3_fired)
        except Exception:
            pass  # G8.5G3 SharpeVelocity-QualityMomentum is non-fatal soft-gate

        # ── Gate 8.5H3 — RecentWR-EmergencyBrake (v103.0/v153.0) ────────────
        # Crisis-detection gate using booster._pnl_ring to compute recent-10-trade
        # win rate.  Zero-API, zero-call — fully internal data source.
        # WR-10 < 15% (<=1.5W) → -3.0pts (ultra-crisis EmergencyBrake)
        # WR-10 < 20% (<=2W)   → -2.0pts (crisis brake)
        # WR-10 < 25% (<2.5W)  → -1.5pts (mild-crisis, v153.0: fills 20-25% gap)
        # WR-10 < 28% (<2.8W)  → -1.0pts (warning, v153.0: fills 25-28% gap at live WR)
        # WR-10 > 40% (>=4W)   → +1.5pts (hot-streak relief)
        # [28-40%] neutral zone.  Requires >=10 ring entries; cold-start neutral.
        # Stores _last_g85h3_ewb (-2/-1/0/+1) for Kelly Step 60 (mild/warning use 0).
        # v153.0 KEY INSIGHT: at G9 floor=73, a -1.5pt penalty pushes borderline
        # composite scores (73-74.5) below the floor → becomes effective hard-block.
        try:
            _h3_adj  = 0.0
            _h3_fired = False
            self._last_g85h3_ewb = 0  # reset each cycle
            _h3_bst  = getattr(self, "_booster", None)
            _h3_ring = list(getattr(_h3_bst, "_pnl_ring", []))
            if len(_h3_ring) >= 10:
                _h3_last10  = _h3_ring[-10:]
                _h3_wins10  = sum(1 for _r in _h3_last10 if _r > 0)
                _h3_wr10    = _h3_wins10 / 10.0
                if _h3_wr10 < 0.15:
                    _h3_adj   = -3.0
                    _h3_fired = True
                    self._last_g85h3_ewb = -2
                    self._logger.info(
                        f"🚨 [v103.0 G8.5H3] EWB ULTRA-CRISIS: recent-10 WR={_h3_wr10:.0%} "
                        f"({_h3_wins10}W/{10-_h3_wins10}L) → -3.0pts (EmergencyBrake)"
                    )
                elif _h3_wr10 < 0.20:
                    _h3_adj   = -2.0
                    _h3_fired = True
                    self._last_g85h3_ewb = -1
                    self._logger.info(
                        f"⛔ [v103.0 G8.5H3] EWB CRISIS: recent-10 WR={_h3_wr10:.0%} "
                        f"({_h3_wins10}W/{10-_h3_wins10}L) → -2.0pts"
                    )
                elif _h3_wr10 < 0.25:
                    _h3_adj   = -1.5
                    _h3_fired = True
                    # _last_g85h3_ewb stays 0 — mild penalty, Kelly Step 60 not activated
                    self._logger.info(
                        f"⚠️ [v153.0 G8.5H3] EWB MILD-CRISIS: recent-10 WR={_h3_wr10:.0%} "
                        f"({_h3_wins10}W/{10-_h3_wins10}L) → -1.5pts (fills 20-25% gap)"
                    )
                elif _h3_wr10 < 0.28:
                    _h3_adj   = -1.0
                    _h3_fired = True
                    # _last_g85h3_ewb stays 0 — warning level, scoring penalty only
                    self._logger.info(
                        f"⚠️ [v153.0 G8.5H3] EWB WARNING: recent-10 WR={_h3_wr10:.0%} "
                        f"({_h3_wins10}W/{10-_h3_wins10}L) → -1.0pts (25-28% live-WR gap)"
                    )
                elif _h3_wr10 > 0.40:
                    _h3_adj   = 1.5
                    _h3_fired = True
                    self._last_g85h3_ewb = 1
                    self._logger.debug(
                        f"🚀 [v103.0 G8.5H3] EWB HOT-STREAK: recent-10 WR={_h3_wr10:.0%} "
                        f"({_h3_wins10}W/{10-_h3_wins10}L) → +1.5pts"
                    )
            if _h3_adj != 0.0:
                quality_score += _h3_adj
            self._record("gate_g85h3_ewb", _h3_fired)
        except Exception:
            pass  # G8.5H3 RecentWR-EmergencyBrake is non-fatal soft-gate

        # ── Gate 8.5I3 — IRONSFloor-Sharpe Compound (v103.0) ────────────────
        # Compound gate cross-validating adaptive IRONS floor (WR-regime indicator)
        # against rolling Sharpe ratio.  Both crisis → amplified penalty.
        # Both healthy → amplified bonus.  Zero-API, zero-call.
        # IRONS>=73 (WR<20%) + Sharpe<-3.0 → -2.0pts (deep crisis compound)
        # IRONS>=73 (WR<20%) + Sharpe<-2.0 → -1.5pts (crisis compound)
        # IRONS<=67 (WR>30%) + Sharpe>-0.5 → +1.5pts (strong recovery compound)
        # IRONS<=70 (WR>25%) + Sharpe>-1.5 → +1.0pts (mild recovery)
        # Stores _last_g85i3_ifm (-2/-1/0/+1/+2) for Kelly Step 61.
        try:
            _i3_adj  = 0.0
            _i3_fired = False
            self._last_g85i3_ifm = 0  # reset each cycle
            _i3_irons = float(getattr(self, "_adaptive_irons_min", 70.0))
            _i3_sr    = float(getattr(self, "_rolling_sharpe",
                               getattr(self, "_sharpe_ratio", 0.0)))
            if _i3_irons >= 73.0 and _i3_sr < -3.0:
                _i3_adj   = -2.0
                _i3_fired = True
                self._last_g85i3_ifm = -2
                self._logger.info(
                    f"🚨 [v103.0 G8.5I3] IFM DEEP-CRISIS: IRONS_floor={_i3_irons:.1f} "
                    f"Sharpe={_i3_sr:.2f} → -2.0pts (dual-crisis compound)"
                )
            elif _i3_irons >= 73.0 and _i3_sr < -2.0:
                _i3_adj   = -1.5
                _i3_fired = True
                self._last_g85i3_ifm = -1
                self._logger.info(
                    f"⛔ [v103.0 G8.5I3] IFM CRISIS: IRONS_floor={_i3_irons:.1f} "
                    f"Sharpe={_i3_sr:.2f} → -1.5pts"
                )
            elif _i3_irons <= 67.0 and _i3_sr > -0.5:
                _i3_adj   = 1.5
                _i3_fired = True
                self._last_g85i3_ifm = 2
                self._logger.debug(
                    f"🚀 [v103.0 G8.5I3] IFM STRONG-RECOVERY: IRONS_floor={_i3_irons:.1f} "
                    f"Sharpe={_i3_sr:.2f} → +1.5pts (dual-recovery compound)"
                )
            elif _i3_irons <= 70.0 and _i3_sr > -1.5:
                _i3_adj   = 1.0
                _i3_fired = True
                self._last_g85i3_ifm = 1
                self._logger.debug(
                    f"✅ [v103.0 G8.5I3] IFM MILD-RECOVERY: IRONS_floor={_i3_irons:.1f} "
                    f"Sharpe={_i3_sr:.2f} → +1.0pts"
                )
            if _i3_adj != 0.0:
                quality_score += _i3_adj
            self._record("gate_g85i3_ifm", _i3_fired)
        except Exception:
            pass  # G8.5I3 IRONSFloor-Sharpe Compound is non-fatal soft-gate

        # ── Gate 8.5J3 — LLM-Technical-Coherence (v104.0) ───────────────────
        # Cross-validates the LLM-generated action (BUY/SELL) against 3 independent
        # technical signals: (1) OFI z-score direction, (2) HMM regime direction,
        # (3) UTBot direction.  Unanimous alignment (3/3 agree with LLM) → +1.5pts;
        # majority opposition (0-1/3 agree when ≥2 signals available) → -2.0pts;
        # partial opposition (1/3 agree when total=3) → -1.0pts.  Requires ≥2
        # signals to fire.  Stores _last_g85j3_ltc (-1/0/+1) for Kelly Step 62.
        # Zero-API; non-fatal soft-gate [v104.0].
        try:
            self._last_g85j3_ltc = 0  # reset each cycle
            _j3_adj  = 0.0
            _j3_fired = False
            _j3_action = str(signal_data.get("action", "")).upper()
            if _j3_action in ("BUY", "SELL"):
                _j3_llm_dir = 1 if _j3_action == "BUY" else -1
                _j3_votes = 0   # votes agreeing with LLM direction
                _j3_total = 0   # total available signals
                # Vote 1: OFI z-score direction
                _j3_ofi = float(getattr(self, "_last_ofi_z", 0.0) or 0.0)
                if abs(_j3_ofi) >= 0.30:
                    _j3_total += 1
                    if (_j3_ofi > 0 and _j3_llm_dir == 1) or (_j3_ofi < 0 and _j3_llm_dir == -1):
                        _j3_votes += 1
                # Vote 2: HMM regime direction
                _j3_hmm = str(getattr(self, "_last_hmm_state", "") or "").upper()
                if _j3_hmm:
                    _j3_total += 1
                    _j3_bull_hmm = any(k in _j3_hmm for k in ("BULL", "EXP", "TREND"))
                    _j3_bear_hmm = any(k in _j3_hmm for k in ("BEAR", "MEAN", "CONT", "REV"))
                    if (_j3_bull_hmm and _j3_llm_dir == 1) or (_j3_bear_hmm and _j3_llm_dir == -1):
                        _j3_votes += 1
                # Vote 3: UTBot direction
                _j3_utb = str(signal_data.get("utbot_direction", signal_data.get("UT_direction", "")) or "").upper()
                if _j3_utb in ("BUY", "SELL"):
                    _j3_total += 1
                    if (_j3_utb == "BUY" and _j3_llm_dir == 1) or (_j3_utb == "SELL" and _j3_llm_dir == -1):
                        _j3_votes += 1
                if _j3_total >= 2:
                    if _j3_votes == _j3_total:
                        # All available signals unanimous with LLM
                        _j3_adj = 1.5
                        _j3_fired = True
                        self._last_g85j3_ltc = 1
                    elif _j3_votes == 0:
                        # All available signals oppose LLM
                        _j3_adj = -2.0
                        _j3_fired = True
                        self._last_g85j3_ltc = -1
                    elif _j3_votes == 1 and _j3_total == 3:
                        # Majority opposition (1/3 agree = 2/3 oppose)
                        _j3_adj = -1.0
                        _j3_fired = True
                        self._last_g85j3_ltc = -1
            if _j3_adj != 0.0:
                quality_score += _j3_adj
            self._record("gate_g85j3_ltc", _j3_fired)
        except Exception:
            pass  # G8.5J3 LLM-Technical-Coherence is non-fatal soft-gate

        # ── Gate 8.5K3 — StreakSession-Compound (v104.0) ─────────────────────
        # Compounds consecutive loss/win streaks with UTC session quality.
        # Losing streaks in the dead zone are doubly punished (worst combination);
        # winning streaks in the prime session are doubly rewarded.
        # ConsecLoss≥3 + dead-zone UTC → -2.0pts; ConsecWin≥2 + prime UTC → +1.5pts.
        # Stores _last_g85k3_ssc (-1/0/+1) for Kelly Step 63.
        # Zero-API; non-fatal soft-gate [v104.0].
        try:
            self._last_g85k3_ssc = 0  # reset each cycle
            _k3_adj  = 0.0
            _k3_fired = False
            import datetime as _dt_k3
            _k3_utc_h = _dt_k3.datetime.utcnow().hour
            _k3_in_dead  = (DEAD_ZONE_UTC_START  <= _k3_utc_h < DEAD_ZONE_UTC_END)
            _k3_in_prime = (SESSION_BONUS_UTC_START <= _k3_utc_h < SESSION_BONUS_UTC_END)
            _booster_k3  = getattr(self, "_booster", None)
            _k3_consec_l = int(getattr(_booster_k3, "_consec_losses", 0) or 0)
            _k3_consec_w = int(getattr(_booster_k3, "_consec_wins",   0) or 0)
            if _k3_consec_l >= 3 and _k3_in_dead:
                # Losing streak in dead zone — ruin-avoiding compound penalty
                _k3_adj = -2.0
                _k3_fired = True
                self._last_g85k3_ssc = -1
            elif _k3_consec_w >= 2 and _k3_in_prime:
                # Winning streak in prime session — momentum-amplifying bonus
                _k3_adj = 1.5
                _k3_fired = True
                self._last_g85k3_ssc = 1
            if _k3_adj != 0.0:
                quality_score += _k3_adj
            self._record("gate_g85k3_ssc", _k3_fired)
        except Exception:
            pass  # G8.5K3 StreakSession-Compound is non-fatal soft-gate

        # ── Gate 8.5L3 — CrisisConsensus-Compound (v105.0) ───────────────────
        # Compounds three independent crisis indicators into a single ruthless filter.
        # Crisis indicators (zero-API, all from stored state):
        #   1. WR crisis: recent-20 ring WR < 25% (systematic losing regime)
        #   2. MaxDD crisis: max drawdown > 35% (capital protection breach)
        #   3. Sharpe crisis: rolling Sharpe < -2.0 (risk-adjusted return catastrophe)
        # Scoring (additive; max one outcome fires):
        #   All 3 crisis conditions met      → -3.0pts (compound ruin — maximum filter)
        #   Exactly 2 of 3 conditions met    → -2.0pts (compound risk — strong filter)
        #   Recovery: WR>33% + Sharpe>-1.0  → +1.5pts (positive regime resumption bonus)
        # WR trigger uses ring-based recent-20 to be faster than Bayes blend.
        # Threshold design: the 3 conditions are all independently predictive of
        # continued losses; their conjunction is near-certainty of further decline.
        # Stores _last_g85l3_cc (-2/-1/0/+1) for Kelly Step 64.
        try:
            self._last_g85l3_cc = 0
            _l3_adj   = 0.0
            _l3_fired = False
            _l3_bst   = getattr(self, "_booster", None)
            # Crisis indicator 1: WR
            _l3_ring   = list(getattr(_l3_bst, "_outcome_ring", []) or [])
            _l3_ring_n = len(_l3_ring)
            _l3_ring_wr = (sum(1 for r in _l3_ring[-20:] if r > 0) / max(1, min(20, _l3_ring_n))) if _l3_ring_n >= 10 else 0.35
            _l3_wr_crisis = _l3_ring_wr < 0.25
            # Crisis indicator 2: MaxDD
            _l3_maxdd = float(getattr(self, "_max_drawdown_pct", 0.0) or 0.0)
            _l3_dd_crisis = _l3_maxdd > 35.0
            # Crisis indicator 3: Sharpe
            _l3_sr  = float(getattr(_l3_bst, "_rolling_sharpe", 0.0) or 0.0)
            _l3_sr_crisis = _l3_sr < -2.0
            _l3_crisis_count = int(_l3_wr_crisis) + int(_l3_dd_crisis) + int(_l3_sr_crisis)
            if _l3_crisis_count == 3:
                _l3_adj = -3.0
                _l3_fired = True
                self._last_g85l3_cc = -2
            elif _l3_crisis_count == 2:
                _l3_adj = -2.0
                _l3_fired = True
                self._last_g85l3_cc = -1
            elif _l3_ring_wr > 0.33 and _l3_sr > -1.0:
                # Recovery bonus: regime turning positive
                _l3_adj = 1.5
                _l3_fired = True
                self._last_g85l3_cc = 1
            if _l3_adj != 0.0:
                quality_score += _l3_adj
            self._record("gate_g85l3_cc", _l3_fired)
        except Exception:
            pass  # G8.5L3 CrisisConsensus-Compound is non-fatal soft-gate

        # ── Gate 8.5M3 — TrendQuality-Persistence (v105.0) ───────────────────
        # Aggregates three independent directional-momentum votes into a persistence signal.
        # Votes (zero-API, all from stored last values):
        #   1. G8.5I MicroTrend vote: last 10-bar LinReg slope direction (+1/0/-1)
        #   2. G8.5G3 SVQ-Momentum vote: last SVQ-Momentum stored value (+1/0/-1)
        #   3. CPCV walk-fwd quality vote: CPCV avg > 50% = bullish (+1/-1)
        # Scoring (additive; max one outcome fires):
        #   All 3 votes align bullish (+3 net)  → +2.0pts (strong trend quality)
        #   All 3 votes align bearish (-3 net)  → -2.0pts (strong trend reversal)
        #   2/3 align bullish (+1 or +2 net)    → +1.0pt (soft quality confirm)
        #   2/3 align bearish (-1 or -2 net)    → -1.0pt (soft quality decline)
        # Each vote is directionally aware to the current signal direction.
        # Stores _last_g85m3_tqp (-1/0/+1) for Kelly Step 65.
        try:
            self._last_g85m3_tqp = 0
            _m3_adj   = 0.0
            _m3_fired = False
            _m3_dir   = str(direction or "").upper()
            _m3_is_long = (_m3_dir == "BUY")
            # Vote 1: MicroTrend direction (from last stored close buffer linreg slope)
            _m3_closes = list(getattr(self, "_quant_layer_close_buf", {}).get(symbol, []) or [])
            _m3_vote1 = 0
            if len(_m3_closes) >= 10:
                import numpy as _np_m3
                _m3_sl = float(_np_m3.polyfit(range(10), _np_m3.array(_m3_closes[-10:], dtype=float), 1)[0])
                if abs(_m3_sl) > 0.0:
                    _m3_vote1 = 1 if (_m3_sl > 0) == _m3_is_long else -1
            # Vote 2: SVQ-Momentum gate last output (stored from G8.5G3)
            _m3_svq_raw = float(getattr(self, "_last_g85g3_svq", 0) or 0)
            _m3_vote2 = 0
            if _m3_svq_raw > 0:
                _m3_vote2 = 1
            elif _m3_svq_raw < 0:
                _m3_vote2 = -1
            # Vote 3: CPCV walk-forward quality (avg CPCV > 50% = regime is learnable)
            _m3_cpcv_avg = float(getattr(getattr(self, "neural_trainer", None), "_last_cpcv_avg", 0.50) or 0.50)
            _m3_vote3 = 1 if _m3_cpcv_avg >= 0.50 else -1
            _m3_net = _m3_vote1 + _m3_vote2 + _m3_vote3
            if _m3_net >= 3:
                _m3_adj = 2.0
                _m3_fired = True
                self._last_g85m3_tqp = 1
            elif _m3_net <= -3:
                _m3_adj = -2.0
                _m3_fired = True
                self._last_g85m3_tqp = -1
            elif _m3_net >= 1:
                _m3_adj = 1.0
                _m3_fired = True
                self._last_g85m3_tqp = 1
            elif _m3_net <= -1:
                _m3_adj = -1.0
                _m3_fired = True
                self._last_g85m3_tqp = -1
            if _m3_adj != 0.0:
                quality_score += _m3_adj
            self._record("gate_g85m3_tqp", _m3_fired)
        except Exception:
            pass  # G8.5M3 TrendQuality-Persistence is non-fatal soft-gate

        # ── Gate 8.5N3 — OFI-HMM-MICROTREND Triple-Sync (v106.0) ────────────
        # Zero-API triple cross-validation combining three independent momentum
        # direction indicators computed from live market microstructure:
        #   Vote 1 — OFI-Velocity direction: _last_g85d_ofi_vel (int ±1/0)
        #             +1 = OFI accelerating in signal direction, -1 = against
        #   Vote 2 — HMM-VPIN-Coherence:   _last_g85y2_hvc (int ±1/0)
        #             +1 = HMM+VPIN both align with signal, -1 = both oppose
        #   Vote 3 — MicroTrend slope:      _last_g85i_microtrend (int ±1/0)
        #             +1 = 10-bar LinReg slope aligns, -1 = opposes
        # Scoring (requires ≥2 votes available):
        #   3/3 aligned  → +2.0pts  (triple confirmation — all momentum green)
        #   2/3 aligned  → +1.5pts  (dual confirmation — strong directional lean)
        #   2/3 opposed  → -1.5pts  (dual opposition — regime reversal warning)
        #   3/3 opposed  → -2.0pts  (triple reversal — avoid signal)
        # Stores _last_g85n3_irc ∈ {+1, -1, 0} for Kelly Step 66 sizing.
        # Non-fatal: any exception leaves quality_score unchanged.
        try:
            _n3_dir      = str(direction or "").upper()
            _n3_ofi_vel  = int(getattr(self, "_last_g85d_ofi_vel",  0) or 0)   # Vote 1: OFI-Velocity
            _n3_hmm_vpin = int(getattr(self, "_last_g85y2_hvc",     0) or 0)   # Vote 2: HMM-VPIN-Coh
            _n3_micro    = int(getattr(self, "_last_g85i_microtrend", 0) or 0) # Vote 3: MicroTrend slope
            _n3_votes_raw = [v for v in [_n3_ofi_vel, _n3_hmm_vpin, _n3_micro] if v != 0]
            _n3_irc_out  = 0
            _n3_adj      = 0.0
            _n3_fired    = True
            if len(_n3_votes_raw) >= 2:
                # Map direction-signed votes: +1 = agrees with signal, -1 = opposes
                _n3_aligned = sum(1 for v in _n3_votes_raw if v == 1)
                _n3_opposed = sum(1 for v in _n3_votes_raw if v == -1)
                _n3_total   = len(_n3_votes_raw)
                if _n3_aligned == _n3_total:
                    _n3_adj     = +2.0  # 3/3 or 2/2 aligned
                    _n3_irc_out = +1
                elif _n3_aligned >= 2:
                    _n3_adj     = +1.5  # 2/3 aligned
                    _n3_irc_out = +1
                elif _n3_opposed == _n3_total:
                    _n3_adj     = -2.0  # 3/3 or 2/2 opposed
                    _n3_irc_out = -1
                elif _n3_opposed >= 2:
                    _n3_adj     = -1.5  # 2/3 opposed
                    _n3_irc_out = -1
                else:
                    _n3_fired = False  # split 1-aligned / 1-opposed — neutral, no change
            else:
                _n3_fired = False  # insufficient votes — skip
            self._last_g85n3_irc = _n3_irc_out
            if _n3_adj != 0.0:
                quality_score += _n3_adj
            self._record("gate_g85n3_irc", _n3_fired)
        except Exception:
            pass  # G8.5N3 OFI-HMM-MicroTrend TripleSync is non-fatal soft-gate

        # ── Gate 8.5O3 — WINRATE-CPCV-NNQUALITY Coherence (v106.0) ──────────
        # Meta-quality gate cross-validating three independent quality signals
        # from orthogonal system dimensions — trading performance, walk-forward
        # validation, and neural model calibration.  When all three are negative
        # simultaneously, signal quality has collapsed across every dimension and
        # aggressive ruin protection is warranted.
        #   Vote 1 (WR regime):  ring-20 WR > 35% = +1; WR < 25% = -1; else 0.
        #   Vote 2 (CPCV):       CPCV avg ≥ 50%  = +1; avg < 45% = -1; else 0.
        #   Vote 3 (NN quality): NN trained + win_acc > 45% = +1;
        #                        NN disabled or win_acc < 35% = -1; else 0.
        # Scoring:
        #   3/3 positive → +2.0pts  (all systems green — quality confirmed)
        #   2/3 positive → +1.5pts  (majority quality positive)
        #   2/3 negative → -1.5pts  (majority quality negative)
        #   3/3 negative → -2.0pts  (all systems red — ruthless ruin filter)
        # Stores _last_g85o3_wnq ∈ {+1, -1, 0} for Kelly Step 67 sizing.
        # Non-fatal: any exception leaves quality_score unchanged.
        try:
            _o3_v1  = 0  # Vote 1: WR regime
            _o3_v2  = 0  # Vote 2: CPCV walk-forward quality
            _o3_v3  = 0  # Vote 3: NN model quality
            # Vote 1: recent-20 ring WR
            _o3_bst = getattr(self, "_booster", None)
            if _o3_bst is not None:
                _o3_ring = list(getattr(_o3_bst, "_win_ring", []) or [])
                if len(_o3_ring) >= 10:
                    _o3_rwr = sum(_o3_ring) / len(_o3_ring)
                    if _o3_rwr > 0.35:
                        _o3_v1 = +1
                    elif _o3_rwr < 0.25:
                        _o3_v1 = -1
            # Vote 2: CPCV walk-forward average PBO chance
            _o3_cpcv_avg = float(getattr(self, "_cpcv_avg_chance", -1.0) or -1.0)
            if _o3_cpcv_avg >= 0.0:
                if _o3_cpcv_avg >= 0.50:
                    _o3_v2 = +1
                elif _o3_cpcv_avg < 0.45:
                    _o3_v2 = -1
            # Vote 3: NN model quality
            _o3_nn = getattr(self, "_neural_engine", None)
            if _o3_nn is None:
                _o3_nn = getattr(self, "neural_trainer", None)
            if _o3_nn is not None:
                _o3_nn_ok  = bool(getattr(_o3_nn, "is_trained", False))
                _o3_win_acc = float(getattr(_o3_nn, "win_class_accuracy", 0.0) or 0.0)
                if _o3_nn_ok and _o3_win_acc > 0.45:
                    _o3_v3 = +1
                elif not _o3_nn_ok or _o3_win_acc < 0.35:
                    _o3_v3 = -1
            _o3_votes    = [v for v in [_o3_v1, _o3_v2, _o3_v3] if v != 0]
            _o3_wnq_out  = 0
            _o3_adj      = 0.0
            _o3_fired    = True
            if len(_o3_votes) >= 2:
                _o3_pos = sum(1 for v in _o3_votes if v > 0)
                _o3_neg = sum(1 for v in _o3_votes if v < 0)
                _o3_tot = len(_o3_votes)
                if _o3_pos == _o3_tot:

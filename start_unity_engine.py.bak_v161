        #   Vote 1 (SPL): SpreadLiquidity regime — _last_g85k_liq_signal (+1=liquid/tight, -1=illiquid/wide)
        #   Vote 2 (SVQ): SharpeVelocity-QualityMomentum — _last_g85g3_svq (+1=quality-up, -1=quality-collapse)
        #   Vote 3 (MLC): MultiLayer-Coherence — _last_g85f3_mlc (+1=coherent, -1=LLM-NN divergent)
        # EMERGENCY -3.5pts: all 3 adverse (illiquid + quality-collapse + coherence-loss)
        # This specifically targets the MaxDD driver: trades taken in illiquid + low-quality conditions.
        try:
            _s5_spl = int(getattr(self, "_last_g85k_liq_signal", 0) or 0)   # +1=liquid, -1=illiquid, 0=neutral
            _s5_svq = int(getattr(self, "_last_g85g3_svq", 0) or 0)          # +1=quality-up, -1=collapse
            _s5_mlc = int(getattr(self, "_last_g85f3_mlc", 0) or 0)          # +1=coherent, -1=divergent
            _s5_vote = _s5_spl + _s5_svq + _s5_mlc                            # range [-3, +3]
            _s5_lsq = 0
            _s5_adj_s5 = 0.0
            _s5_emergency = (_s5_spl == -1 and _s5_svq == -1 and _s5_mlc == -1)
            if _s5_emergency:
                _s5_lsq = -3
                _s5_adj_s5 = -3.5
            elif _s5_vote <= -2:
                _s5_lsq = -2
                _s5_adj_s5 = -2.0
            elif _s5_vote == -1:
                _s5_lsq = -1
                _s5_adj_s5 = -1.0
            elif _s5_vote >= 3:
                _s5_lsq = 2
                _s5_adj_s5 = 2.0
            elif _s5_vote == 2:
                _s5_lsq = 1
                _s5_adj_s5 = 1.0
            self._last_g85s5_lsq = _s5_lsq
            quality_score += _s5_adj_s5
            self._gate_stats["gate_g85s5_lsq"]["pass" if _s5_adj_s5 >= 0 else "fail"] += 1
            self._gate_stats_recent["gate_g85s5_lsq"].append(1 if _s5_adj_s5 >= 0 else 0)
            self._logger.debug(
                f"[v140.0 G8.5S5 LSQ] {symbol} "
                f"spl={_s5_spl:+d} svq={_s5_svq:+d} mlc={_s5_mlc:+d} vote={_s5_vote:+d} "
                f"emergency={_s5_emergency} adj={_s5_adj_s5:+.1f}pts lsq={_s5_lsq:+d}"
            )
        except Exception:
            pass  # G8.5S5 LSQ Liquidity-Sharpe-Quality is non-fatal soft-gate

        # ── v140.0 Gate G8.5T5 — MFR MomentumFlow-Regime Triple-Resonance ──────
        # 130th gate — zero-API 3-vote cross-validation combining:
        #   Vote 1 (OFV): OFI z-score direction-alignment (vs signal action) — real-time flow
        #   Vote 2 (RS): RegimeSentiment-Composite — _last_g85r2_regimesent (+1=pos, -1=neg)
        #   Vote 3 (DDM): DrawdownMomentum-Sentinel — _last_g85w2_ddm (+1=safe, -1=deteriorating)
        # EMERGENCY -3.5pts: OFI-opposed + regime-adverse + drawdown-worsening simultaneously.
        # Targets the flow-vs-regime divergence pattern that drives losing trades in crisis.
        try:
            _t5_action = str(signal_data.get("action", "") or "").upper()
            _t5_dir_int = 1 if _t5_action == "BUY" else (-1 if _t5_action == "SELL" else 0)
            _t5_ofi_z = float(signal_data.get("ofi_z", 0.0) or 0.0)
            _t5_ofi_aligned = _t5_ofi_z * _t5_dir_int if _t5_dir_int != 0 else 0.0
            _t5_ofv = 1 if _t5_ofi_aligned > 0.3 else (-1 if _t5_ofi_aligned < -0.3 else 0)
            _t5_rs  = int(getattr(self, "_last_g85r2_regimesent", 0) or 0)   # +1=positive, -1=negative
            _t5_ddm_raw = int(getattr(self, "_last_g85w2_ddm", 0) or 0)      # -1=adverse, +1=safe
            _t5_ddm = 1 if _t5_ddm_raw > 0 else (-1 if _t5_ddm_raw < 0 else 0)
            _t5_vote = _t5_ofv + _t5_rs + _t5_ddm                             # range [-3, +3]
            _t5_mfr = 0
            _t5_adj_t5 = 0.0
            _t5_emergency = (_t5_ofv == -1 and _t5_rs == -1 and _t5_ddm == -1)
            if _t5_emergency:
                _t5_mfr = -3
                _t5_adj_t5 = -3.5
            elif _t5_vote <= -2:
                _t5_mfr = -2
                _t5_adj_t5 = -2.0
            elif _t5_vote == -1:
                _t5_mfr = -1
                _t5_adj_t5 = -1.0
            elif _t5_vote >= 3:
                _t5_mfr = 2
                _t5_adj_t5 = 2.0
            elif _t5_vote == 2:
                _t5_mfr = 1
                _t5_adj_t5 = 1.0
            self._last_g85t5_mfr = _t5_mfr
            quality_score += _t5_adj_t5
            self._gate_stats["gate_g85t5_mfr"]["pass" if _t5_adj_t5 >= 0 else "fail"] += 1
            self._gate_stats_recent["gate_g85t5_mfr"].append(1 if _t5_adj_t5 >= 0 else 0)
            self._logger.debug(
                f"[v140.0 G8.5T5 MFR] {symbol} "
                f"ofv={_t5_ofv:+d}(ofi_z={_t5_ofi_z:.2f},dir={_t5_dir_int:+d}) "
                f"rs={_t5_rs:+d} ddm={_t5_ddm:+d} vote={_t5_vote:+d} "
                f"emergency={_t5_emergency} adj={_t5_adj_t5:+.1f}pts mfr={_t5_mfr:+d}"
            )
        except Exception:
            pass  # G8.5T5 MFR MomentumFlow-Regime is non-fatal soft-gate

        # ── v141.0 Gate G8.5U5 — OUP Ornstein-Uhlenbeck Process Mean-Reversion ──
        # 131st gate — zero-API OU-process spread quality gate implementing the
        # Ornstein-Uhlenbeck stochastic differential equation (StatArb framework):
        #   dS_t = θ(μ - S_t)dt + σdW_t  →  Z_t = (S_t - μ_rolling) / σ_rolling
        # S_t proxy = current quality score vs rolling quality_score_ring (8-sample window).
        # Entry at |Z_t| ≥ 1.5σ (statistical edge); max edge at Z_t > 2.5σ.
        # EMERGENCY -3.5pts: |Z_t| > 3.5σ (O-U structural break / cointegration collapse).
        # Targets regime shifts where quality has diverged beyond 3.5σ from its mean —
        # the statistical signature of a market-structure breakdown, not noise.
        #   EMERGENCY -3.5pts: |Z_t| > 3.5 (structural break, cointegration collapse)
        #   -2.0pts: Z_t < -2.5 (EV far below rolling mean, system at edge-floor)
        #   -1.0pts: Z_t < -1.5 (below-mean quality, reduced statistical edge)
        #    0.0pts: |Z_t| < 1.0 (equilibrium — no OU signal, balanced state)
        #   +1.0pts: Z_t > 1.5 (above-mean quality, mild OU-edge confirmation)
        #   +2.0pts: Z_t > 2.5 (quality at statistical peak, maximum OU-process edge)
        # Stores _last_g85u5_oup (+2/+1/0/-1/-2/-3) for Kelly Step 126. [v141.0]
        try:
            _u5_ring = list(getattr(self, "_quality_score_ring", None) or [])
            _u5_oup = 0
            _u5_adj_u5 = 0.0
            _u5_z = 0.0
            _u5_emergency = False
            if len(_u5_ring) >= 6:
                _u5_n = len(_u5_ring)
                _u5_mu = sum(_u5_ring) / _u5_n
                _u5_var = sum((x - _u5_mu) ** 2 for x in _u5_ring) / _u5_n
                _u5_sig = _u5_var ** 0.5
                if _u5_sig > 0.5:  # only fire when meaningful quality variation exists
                    _u5_z = (float(quality_score) - _u5_mu) / _u5_sig
                _u5_emergency = abs(_u5_z) > 3.5
                if _u5_emergency:
                    _u5_oup = -3
                    _u5_adj_u5 = -3.5
                elif _u5_z < -2.5:
                    _u5_oup = -2
                    _u5_adj_u5 = -2.0
                elif _u5_z < -1.5:
                    _u5_oup = -1
                    _u5_adj_u5 = -1.0
                elif _u5_z > 2.5:
                    _u5_oup = 2
                    _u5_adj_u5 = 2.0
                elif _u5_z > 1.5:
                    _u5_oup = 1
                    _u5_adj_u5 = 1.0
            self._last_g85u5_oup = _u5_oup
            quality_score += _u5_adj_u5
            self._gate_stats["gate_g85u5_oup"]["pass" if _u5_adj_u5 >= 0 else "fail"] += 1
            self._gate_stats_recent["gate_g85u5_oup"].append(1 if _u5_adj_u5 >= 0 else 0)
            self._logger.debug(
                f"[v141.0 G8.5U5 OUP] {symbol} "
                f"n={len(_u5_ring)} mu={_u5_mu:.2f} sig={_u5_sig:.2f} z={_u5_z:.3f} "
                f"emergency={_u5_emergency} adj={_u5_adj_u5:+.1f}pts oup={_u5_oup:+d}"
            )
        except Exception:
            pass  # G8.5U5 OUP Ornstein-Uhlenbeck Process is non-fatal soft-gate

        # ── v141.0 Gate G8.5V5 — MFA Multi-Factor Alpha FLOAM (IR=IC×√BR) ──────
        # 132nd gate — zero-API FLOAM (Fundamental Law of Active Management) gate:
        #   Information Ratio: IR ≈ IC × √BR
        #   IC (Information Coefficient) = quality score / 100 (signal accuracy proxy)
        #   BR (Breadth) = count of independent signal sources currently aligned
        #     - FLOW category: OFI z-score directionally aligned (vs action)
        #     - REGIME category: RegimeSentiment-Composite positive
        #     - QUALITY category: SVQ Sharpe-Velocity-Quality momentum positive
        #     - MOMENTUM category: MFR MomentumFlow-Regime resonance positive
        #     - MEAN-REV category: OUP Ornstein-Uhlenbeck process edge confirmed
        # EMERGENCY -3.5pts: IC < -0.15 AND BR < 3 (negative alpha + low breadth = ruin).
        # +2.0pts at IR > 0.15 (high FLOAM alpha); +1.0 at IR > 0.08 (mild alpha).
        # Negative IR = system below IR threshold → penalise.
        # Stores _last_g85v5_mfa (+2/+1/0/-1/-2/-3) for Kelly Step 127. [v141.0]
        try:
            _v5_action = str(signal_data.get("action", "") or "").upper()
            _v5_dir = 1 if _v5_action == "BUY" else (-1 if _v5_action == "SELL" else 0)
            _v5_ic = float(quality_score) / 100.0  # IC proxy: normalised quality score
            # BR: count independent confirming sources (5 orthogonal categories)
            _v5_br = 0
            # Category 1 (FLOW): OFI direction alignment
            _v5_ofi_z = float(signal_data.get("ofi_z", 0.0) or 0.0)
            if _v5_dir != 0 and _v5_ofi_z * _v5_dir > 0.5:
                _v5_br += 1
            # Category 2 (REGIME): RegimeSentiment positive
            _v5_regimesent = int(getattr(self, "_last_g85r2_regimesent", 0) or 0)
            if _v5_regimesent > 0:
                _v5_br += 1
            # Category 3 (QUALITY): SVQ Sharpe-Velocity-Quality positive
            _v5_svq = int(getattr(self, "_last_g85g3_svq", 0) or 0)
            if _v5_svq > 0:
                _v5_br += 1
            # Category 4 (MOMENTUM): MFR Triple-Resonance positive
            _v5_mfr = int(getattr(self, "_last_g85t5_mfr", 0) or 0)
            if _v5_mfr > 0:
                _v5_br += 1
            # Category 5 (MEAN-REV): OUP OU-process edge confirmed
            _v5_oup = int(getattr(self, "_last_g85u5_oup", 0) or 0)
            if _v5_oup > 0:
                _v5_br += 1
            # IR = IC × √BR  (Fundamental Law of Active Management)
            _v5_ir = _v5_ic * (_v5_br ** 0.5) if _v5_br > 0 else _v5_ic
            _v5_emergency = _v5_ic < -0.15 and _v5_br < 3
            _v5_mfa = 0
            _v5_adj_v5 = 0.0
            if _v5_emergency:
                _v5_mfa = -3
                _v5_adj_v5 = -3.5
            elif _v5_ir < -0.10:
                _v5_mfa = -2
                _v5_adj_v5 = -2.0
            elif _v5_ir < 0.0:
                _v5_mfa = -1
                _v5_adj_v5 = -1.0
            elif _v5_ir > 0.15:
                _v5_mfa = 2
                _v5_adj_v5 = 2.0
            elif _v5_ir > 0.08:
                _v5_mfa = 1
                _v5_adj_v5 = 1.0
            self._last_g85v5_mfa = _v5_mfa
            quality_score += _v5_adj_v5
            self._gate_stats["gate_g85v5_mfa"]["pass" if _v5_adj_v5 >= 0 else "fail"] += 1
            self._gate_stats_recent["gate_g85v5_mfa"].append(1 if _v5_adj_v5 >= 0 else 0)
            self._logger.debug(
                f"[v141.0 G8.5V5 MFA] {symbol} "
                f"ic={_v5_ic:.3f} br={_v5_br} ir={_v5_ir:.3f} "
                f"emergency={_v5_emergency} adj={_v5_adj_v5:+.1f}pts mfa={_v5_mfa:+d}"
            )
        except Exception:
            pass  # G8.5V5 MFA Multi-Factor Alpha FLOAM is non-fatal soft-gate

        # ── Gate 8.5W5 — WNZ Winsorization-Normalized Z-Score Guard [v142.0] ──────
        # From the FLOAM / StatArb framework (Roan+Ruuj): institutional quant pipelines
        # WINSORIZE extreme outlier readings (clip at ±3σ) before signal blending to
        # prevent any single spike from dominating the composite. This gate detects
        # conflicting extreme signals — if OFI-z AND quality-score are simultaneously
        # extreme in OPPOSING directions, the signal inputs would both be capped in
        # opposite directions → synthetic conflict indicating regime instability.
        # EMERGENCY -3.5pts: |ofi_z|>2.5 AND |qs_z|>2.5 AND conflict (opposed signs)
        # -2.0pts: OFI extreme and opposed to direction
        # -1.0pts: quality_score extreme and opposed to direction
        # +1.0pts: one extreme reading aligned with direction (institutional entry zone)
        # +2.0pts: BOTH extremes aligned (peak institutional breakout signal)
        # Sentinel: self._last_g85w5_wnz; Kelly Step 128 WNZ. [v142.0]
        try:
            _w5_qs_ring = list(self._quality_score_ring) if hasattr(self, "_quality_score_ring") and len(self._quality_score_ring) >= 5 else []
            _w5_ofi_z   = float(signal_data.get("ofi_z", 0.0) or 0.0)
            _w5_dir_int  = 1 if (direction or "").upper() == "BUY" else -1
            _w5_wnz = 0
            _w5_adj = 0.0
            if len(_w5_qs_ring) >= 5:
                _w5_mu  = sum(_w5_qs_ring) / len(_w5_qs_ring)
                _w5_var = sum((x - _w5_mu) ** 2 for x in _w5_qs_ring) / len(_w5_qs_ring)
                _w5_sig = _w5_var ** 0.5 if _w5_var > 0 else 1.0
                _w5_qs_z = (float(quality_score) - _w5_mu) / _w5_sig if _w5_sig > 0 else 0.0
                _w5_ofi_extreme = abs(_w5_ofi_z) > 2.5    # beyond institutional winsorization boundary
                _w5_qs_extreme  = abs(_w5_qs_z)  > 2.5
                _w5_ofi_aligned = (_w5_ofi_z * _w5_dir_int > 0)
                _w5_qs_aligned  = (_w5_qs_z  * _w5_dir_int > 0)
                if _w5_ofi_extreme and _w5_qs_extreme and (_w5_ofi_aligned != _w5_qs_aligned):
                    # Both extremes conflicting → institutional system would see capped-conflicting inputs → EMERGENCY
                    _w5_wnz = -3
                    _w5_adj = -3.5
                elif _w5_ofi_extreme and not _w5_ofi_aligned:
                    _w5_wnz = -2
                    _w5_adj = -2.0
                elif _w5_qs_extreme and not _w5_qs_aligned:
                    _w5_wnz = -1
                    _w5_adj = -1.0
                elif _w5_ofi_extreme and _w5_qs_extreme and _w5_ofi_aligned and _w5_qs_aligned:
                    _w5_wnz = 2   # peak breakout: both extremes aligned → maximum institutional edge
                    _w5_adj = +2.0
                elif (_w5_ofi_extreme or _w5_qs_extreme) and _w5_ofi_aligned and _w5_qs_aligned:
                    _w5_wnz = 1
                    _w5_adj = +1.0
            self._last_g85w5_wnz = _w5_wnz
            self._gate_stats["gate_g85w5_wnz"]["pass" if _w5_adj >= 0 else "fail"] += 1
            self._gate_stats_recent["gate_g85w5_wnz"].append(1 if _w5_adj >= 0 else 0)
            _record("gate_g85w5_wnz", _w5_adj >= 0)
            if _w5_wnz != 0:
                self._logger.debug(
                    f"[v142.0 G8.5W5 WNZ] {symbol} "
                    f"wnz={_w5_wnz:+d} adj={_w5_adj:+.1f}pts "
                    f"ofi_z={_w5_ofi_z:.2f}({'ext' if _w5_ofi_extreme else 'norm'}) "
                    f"qs_z={_w5_qs_z:.2f}({'ext' if _w5_qs_extreme else 'norm'}) "
                    f"aligned_ofi={_w5_ofi_aligned} aligned_qs={_w5_qs_aligned}"
                )
            score += _w5_adj
        except Exception:
            pass  # G8.5W5 WNZ Winsorization-Guard is non-fatal soft-gate

        # ── Gate 8.5X5 — ADF Stationarity-Proxy OU-Validity Gate [v142.0] ────────
        # From the StatArb framework: before trusting the OU-process mean-reversion
        # signal (G8.5U5), verify the quality_score ring is STATIONARY (I(0) process).
        # ADF proxy: lag-1 autocorrelation < 0.7 (not unit root) AND mean-crossing
        # rate > 0.2 (mean-reverting). If NON-STATIONARY while OU is firing extremes,
        # the OU gate is giving false signals on a trending/random-walk process.
        # Reference: ADF test, Engle-Granger cointegration (Johansen), OU validity.
        # EMERGENCY -3.5pts: non-stationary (rho>0.9 OR xcross<0.1) AND |OU_Z|>=2
        # -2.0pts: non-stationary (strong trending, rho>0.9)
        # -1.0pts: weakly non-stationary (rho 0.7-0.9)
        # +1.0pts: stationary (rho<0.7 + xcross>0.2)
        # +2.0pts: stationary AND OU gate confirmed positive
        # Sentinel: self._last_g85x5_adf; Kelly Step 129 ADF. [v142.0]
        try:
            _x5_qs_ring = list(self._quality_score_ring) if hasattr(self, "_quality_score_ring") and len(self._quality_score_ring) >= 5 else []
            _x5_adf = 0
            _x5_adj = 0.0
            if len(_x5_qs_ring) >= 5:
                _x5_n   = len(_x5_qs_ring)
                _x5_mu  = sum(_x5_qs_ring) / _x5_n
                _x5_var = sum((x - _x5_mu) ** 2 for x in _x5_qs_ring) / _x5_n
                _x5_sig = _x5_var ** 0.5 if _x5_var > 0 else 1.0
                # Lag-1 autocorrelation (ADF proxy — ρ≈1 → unit root / non-stationary)
                _x5_dem  = [x - _x5_mu for x in _x5_qs_ring]
                _x5_cov  = sum(_x5_dem[i] * _x5_dem[i - 1] for i in range(1, _x5_n)) / max(1, _x5_n - 1)
                _x5_var2 = sum(v * v for v in _x5_dem) / _x5_n
                _x5_rho1 = _x5_cov / _x5_var2 if _x5_var2 > 1e-9 else 0.0
                _x5_rho1 = max(-1.0, min(1.0, _x5_rho1))
                # Mean-crossing rate (stationary series crosses mean frequently)
                _x5_cross = sum(
                    1 for i in range(1, _x5_n)
                    if (_x5_qs_ring[i] - _x5_mu) * (_x5_qs_ring[i - 1] - _x5_mu) < 0
                )
                _x5_xcross_rate = _x5_cross / max(1, _x5_n - 1)
                _x5_stationary    = _x5_rho1 < 0.7  and _x5_xcross_rate > 0.2   # I(0) confirmed
                _x5_nonstationary = _x5_rho1 > 0.9  or  _x5_xcross_rate < 0.1   # unit-root risk
                _x5_u5 = int(getattr(self, "_last_g85u5_oup", 0) or 0)
                if _x5_nonstationary and abs(_x5_u5) >= 2:
                    # OU firing extreme signals on a non-stationary process → false-signal EMERGENCY
                    _x5_adf = -3
                    _x5_adj = -3.5
                elif _x5_nonstationary:
                    _x5_adf = -2
                    _x5_adj = -2.0
                elif _x5_rho1 > 0.7:
                    _x5_adf = -1
                    _x5_adj = -1.0
                elif _x5_stationary and _x5_u5 > 0:
                    # Stationary + OU confirmed → maximum OU validity, scale up
                    _x5_adf = 2
                    _x5_adj = +2.0
                elif _x5_stationary:
                    _x5_adf = 1
                    _x5_adj = +1.0
            self._last_g85x5_adf = _x5_adf
            self._gate_stats["gate_g85x5_adf"]["pass" if _x5_adj >= 0 else "fail"] += 1
            self._gate_stats_recent["gate_g85x5_adf"].append(1 if _x5_adj >= 0 else 0)
            _record("gate_g85x5_adf", _x5_adj >= 0)
            if _x5_adf != 0:
                self._logger.debug(
                    f"[v142.0 G8.5X5 ADF] {symbol} "
                    f"adf={_x5_adf:+d} adj={_x5_adj:+.1f}pts "
                    f"rho1={_x5_rho1:.3f} xcross={_x5_xcross_rate:.2f} "
                    f"stationary={_x5_stationary} ou={_x5_u5:+d}"
                )
            score += _x5_adj
        except Exception:
            pass  # G8.5X5 ADF Stationarity-Guard is non-fatal soft-gate

        # ── Gate 8.5Y5 — PCO PCA-Cross-Signal-Orthogonality Gate [v143.0] ─────────
        # From FLOAM (Fundamental Law of Active Management) Step 4: Collinearity Deflation.
        # When multiple alpha signals derive from overlapping sources (ofi_z, quality_score,
        # vpin), their cross-correlation degrades the FLOAM IR = IC × √BR.
        # Per GRINOLD's theorem: non-orthogonal signals count as fractional breadth, not
        # independent breadth. High avg|corr|>0.70 = IR-destroying collinearity bubble.
        # Uses rolling deque history of ofi_z and vpin_norm to compute live pairwise Pearson
        # correlations against quality_score_ring.
        # EMERGENCY -3.5pts: avg|corr|>0.85 AND all signals same direction (single-factor bubble)
        # -2.0pts: avg|corr|>0.70 (significant collinearity → IR degradation)
        # -1.0pts: avg|corr| 0.50-0.70 (moderate overlap)
        # +1.0pts: avg|corr|<0.30 (genuinely orthogonal multi-factor)
        # +2.0pts: avg|corr|<0.15 (maximum independent breadth → FLOAM peak IR premium)
        # Sentinel: self._last_g85y5_pco; Kelly Step 130 PCO. [v143.0]
        try:
            _y5_ofi_z_cur = float(signal_data.get("ofi_z", 0.0) or 0.0)
            _y5_vpin_cur  = float(getattr(self, "_vpin_latest", 0.5) or 0.5)
            # Append current readings to rings
            if hasattr(self, "_ofi_z_ring"):
                self._ofi_z_ring.append(_y5_ofi_z_cur)
            if hasattr(self, "_vpin_pco_ring"):
                self._vpin_pco_ring.append(_y5_vpin_cur)
            _y5_pco = 0
            _y5_adj = 0.0
            _y5_qs_ring  = list(self._quality_score_ring) if hasattr(self, "_quality_score_ring") and len(self._quality_score_ring) >= 8 else []
            _y5_ofi_ring = list(getattr(self, "_ofi_z_ring", [])) if len(getattr(self, "_ofi_z_ring", [])) >= 8 else []
            _y5_vpin_ring= list(getattr(self, "_vpin_pco_ring", [])) if len(getattr(self, "_vpin_pco_ring", [])) >= 8 else []
            if _y5_qs_ring and _y5_ofi_ring and _y5_vpin_ring:
                _n = min(len(_y5_qs_ring), len(_y5_ofi_ring), len(_y5_vpin_ring))
                _qs_s  = _y5_qs_ring[-_n:]
                _ofi_s = _y5_ofi_ring[-_n:]
                _vpin_s= _y5_vpin_ring[-_n:]
                def _pearson(a, b):
                    _n2 = len(a)
                    _ma = sum(a)/_n2; _mb = sum(b)/_n2
                    _num = sum((a[i]-_ma)*(b[i]-_mb) for i in range(_n2))
                    _da  = (sum((x-_ma)**2 for x in a)/_n2)**0.5
                    _db  = (sum((x-_mb)**2 for x in b)/_n2)**0.5
                    return _num/(_n2*_da*_db) if _da*_db > 1e-9 else 0.0
                _r_qs_ofi  = _pearson(_qs_s, _ofi_s)
                _r_qs_vpin = _pearson(_qs_s, _vpin_s)
                _r_ofi_vpin= _pearson(_ofi_s, _vpin_s)
                _avg_corr  = (abs(_r_qs_ofi) + abs(_r_qs_vpin) + abs(_r_ofi_vpin)) / 3.0
                _y5_dir_int= 1 if (direction or "").upper() == "BUY" else -1
                _all_same_dir = (
                    (_y5_ofi_z_cur * _y5_dir_int > 0) and
                    (float(quality_score or 50) - 50) * _y5_dir_int > 0 and
                    (0.5 - _y5_vpin_cur) * _y5_dir_int > 0   # VPIN<0.5 = BUY-aligned
                )
                if _avg_corr > 0.85 and _all_same_dir:
                    _y5_pco = -3;  _y5_adj = -3.5   # collinearity bubble: single-factor masquerade
                elif _avg_corr > 0.70:
                    _y5_pco = -2;  _y5_adj = -2.0   # high collinearity → FLOAM IR degradation
                elif _avg_corr > 0.50:
                    _y5_pco = -1;  _y5_adj = -1.0   # moderate overlap
                elif _avg_corr < 0.15:
                    _y5_pco = 2;   _y5_adj = +2.0   # maximum independent breadth → peak FLOAM IR
                elif _avg_corr < 0.30:
                    _y5_pco = 1;   _y5_adj = +1.0   # orthogonal multi-factor
            self._last_g85y5_pco = _y5_pco
            self._gate_stats["gate_g85y5_pco"]["pass" if _y5_adj >= 0 else "fail"] += 1
            self._gate_stats_recent["gate_g85y5_pco"].append(1 if _y5_adj >= 0 else 0)
            _record("gate_g85y5_pco", _y5_adj >= 0)
            if _y5_pco != 0:
                self._logger.debug(
                    f"[v143.0 G8.5Y5 PCO] {symbol} "
                    f"pco={_y5_pco:+d} adj={_y5_adj:+.1f}pts "
                    f"avg_corr={_avg_corr:.3f} r_qs_ofi={_r_qs_ofi:.2f} "
                    f"r_qs_vpin={_r_qs_vpin:.2f} r_ofi_vpin={_r_ofi_vpin:.2f}"
                )
            score += _y5_adj
        except Exception:
            pass  # G8.5Y5 PCO Signal-Orthogonality is non-fatal soft-gate

        # ── Gate 8.5Z5 — ICS Information-Coefficient-Sharpe FLOAM-IR Gate [v143.0] ─
        # From FLOAM: IR = IC × √BR. Measures actual signal quality via IC proxy (rolling
        # WR-based correlation) × Breadth proxy (recent trade pace × annualized).
        # Information Coefficient (IC) proxy: (recent_WR - 0.5) × 2 → correlation between
        # predicted direction and actual outcome. IC>0 = positive edge; IC<0 = no edge.
        # Breadth (BR) proxy: annualized trade count = recent_n × (252 / lookback_days).
        # FLOAM IR proxy = IC × √(BR / 252). High IR = signal quality × independence confirmed.
        # Also integrates PCO gate quality and WNZ/ADF confirmation for multi-gate IR boost.
        # EMERGENCY -3.5pts: negative IC (WR<40%) AND PCO emergency (collinear bubble)
        # -2.0pts: IC negative (WR<50% — below random walk, no statistical edge)
        # -1.0pts: IC marginal (WR 50-52%, edge barely above noise floor)
        # +1.0pts: IC moderate (WR>55%, solid statistical edge)
        # +2.0pts: high IC (WR>60%) + orthogonal signals confirmed (peak FLOAM IR premium)
        # Sentinel: self._last_g85z5_ics; Kelly Step 131 ICS. [v143.0]
        try:
            _z5_ics = 0
            _z5_adj = 0.0
            _z5_pnl_ring = list(getattr(self, "_pnl_ring", None) or [])
            if len(_z5_pnl_ring) >= 10:
                _z5_recent_n  = min(30, len(_z5_pnl_ring))
                _z5_recent    = _z5_pnl_ring[-_z5_recent_n:]
                _z5_wins      = sum(1 for x in _z5_recent if x > 0)
                _z5_wr        = _z5_wins / _z5_recent_n
                _z5_ic        = (_z5_wr - 0.5) * 2.0   # IC proxy: [-1, +1]
                # BR proxy (annualized pace estimate)
                _z5_br_raw    = _z5_recent_n * (252 / max(1, _z5_recent_n))  # simplified annualized
                _z5_floam_ir  = _z5_ic * (_z5_br_raw / 252) ** 0.5           # IR = IC × √BR
                _z5_pco_sent  = int(getattr(self, "_last_g85y5_pco", 0) or 0)
                # Gate logic
                if _z5_ic < -0.20 and _z5_pco_sent == -3:
                    _z5_ics = -3;  _z5_adj = -3.5  # negative IC + collinear bubble = worst case
                elif _z5_ic < 0:
                    _z5_ics = -2;  _z5_adj = -2.0  # below-random-walk (negative IC)
                elif _z5_ic < 0.04:
                    _z5_ics = -1;  _z5_adj = -1.0  # marginal IC (WR barely above 52%)
                elif _z5_ic > 0.20 and _z5_pco_sent >= 1:
                    _z5_ics = 2;   _z5_adj = +2.0  # high IC + orthogonal signals = FLOAM peak IR
                elif _z5_ic > 0.10:
                    _z5_ics = 1;   _z5_adj = +1.0  # solid IC (WR>55%)
            self._last_g85z5_ics = _z5_ics
            self._gate_stats["gate_g85z5_ics"]["pass" if _z5_adj >= 0 else "fail"] += 1
            self._gate_stats_recent["gate_g85z5_ics"].append(1 if _z5_adj >= 0 else 0)
            _record("gate_g85z5_ics", _z5_adj >= 0)
            if _z5_ics != 0:
                self._logger.debug(
                    f"[v143.0 G8.5Z5 ICS] {symbol} "
                    f"ics={_z5_ics:+d} adj={_z5_adj:+.1f}pts "
                    f"IC={_z5_ic:.3f} WR={_z5_wr:.1%} "
                    f"FLOAM_IR={_z5_floam_ir:.3f} pco={_z5_pco_sent:+d}"
                )
            score += _z5_adj
        except Exception:
            pass  # G8.5Z5 ICS Information-Coefficient-Sharpe is non-fatal soft-gate

        # ── G8.5AA — CWD: Confidence-WR Divergence Penalty (v157.0) ─────────
        # Zero-API soft-gate targeting the #1 confirmed anti-signal from live trade
        # data (2,798 resolved trades): AI confidence ≥90% at WR<30% produces WORSE
        # outcomes than confidence 70-80% at the same WR. Mechanism: in a losing
        # regime the model's high certainty is driven by overfitted pattern-matching —
        # it mirrors the structural bias that caused the losing streak rather than
        # detecting a genuine reversal edge. The divergence between model certainty
        # and empirical WR is the counterfactual signal.
        # Penalty tiers (penalty-only gate; positive case needs separate validation):
        #   -1.5pts: confidence ≥92 + WR<30% (primary confirmed anti-signal from data)
        #   -1.0pts: confidence ≥90 + WR<25% (ultra-crisis: AI still high-conf at DD>49%)
        # Cold-start safe: skips when booster._pnl_ring has < 20 outcomes.
        # Stores _last_g85aa_cwd (-2/-1/0) for reference [v157.0].
        try:
            _aa_fired = False
            _aa_adj   = 0.0
            self._last_g85aa_cwd = 0
            _aa_bst   = self._booster
            if _aa_bst is not None:
                _aa_pnl_ring = list(getattr(_aa_bst, "_pnl_ring", []) or [])
                if len(_aa_pnl_ring) >= 20:
                    _aa_wr_raw = float(getattr(_aa_bst, "win_rate", 0.0) or 0.0)
                    _aa_wr     = _aa_wr_raw / 100.0   # normalise 0-100 → 0-1
                    _aa_conf   = float(confidence or 0.0)  # 0-100 scale (same as G3 check)
                    if _aa_conf >= 92.0 and _aa_wr < 0.30:
                        _aa_adj = -1.5; self._last_g85aa_cwd = -2; _aa_fired = True
                        self._logger.debug(
                            f"⚠️ [v157.0 G8.5AA CWD] HIGH-CONF+LOW-WR anti-signal: "
                            f"conf={_aa_conf:.0f}% WR={_aa_wr:.1%} → -1.5pts"
                        )
                    elif _aa_conf >= 90.0 and _aa_wr < 0.25:
                        _aa_adj = -1.0; self._last_g85aa_cwd = -1; _aa_fired = True
                        self._logger.debug(
                            f"⚠️ [v157.0 G8.5AA CWD] HIGH-CONF+ULTRA-CRISIS anti-signal: "
                            f"conf={_aa_conf:.0f}% WR={_aa_wr:.1%} → -1.0pts"
                        )
            if _aa_adj != 0.0:
                score += _aa_adj
            _aa_pass = not _aa_fired
            self._gate_stats["gate_g85aa_cwd"]["pass" if _aa_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85aa_cwd"].append(1 if _aa_pass else 0)
            _record("gate_g85aa_cwd", _aa_pass)
        except Exception:
            pass  # G8.5AA CWD Confidence-WR Divergence is non-fatal soft-gate

        # ── G8.5AB — XRSI: RSI Extreme Direction Penalty (v158.0) ───────────
        # Zero-API soft-gate targeting the confirmed negative pocket from live trade
        # data: RSI>70 signals have negative expectancy at WR<35%.
        # Mechanism: at RSI extremes, chasing direction (LONG when overbought, SHORT
        # when oversold) is an empirically confirmed losing pattern. The engine is
        # momentum-aligned with an exhausted move rather than positioning for edge.
        # Direction-aware scoring (penalty-only; positive RSI reversal case validated
        # separately via GCEF and G8.5T4 CapitulationReversal gate):
        #   LONG  at RSI>78 + WR<35% → -2.5pts (extreme overbought chase)
        #   LONG  at RSI>72 + WR<35% → -1.5pts (overbought chase, confirmed anti-signal)
        #   SHORT at RSI<22 + WR<35% → -2.5pts (extreme oversold chase)
        #   SHORT at RSI<28 + WR<35% → -1.5pts (oversold chase, confirmed anti-signal)
        # WR guard: WR≥35% → skip penalty (momentum continuation valid in strong trends).
        # Cold-start safe: skips when booster._pnl_ring has < 20 outcomes.
        # Stores _last_g85ab_xrsi (-3/-2/0) for reference [v158.0].
        try:
            _ab_fired = False
            _ab_adj   = 0.0
            self._last_g85ab_xrsi = 0
            _ab_bst   = self._booster
            if _ab_bst is not None:
                _ab_pnl_ring = list(getattr(_ab_bst, "_pnl_ring", []) or [])
                if len(_ab_pnl_ring) >= 20:
                    _ab_wr_raw = float(getattr(_ab_bst, "win_rate", 0.0) or 0.0)
                    _ab_wr     = _ab_wr_raw / 100.0   # normalise 0-100 → 0-1
                    if _ab_wr < 0.35:  # WR guard: only penalise in losing/crisis regimes
                        _ab_rsi = float(signal_data.get("rsi", 50) or 50)
                        if direction == "LONG":
                            if _ab_rsi > 78.0:
                                _ab_adj = -2.5; self._last_g85ab_xrsi = -3; _ab_fired = True
                                self._logger.debug(
                                    f"⚠️ [v158.0 G8.5AB XRSI] EXTREME-OVERBOUGHT-CHASE: "
                                    f"LONG RSI={_ab_rsi:.1f}>78 WR={_ab_wr:.1%} → -2.5pts"
                                )
                            elif _ab_rsi > 72.0:
                                _ab_adj = -1.5; self._last_g85ab_xrsi = -2; _ab_fired = True
                                self._logger.debug(
                                    f"⚠️ [v158.0 G8.5AB XRSI] OVERBOUGHT-CHASE: "
                                    f"LONG RSI={_ab_rsi:.1f}>72 WR={_ab_wr:.1%} → -1.5pts"
                                )
                        elif direction == "SHORT":
                            if _ab_rsi < 22.0:
                                _ab_adj = -2.5; self._last_g85ab_xrsi = -3; _ab_fired = True
                                self._logger.debug(
                                    f"⚠️ [v158.0 G8.5AB XRSI] EXTREME-OVERSOLD-CHASE: "
                                    f"SHORT RSI={_ab_rsi:.1f}<22 WR={_ab_wr:.1%} → -2.5pts"
                                )
                            elif _ab_rsi < 28.0:
                                _ab_adj = -1.5; self._last_g85ab_xrsi = -2; _ab_fired = True
                                self._logger.debug(
                                    f"⚠️ [v158.0 G8.5AB XRSI] OVERSOLD-CHASE: "
                                    f"SHORT RSI={_ab_rsi:.1f}<28 WR={_ab_wr:.1%} → -1.5pts"
                                )
            if _ab_adj != 0.0:
                score += _ab_adj
            _ab_pass = not _ab_fired
            self._gate_stats["gate_g85ab_xrsi"]["pass" if _ab_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85ab_xrsi"].append(1 if _ab_pass else 0)
            _record("gate_g85ab_xrsi", _ab_pass)
        except Exception:
            pass  # G8.5AB XRSI RSI-Extreme-Direction Penalty is non-fatal soft-gate

        # ── G8.5AC — GDLB: Direction Long Bias Penalty (v159.0) ─────────────
        # DATA-CONFIRMED structural edge from 16,305 terminal signals (full channel history):
        #   LONG  signals: WR=14.1%  avgP=−0.28%  (structural loser)
        #   SHORT signals: WR=16.4%  avgP=+0.26%  (structural winner)
        # At crisis WR (<32%), every LONG signal faces this structural 0.54pp avgP headwind
        # compounding on top of the existing crisis conditions. Penalty-only (cannot block):
        #   direction==LONG + WR<28% → -1.5pts (deep-crisis LONG structural penalty)
        #   direction==LONG + WR<32% → -1.0pt  (crisis LONG structural penalty)
        #   direction==SHORT          → 0pts    (already has structural edge; no boost)
        # WR guard: WR≥35% → skip (momentum trends can override structural bias signal).
        # Cold-start safe: requires booster._pnl_ring ≥ 30 outcomes.
        # Cross-validates with G8.5AB XRSI: both hit simultaneously on LONG+overbought = −2.5pts.
        # Stores _last_g85ac_dlb (-2/-1/0) for reference [v159.0].
        try:
            _ac_fired = False
            _ac_adj   = 0.0
            self._last_g85ac_dlb = 0
            _ac_bst = self._booster
            if _ac_bst is not None:
                _ac_pnl_ring = list(getattr(_ac_bst, "_pnl_ring", []) or [])
                if len(_ac_pnl_ring) >= 30:
                    _ac_wr_raw = float(getattr(_ac_bst, "win_rate", 0.0) or 0.0)
                    _ac_wr     = _ac_wr_raw / 100.0   # normalise 0-100 → 0-1
                    if direction == "LONG" and _ac_wr < 0.35:
                        if _ac_wr < 0.28:
                            _ac_adj = -1.5; self._last_g85ac_dlb = -2; _ac_fired = True
                            self._logger.debug(
                                f"⚠️ [v159.0 G8.5AC GDLB] DEEP-CRISIS-LONG: "
                                f"WR={_ac_wr:.1%}<28% direction=LONG → -1.5pts "
                                f"(data: LONG avgP=−0.28% structural headwind)"
                            )
                        elif _ac_wr < 0.32:
                            _ac_adj = -1.0; self._last_g85ac_dlb = -1; _ac_fired = True
                            self._logger.debug(
                                f"⚠️ [v159.0 G8.5AC GDLB] CRISIS-LONG: "
                                f"WR={_ac_wr:.1%}<32% direction=LONG → -1.0pt "
                                f"(data: LONG avgP=−0.28% structural headwind)"
                            )
            if _ac_adj != 0.0:
                score += _ac_adj
            _ac_pass = not _ac_fired
            self._gate_stats["gate_g85ac_dlb"]["pass" if _ac_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85ac_dlb"].append(1 if _ac_pass else 0)
            _record("gate_g85ac_dlb", _ac_pass)
        except Exception:
            pass  # G8.5AC GDLB Direction Long Bias Penalty is non-fatal soft-gate

        # ── G8.5AD — GTOD: Time-of-Day Direction Penalty (v160.0) ───────────
        # Zero-API soft-gate targeting confirmed worst Direction×Hour pockets from
        # 17,647-signal channel analysis (US session = engine's active window, 13-22h UTC).
        # Microstructure rationale:
        #   LONG  13-14h UTC: NY market open chaos → directional instability → LONG gets chopped
        #   LONG  15h UTC   : early US continuation weakness → LONG struggles to find edge
        #   SHORT 22h UTC   : US session close → late-day short-covering/buy programs wipe SHORT
        # Penalty-only (cannot block); compounds with G8.5AC GDLB for LONG signals in worst pockets.
        # WR guard: WR≥35% → skip all (trending market can override microstructure bias).
        # Cold-start safe: skips when booster._pnl_ring < 20 outcomes.
        # Stores _last_g85ad_gtod (-3/-2/0) for reference [v160.0].
        try:
            _ad_fired = False
            _ad_adj   = 0.0
            self._last_g85ad_gtod = 0
            _ad_bst = self._booster
            if _ad_bst is not None:
                _ad_pnl_ring = list(getattr(_ad_bst, "_pnl_ring", []) or [])
                if len(_ad_pnl_ring) >= 20:
                    _ad_wr_raw = float(getattr(_ad_bst, "win_rate", 0.0) or 0.0)
                    _ad_wr     = _ad_wr_raw / 100.0   # normalise 0-100 → 0-1
                    if _ad_wr < 0.35:   # WR guard
                        _ad_hour = datetime.utcnow().hour
                        if direction == "LONG":
                            if _ad_hour in (13, 14):
                                _ad_adj = -1.5; self._last_g85ad_gtod = -3; _ad_fired = True
                                self._logger.debug(
                                    f"⚠️ [v160.0 G8.5AD GTOD] NY-OPEN LONG: UTC {_ad_hour:02d}h "
                                    f"WR={_ad_wr:.1%} → -1.5pts (data: 13h avgP=-4.12%, 14h avgP=-3.01%)"
                                )
                            elif _ad_hour == 15:
                                _ad_adj = -1.0; self._last_g85ad_gtod = -2; _ad_fired = True
                                self._logger.debug(
                                    f"⚠️ [v160.0 G8.5AD GTOD] EARLY-US LONG: UTC 15h "
                                    f"WR={_ad_wr:.1%} → -1.0pt (data: avgP=-3.06%)"
                                )
                        elif direction == "SHORT":
                            if _ad_hour == 14:
                                _ad_adj = -1.0; self._last_g85ad_gtod = -2; _ad_fired = True
                                self._logger.debug(
                                    f"⚠️ [v160.0 G8.5AD GTOD] NY-OPEN SHORT: UTC 14h "
                                    f"WR={_ad_wr:.1%} → -1.0pt (data: avgP=-2.80%)"
                                )
                            elif _ad_hour == 22:
                                _ad_adj = -2.0; self._last_g85ad_gtod = -3; _ad_fired = True
                                self._logger.debug(
                                    f"⚠️ [v160.0 G8.5AD GTOD] US-CLOSE SHORT: UTC 22h "
                                    f"WR={_ad_wr:.1%} → -2.0pts (data: avgP=-4.39%, worst SHORT hour)"
                                )
            if _ad_adj != 0.0:
                score += _ad_adj
            _ad_pass = not _ad_fired
            self._gate_stats["gate_g85ad_gtod"]["pass" if _ad_pass else "fail"] += 1
            self._gate_stats_recent["gate_g85ad_gtod"].append(1 if _ad_pass else 0)
            _record("gate_g85ad_gtod", _ad_pass)
        except Exception:
            pass  # G8.5AD GTOD Time-of-Day Direction Penalty is non-fatal soft-gate

        # ── v161.0: Daily state reset (UTC-day boundary) ─────────────────────
        # Resets _v161_daily_signal_n, _v161_unique_syms, _v161_dir_ring, _v161_batch_ts
        # and loads prev_day_total_pnl for recovery paradox each new UTC day.
        try:
            _v161_today = datetime.utcnow().day
            if _v161_today != getattr(self, "_v161_last_day_utc", -1):
                # Store yesterday's total pnl for recovery paradox
                try:
                    _v161_old_total = 0.0
                    if self._booster is not None:
                        _v161_pnl_ring = list(getattr(self._booster, "_pnl_ring", []) or [])
                        if len(_v161_pnl_ring) >= 5:
                            # Approximate prev-day total from pnl ring (sum × 100 for % representation)
                            _v161_old_total = sum(_v161_pnl_ring[-30:]) * 100.0  # last-30 as proxy
                    self._v161_prev_day_total = _v161_old_total
                except Exception:
                    pass
                self._v161_daily_signal_n  = 0
                self._v161_unique_syms     = set()
                self._v161_dir_ring        = []
                self._v161_batch_ts        = []
                self._v161_last_day_utc    = _v161_today
        except Exception:
            pass  # daily reset non-fatal

        # ── v161.0 G8.5AF — GCAL: Calendar Week Effect ───────────────────────
        # Data: 17,647 InsiderTactics trades. Month-start alpha vs mid-month drag.
        # Days 1-7:  WR=26.6% EV=+1.55% (+1.0pt quality bonus — institutional positioning)
        # Days 8-14: WR=22.3% EV=-0.47% (neutral→slight penalty -0.5pt)
        # Days 15-21: WR=20.8% EV=-0.53% (-1.5pt strongest drag fortnight)
        # Days 22-31: WR=21.8% EV=-0.09% (-0.3pt mild late-month drag)
        try:
            self._last_g85af_gcal = 0.0
            if GCAL_ENABLED:
                _gcal_dom = datetime.utcnow().day
                if 1 <= _gcal_dom <= 7:
                    _gcal_adj = 1.0      # month-start alpha — institutional rebalancing flow
                    self._last_g85af_gcal = 1.0
                    score += _gcal_adj
                    self._logger.debug(f"📅 [v161.0 G8.5AF GCAL] Month-start alpha: day {_gcal_dom} (+1.0pt)")
                elif 8 <= _gcal_dom <= 14:
                    _gcal_adj = -0.5     # mid-month onset drag
                    self._last_g85af_gcal = -0.5
                    score += _gcal_adj
                elif 15 <= _gcal_dom <= 21:
                    _gcal_adj = -1.5     # worst fortnight drag
                    self._last_g85af_gcal = -1.5
                    score += _gcal_adj
                    self._logger.debug(f"📅 [v161.0 G8.5AF GCAL] Mid-month drag: day {_gcal_dom} (-1.5pt)")
                else:
                    _gcal_adj = -0.3     # late-month mild drag
                    self._last_g85af_gcal = -0.3
                    score += _gcal_adj
            _gcal_fire = abs(self._last_g85af_gcal) >= 0.5
            _record("gate_g85af_gcal", not _gcal_fire or self._last_g85af_gcal > 0)
        except Exception:
            pass  # GCAL non-fatal soft-gate

        # ── v161.0 G8.5AG — GDIV: Symbol Diversity Alarm ─────────────────────
        # Data: catastrophic days avg 52.5 unique symbols WR=16.6% vs profitable 44.0 syms WR=31.0%.
        # Multi-sector volatility → signal quality degrades → spray-and-pray regime.
        # Thresholds: >55 unique syms = catastrophic (-2.5pt) | >50 = warning (-1.5pt) | <40 = concentrated (+0.5pt)
        try:
            self._last_g85ag_gdiv = 0.0
            if GDIV_ENABLED:
                # Update today's unique symbol count
                _gdiv_sym = symbol.upper() if symbol else ""
                if _gdiv_sym:
                    self._v161_unique_syms.add(_gdiv_sym)
                _gdiv_n = len(self._v161_unique_syms)
                if _gdiv_n >= 55:
                    _gdiv_adj = -2.5
                    self._last_g85ag_gdiv = -2.5
                    score += _gdiv_adj
                    self._logger.warning(
                        f"⚠️ [v161.0 G8.5AG GDIV] Catastrophic symbol diversity: "
                        f"{_gdiv_n} unique syms today ≥55 (data: WR=16.6% vs 31.0% normal) → -2.5pt"
                    )
                elif _gdiv_n >= 50:
                    _gdiv_adj = -1.5
                    self._last_g85ag_gdiv = -1.5
                    score += _gdiv_adj
                elif _gdiv_n >= GDIV_LIMIT:
                    _gdiv_adj = -0.8
                    self._last_g85ag_gdiv = -0.8
                    score += _gdiv_adj
                elif _gdiv_n < 40:
                    _gdiv_adj = 0.5     # concentrated session = quality regime
                    self._last_g85ag_gdiv = 0.5
                    score += _gdiv_adj
            _record("gate_g85ag_gdiv", self._last_g85ag_gdiv >= -1.5)
        except Exception:
            pass  # GDIV non-fatal soft-gate

        # ── v161.0 G8.5AH — GSEQ: Intraday Sequence Position ────────────────
        # Data: intraday signal sequence dramatically predicts quality.
        # Signals 1-10:  warm-up period (WR=23%) — bot calibrating to session
        # Signals 11-20: PEAK window (WR=28% EV=+1.79%) — full momentum +1.5pt
        # Signals 21-90: plateau baseline (WR=22-24%) — neutral
        # Signals 91-100: kill zone (WR=14% EV=-3.4%) — severe degradation -2.5pt
        # Signals >100:  meltdown zone (WR=12%) — ultra-kill -3.5pt
        try:
            self._last_g85ah_gseq = 0.0
            if GSEQ_ENABLED:
                self._v161_daily_signal_n += 1
                _gseq_n = self._v161_daily_signal_n
                if 11 <= _gseq_n <= 20:
                    _gseq_adj = 1.5
                    self._last_g85ah_gseq = 1.5
                    score += _gseq_adj
                    self._logger.debug(f"🎯 [v161.0 G8.5AH GSEQ] Peak window signal #{_gseq_n} (+1.5pt)")
                elif 21 <= _gseq_n <= 90:
                    pass  # neutral plateau
                elif 91 <= _gseq_n <= 100:
                    _gseq_adj = -2.5
                    self._last_g85ah_gseq = -2.5
                    score += _gseq_adj
                    self._logger.warning(
                        f"⚠️ [v161.0 G8.5AH GSEQ] Kill zone: signal #{_gseq_n} "
                        f"(data: WR=14% EV=-3.4%) → -2.5pt"
                    )
                elif _gseq_n > 100:
                    _gseq_adj = -3.5
                    self._last_g85ah_gseq = -3.5
                    score += _gseq_adj
                    self._logger.warning(
                        f"🛑 [v161.0 G8.5AH GSEQ] Meltdown zone: signal #{_gseq_n} "
                        f"(data: WR=12%) → -3.5pt"
                    )
            _record("gate_g85ah_gseq", self._last_g85ah_gseq >= -2.5)
        except Exception:
            pass  # GSEQ non-fatal soft-gate

        # ── v161.0 G8.5AI — GMOM3: 3-Signal Session Direction Momentum ───────
        # Data: strongest session-level edge in 17k-trade dataset.
        # After 2×LONG then SHORT fires: WR=28% EV=+1.79% (reversal edge → +1.5pt)
        # After 2×SHORT continuation SHORT: WR=22% EV=-0.41% (fatigue → -0.5pt)
        # After 2×LONG then LONG: WR=20% EV=-0.38% (LONG-dominance → -1.0pt)
        # Mechanism: SHORT after LONG-dominated session = regime change signal (highest quality)
        try:
            self._last_g85ai_gmom3 = 0.0
            if GMOM3_ENABLED:
                _gm3_sd  = signal_data.get("action", signal_data.get("direction", "")) if isinstance(signal_data, dict) else ""
                _gm3_dir = "LONG" if _gm3_sd in ("LONG","BUY","long","buy") else ("SHORT" if _gm3_sd in ("SHORT","SELL","short","sell") else "")
                if _gm3_dir:
                    _gm3_ring = list(self._v161_dir_ring)   # last ≤3 directions
                    if len(_gm3_ring) >= 2:
                        _gm3_longs  = _gm3_ring.count("LONG")
                        _gm3_shorts = _gm3_ring.count("SHORT")
                        if _gm3_longs >= 2 and _gm3_dir == "SHORT":
                            # Reversal SHORT after LONG-dominated session — strongest edge
                            _gm3_adj = 1.5
                            self._last_g85ai_gmom3 = 1.5
                            score += _gm3_adj
                            self._logger.debug(
                                f"🎯 [v161.0 G8.5AI GMOM3] Reversal SHORT after {_gm3_longs}×LONG session "
                                f"(data: WR=28% EV=+1.79%) → +1.5pt"
                            )
                        elif _gm3_longs >= 2 and _gm3_dir == "LONG":
                            # LONG after LONG-dominance — confirmed kill
                            _gm3_adj = -1.0
                            self._last_g85ai_gmom3 = -1.0
                            score += _gm3_adj
                        elif _gm3_shorts >= 2 and _gm3_dir == "SHORT":
                            # SHORT continuation fatigue
                            _gm3_adj = -0.5
                            self._last_g85ai_gmom3 = -0.5
                            score += _gm3_adj
                    # Update direction ring (keep last 3)
                    self._v161_dir_ring.append(_gm3_dir)
                    if len(self._v161_dir_ring) > 3:
                        self._v161_dir_ring = self._v161_dir_ring[-3:]
            _record("gate_g85ai_gmom3", self._last_g85ai_gmom3 >= -1.0)
        except Exception:
            pass  # GMOM3 non-fatal soft-gate

        # ── v161.0 G8.5AJ — GBATCH: Batch Size Signal Cluster ────────────────
        # Data: rapid-fire signal batches have dramatically different WR by batch size.
        # Batch 5 or 7 signals in window: WR+6pp elite → +2.5pt
        # Batch 4, 9, or 10 signals: WR-8pp confirmed kill → -3.0pt
        # Batch 1-3 (isolated signal): WR=baseline → 0pt
        # Batch 6/8: neutral → 0pt
        # Mechanism: batch size 5/7 = selective momentum regime; 4/9/10 = spray-and-pray chaos
        try:
            self._last_g85aj_gbatch = 0.0
            if GBATCH_ENABLED:
                _gbat_now = time.time()
                # Prune batch window to last GBATCH_WIN_SEC seconds
                self._v161_batch_ts = [t for t in self._v161_batch_ts if _gbat_now - t < GBATCH_WIN_SEC]
                self._v161_batch_ts.append(_gbat_now)
                _gbat_n = len(self._v161_batch_ts)
                if _gbat_n in (5, 7):
                    _gbat_adj = 2.5
                    self._last_g85aj_gbatch = 2.5
                    score += _gbat_adj
                    self._logger.debug(
                        f"🎯 [v161.0 G8.5AJ GBATCH] Elite batch size {_gbat_n} "
                        f"(data: WR+6pp) → +2.5pt"
                    )
                elif _gbat_n in (4, 9, 10):
                    _gbat_adj = -3.0
                    self._last_g85aj_gbatch = -3.0
                    score += _gbat_adj
                    self._logger.warning(
                        f"⚠️ [v161.0 G8.5AJ GBATCH] Kill batch size {_gbat_n} "
                        f"(data: WR-8pp) → -3.0pt"
                    )
                elif _gbat_n > 10:
                    _gbat_adj = -4.0
                    self._last_g85aj_gbatch = -4.0
                    score += _gbat_adj
                    self._logger.warning(
                        f"🛑 [v161.0 G8.5AJ GBATCH] Ultra-kill batch {_gbat_n} → -4.0pt"
                    )
            _record("gate_g85aj_gbatch", self._last_g85aj_gbatch >= -3.0)
        except Exception:
            pass  # GBATCH non-fatal soft-gate


        # ── Gate 8.5m — BTC Macro GEX Alignment (v18.94) ────────────────────
        # Deribit BTC GEX net direction vs signal direction quality adjustment.
        # When dealer net GEX is strongly negative (short-gamma regime), LONGs
        # face amplified adverse volatility from dealers hedging against the move.
        # When dealer net GEX is positive (long-gamma regime), LONGs benefit from
        # dealer re-hedging dampening volatility — the "gamma pin" stabilises price.
        # Net thresholds: |net| > $500M before applying (filters micro-noise).
        # Confidence guard: only fires when Deribit conf ≥ 30.
        # Symbol exemption: BTCUSDT / ETHUSDT have their own per-symbol GEX already.
        # Age guard: BTC GEX snapshot must be < 90s old (live stream guarantee).
        #   FLIP ZONE:                 −1.5pts (regime uncertainty, all directions)
        #   net < −$500M + LONG:       −2.0pts (dealer short-gamma opposes LONG)
        #   net < −$500M + SHORT:      +1.5pts (dealer short-gamma supports SHORT)
        #   net > +$500M + LONG:       +1.5pts (dealer long-gamma supports LONG)
        #   net > +$500M + SHORT:      −2.0pts (dealer long-gamma opposes SHORT)
        try:
            _g85m_sym = (symbol or "").upper()
            if _g85m_sym not in ("BTCUSDT", "ETHUSDT"):
                _g85m_snaps = getattr(self, "_engine_gex_snapshots", None)
                if _g85m_snaps is not None:
                    _g85m_entry = _g85m_snaps.get("BTCUSDT")
                    if _g85m_entry is not None:
                        _g85m_snap, _g85m_ts = (
                            (_g85m_entry[0], _g85m_entry[1])
                            if isinstance(_g85m_entry, tuple)
                            else (_g85m_entry, 0.0)
                        )
                        _g85m_age = time.time() - float(_g85m_ts or 0.0)
                        if _g85m_age < 90.0 and _g85m_snap is not None:
                            _g85m_net   = float(getattr(_g85m_snap, "net_gex", 0.0)   or 0.0)
                            _g85m_regime = str(getattr(_g85m_snap, "regime",  "") or "").upper()
                            _g85m_conf  = float(getattr(_g85m_snap, "confidence", 0) or 0)
                            _g85m_dir   = (direction or "").upper()
                            if _g85m_conf >= 30:
                                if _g85m_regime == "FLIP ZONE":
                                    quality_score -= 1.5
                                    self._logger.debug(
                                        f"[G8.5m BTC-GEX v18.94] {symbol} BTC FLIP ZONE "
                                        f"conf={_g85m_conf} → -1.5pts macro uncertainty"
                                    )
                                    # v18.98: GEX Flip-Level Directional Alignment.
                                    # BUG FIX: was checking "LONG"/"SHORT" (never matched "BUY"/"SELL").
                                    # When BTC is in FLIP ZONE, the direction of spot relative to
                                    # the gamma-flip level predicts dealer hedge direction:
                                    #   spot > flip_price → dealer long gamma → trending regime → favour BUYs
                                    #   spot < flip_price → dealer short gamma → bearish pressure → favour SELLs
                                    # +2.0pts for direction-aligned trades; -3.5pts for contra-flip trades.
                                    # Guards: conf ≥ 35, flip_price > 0, entry_price > 0.
                                    if _g85m_conf >= 35:
                                        _g85m_flip_px  = float(getattr(_g85m_snap, "flip_price", 0.0) or 0.0)
                                        _g85m_entry_px = float(
                                            (signal_data if isinstance(signal_data, dict) else {}).get(
                                                "entry_price",
                                                (signal_data if isinstance(signal_data, dict) else {}).get("entry", 0.0)
                                            ) or 0.0
                                        )
                                        if _g85m_flip_px > 0.0 and _g85m_entry_px > 0.0:
                                            _g85m_above = _g85m_entry_px > _g85m_flip_px
                                            _g85m_aligned = (
                                                (_g85m_dir == "BUY"  and _g85m_above) or
                                                (_g85m_dir == "SELL" and not _g85m_above)
                                            )
                                            if _g85m_aligned:
                                                quality_score += 2.0
                                                self._logger.debug(
                                                    f"[G8.5m-DIR v18.98] {symbol} {_g85m_dir} aligned "
                                                    f"entry={_g85m_entry_px:.0f} {'>' if _g85m_above else '<'} "
                                                    f"flip={_g85m_flip_px:.0f} → +2.0pts"
                                                )
                                            else:
                                                quality_score -= 3.5
                                                self._logger.debug(
                                                    f"[G8.5m-DIR v18.98] {symbol} {_g85m_dir} contra-flip "
                                                    f"entry={_g85m_entry_px:.0f} {'<' if not _g85m_above else '>'} "
                                                    f"flip={_g85m_flip_px:.0f} → -3.5pts"
                                                )
                                elif _g85m_net < -500_000_000.0:
                                    if _g85m_dir == "BUY":   # v18.98 BUG FIX: was "LONG" (never matched)
                                        quality_score -= 2.0
                                        self._logger.debug(
                                            f"[G8.5m BTC-GEX v18.98] {symbol} BTC net=${_g85m_net/1e6:.0f}M "
                                            f"NEGATIVE_GEX + BUY → -2.0pts (dealer short-gamma)"
                                        )
                                    elif _g85m_dir == "SELL":  # v18.98 BUG FIX: was "SHORT" (never matched)
                                        quality_score += 1.5
                                        self._logger.debug(
                                            f"[G8.5m BTC-GEX v18.98] {symbol} BTC net=${_g85m_net/1e6:.0f}M "
                                            f"NEGATIVE_GEX + SELL → +1.5pts (aligned with dealer)"
                                        )
                                elif _g85m_net > 500_000_000.0:
                                    if _g85m_dir == "BUY":   # v18.98 BUG FIX: was "LONG" (never matched)
                                        quality_score += 1.5
                                        self._logger.debug(
                                            f"[G8.5m BTC-GEX v18.98] {symbol} BTC net=+${_g85m_net/1e6:.0f}M "
                                            f"POSITIVE_GEX + BUY → +1.5pts (gamma pin supports)"
                                        )
                                    elif _g85m_dir == "SELL":  # v18.98 BUG FIX: was "SHORT" (never matched)
                                        quality_score -= 2.0
                                        self._logger.debug(
                                            f"[G8.5m BTC-GEX v18.98] {symbol} BTC net=+${_g85m_net/1e6:.0f}M "
                                            f"POSITIVE_GEX + SELL → -2.0pts (against gamma pin)"
                                        )
        except Exception:
            pass

        # ── Gate 8.5n — Multi-Asset FLIP ZONE Macro Penalty (v18.95) ─────────
        # When 2 or more of the three major Deribit GEX assets (BTC/ETH/SOL) are
        # simultaneously in FLIP ZONE, the entire crypto market is in coordinated
        # regime uncertainty — dealers across all three primary option markets are
        # at their gamma-flip level simultaneously.  This structural condition is
        # statistically rare (~8% of hours) and correlates with the highest
        # dispersion in realised intraday returns (both dirs equally likely).
        # Penalty: −2.0pts (compounds with G8.5m's per-asset BTC penalty when
        # BTC itself is also in FLIP ZONE, giving up to −3.5pts total on LONGs).
        # Guards: at least 2 snapshots must be < 120s old; conf ≥ 25 on each.
        # v18.96: _multiflip_count exposed outside try-block for G9 compound floor.
        _multiflip_count: int = 0   # v18.96: used by G9 floor compound
        try:
            _g85n_snaps = getattr(self, "_engine_gex_snapshots", None)
            if _g85n_snaps is not None:
                _g85n_cnt = 0
                for _g85n_sym in ("BTCUSDT", "ETHUSDT", "SOLUSDT"):
                    _g85n_entry = _g85n_snaps.get(_g85n_sym)
                    if _g85n_entry is not None:
                        _g85n_s, _g85n_t = (
                            (_g85n_entry[0], _g85n_entry[1])
                            if isinstance(_g85n_entry, tuple)
                            else (_g85n_entry, 0.0)
                        )
                        if (time.time() - float(_g85n_t or 0.0)) < 120.0 and _g85n_s is not None:
                            _g85n_reg  = str(getattr(_g85n_s, "regime",     "") or "").upper()
                            _g85n_conf = float(getattr(_g85n_s, "confidence", 0) or 0)
                            if _g85n_reg == "FLIP ZONE" and _g85n_conf >= 25:
                                _g85n_cnt += 1
                _multiflip_count = _g85n_cnt   # expose for G9 compound floor
                self._last_multiflip_count = _g85n_cnt   # v18.97: persist for Gate-4 GEX stamp
                if _g85n_cnt >= 2:
                    quality_score -= 2.0
                    self._logger.debug(
                        f"[G8.5n MultiFlip v18.95] {symbol} {_g85n_cnt}/3 assets "
                        f"in FLIP ZONE → -2.0pts macro regime uncertainty"
                    )
        except Exception:
            pass

        # ── Gate 8.5V — Vibe-Trading Multi-Agent Consensus (v18.40) ──────────
        # Three specialized agents (Trend, Flow, Macro) evaluate the signal from
        # orthogonal perspectives and produce a weighted consensus quality bias.
        # Inspired by HKUDS Vibe-Trading multi-agent framework methodology.
        # Weights: Trend=0.30, Flow=0.40 (most actionable for futures), Macro=0.30.
        # Never hard-vetos — soft quality modifier only.  Fail-safe by design.
        _vibe_sov_flag = False   # v18.42: VibePool SOVEREIGN flag for ISB convergence
        if symbol and direction and self._vibe_pool is not None:
            try:
                _vibe_delta, _vibe_reason = self._vibe_pool.evaluate(
                    signal_data, direction, gex_snapshot
                )
                if _vibe_delta != 0.0:
                    quality_score += _vibe_delta
                    _vibe_log = (
                        self._logger.info
                        if abs(_vibe_delta) >= VibeAgentPool.VIBE_SOVEREIGN_PTS
                        else self._logger.debug
                    )
                    _vibe_log(f"🤖 [{symbol}] {_vibe_reason}")
                    if _vibe_delta >= VibeAgentPool.VIBE_SOVEREIGN_PTS:
                        _vibe_sov_flag = True   # v18.42: flag for Intelligence Singularity Bonus
                    self._record("gate_vibe", _vibe_delta > 0)
                else:
                    self._record("gate_vibe", True)   # neutral = pass-through
            except Exception as _vibe_exc:
                self._logger.debug(f"[VibePool G8.5V] non-fatal: {_vibe_exc}")
        # v18.42: Intelligence Singularity Bonus (ISB)
        # When Markov SOVEREIGN (p_ij≥0.87) AND VibePool SOVEREIGN (consensus≥0.60)
        # both confirm the same signal direction, apply +3pts ISB bonus.
        # Optionally, consensus ≥ 0.95 alone with Markov SOVEREIGN also qualifies.
        # These are orthogonal intelligence axes — Markov captures statistical regime
        # transition probability; VibePool captures multi-agent dynamic consensus.
        # Their joint confirmation multiplicatively reduces the probability of a false
        # positive, justifying a structural quality uplift. [v18.42]
        try:
            _isb_cons = float(signal_data.get("consensus", signal_data.get("swarm_consensus", 0)) or 0)
            _isb_sr    = float(getattr(self, "sharpe_ratio", 0.0) or 0.0)
            # v20.2: Sharpe-aware ISB guard — when in deep ruin (Sharpe<-4), require
            # BOTH intelligence axes to be SOVEREIGN for the bonus.
            # The Markov+95%-consensus shortcut is disabled: at Sharpe<-4 consensus alone
            # is insufficient evidence to justify a quality uplift (high consensus in ruin
            # regime has historically correlated with crowded trades, not genuine edge).
            # Dual-SOV (Markov p_ij≥0.87 AND Vibe consensus≥0.60) remains active — that
            # requires two orthogonal intelligence systems to agree, which is the true signal.
            _isb_fired = (
                (_mk_sov_flag and _vibe_sov_flag) or          # dual-SOV: both intelligence systems SOVEREIGN
                (_mk_sov_flag and _isb_cons >= 0.95 and _isb_sr >= -4.0)  # Markov+unanimous (disabled in deep crisis)
            )
            if _isb_fired:
                quality_score += 5.0   # v18.52: raised +3pts → +5pts (dual-SOVEREIGN convergence warrants stronger uplift)
                self._logger.info(
                    f"⚡ [{symbol}] INTELLIGENCE SINGULARITY BONUS v18.52: "
                    f"Markov={'SOV' if _mk_sov_flag else '—'} "
                    f"Vibe={'SOV' if _vibe_sov_flag else '—'} "
                    f"cons={_isb_cons:.0%} → +5pts (quality={quality_score:.1f})"
                )
        except Exception:
            pass

        # v11.3: Bayesian WP regime penalty — when Bayesian win probability is in a
        # chronic losing regime, apply a quality penalty so Gate 9 blocks all but the
        # highest-conviction signals.  Only fires when Bayes posterior is below 27%
        # (i.e. the engine has demonstrated sustained sub-28% win rate historically).
        # Penalty: up to −12pts, linearly from WP=27% down to WP=15%.
        if self._booster is not None:
            _ba9 = float(getattr(self._booster, "_bayes_alpha", 2.0) or 2.0)
            _bb9 = float(getattr(self._booster, "_bayes_beta",  2.0) or 2.0)
            _bwp9 = _ba9 / (_ba9 + _bb9)
            if _bwp9 < 0.27:
                _bwp_penalty = min(12.0, max(0.0, (0.27 - _bwp9) / 0.12 * 12.0))
                quality_score -= _bwp_penalty
                self._logger.debug(
                    f"[v11.3] Bayes WP penalty: p̂={_bwp9:.1%}<27% → "
                    f"−{_bwp_penalty:.1f}pts quality"
                )
            elif _bwp9 > 0.45:
                # v13.0: Bayesian WP bonus — reward sustained edge when WP>45%.
                # Linear interpolation 45%→60%: 0→+6pts.  Exploits demonstrated
                # hot regimes more aggressively while the edge is real.  Capped
                # at +6pts (conservative) so a single lucky streak can't open-gate.
                _bwp_bonus = min(6.0, max(0.0, (_bwp9 - 0.45) / 0.15 * 6.0))
                quality_score += _bwp_bonus
                if _bwp_bonus >= 2.0:
                    self._logger.debug(
                        f"[v13.0] Bayes WP bonus: p̂={_bwp9:.1%}>45% → "
                        f"+{_bwp_bonus:.1f}pts quality"
                    )

        # ── v17.0 Singularity: Sortino Quality Bias ─────────────────────────
        # Incorporates realized Sortino Ratio into the composite quality score
        # as a third-dimension risk-adjusted signal prioritization layer.
        # When Sortino is strongly positive (downside-controlled precision
        # regime), signals earn a quality bonus — the system is firing in a
        # state where losses are small and controlled.  When Sortino is
        # negative, apply a graduated penalty that mirrors the Kelly overlay.
        # Uses the booster's _pnl_ring (last-100 trades) — same data source
        # as the Kelly Sortino overlay for consistency.  No-op on cold-start
        # (<10 samples) so the first signals flow through unpenalised.
        if self._booster is not None:
            try:
                _srt_q = self._booster.sortino_ratio
                if _srt_q > 2.0:
                    # Deep precision: Srt=2.0→+2pts, Srt=4.0→+6pts (max +6)
                    _srt_q_bonus = min(6.0, 2.0 + (_srt_q - 2.0) * 2.0)
                    quality_score += _srt_q_bonus
                    self._logger.debug(
                        f"[v17.0] Sortino Q+: Srt={_srt_q:.2f}>2.0 → "
                        f"+{_srt_q_bonus:.1f}pts (precision regime)"
                    )
                elif _srt_q > 0.5:
                    quality_score += 1.5   # modest positive regime bonus
                elif _srt_q < -1.5:
                    # Severe downside: Srt=-1.5→-0, Srt=-4.5→-5pts (max -5)
                    _srt_q_pen = min(5.0, abs(_srt_q + 1.5) * (5.0 / 3.0))
                    quality_score -= _srt_q_pen
                    self._logger.debug(
                        f"[v17.0] Sortino Q-: Srt={_srt_q:.2f}<-1.5 → "
                        f"-{_srt_q_pen:.1f}pts (drawdown regime)"
                    )
                elif _srt_q < -0.5:
                    quality_score -= 2.0   # mild downside penalty
            except Exception:
                pass

        # v18.10: FLIP ZONE Quality Penalty — regime-aware signal suppression.
        # The GEX FLIP ZONE regime (gamma-zero crossing) is where dealer delta-hedging
        # direction is maximally uncertain.  Signals fired into FLIP ZONE face:
        #   • Higher adverse selection (dealer may hedge against our direction)
        #   • Whipsaw risk as price oscillates around the gamma-zero level
        #   • Lower realized WR empirically (dominant regime during WR=31.1% period)
        # Penalty is calibrated by GEX confidence — low-confidence FLIP ZONE (conf<50)
        # is the weakest signal environment and receives the full -4pts penalty.
        # Guard: WR<40% (if our track record is good, FLIP ZONE may still be tradeable);
        # GEX conf≥25 (avoid penalising cold-boot with no GEX data yet).
        try:
            if gex_snapshot is not None:
                _fz_regime = str(getattr(gex_snapshot, "regime", "")).upper()
                _fz_conf   = float(getattr(gex_snapshot, "confidence", 0) or 0)
                _fz_dgrp   = float(getattr(gex_snapshot, "dgrp_score", 50) or 50)
                if "FLIP" in _fz_regime and _fz_conf >= 25:
                    _fz_wr = (
                        sum(self._booster._win_ring) / len(self._booster._win_ring)
                        if self._booster is not None
                        and len(getattr(self._booster, "_win_ring", [])) >= 10
                        else 0.35
                    )
                    if _fz_wr < 0.40:
                        # Low-confidence FLIP ZONE (DGRP<45 or conf<50): full -4pts
                        # Moderate-confidence FLIP ZONE: lighter -2pts
                        _fz_penalty = -4.0 if (_fz_dgrp < 45 or _fz_conf < 50) else -2.0
                        quality_score += _fz_penalty
        except Exception:
            pass

        # v61.0: G9 Recovery Momentum Bonus — fast-momentum recovery signal.
        # When the RECENT-20 win rate is improving ≥3pp above the PRIOR-20 win rate
        # AND Sharpe > -2.0 (not in active ruin), grant a +1.5pt quality bonus.
        # Rationale: Bayesian WP (p̂) is a slow posterior — it takes 10-15 wins to shift
        # meaningfully.  This bonus fires on MOMENTUM within 1 scan cycle of the regime
        # turn, giving the engine a 10-15 cycle head-start on recognising a hot streak.
        # Guard: Sharpe > -2.0 prevents firing during a noisy blip inside a losing run.
        if self._booster is not None:
            try:
                _rmb_ring = list(getattr(self._booster, "_win_ring", []))
                if len(_rmb_ring) >= 40:
                    _rmb_recent20 = sum(_rmb_ring[-20:]) / 20.0
                    _rmb_prior20  = sum(_rmb_ring[-40:-20]) / 20.0
                    _rmb_sr       = float(getattr(self._booster, "sharpe_ratio", 0.0) or 0.0)
                    if (_rmb_recent20 - _rmb_prior20) >= 0.03 and _rmb_sr > -2.0:
                        quality_score += 1.5
                        self._logger.debug(
                            f"[v61.0] G9 Recovery Momentum Bonus: "
                            f"recent20={_rmb_recent20:.1%} prior20={_rmb_prior20:.1%} "
                            f"Δ={_rmb_recent20-_rmb_prior20:+.1%} SR={_rmb_sr:.2f} → +1.5pts"
                        )
            except Exception:
                pass

        quality_score = min(100.0, max(0.0, quality_score))

        # ── Gate 9 — Composite quality floor (adaptive v11.3, base v5.8) ──────
        # v11.3: Floor now scales with demonstrated WR (mirrors IRONS adaptive floor).
        # WR-tier adaptive floors (v70.0 recalibrated; base=67):
        # WR<15%: floor=74. WR<20%: floor=70. WR<25%: floor=70. WR<30%: floor=69. WR<35%: floor=68.
        # WR 35-50%: base=67. Recovery bonus at WR≥42%+Sharpe>0: floor−1pt.
        # v70.0: WR<20% relaxed 72→70 (was 72; co-equal with IRONS WR<18%→73/WR<20%→72 v70.0 split).
        _g9_floor = float(SIGNAL_MIN_QUALITY_GATE)
        # v115.0: MaxDD Adaptive Quality Floor Raise — when MaxDD is in ruin territory,
        # the G9 composite quality minimum is raised beyond the WR-tier floor.
        # This prevents high-scoring individual signals from sneaking through during
        # portfolio-level ruin (MaxDD=49.37%). Separate from the MaxDD deterrent which
        # deducts from score — this RAISES the bar that must be cleared.
        #   MaxDD > 47%: +3pts floor raise (near-absolute ruin)
        #   MaxDD > 43%: +2pts floor raise (deep drawdown)
        #   MaxDD > 38%: +1pt floor raise (moderate drawdown warning)
        try:
            _g9_maxdd_pct = float(getattr(self._booster, "max_drawdown_pct", 0.0) or 0.0) if self._booster else 0.0
            if _g9_maxdd_pct > 0.47:
                _g9_floor += 3.0  # v115.0: near-absolute ruin raise
            elif _g9_maxdd_pct > 0.43:
                _g9_floor += 2.0  # v115.0: deep drawdown raise
            elif _g9_maxdd_pct > 0.38:
                _g9_floor += 1.0  # v115.0: moderate drawdown caution
        except Exception:
            pass
        if self._booster is not None:
            _g9_ring = self._booster._win_ring
            if len(_g9_ring) >= 10:
                _g9_wr = sum(_g9_ring) / len(_g9_ring)
                if _g9_wr < 0.15:
                    _g9_floor = max(SIGNAL_MIN_QUALITY_GATE, 77.0)   # v115.0: 74→77 — extreme-ruin tier recalibrated to new base=70; only top-1st-percentile signals (77+) pass at WR<15%; SOVEREIGN bonus (+16) carries to 93+ always clears; hard-filters all but maximum-conviction entries in catastrophic losing streaks [v59.0: initial 74]
                elif _g9_wr < 0.20:
                    _g9_floor = max(SIGNAL_MIN_QUALITY_GATE, 73.0)   # v115.0: 70→73 — ultra-critical crisis: matches new IRONS_MIN_WR_BELOW30=73; at WR=18-20% G9=73+IRONS=76 dual-floor enforces institutional quality; SOVEREIGN bonus (+16) lifts to 89+ which clears; v70.0: 72→70; v115.0: 70→73
                elif _g9_wr < 0.25:
                    _g9_floor = max(SIGNAL_MIN_QUALITY_GATE, 73.0)   # v115.0: 70→73 — deep-crisis recalibrated; matches IRONS_MIN_WR_BELOW30=73; at WR<25% break-even RR=2.65; conviction-grade floor; v38.0: 66→70
                elif _g9_wr < 0.30:
                    _g9_floor = max(SIGNAL_MIN_QUALITY_GATE, 72.0)   # v115.0: 69→72 — +2pt above new base=70; matches IRONS_MIN_WR_BELOW30=73 approximately; at WR<30% break-even RR=2.65; v38.0: 65→69
                elif _g9_wr < 0.35:
                    _g9_floor = max(SIGNAL_MIN_QUALITY_GATE, 71.0)   # v115.0: 68→71 — +1pt above new base=70; sub-break-even zone WR=30-35%; v38.0: 64→68
                elif _g9_wr < 0.40:
                    _g9_floor = max(SIGNAL_MIN_QUALITY_GATE, 70.0)   # v115.0: 67→70 — equals new base; WR=35-40% approaching break-even; max(70,70)=70; v38.0: 63→67
                elif _g9_wr < 0.50:
                    _g9_floor = max(SIGNAL_MIN_QUALITY_GATE, 70.0)   # v115.0: 67→70 — equals new base; WR=40-50% above break-even; base floor appropriate; v38.0: 62→67
        # v23.0: WR Recovery Bonus — when ring WR≥42% and Sharpe>0 (positive-EV recovery
        # confirmed), relax the G9 quality floor by 1pt (hard floor: SIGNAL_MIN_QUALITY_GATE-1).
        # At WR=42%: EV = 0.42×2.35 − 0.58 = +0.407R — strongly positive EV zone.
        # Symmetric counterpart to the crisis tightening tiers above: the engine exploits
        # demonstrated recovery edge rather than defending against a past bad regime.
        # Guard: ≥15 ring samples (cold-start safe) + Sharpe>0 (quality not luck).
        try:
            if self._booster is not None and len(getattr(self._booster, "_win_ring", [])) >= 15:
                _g9_wr_rec = sum(self._booster._win_ring) / len(self._booster._win_ring)
                _g9_sr_rec = float(getattr(self._booster, "sharpe_ratio", 0.0) or 0.0)
                if _g9_wr_rec >= 0.42 and _g9_sr_rec > 0.0:
                    _g9_floor = max(SIGNAL_MIN_QUALITY_GATE - 1.0, _g9_floor - 1.0)
        except Exception:
            pass
        # v17.2: Prime-session + positive-Sortino floor relaxation.
        # During the London PM / NY AM overlap (12-20h UTC), when our realised
        # Sortino > 1.0 (downside-controlled regime), lower the WR-tier floor by
        # 1pt to allow compound-edge signals through a marginally tighter bar.
        # This is the symmetric counterpart to the WR-tier raises during bad regimes:
        # the engine should exploit confirmed edge, not only defend against bad edge.
        # Guard: only active with ≥15 ring samples (avoid cold-start artefacts).
        try:
            _utc_h_g9 = datetime.utcnow().hour
            _in_prime_g9 = SESSION_BONUS_UTC_START <= _utc_h_g9 < SESSION_BONUS_UTC_END
            if _in_prime_g9 and self._booster is not None:
                _g9_ring_len = len(getattr(self._booster, "_win_ring", []))
                if _g9_ring_len >= 15:
                    _g9_srt = float(getattr(self._booster, "sortino_ratio", 0.0) or 0.0)
                    if _g9_srt > 1.0:
                        _g9_floor = max(SIGNAL_MIN_QUALITY_GATE - 1.0, _g9_floor - 1.0)
        except Exception:
            pass
        # v18.96: G9 compound floor when ALL 3 macro assets in FLIP ZONE.
        # When _multiflip_count==3 (BTC+ETH+SOL all FLIP ZONE simultaneously),
        # raise the effective quality floor by +3pts (capped at 71).
        # Combined with G8.5n's −2pts penalty, a signal must score 67+ base
        # quality to pass G9 during full FLIP ZONE — a +5pt compound filter
        # that enforces strict selectivity during the most uncertain macro regime.
        # _multiflip_count is set by G8.5n above; defaults to 0 if G8.5n didn't fire.
        # v20.3: Crisis-aware FLIP ZONE floor — when Sharpe < -4.0 the +3pts quality
        # uplift is counterproductive. During deep ruin, 3/3 FLIP ZONE does NOT mean
        # signals are higher quality; it means maximum dealer hedging pressure and
        # the most adverse regime for directional trades. Suppress the bonus so the
        # filter stays strict; only restore it when Sharpe ≥ -4.0 (recovery zone).
        if _multiflip_count == 3:
            try:
                _g9_flip_sr = float(getattr(self._booster, "sharpe_ratio", 0.0) or 0.0) if self._booster else 0.0
            except Exception:
                _g9_flip_sr = 0.0
            if _g9_flip_sr >= -4.0:
                _g9_floor = min(71.0, _g9_floor + 3.0)
                self._logger.debug(
                    f"[G9-FlipFloor v20.3] {symbol} 3/3 FLIP ZONE SR={_g9_flip_sr:.2f}≥-4.0 → G9 floor +3pts "
                    f"({_g9_floor - 3.0:.0f}→{_g9_floor:.0f})"
                )
            else:
                self._logger.debug(
                    f"[G9-FlipFloor v20.3] {symbol} 3/3 FLIP ZONE SR={_g9_flip_sr:.2f}<-4.0 → floor +0pts (crisis-neutral)"
                )

        # v41.0: G9 Compound Hostile Regime Gate ─────────────────────────────────────────
        # When THREE simultaneous hostile signals converge: (1) Fear&Greed < 25 (Extreme
        # Fear — capitulation / panic-liquidation environment), (2) BTC GEX is FLIP ZONE
        # (dealer short-gamma — amplifies moves in BOTH directions, maximum uncertainty),
        # AND (3) rolling-20 WR < 30% (engine already in loss regime), the compound state
        # is measurably more hostile than any single factor alone. Historical observation:
        # F&G<25 + FLIP ZONE + WR<30% → realized signal quality degrades ~5-7pp below the
        # WR baseline due to amplified whipsaw + panic noise. Remedy: +2pt floor raise
        # (capped at 73) removes the bottom decile of signals without touching
        # SOVEREIGN/Markov-confirmed trades (which carry +16pt bonus over any floor).
        # Guard: ≥15 ring samples (cold-start safe). Uses signal_data["gex_btc_regime"]
        # (already set by GEX pipeline — no additional API call required). Non-fatal.
        try:
            _g9_cmp_fg   = 100
            _g9_cmp_btc  = str(signal_data.get("gex_btc_regime", "") or "")
            _g9_cmp_ring = getattr(getattr(self, "_booster", None), "_win_ring", [])
            _g9_cmp_wr   = (sum(_g9_cmp_ring) / len(_g9_cmp_ring)) if len(_g9_cmp_ring) >= 15 else 1.0
            _g9_pa = getattr(self, "_public_api", None)
            if _g9_pa is not None:
                _g9_cmp_fg = int((_g9_pa.get_market_summary() or {}).get("fear_greed", 100) or 100)
            if _g9_cmp_fg < 25 and "FLIP" in _g9_cmp_btc and _g9_cmp_wr < 0.30:
                # v42.0: Direction-aware compound hostile floor adjustment.
                # SELL in extreme fear = regime-aligned: panic momentum favors SHORT continuation;
                # ease G9 floor +1pt (vs default +2pt) to reward regime-aligned conviction.
                # BUY in extreme fear = regime-opposed: fighting panic sellers in FLIP ZONE;
                # tighten G9 floor +3pt (vs default +2pt) for extra protection against whipsaws.
                # No direction info: neutral +2pt (unchanged from v41.0 behavior).
                # Math (live regime: MaxDD=49.37% + F&G=23 + FLIP):
                #   SELL: pre-deterrent −4pt + G9-floor 69 + hostile+1pt = needs gross≥74
                #   BUY:  pre-deterrent −4pt + G9-floor 69 + hostile+3pt = needs gross≥76
                _g9_cmp_floor_adj = 2.0  # v41.0 default (no direction / unknown)
                if direction == "SELL":
                    _g9_cmp_floor_adj = 1.0   # v42.0: extreme fear + SELL regime-aligned — easier path
                elif direction == "BUY":
                    _g9_cmp_floor_adj = 3.0   # v42.0: extreme fear + BUY regime-opposed — harder path
                _g9_floor_before_hostile = _g9_floor
                _g9_floor = min(73.0, _g9_floor + _g9_cmp_floor_adj)
                self._logger.debug(
                    f"[G9-CompoundHostile v42.0] {symbol} F&G={_g9_cmp_fg}<25 + BTC={_g9_cmp_btc} + "
                    f"WR={_g9_cmp_wr:.1%}<30% dir={direction} → G9 floor +{_g9_cmp_floor_adj:.0f}pts "
                    f"({_g9_floor_before_hostile:.0f}→{_g9_floor:.0f}) "
                    f"[compound-hostile: panic+whipsaw+losing-streak "
                    f"dir={'ALIGNED' if direction == 'SELL' else 'OPPOSED' if direction == 'BUY' else 'NEUTRAL'}]"
                )
        except Exception:
            pass

        # v65.0: G9 Sortino Ultra-Crisis Floor ─────────────────────────────────────────
        # When the Sortino ratio drops below −4.0 (extreme downside-vol regime where
        # large losing trades dominate the return distribution), the G9 quality floor
        # is raised +1pt. Sortino is orthogonal to Sharpe: Sharpe penalises both
        # upside and downside vol; Sortino < −4.0 specifically captures high-magnitude
        # LOSS regimes that Sharpe may under-weight if win-size and loss-size are both
        # inflated. Cap: SIGNAL_MIN_QUALITY_GATE + 4 (same as WR<15% tier).
        # Guard: ≥15 ring samples (cold-start safe). Non-fatal.
        try:
            if self._booster is not None and len(getattr(self._booster, "_win_ring", [])) >= 15:
                _g9_srt_uc = float(getattr(self._booster, "sortino_ratio", 0.0) or 0.0)
                if _g9_srt_uc < -4.0:
                    _g9_floor_before_srt = _g9_floor
                    _g9_floor = min(SIGNAL_MIN_QUALITY_GATE + 4.0, _g9_floor + 1.0)
                    self._logger.debug(
                        f"[G9-SortinoUC v65.0] {symbol} Sortino={_g9_srt_uc:.2f}<−4.0 "
                        f"→ G9 floor +1pt ({_g9_floor_before_srt:.0f}→{_g9_floor:.0f})"
                    )
        except Exception:
            pass

        # v116.0: G9 Sharpe Ultra-Crisis Floor ───────────────────────────────────────────
        # When Sharpe drops below −5.5 (deep-ruin regime: losing capital at >5.5σ below
        # neutral expectation), apply an additional −2pt quality_score penalty. This is
        # distinct from the SortinoUC floor (+1pt floor raise at Sortino<−4.0): the
        # SortinoUC acts as a floor raise while this acts as a direct score reduction to
        # ensure that in extreme regimes (Sharpe<−5.5) the composite score is actively
        # pulled down rather than simply hitting a higher floor. Combined effect: signals
        # in extreme-ruin need +3pt more quality buffer than normal. Non-fatal.
        try:
            _g9_sr_uc = float(getattr(self._booster, "sharpe_ratio", 0.0) or 0.0) if self._booster else 0.0
            if _g9_sr_uc < -5.5:
                _g9_sr_before = quality_score
                quality_score -= 2.0
                self._logger.debug(
                    f"[G9-SharpeUC v116.0] {symbol} Sharpe={_g9_sr_uc:.2f}<−5.5 "
                    f"→ quality_score −2pts ({_g9_sr_before:.1f}→{quality_score:.1f})"
                )
        except Exception:
            pass

        # v72.0: G9 HMM+GEX Regime-Expansion Bonus ────────────────────────────────────────
        # When HMM regime is EXPANSION (P≥0.75) AND BTC GEX net > +$500M AND direction=BUY,
        # OR HMM is CONTRACTION (P≥0.65) AND GEX net < -$500M AND direction=SELL, a +1.5pt
        # quality_score bonus is applied. Both orthogonal institutional regime sources (HMM=
        # market microstructure state machine + GEX=dealer option positioning) simultaneously
        # confirming the signal direction eliminates a large class of false signals that each
        # individually pass but lack cross-source institutional validation. This is ADDITIVE
        # with G8.5e (HMM-DIR ±8pts) and G8.5R (HMM-GEX-Coherence ±1.5pts) — each of those
        # gates already incorporates HMM/GEX independently; the G9 bonus adds a final
        # confirmation layer that applies AFTER all quality accumulation. Non-fatal.
        try:
            _g9_hmm_eng = getattr(self, "_hmm_regime", None)
            if _g9_hmm_eng is not None:
                _g9_hmm_str, _g9_hmm_pexp, _ = _g9_hmm_eng.get_regime()
                _g9_gex_net = 0.0
                _g9_gex_snaps = getattr(self, "_gex_snaps", None)
                if _g9_gex_snaps is not None:
                    try:
                        _g9_snap = _g9_gex_snaps[-1] if len(_g9_gex_snaps) > 0 else None
                        if _g9_snap is not None:
                            _g9_gex_net = float(getattr(_g9_snap, "net_gex", 0.0) or 0.0)
                    except Exception:
                        pass
                _g9_dir_u = (direction or "").upper()
                _g9_exp_bonus = False
                if (_g9_hmm_str == "EXPANSION" and float(_g9_hmm_pexp or 0.0) >= 0.75
                        and _g9_gex_net > 500_000_000 and _g9_dir_u == "BUY"):
                    _g9_exp_bonus = True
                elif (_g9_hmm_str == "CONTRACTION" and float(_g9_hmm_pexp or 0.0) >= 0.65
                      and _g9_gex_net < -500_000_000 and _g9_dir_u == "SELL"):
                    _g9_exp_bonus = True
                if _g9_exp_bonus:
                    quality_score += 1.5
                    self._logger.debug(
                        f"[G9-RegimeExpansion v72.0] {symbol} HMM={_g9_hmm_str}"
                        f"(P={float(_g9_hmm_pexp or 0.0):.2f}) GEX={_g9_gex_net/1e9:.2f}B "
                        f"dir={_g9_dir_u} → +1.5pts dual-regime-confirm"
                    )
        except Exception:
            pass  # G9 regime-expansion bonus is non-fatal

        # v37.0: G9 drought softening REMOVED — quality floor is absolute; no drought exemption [v37.0-STRICT]
        # ── v18.51: SOVEREIGN RECOVERY Mode — Gate 9 floor tightening (ALL signals) ────
        # When rolling-20 WR < SOVEREIGN_RECOVERY_WR (28%), the engine enters
        # SOVEREIGN RECOVERY: Gate 9 floor raised to SOVEREIGN_RECOVERY_GATE (77) for all
        # non-SOVEREIGN-Markov signals.  SOVEREIGN-confirmed signals (p_ij≥0.87) are EXEMPT
        # from this raise, effectively forcing the engine to rely on Markov-confirmed edge.
        # Goal: improve signal selectivity in losing regimes by ONLY allowing through signals
        # with statistically demonstrated high win-probability state transitions.
        # Guards: ≥15 win_ring samples (cold-start); SOVEREIGN flag must be set by Pre-Gate M.
        # v19.6: Bayesian-blended WR applied here — same fix as paper_mode, Step 4b, and IRONS.
        # Raw ring 0W/20L (Bug N) → ring_WR=0% → SOVEREIGN Recovery fires on every restart
        # even when Bayesian WR=29.96% is above break-even.  Blend 85% Bayes + 15% ring
        # so 2488+ lifetime trades dominate the ring seed; threshold also lowered 38%→28%.
        try:
            if self._booster is not None:  # v37.0: SOVEREIGN exemption removed — ALL signals subject to SOVEREIGN_RECOVERY floor, no tier gets a free pass [v37.0-STRICT]
                _g9_sov_ring = self._booster._win_ring
                if len(_g9_sov_ring) >= 15:
                    _g9_raw_wr = sum(_g9_sov_ring) / len(_g9_sov_ring)
                    # v19.6: Bayesian blend — mirrors paper_mode + Step 4b fix
                    try:
                        _g9_ba = self._booster._bayes_alpha
                        _g9_bb = self._booster._bayes_beta
                        _g9_bn = _g9_ba + _g9_bb
                        _g9_bw = min(0.85, max(0.60, (_g9_bn - 4.0) / (_g9_bn - 4.0 + 20.0)))
                        _g9_sov_wr = _g9_bw * (_g9_ba / max(1.0, _g9_bn)) + (1.0 - _g9_bw) * _g9_raw_wr
                    except Exception:
                        _g9_sov_wr = _g9_raw_wr
                    if _g9_sov_wr < SOVEREIGN_RECOVERY_WR:
                        _g9_floor_pre_sov = _g9_floor
                        # v20.4: Ultra-crisis tier — WR<23% raises floor to 67 (was 65 for all WR<28%).
                        # At WR=23-28% the engine is in deep ruin; 65 floor was calibrated for 28-30%.
                        # WR<23% → 67pt floor enforces +2pt additional selectivity: only the top
                        # quartile of already-crisis-filtered signals can initiate recovery attempts.
                        # Mathematically: WR=23% break-even RR=0.77/0.23=3.35 > MIN_RR=2.35 → all
                        # signals at this WR are EV-negative at current RR; stricter quality bar
                        # preserves capital while better signals are sought.
                        _ultra_crisis_gate = SOVEREIGN_RECOVERY_GATE + 2.0 if _g9_sov_wr < 0.23 else SOVEREIGN_RECOVERY_GATE
                        _g9_floor = max(_g9_floor, _ultra_crisis_gate)
                        self._logger.debug(
                            f"[Gate9-v20.4-SovRecovery] WR={_g9_sov_wr:.1%}<{SOVEREIGN_RECOVERY_WR:.0%} "
                            f"non-SOVEREIGN → floor raised {_g9_floor_pre_sov:.0f}→{_g9_floor:.0f} "
                            f"({'ultra-crisis WR<23%→67' if _g9_sov_wr < 0.23 else 'standard 65'})"
                        )
        except Exception:
            pass
        # v20.4: Per-symbol consecutive loss streak penalty.
        # When a symbol has 3+ consecutive recent losses, its signal quality receives
        # a -4pt penalty. This targets "death spiral symbols" that keep generating
        # signals that pass all quality gates on paper but consistently lose — often
        # due to microstructure issues (persistently negative GEX, funding pressure,
        # or momentum divergence) not fully captured by the feature set.
        # 3-loss threshold: P(3 consec losses at WR=30%) ≈ 34.3% — common enough to be
        # statistically meaningful; 5-loss would be too rare (16.8%) to fire regularly.
        # SOVEREIGN-confirmed signals (Markov p_ij≥0.87) are exempt: their edge derives
        # from transition probability not symbol-level WR history.
        # Reset fires automatically when the symbol next wins (via PerSymbolTracker.record).
        try:
            if self._sym_tracker is not None and not _mk_sov_flag:
                _consec_sym_loss = self._sym_tracker.consecutive_losses(symbol)
                if _consec_sym_loss >= 3:
                    _consec_penalty = min(6.5, 4.5 + (_consec_sym_loss - 3) * 0.5)  # v59.0: 4.0→4.5 base penalty, cap 6.5; at WR<30% floor=69, symbol needs raw ≥73.5+ to survive 3 consec losses; +0.5pt/extra loss beyond 3; tighter death-spiral filter without touching SOVEREIGN path
                    quality_score -= _consec_penalty
                    self._logger.debug(
                        f"[G9-ConsecLoss v20.4] {symbol} {_consec_sym_loss} consecutive losses "
                        f"→ quality −{_consec_penalty:.1f}pts (non-SOVEREIGN)"
                    )
        except Exception:
            pass
        # v17.5: MaxDD-Adaptive Gate 9 quality floor tightening.
        # When MaxDD exceeds 40%, the portfolio is in significant impairment.
        # The WR-tier floor above reacts to recent win-rate micro-fluctuations;
        # this block adds an independent DRAWDOWN DEPTH axis: even if a local
        # WR recovery looks encouraging, a 40%+ MaxDD means the portfolio can
        # ill afford another run of borderline-quality losses.
        # v20.3: Added 50% tier (+3pts): at MaxDD>50% (ruin-territory) the quality
        # bar rises one full grade above the 45% tier. Kelly25 already halves size
        # at MaxDD>50%; the G9 floor ensures ONLY the highest-quality signals enter
        # during the position-sizing recovery attempt. Hard upper cap at 70.
        try:
            if self._booster is not None:
                _g9_maxdd = float(getattr(self._booster, "_max_drawdown_pct", 0.0) or 0.0)
                if _g9_maxdd > 50.0:
                    _g9_floor = min(75.0, _g9_floor + 5.0)  # v38.0: +3→+5pts ruin-territory; with base=67 this forces floor to 72+; at MaxDD>50% only top-5th-percentile signals (72+) pass; cap raised from 70→75 to allow full effect
                elif _g9_maxdd > 45.0:
                    # v38.0: raised +2→+4pts; current MaxDD=49.37% hits this tier; with base=67 floor→71; blocks all but highest-conviction SOVEREIGN signals; resolves the v18.42 death-spiral risk by raising BOTH early-deterrent (-5pts) AND G9 floor (+4pts) together
                    _g9_floor = min(75.0, _g9_floor + 4.0)  # v38.0: near-ruin → +4pts (was +2pts — too lenient at MaxDD=49%)
                elif _g9_maxdd > 40.0:
                    _g9_floor = min(75.0, _g9_floor + 2.0)  # v38.0: +1→+2pts moderate impairment; with base=67 floor→69
        except Exception:
            pass
        # v37.0: Bypass compensation block REMOVED — all bypasses eliminated; G3/G4 flags always False [v37.0-STRICT]

        # v18.8: Hard quality score cap — quality is additive across up to 12
        # bonus sources and can technically exceed 100 on high-conviction unanimous
        # signals. Cap here to maintain semantic integrity of the 0-100 scale and
        # prevent over-inflated scores from masking bypass-adjusted floors.
        quality_score = min(100.0, quality_score)

        # ── Anti-burst guard (v14.0) ──────────────────────────────────────────
        # If >4 signals forwarded in the last 3min, this is a burst — typically
        # false breakouts from choppy low-liquidity conditions.  Quality penalty
        # feeds into Gate 9 so only high-conviction signals survive a burst.
        _burst_now = time.time()
        _burst_count = sum(1 for _bt in self._global_forward_ring
                           if _burst_now - _bt < 180.0)
        if _burst_count >= 4:
            _burst_penalty = min(10.0, (_burst_count - 3) * 3.0)
            quality_score -= _burst_penalty
            self._logger.debug(
                f"⚡ [Anti-Burst v14.0] {_burst_count} signals in 3min "
                f"→ −{_burst_penalty:.0f}pts quality penalty applied"
            )

        # ── v74.0: G9 Flow-Persistence Stack Bonus ───────────────────────────
        # When BOTH G8.5B (OFI-Persistence 3-cycle ring, +2.0pts at 3/3 aligned)
        # AND G8.5C (Regime-Coherence dual HMM+GEX, +2.0pts dual-confirm) fire at
        # MAXIMUM strength in the same evaluation, the simultaneous agreement of
        # persistent order-flow AND institutional regime coherence is a high-
        # conviction compound state. Add +1.0pt stack bonus. This cannot alone
        # cause a signal to pass G9 (it only helps if nearly passing already).
        try:
            _g9_stack_bonus = 0.0
            _g9_sb_sym = (symbol or "").upper()
            # G8.5B check: 3/3 OFI ring aligned with direction
            _g9_ofi_ring = self._ofi_persist_ring.get(_g9_sb_sym)
            if _g9_ofi_ring is not None and len(_g9_ofi_ring) >= 3:
                _g9_dir_sign  = 1 if (direction or "").upper() == "BUY" else -1
                _g9_ofi_align = sum(1 for r in _g9_ofi_ring if r == _g9_dir_sign)
                if _g9_ofi_align == 3:
                    # G8.5C check: both HMM and GEX dual-confirm (g85c_adj must equal ±2.0)
                    # We detect this by checking if the G8.5C gate fired at maximum
                    # strength — use the stored _g85c_adj from this same evaluation
                    if abs(getattr(self, "_last_g85c_adj", 0.0)) >= 2.0:
                        _g9_stack_bonus = 1.0
                        quality_score += _g9_stack_bonus
                        self._logger.debug(
                            f"⚡ [G9-FlowStack v74.0] {_g9_sb_sym} OFI3/3 + "
                            f"RegimeCoh dual-confirm → +1.0pt stack bonus "
                            f"(quality now {quality_score:.1f})"
                        )
        except Exception:
            pass  # Flow-Persistence Stack bonus is non-fatal

        if _g9_floor > 0 and quality_score < _g9_floor:
            self._record("gate9", False)
            return False, (
                f"G9_FAIL: quality={quality_score:.1f}/100 < {_g9_floor:.0f} "
                f"(adaptive floor) [v11.3]"
            ), quality_score
        self._record("gate9", True)
        self._global_forward_ring.append(time.time())  # v14.0: anti-burst tracking

        # ── Gate 10 — IRONS AI Scorer (v6.0) ─────────────────────────────────
        # 25-indicator composite quality gate: Momentum / Trend / Volatility / Volume
        # Requires IRONSScorer to be wired in via set_irons_scorer().
        # Falls back to pass-through with neutral quality if scorer unavailable.
        _irons_min = self.effective_irons_min   # v6.3: adaptive threshold
        # v43.0: Direction-aware IRONS floor relief — regime-aligned signals in crisis get 1pt relief.
        # At WR<30% + F&G<30 + SELL: IRONS floor 70→69 (regime-aligned panic-continuation SELL)
        # At WR<30% + F&G>70 + BUY:  IRONS floor 70→69 (regime-aligned greed-continuation BUY)
        # Preserves strict G9=67 two-gate discipline; only 1pt relief, never below IRONS_MIN_SCORE(50).
        try:
            if self._booster is not None:
                _ir_wr_raw = float(getattr(self._booster, "win_rate", 0.0) or 0.0)
                _ir_wr = (_ir_wr_raw / 100.0) if _ir_wr_raw > 1.0 else _ir_wr_raw
                if _ir_wr < 0.30:
                    _ir_fg = float(signal_data.get("fear_greed_index", 50) or 50)
                    if (_ir_fg < 30.0 and direction == "SELL") or (_ir_fg > 70.0 and direction == "BUY"):
                        _irons_min = max(float(IRONS_MIN_SCORE), _irons_min - 1.0)
        except Exception:
            pass

        # v11.2 COLD-START BYPASS: when the IRONS ring has < 5 entries, the
        # system just started and has no statistical baseline.  The ring is
        # populated ONLY when a signal reaches Gate 10 and passes, so with
        # floor=54 (WR<30% adaptive) and ring avg=0, Gate 10 always fails →
        # ring never fills → permanent dead-loop.  During warm-up use floor=45
        # to allow data collection; normal adaptive logic takes over at ≥5 pts.
        _ring_size = len(self._irons_score_ring)
        # v55.0: cold-start bypass floor 45→38.
        # Problem observed live: first signal to reach Gate 10 (IRONS_AIScorer calls=1, sr=0%)
        # failed because the fallback re-scoring path (no irons_score_precomputed in signal_data)
        # produced a stub-quality score below 45. The ring populates unconditionally (from both
        # precomp AND re-score paths, even from failures) so the dead-loop from v11.2 is resolved.
        # The remaining issue is that stub OHLCV data (1-bar or minimal kline) consistently
        # produces IRONS scores in the 30-42 range — below the 45 cold-start bypass.
        # Lowering to 38 allows initial warm-up signals through Gate 10 so the ring fills with
        # real data. After 5 ring entries, the adaptive WR-tier logic takes over (floor=70+ at
        # WR<30%). At 38, the requirement is still above random (IRONS random baseline ≈ 30-35)
        # and guarantees some directional signal before accepting. Non-fatal: after ring fills,
        # this branch no longer executes. v11.2: initial cold-start bypass at 45.
        # v128.1 STRICT [ZERO-BYPASS]: cold-start floor relaxation REMOVED.
        # Previously (v11.2/v55.0) the IRONS floor was forced down to 38.0 while the
        # score ring held <5 entries — the LAST remaining active gate relaxation.
        # It is no longer needed: the IRONS ring now appends UNCONDITIONALLY on every
        # Gate 10 evaluation (both pass AND fail — see _irons_score_ring.append above),
        # so warm-up no longer depends on letting weak signals through; failed
        # evaluations fill the ring on their own. Gate 10 is now strict-adaptive from
        # the very first signal: no signal passes unless irons_score >= adaptive floor.
        if _ring_size < 5:
            self._logger.debug(
                f"[Gate10] Cold-start observation: ring={_ring_size} < 5 — "
                f"strict floor={_irons_min:.0f} retained, NO relaxation [v128.1-STRICT]"
            )

        if self._irons_scorer is not None and _irons_min > 0:
            try:
                # v10.8 BUG FIX: Use pre-computed IRONS score from SwarmSignal when
                # available.  SwarmSignal computed IRONS from real 200-bar 15m klines;
                # re-running Gate 10 without those bars produced stub-data artefacts:
                # (1-bar OHLCV, rsi=50, htf=NEUTRAL) → artificially low IRONS scores.
                _precomp_irons = int(signal_data.get("irons_score_precomputed", 0) or 0)
                if _precomp_irons > 0:
                    irons_score = float(_precomp_irons)
                    self._irons_score_ring.append(irons_score)
                else:
                    # Fallback: re-score from signal_data values.
                    # v10.8 bot now passes real 200-bar OHLCV + indicators (atr, rsi,
                    # htf_1h, htf_4h, volume_ratio) so this path also gets real data.
                    _closes  = signal_data.get("closes",  signal_data.get("close_prices", []))
                    _highs   = signal_data.get("highs",   signal_data.get("high_prices", []))
                    _lows    = signal_data.get("lows",    signal_data.get("low_prices", []))
                    _vols    = signal_data.get("volumes", signal_data.get("volume_data", []))
                    _cur_p   = float(signal_data.get("current_price", entry) or entry)
                    _atr     = float(signal_data.get("atr", signal_data.get("atr_value", 0.01)) or 0.01)
                    _rsi     = float(signal_data.get("rsi", 50) or 50)
                    _macd_l  = signal_data.get("macd_line", signal_data.get("macd"))
                    _macd_s  = signal_data.get("macd_signal", signal_data.get("macd_sig"))
                    _vol_r   = float(signal_data.get("volume_ratio", 1.0) or 1.0)
                    _regime  = str(signal_data.get("gex_regime", signal_data.get("regime", "NEUTRAL")) or "NEUTRAL")
                    _htf_1h  = str(signal_data.get("htf_1h", "NEUTRAL"))
                    _htf_4h  = str(signal_data.get("htf_4h", "NEUTRAL"))

                    # v18.14: Upgrade empty-OHLCV stub using live 1m kline data.
                    # Previously, when REST klines weren't forwarded (e.g. legacy paths),
                    # the stub was [entry_price, entry_price, entry_price, 1.0] — flat
                    # candles with ATR≈0.  Now: if the @kline_1m WS has fresh data
                    # (<90s) for this symbol, use its close/high/low as the seed row
                    # and derive ATR from (high-low) — 40-80× more accurate.
                    _lk = signal_data.get("live_kline_fresh") and {
                        "c": signal_data.get("live_kline_close", _cur_p),
                        "h": signal_data.get("live_kline_high",  _cur_p),
                        "l": signal_data.get("live_kline_low",   _cur_p),
                        "v": signal_data.get("live_kline_volume", 1.0),
                    }
                    if not _closes:
                        _closes = [float(_lk["c"]) if _lk else _cur_p]
                    if not _highs:
                        _highs  = [float(_lk["h"]) if _lk else _cur_p]
                    if not _lows:
                        _lows   = [float(_lk["l"]) if _lk else _cur_p]
                    if not _vols:
                        _vols   = [float(_lk["v"]) if _lk else 1.0]
                    # Augment ATR estimate from live kline range when REST ATR is default stub
                    if _lk and _atr <= 0.01:
                        _lk_atr = float(_lk["h"]) - float(_lk["l"])
                        if _lk_atr > 0:
                            _atr = _lk_atr   # raw (high-low) range — real volatility measure

                    irons_result = self._irons_scorer.score(
                        closes=_closes,
                        highs=_highs,
                        lows=_lows,
                        volumes=_vols,
                        action=direction,
                        atr=_atr,
                        rsi=_rsi,
                        macd_line=_macd_l,
                        macd_sig=_macd_s,
                        swarm_consensus=consensus,
                        confidence=confidence,
                        vol_ratio=_vol_r,
                        regime=_regime,
                        htf_1h=_htf_1h,
                        htf_4h=_htf_4h,
                    )
                    irons_score = float(
                        irons_result.get("score", irons_result.get("total_score", 0))
                        if isinstance(irons_result, dict) else float(irons_result or 0)
                    )
                    self._irons_score_ring.append(irons_score)

                # v37.0: G10 IRONS quality-override REMOVED — floor is absolute; no quality-bypass [v37.0-STRICT]
                passed_g10 = irons_score >= _irons_min   # v37.0: strict — no quality-override relaxation
                self._record("gate10", passed_g10)
                # v6.2 FIX: record IRONS health call so calls counter shows > 0
                # v100.0 FIX: success=True when scorer COMPUTED a valid score (health=scorer availability,
                # not gate pass rate).  success=False is reserved for exceptions only (scorer broken).
                self._health.record_call("IRONS_AIScorer", success=True)
                if not passed_g10:
                    return False, (
                        f"G10_FAIL: IRONS score={irons_score:.1f}/100 < {_irons_min:.0f} "
                        f"(adaptive floor={_irons_min:.0f}, static base={IRONS_MIN_SCORE:.0f}) [v37.0-STRICT]"
                    ), quality_score
                # IRONS bonus: high score adds up to 5 quality points
                _irons_range = max(1.0, 100.0 - _irons_min)
                quality_score = min(100.0, quality_score + (irons_score - _irons_min) / _irons_range * 5.0)
            except Exception as _irons_ex:
                self._logger.debug(f"Gate 10 IRONS error (non-fatal): {_irons_ex}")
                self._record("gate10", True)
                self._health.record_call("IRONS_AIScorer", success=True)   # pass-through counts
        else:
            self._record("gate10", True)
            self._health.record_call("IRONS_AIScorer", success=True)       # scorer not loaded = pass

        # v124.0: Feed quality_score into ring buffer for F284 quality_velocity feature
        try:
            _qs_ring = getattr(self, "_quality_score_ring", None)
            if _qs_ring is not None:
                _qs_ring.append(float(quality_score))
        except Exception:
            pass
        return True, "ALL_GATES_PASSED", quality_score

    # v6.2 BUG FIX: map internal dict keys to correct display gate labels
    # (old code used enumerate() → sequential numbers that didn't match gate names)
    _GATE_DISPLAY_LABELS: Dict[str, str] = {
        "gate_ev":         "G0",
        "gate_mark_div":   "GMDV",  # v18.0: mark-price divergence absolute block
        "gate_vev":        "GVEV",  # v18.3: vectorized EV pre-screener
        "gate_session":    "G0.5",
        "gate_min_tp1":    "G0.8",    # v6.2: Min TP1 distance gate
        "gate_blacklist":  "GBLK",    # v9.0 FIX: whitelist/blacklist pre-gate
        "gate_session_asian": "GASN",  # v144.0: Asian-session hard-block (WF-validated)
        "gate_session_nonus": "GEUT",  # v145.0: EU/TRANSITION hard-block (WF-validated)
        "gate_vol_spike":     "GVSP",  # v145.0: volume_ratio>2 hard-block (WF-validated)
        "gate_gdcr":          "GDCR",  # v154.0: triple-crisis hard-block (DD+WR+SR)
        "gate_gmdr":          "GMDR",  # v155.0: medium-crisis recovery hard-block
        "gate_gxpr":          "GXPR",  # v156.0: EXPIRED-proxy rate hard-block (near-zero pnl bleed)
        "gate_funding":    "GFND",    # v9.7: Binance USDM funding-window guard
        "gate_cusum":      "GCUS",    # v9.7: de Prado symmetric CUSUM event filter
        "gate_ofi":        "GOFI",    # v9.7: Order-Flow Imbalance Z-score (Cont 2014)
        "gate_liq_cascade": "GLIQ",  # v18.1: Binance force-order liquidation cascade gate
        "gate1":           "G1",
        "gate2":          "G2",
        "gate_book_imb":  "G2.5",   # v9.6: orderbook imbalance veto (Bookmap)
        "gate3":          "G3",
        "gate4":          "G4",
        "gate5":          "G5",
        "gate6":          "G6",
        "gate7":          "G7",
        "gate8":          "G8",
        "gate9":          "G9",
        "gate10":         "G10",
        "gate_cvar":      "GCVAR",  # v18.44: Pre-Gate G CVaR tail-risk gate
        "gate_markov":    "GMK",    # v18.44: Pre-Gate M Markov Chain (p_ij≥0.87)
        "gate_vibe":      "G8.5V",  # v18.44: Gate 8.5V Vibe-Trading agent pool
        "gate_g85w":      "G8.5w",  # v51.0: MTF-Momentum quality adjuster (±2.5pts)
        "gate_g85x":      "G8.5x",  # v51.0: LiqCascade-Direction quality adjuster (±2.0pts)
        "gate_g85t":      "G8.5T",  # v57.0: TurboVec vectorized 3-TF momentum (±2.5pts)
        "gate_g85u":      "G8.5U",  # v68.0: MomentumConsensus 5-gate meta-gate (±3.5pts)
        "gate_g85p":      "G8.5P",  # v60.0: BTC cross-pair momentum alignment (±1.5pts)
        "gate_g85r":      "G8.5R",  # v62.0: HMM-GEX regime coherence joint confirmation (±1.5pts)
        "gate_g85s":      "G8.5S",  # v63.0: bid-ask spread stress (−2pts acute / −1pt elevated)
        "gate_g85z":      "G8.5Z",  # v64.0: return autocorrelation persistence (±2.0pts trending/mean-rev)
        "gate_g85y":      "G8.5Y",  # v65.0: ATR volatility compression/expansion (±2.0pts/-1.5pts)
        "gate_g85dv":     "G8.5X",  # v66.0: DGRP velocity (rapid-deterioration −2.0pts, rapid-improve +1.5pts)
        "gate_g85a":      "G8.5A",  # v68.0: FundingRate trend/crowding momentum (-2.0/+1.5pts)
        "gate_g85b":      "G8.5B",  # v72.0: OFI Persistence 3-cycle ring (±2.0pts)
        "gate_g85c":      "G8.5C",  # v73.0: Regime-Coherence dual HMM+GEX confirm (±2.0pts)
        "gate_g85d":      "G8.5D",  # v74.0: OFI-Velocity signed acceleration (±2.0/-1.5pts)
        "gate_g85e":      "G8.5E",  # v75.0: Quant Cross-Signal Coherence (+2.0/+0.8/-1.5pts)
        "gate_g85f":      "G8.5F",  # v76.0: VWAP-Extension direction quality adjuster (±2.0/+1.5pts)
        "gate_g85g":      "G8.5G",  # v76.0: CUSUM-Breakout statistical confirmation (±1.5pts)
        "gate_g85h":      "G8.5H",      # v77.0: Bid-Ask Flow Asymmetry OFI+OB dual-source (±2.0/+1.5pts)
        "gate_g85i":      "G8.5I",      # v77.0: Close-Microtrend Slope 10-bar polyfit (±1.5pts)
        "gate_g85j_hmm":  "G8.5J",      # v78.0: HMM Volatility Regime Transition (±2.0/+1.5pts)
        "gate_g85k_spread": "G8.5K",   # v79.0: Spread-Regime Liquidity (±2.0/+1.5pts)
        "gate_g85l2_vpr":   "G8.5L2",  # v80.0: VolumePressure-Regime (±2.0/+1.5pts)
        "gate_g85n2_fmp":   "G8.5N2",  # v81.0: FundingMomentum-Persistence (±2.0/+1.5pts)
        "gate_g85o2_evcoherence": "G8.5O2",  # v82.0: WinRate-EV Coherence (±2.0/+1.5pts)
        "gate_g85p2_evcrisis":    "G8.5P2",  # v83.0: EV-Crisis Quality Gate (−3.0/−1.5pts)
        "gate_g85q_trendmom":     "G8.5Q",   # v84.0: TrendMomentum-Persistence (±2.0pts)
        "gate_g85r2_regimesent":  "G8.5R2",  # v84.0: RegimeSentiment-Composite (±2.0/+1.5pts)
        "gate_g85s2_wrcrisis":    "G8.5S2",  # v85.0: WinRate-CrisisRegime (±2.0/+1.5pts)
        "gate_g85t2_fearreg":     "G8.5T2",  # v85.0: ExtremeFear-Regime (±1.5/+0.5pts)
        "gate_g85u2_vov":         "G8.5U2",  # v87.0: VoV-StabilityRegime (±1.5pts)
        "gate_g85v2_obp":         "G8.5V2",  # v88.0: OBPressure-Imbalance (±2.0/+1.5pts)
        "gate_g85w2_ddm":         "G8.5W2",  # v89.0: DrawdownMomentum-Sentinel (-3.0/-2.0/-1.5/+1.5pts)
        "gate_g85x2_wrt":         "G8.5X2",  # v90.0: WinRateTrajectory (-2.0/-1.0/+2.0pts)
        "gate_g85y2_hvc":         "G8.5Y2",  # v91.0: HMM-VPIN-Coherence (-2.0/-1.5/+2.0/+1.5pts)
        "gate_g85z2_rms":         "G8.5Z2",  # v92.0: RegimeMomentumSync (-2.0/-1.5/+2.0/+1.5pts)
        "gate_g85a3_vpc":         "G8.5A3",  # v93.0: VPIN-OFI-Funding Triple-Confluence (-2.0/-1.5/+2.0/+1.5pts)
        "gate_g85b3_hos":         "G8.5B3",  # v94.0: HMM-OFI-Spread Triple-Sync (-2.0/-1.5/+2.0/+1.5pts)
        "gate_g85c3_voe":         "G8.5C3",  # v95.0: VolumeFlow-OFI-EV Triple-Convergence (-2.0/-1.5/+2.0/+1.5pts)
        "gate_g85d3_rdw":         "G8.5D3",  # v96.0: Regime-Drawdown-WinRate Triple-Risk (-2.0/-1.5/+2.0/+1.5pts)
        "gate_g85e3_efo":         "G8.5E3",  # v97.0: EV-FundMom-OFI Triple-Pressure (-2.0/-1.5/+2.0/+1.5pts)
        "gate_g85f3_mlc":         "G8.5F3",  # v101.0: MultiLayer-Coherence (-2.0/+1.0/+2.0pts)
        "gate_g85g3_svq":         "G8.5G3",  # v102.0: SharpeVelocity-QualityMomentum (-2.0/-1.5/+2.0/+1.5pts)
        "gate_g85h3_ewb":         "G8.5H3",  # v103.0: RecentWR-EmergencyBrake (-3.0/-2.0/+1.5pts)
        "gate_g85i3_ifm":         "G8.5I3",  # v103.0: IRONSFloor-Sharpe Compound (-2.0/-1.5/+1.5/+1.0pts)
        "gate_g85j3_ltc":         "G8.5J3",  # v104.0: LLM-Technical-Coherence (-2.0/-1.0/+1.5pts)
        "gate_g85k3_ssc":         "G8.5K3",  # v104.0: StreakSession-Compound (-2.0/+1.5pts)
        "gate_g85l3_cc":          "G8.5L3",  # v105.0: CrisisConsensus-Compound (-3.0/-2.0/+1.5pts)
        "gate_g85m3_tqp":         "G8.5M3",  # v105.0: TrendQuality-Persistence (-2.0/-1.0/+1.0/+2.0pts)
        "gate_g85n3_irc":         "G8.5N3",  # v106.0: OFI-HMM-MicroTrend TripleSync (-2.0/-1.5/+2.0/+1.5pts)
        "gate_g85o3_wnq":         "G8.5O3",  # v106.0: WinRate-CPCV-NNQuality Coherence (-2.0/-1.5/+2.0/+1.5pts)

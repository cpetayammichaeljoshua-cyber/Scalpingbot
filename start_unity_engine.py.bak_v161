        # Stores _last_g85y3_mcs (+1/-1/0) for Kelly Step 77 [v113.0].
        try:
            _y3_v1 = int(getattr(self, "_last_g85w3_mot",   0) or 0)   # Vote 1: MOT-TripleSync
            _y3_v2 = int(getattr(self, "_last_g85t3_rfw",   0) or 0)   # Vote 2: RFW-TripleAlignment
            _y3_v3 = int(getattr(self, "_last_g85n3_irc",   0) or 0)   # Vote 3: IRC-TripleSync
            _y3_fired = False
            self._last_g85y3_mcs = 0  # reset
            _y3_pos = sum(1 for v in [_y3_v1, _y3_v2, _y3_v3] if v > 0)
            _y3_neg = sum(1 for v in [_y3_v1, _y3_v2, _y3_v3] if v < 0)
            if _y3_pos == 3:
                quality_score += 2.0
                self._last_g85y3_mcs = 1
                _y3_fired = True
            elif _y3_pos == 2 and _y3_neg < 2:
                quality_score += 1.5
                self._last_g85y3_mcs = 1
                _y3_fired = True
            elif _y3_neg == 3:
                quality_score -= 2.0
                self._last_g85y3_mcs = -1
                _y3_fired = True
            elif _y3_neg == 2 and _y3_pos < 2:
                quality_score -= 1.5
                self._last_g85y3_mcs = -1
                _y3_fired = True
            self._record("gate_g85y3_mcs", _y3_fired)
        except Exception:
            pass  # G8.5Y3 MomentumCoh-TripleSync Meta-Gate is non-fatal soft-gate

        # ── Gate G8.5Z3 — RegimeCrisisQuality-TripleSync (v114.0) ──
        # 86th gate. Zero-API-call soft-gate: cross-validates 3 pre-computed regime/crisis
        # quality sentinels from v84-92 generation to confirm multi-source regime alignment.

            _z3_neg = sum(1 for v in [_z3_v1, _z3_v2, _z3_v3] if v < 0)
            if _z3_pos == 3:
                quality_score += 2.0
                self._last_g85z3_rqt = 1
                _z3_fired = True
            elif _z3_pos == 2 and _z3_neg < 2:
                quality_score += 1.5
                self._last_g85z3_rqt = 1
                _z3_fired = True
            elif _z3_neg == 3:
                quality_score -= 2.0
                self._last_g85z3_rqt = -1
                _z3_fired = True
            elif _z3_neg == 2 and _z3_pos < 2:
                quality_score -= 1.5
                self._last_g85z3_rqt = -1
                _z3_fired = True
            self._record("gate_g85z3_rqt", _z3_fired)
        except Exception:

                        # F122: fear_greed_regime — F&G index normalized to [-1,+1]
                        # (50 → 0.0; 100 → +1.0; 0 → -1.0)
                        _v85_fg    = float(signal_data.get("fear_greed_index", 50) or 50)
                        _v85_f122  = max(-1.0, min(1.0, (_v85_fg - 50.0) / 50.0))
                        signal_data.setdefault("fear_greed_regime", _v85_f122)
                        # F123: G8.5S2 WinRate-CrisisRegime gate output (+1/0/-1)
                        _v85_f123  = float(getattr(self, "_last_g85s2_crisis", 0))
                        signal_data.setdefault("g85s2_crisis", max(-1.0, min(1.0, _v85_f123)))
                        # F124: G8.5T2 ExtremeFear-Regime gate output (+1/0/-1)
                        _v85_f124  = float(getattr(self, "_last_g85t2_fearreg", 0))
                        signal_data.setdefault("g85t2_fearreg", max(-1.0, min(1.0, _v85_f124)))
                        # F125: crisis_regime_composite — G8.5S2(1.5x)+G8.5T2(1.0x)+WRscore(0.5x) weighted vote
                        _v85_f125  = max(-1.0, min(1.0,
                            (1.5 * _v85_f123 + 1.0 * _v85_f124 + 0.5 * _v85_f121) / 3.0
                        ))
                        signal_data.setdefault("crisis_regime_composite", _v85_f125)
                    except Exception:
                        pass  # v85.0 F121-F125 injection block is non-fatal
                    # v87.0 NN v23: F126-F130 — VoV-stability and live-flow features
                    try:
                        # F126: vov_stability — VoV gate output (+1=stable, 0=neutral, -1=chaotic)
                        #   Source: _last_g85u2_vov set by G8.5U2 gate above
                        _v87_f126 = float(getattr(self, "_last_g85u2_vov", 0))
                        signal_data.setdefault("vov_stability", max(-1.0, min(1.0, _v87_f126)))
                        # F127: funding_extreme_norm — extreme funding direction [-1,+1]
                        #   High positive fr = crowded long → contra-long signal (negative)
                        #   High negative fr = crowded short → contra-short signal (positive)
                        _v87_fr_raw = float(signal_data.get("funding_rate", 0.0) or 0.0)
                        _v87_f127   = max(-1.0, min(1.0, -_v87_fr_raw / 0.001))  # 0.1% fr = full extreme
                        signal_data.setdefault("funding_extreme_norm", _v87_f127)
                        # F128: oi_velocity_norm — OI change rate direction from mark-price WS
                        #   Increasing OI + price move = trend confirmation (+1)
                        #   Decreasing OI + price move = stop-run warning (-1)
                        _v87_oi_v   = float(signal_data.get("oi_velocity", 0.0) or 0.0)
                        _v87_f128   = max(-1.0, min(1.0, _v87_oi_v))
                        signal_data.setdefault("oi_velocity_norm", _v87_f128)
                        # F129: depth_ratio_norm — bid/ask depth asymmetry from live orderbook
                        #   Positive = buy-side heavier → bullish microstructure
                        #   Negative = sell-side heavier → bearish microstructure
                        _v87_bid_d  = float(signal_data.get("bid_depth_ratio", 0.0) or 0.0)
                        _v87_f129   = max(-1.0, min(1.0, _v87_bid_d))
                        signal_data.setdefault("depth_ratio_norm", _v87_f129)
                        # F130: liq_net_momentum — net liquidation pressure direction [-1,+1]
                        #   +1 = buy-side liquidations dominate (long squeeze, bearish pressure)
                        #   -1 = sell-side liquidations dominate (short squeeze, bullish pressure)
                        _v87_sym    = str(signal_data.get("symbol", "") or "")
                        _v87_liq_e  = _live_liq_data.get(_v87_sym, {})
                        _v87_buy_l  = float(_v87_liq_e.get("buy_vol", 0.0) or 0.0)
                        _v87_sell_l = float(_v87_liq_e.get("sell_vol", 0.0) or 0.0)
                        _v87_tot_l  = _v87_buy_l + _v87_sell_l
                        _v87_f130   = ((_v87_buy_l - _v87_sell_l) / _v87_tot_l) if _v87_tot_l > 0 else 0.0
                        signal_data.setdefault("liq_net_momentum", max(-1.0, min(1.0, _v87_f130)))
                    except Exception:
                        pass  # v87.0 F126-F130 injection block is non-fatal
                    # v88.0 NN v24: F131-F135 — OB-pressure and live-flow features
                    try:
                        # F131: ob_pressure_imbalance — direction-weighted OB depth imbalance gate output
                        #   Source: _last_g85v2_obp set by G8.5V2 gate above (+1/-1/0)
                        _v88_f131 = float(getattr(self, "_last_g85v2_obp", 0))
                        signal_data.setdefault("ob_pressure_imbalance", max(-1.0, min(1.0, _v88_f131)))
                        # F132: ob_bid_dominance — normalized bid depth dominance from WS orderbook [0,1]
                        #   depth_imbalance > 0 means bid side heavier → higher bid dominance
                        _v88_sym    = str(signal_data.get("symbol", "") or "")
                        _v88_ws_e   = (getattr(self, "_ws_state", None) or {}).get(_v88_sym) or {}
                        _v88_imb    = float(_v88_ws_e.get("depth_imbalance", 0.0) or 0.0)
                        _v88_f132   = max(0.0, min(1.0, 0.5 + _v88_imb * 2.5))  # map [-0.2,+0.2] → [0,1]
                        signal_data.setdefault("ob_bid_dominance", _v88_f132)
                        # F133: ob_ask_dominance — normalized ask depth dominance [0,1]
                        _v88_f133   = max(0.0, min(1.0, 0.5 - _v88_imb * 2.5))  # inverse of bid dominance
                        signal_data.setdefault("ob_ask_dominance", _v88_f133)
                        # F134: spread_vol_norm — rolling spread volatility normalized to [-1,+1]
                        #   Low spread_pct variance = stable liquidity (+1), high = erratic (-1)
                        _v88_sp     = float(_v88_ws_e.get("spread_pct", 0.0) or 0.0)
                        _v88_f134   = max(-1.0, min(1.0, 1.0 - _v88_sp * 50.0))  # 0.02% spread → 0.0; stable near +1
                        signal_data.setdefault("spread_vol_norm", _v88_f134)
                        # F135: trade_flow_intensity — aggressor buy ratio [-1,+1]
                        #   Source: depth_imbalance as proxy (positive → buy aggression)
                        _v88_f135   = max(-1.0, min(1.0, _v88_imb * 4.0))  # scale to [-1,+1]
                        signal_data.setdefault("trade_flow_intensity", _v88_f135)
                    except Exception:
                        pass  # v88.0 F131-F135 injection block is non-fatal
                    # v89.0 NN v25: F136-F140 — drawdown/risk/regime features
                    try:
                        # F136: dd_sentiment_norm — MaxDD normalized to [-1,0]
                        #   0.0=no drawdown; -1.0=MaxDD at 50% (max ruin boundary)
                        _v89_dd   = float(getattr(self, "_max_drawdown_pct", 0.0) or 0.0)
                        _v89_f136 = max(-1.0, min(0.0, -_v89_dd / 50.0))
                        signal_data.setdefault("dd_sentiment_norm", _v89_f136)
                        # F137: sharpe_norm_g — session Sharpe ratio normalized [-1,+1]
                        #   clamp(Sharpe / 5.0, -1, +1); Sharpe=-5→-1.0, 0→0.0, +5→+1.0
                        _v89_sr   = float(getattr(self, "sharpe_ratio", 0.0) or 0.0)
                        _v89_f137 = max(-1.0, min(1.0, _v89_sr / 5.0))
                        signal_data.setdefault("sharpe_norm_g", _v89_f137)
                        # F138: ev_session_norm — session EV/R normalized [-1,+1]
                        #   clamp(EV / 0.5, -1, +1); EV=-0.5→-1.0, 0→0.0, +0.5→+1.0
                        _v89_ev   = float(getattr(self, "expected_value_r", 0.0) or 0.0)
                        _v89_f138 = max(-1.0, min(1.0, _v89_ev / 0.5))
                        signal_data.setdefault("ev_session_norm", _v89_f138)
                        # F139: dd_gate_output — G8.5W2 DrawdownMomentum-Sentinel gate output
                        #   +1=healthy regime, -1=drawdown warning, 0=neutral
                        _v89_f139 = float(getattr(self, "_last_g85w2_ddm", 0))
                        signal_data.setdefault("dd_gate_output", _v89_f139)
                        # F140: kelly_health_norm — Kelly fraction health [0,1]
                        #   Current Kelly / Kelly cap; 0=floor, 1=cap (last_kelly_fraction property)
                        _v89_kf   = float(getattr(self, "last_kelly_fraction", 0.0) or 0.0)
                        _v89_kc   = float(getattr(self, "_kelly_cap", 0.02) or 0.02)
                        _v89_f140 = max(0.0, min(1.0, _v89_kf / _v89_kc if _v89_kc > 0 else 0.5))
                        signal_data.setdefault("kelly_health_norm", _v89_f140)
                    except Exception:
                        pass  # v89.0 F136-F140 injection block is non-fatal
                    # v90.0 NN v26: F141-F145 — WR-trajectory features
                    try:
                        _x2_total_f = int(
                            getattr(self._metrics, "win_count", 0) +
                            getattr(self._metrics, "loss_count", 0)
                        ) if self._metrics else 0
                        _x2_at_wr_f = float(getattr(self._metrics, "win_count", 0)) / max(1.0, float(_x2_total_f))
                        _x2_bst_f   = self._booster if self._booster else None
                        _x2_rw_f    = int(getattr(_x2_bst_f, "_rl_wins", 0))
                        _x2_rs_f    = int(getattr(_x2_bst_f, "_rl_ring_size", 20))
                        _x2_rr_wr_f = float(_x2_rw_f) / max(1.0, float(_x2_rs_f))
                        # F141: rolling_5wr_norm — recent 5-trade WR normalized [-1,+1]
                        #   Uses booster ring WR (best available proxy) normalized: 0%->-1, 100%->+1
                        _v90_f141 = max(-1.0, min(1.0, (_x2_rr_wr_f - 0.5) * 2.0))
                        signal_data.setdefault("rolling_5wr_norm", _v90_f141)
                        # F142: rolling_20wr_norm — all-time WR normalized [-1,+1]
                        _v90_f142 = max(-1.0, min(1.0, (_x2_at_wr_f - 0.5) * 2.0))
                        signal_data.setdefault("rolling_20wr_norm", _v90_f142)
                        # F143: wr_trajectory_norm — delta(recent - alltime) WR normalized [-1,+1]
                        #   +1=strongly recovering, -1=strongly deteriorating, 0=stable
                        _v90_f143 = max(-1.0, min(1.0, (_x2_rr_wr_f - _x2_at_wr_f) * 5.0))
                        signal_data.setdefault("wr_trajectory_norm", _v90_f143)
                        # F144: recent_loss_streak_norm — G8.5X2 trajectory gate output (+1/-1/0) as norm
                        _v90_f144 = float(getattr(self, "_last_g85x2_wrt", 0)) * -0.5  # -1->+0.5 (loss streak), +1->-0.5 (recovery)
                        signal_data.setdefault("recent_loss_streak_norm", _v90_f144)
                        # F145: recent_win_streak_norm — positive trajectory indicator [0,1]
                        _v90_f145 = max(0.0, min(1.0, _x2_rr_wr_f))
                        signal_data.setdefault("recent_win_streak_norm", _v90_f145)
                    except Exception:
                        pass  # v90.0 F141-F145 injection block is non-fatal
                    # v91.0 NN v27: F146-F150 — HMM-regime / VPIN-flow coherence features
                    try:
                        # HMM expansion probability [0,1]
                        _y2_hmm_ref_f = getattr(self, "_hmm_regime", None)
                        _y2_hmm_reg_f = "UNKNOWN"
                        _y2_hmm_pexp_f = 0.5
                        if _y2_hmm_ref_f is not None:
                            try:
                                _y2_hmm_reg_f, _y2_hmm_pexp_f, _ = _y2_hmm_ref_f.get_regime()
                            except Exception:
                                pass
                        # VPIN percentile and toxicity
                        _y2_vpin_ref_f   = getattr(self, "_vpin_model", None)
                        _y2_vpin_pct_f   = 0.5
                        _y2_vpin_toxic_f = False
                        if _y2_vpin_ref_f is not None and getattr(_y2_vpin_ref_f, "is_ready", False):
                            try:
                                _, _y2_vpin_pct_f, _, _y2_vpin_toxic_f = _y2_vpin_ref_f.get_signal()
                            except Exception:
                                pass
                        # F146: hmm_expansion_prob_norm [0,1]
                        _v91_f146 = float(_y2_hmm_pexp_f) if _y2_hmm_reg_f == "EXPANSION" else (1.0 - float(_y2_hmm_pexp_f))
                        _v91_f146 = max(0.0, min(1.0, _v91_f146 if _y2_hmm_reg_f == "EXPANSION" else float(_y2_hmm_pexp_f)))
                        signal_data.setdefault("hmm_expansion_prob_norm", _v91_f146)
                        # F147: vpin_pct_norm [0,1] (raw percentile)
                        _v91_f147 = max(0.0, min(1.0, float(_y2_vpin_pct_f)))
                        signal_data.setdefault("vpin_pct_norm", _v91_f147)
                        # F148: hmm_vpin_coherence_norm [-1,+1]
                        #   +1 = EXPANSION + clean; -1 = CONTRACTION + toxic; 0 = neutral
                        _hvc_hmm = 1.0 if _y2_hmm_reg_f == "EXPANSION" else (-1.0 if _y2_hmm_reg_f == "CONTRACTION" else 0.0)
                        _hvc_vpin = max(-1.0, min(1.0, (0.5 - float(_y2_vpin_pct_f)) * 2.0))  # low pct -> +1 (clean)
                        _v91_f148 = max(-1.0, min(1.0, (_hvc_hmm + _hvc_vpin) / 2.0))
                        signal_data.setdefault("hmm_vpin_coherence_norm", _v91_f148)
                        # F149: hmm_regime_norm [-1,+1]
                        _v91_f149 = 1.0 if _y2_hmm_reg_f == "EXPANSION" else (-1.0 if _y2_hmm_reg_f == "CONTRACTION" else 0.0)
                        signal_data.setdefault("hmm_regime_norm", _v91_f149)
                        # F150: vpin_toxic_norm [0,1]
                        _v91_f150 = 1.0 if _y2_vpin_toxic_f else max(0.0, min(1.0, (float(_y2_vpin_pct_f) - 0.8) * 5.0))
                        signal_data.setdefault("vpin_toxic_norm", _v91_f150)
                    except Exception:
                        pass  # v91.0 F146-F150 injection block is non-fatal
                    # v92.0 NN v28: F151-F155 — Regime-Momentum-Sync triple-source features
                    try:
                        # Derive the 3 source direction signs from already-computed data
                        _z2_sig_d = signal_data.get("action", signal_data.get("direction", "")) if isinstance(signal_data, dict) else ""  # v99.0: "action" key fix
                        _z2_dsign = 1 if _z2_sig_d in ("LONG","BUY","long","buy") else (-1 if _z2_sig_d in ("SHORT","SELL","short","sell") else 0)
                        # HMM source sign
                        _z2_hmm_reff = getattr(self, "_hmm_regime", None)
                        _z2_hmm_s = 0
                        if _z2_hmm_reff is not None:
                            try:
                                _z2_hr, _, _ = _z2_hmm_reff.get_regime()
                                _z2_hmm_s = 1 if _z2_hr == "EXPANSION" else (-1 if _z2_hr == "CONTRACTION" else 0)
                            except Exception:
                                pass
                        # OFI source sign
                        _z2_ofi_zz = float(signal_data.get("ofi_z", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                        _z2_ofi_s  = 1 if _z2_ofi_zz > 0.3 else (-1 if _z2_ofi_zz < -0.3 else 0)
                        # Funding rate trend source sign
                        _z2_fr_t   = float(signal_data.get("funding_rate_trend", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                        _z2_fund_s = 1 if _z2_fr_t < -0.00005 else (-1 if _z2_fr_t > 0.00005 else 0)
                        # F151: rms_3source_sync_norm [-1,+1]
                        _z2_srcs   = [_z2_hmm_s, _z2_ofi_s, _z2_fund_s]
                        _z2_active = [s for s in _z2_srcs if s != 0]
                        if _z2_active and _z2_dsign != 0:
                            _z2_al = sum(1 for s in _z2_active if s == _z2_dsign)
                            _z2_op = sum(1 for s in _z2_active if s == -_z2_dsign)
                            _z2_sync = (_z2_al - _z2_op) / max(1, len(_z2_active))
                        else:
                            _z2_sync = 0.0
                        signal_data.setdefault("rms_3source_sync_norm", max(-1.0, min(1.0, _z2_sync)))
                        # F152: hmm_ofi_sync_norm [-1,+1]
                        _z2_ho = float(_z2_hmm_s * _z2_ofi_s) if (_z2_hmm_s != 0 and _z2_ofi_s != 0) else 0.0
                        signal_data.setdefault("hmm_ofi_sync_norm", _z2_ho)
                        # F153: ofi_fund_sync_norm [-1,+1]
                        _z2_of = float(_z2_ofi_s * _z2_fund_s) if (_z2_ofi_s != 0 and _z2_fund_s != 0) else 0.0
                        signal_data.setdefault("ofi_fund_sync_norm", _z2_of)
                        # F154: hmm_fund_sync_norm [-1,+1]
                        _z2_hf = float(_z2_hmm_s * _z2_fund_s) if (_z2_hmm_s != 0 and _z2_fund_s != 0) else 0.0
                        signal_data.setdefault("hmm_fund_sync_norm", _z2_hf)
                        # F155: rms_quality_norm [0,1]
                        _z2_qual = abs(_z2_sync)
                        signal_data.setdefault("rms_quality_norm", max(0.0, min(1.0, _z2_qual)))
                    except Exception:
                        pass  # v92.0 F151-F155 injection block is non-fatal
                    # v93.0 NN v29: F156-F160 — VPIN-OFI-Funding Triple-Confluence features
                    try:
                        # VPIN toxicity score (already computed by _vpin_model)
                        _a3_vpin_ref = getattr(self, "_vpin_model", None)
                        _a3_vpin_pct = 0.5  # default neutral
                        if _a3_vpin_ref is not None:
                            try:
                                _a3_vs = _a3_vpin_ref.get_signal()
                                _a3_vpin_pct = float(_a3_vs.get("vpin_pct", 0.5) or 0.5) if isinstance(_a3_vs, dict) else 0.5
                            except Exception:
                                pass
                        # OFI z-score direction (already in signal_data)
                        _a3_ofi_z  = float(signal_data.get("ofi_z", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                        _a3_ofi_s  = 1 if _a3_ofi_z > 0.3 else (-1 if _a3_ofi_z < -0.3 else 0)
                        # Funding rate trend direction (already in signal_data)
                        _a3_fr_t   = float(signal_data.get("funding_rate_trend", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                        _a3_fund_s = 1 if _a3_fr_t < -0.00005 else (-1 if _a3_fr_t > 0.00005 else 0)
                        # Signal direction sign
                        _a3_sd     = signal_data.get("action", signal_data.get("direction", "")) if isinstance(signal_data, dict) else ""  # v99.0: "action" key fix
                        _a3_dsign  = 1 if _a3_sd in ("LONG","BUY","long","buy") else (-1 if _a3_sd in ("SHORT","SELL","short","sell") else 0)
                        # VPIN sign: clean=aligned, toxic=opposing
                        _a3_vpin_s = (-1 if _a3_vpin_pct > 0.60 else (1 if _a3_vpin_pct < 0.40 else 0))
                        # F156: vpin_ofi_conf_norm — VPIN×OFI cross-source alignment [-1,+1]
                        _a3_vo = float(_a3_vpin_s * _a3_ofi_s) if (_a3_vpin_s != 0 and _a3_ofi_s != 0) else 0.0
                        signal_data.setdefault("vpin_ofi_conf_norm", _a3_vo)
                        # F157: vpin_fund_conf_norm — VPIN×Funding cross-source alignment [-1,+1]
                        _a3_vf = float(_a3_vpin_s * _a3_fund_s) if (_a3_vpin_s != 0 and _a3_fund_s != 0) else 0.0
                        signal_data.setdefault("vpin_fund_conf_norm", _a3_vf)
                        # F158: ofi_fund_conf_norm — OFI×Funding cross-source alignment [-1,+1]
                        _a3_of = float(_a3_ofi_s * _a3_fund_s) if (_a3_ofi_s != 0 and _a3_fund_s != 0) else 0.0
                        signal_data.setdefault("ofi_fund_conf_norm", _a3_of)
                        # F159: triple_conf_quality — 3-way absolute agreement [0,1]
                        _a3_srcs   = [_a3_vpin_s, _a3_ofi_s, _a3_fund_s]
                        _a3_active = [s for s in _a3_srcs if s != 0]
                        if len(_a3_active) >= 2 and _a3_dsign != 0:
                            _a3_al    = sum(1 for s in _a3_active if s == _a3_dsign)
                            _a3_qual  = _a3_al / max(1, len(_a3_active))
                        else:
                            _a3_qual  = 0.5
                        signal_data.setdefault("triple_conf_quality", max(0.0, min(1.0, _a3_qual)))
                        # F160: vpc_gate_output — gate output +1/0/-1 (uses _last_g85a3_vpc)
                        signal_data.setdefault("vpc_gate_output", float(getattr(self, "_last_g85a3_vpc", 0)))
                    except Exception:
                        pass  # v93.0 F156-F160 injection block is non-fatal
                    # v94.0 NN v30: F161-F165 — HMM-OFI-Spread Triple-Sync features
                    try:
                        # Source 1: HMM state alignment with signal direction
                        _b3_hmm_state  = signal_data.get("hmm_state", None) if isinstance(signal_data, dict) else None
                        _b3_sd         = signal_data.get("action", signal_data.get("direction", "")) if isinstance(signal_data, dict) else ""  # v99.0: "action" key fix
                        _b3_is_long    = _b3_sd in ("LONG", "BUY", "long", "buy")
                        _b3_is_short   = _b3_sd in ("SHORT", "SELL", "short", "sell")
                        _b3_dir_sign   = 1 if _b3_is_long else (-1 if _b3_is_short else 0)
                        # HMM: BULL/BULLISH=+1 (favours LONG), BEAR/BEARISH=-1, TRENDING=+1, RANGING/TRANSITIONING=0
                        if isinstance(_b3_hmm_state, str):
                            _b3_hmm_s = 1 if _b3_hmm_state.upper() in ("BULL","BULLISH","TRENDING") else \
                                        (-1 if _b3_hmm_state.upper() in ("BEAR","BEARISH") else 0)
                        else:
                            _b3_hmm_s = 0
                        _b3_hmm_conf = _b3_hmm_s * _b3_dir_sign if _b3_hmm_s != 0 and _b3_dir_sign != 0 else 0
                        # Source 2: OFI z-score direction agreement
                        _b3_ofi_z    = float(signal_data.get("ofi_z", 0.0) or 0.0) if isinstance(signal_data, dict) else 0.0
                        _b3_ofi_s    = 1 if _b3_ofi_z > 0.3 else (-1 if _b3_ofi_z < -0.3 else 0)
                        _b3_ofi_conf = _b3_ofi_s * _b3_dir_sign if _b3_ofi_s != 0 and _b3_dir_sign != 0 else 0
                        # Source 3: SpreadLiq gate last output (from _last_g85k_slq: +1=liquid, -1=illiquid)
                        _b3_slq_s    = getattr(self, "_last_g85k_slq", 0)
                        # Liquid spread aligns with ANY direction; illiquid opposes any trade
                        _b3_slq_conf = int(_b3_slq_s) if _b3_dir_sign != 0 else 0
                        # F161: hmm_ofi_sync_norm — HMM×OFI agreement [-1,+1]
                        _b3_ho = float(_b3_hmm_conf * _b3_ofi_conf) if (_b3_hmm_conf != 0 and _b3_ofi_conf != 0) else \
                                 (float(_b3_hmm_conf) if _b3_hmm_conf != 0 else float(_b3_ofi_conf))

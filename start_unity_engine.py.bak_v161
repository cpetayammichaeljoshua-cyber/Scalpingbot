            ("SignalMaestro.public_api_intelligence",      None,                "Public API Intelligence"),
        ]:
            try:
                import importlib
                mod = importlib.import_module(mod_path)
                if attr:
                    obj = getattr(mod, attr, None)
                    if obj:
                        if "market_intel" in label.lower():

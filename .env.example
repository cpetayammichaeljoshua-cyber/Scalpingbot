# ══════════════════════════════════════════════════════════════════════════════
# UNITY ENGINE — environment template
# ══════════════════════════════════════════════════════════════════════════════
# Copy to .env, fill in real values, then run `python3 start_unity_engine.py`.
#
#   cp .env.example .env
#
# .env.example is committed so new environments know the shape; .env itself is
# gitignored and must hold the real credentials.
#
# The entrypoint has a built-in stdlib loader (v230.2) that reads .env from
# CWD, the script directory, and $HOME. No python-dotenv dependency needed.
#
# Security: never commit .env, never paste live keys into chat/logs/tickets.
# .gitignore already excludes .env (line 123).
# ══════════════════════════════════════════════════════════════════════════════

# ── Binance (REQUIRED) ───────────────────────────────────────────────────────
# Create at https://www.binance.com/en/my/settings/api-management
# For safety, grant only: Spot API + Enable Reading. Leave Trading OFF until
# shadow mode is verified on real data.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── AI / LLM routing (engine gate stack calls these per signal) ───────────────
# G0DM0D3 engine priority: NVIDIA_API_KEY -> OPENROUTER_API_KEY -> OPENAI_API_KEY.
# NVIDIA is the primary provider (nvidia/nemotron-* free models on
# integrate.api.nvidia.com/v1).  Add your NVIDIA key here.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Backup: the engine falls back to OpenAI if NVIDIA/OpenRouter unavailable.
OPENAI_API_KEY=
# Optional: backup key slots consumed by the failover chain.
BACKUP_1=
BACKUP_2=
BACKUP_3=

# ── Telegram (REQUIRED) ──────────────────────────────────────────────────────
# Bot token from @BotFather; chat ID from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Channel to publish signals to (e.g. -100xxxxxxxxxx).
TELEGRAM_CHANNEL_ID=

# ── Signal routing safety ────────────────────────────────────────────────────
# Unity Engine's own safety gate:
#   UNITY_SHADOW_MODE=1  -> force LOG-ONLY, no orders and no dispatch
#   UNITY_AUTO_SHADOW=0  -> disable the automatic low-WR shadow fallback
#
# Default (both unset) is already protective: with zero trade history the
# Bayesian win-rate estimator sits below AUTO_PAPER_WR_THRESHOLD (0.27) and
# the engine routes to shadow mode by itself. Leave these unset until you
# have real closed-out trade data.
UNITY_SHADOW_MODE=0
UNITY_AUTO_SHADOW=1

# ── Session / risk hard-blocks (walk-forward-validated neg-expectancy gates) ──
# UNITY_ASIAN_HARDBLOCK: 0=OFF (allow Asian-session trading), 1=ON (0-6h UTC block).
#   Default 1.  Set 0 to trade the Asian session (Kelly Step106 still de-sizes 0.55).
UNITY_ASIAN_HARDBLOCK=0
# UNITY_VOLSPIKE_HARDBLOCK: 1=ON blocks volume_ratio > 2.0 spikes. Default 1.
UNITY_VOLSPIKE_HARDBLOCK=1
# UNITY_NONUS_HARDBLOCK: 0=OFF (non-US sessions allowed). Default 0.
UNITY_NONUS_HARDBLOCK=0

# ── Optional infra ───────────────────────────────────────────────────────────
# Redis cache/state (falls back to local file persistence when absent).
REDIS_URL=
# Railway/Heroku injects this automatically; the health server binds to it.
PORT=
